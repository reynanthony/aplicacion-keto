---
// Hamburger slide-in menu — shared across all app pages.
// Toggle with: toggleHamburgerMenu()
---

<!-- Overlay -->
<div id="hamburgerMenu" class="fixed inset-0 z-[70] hidden">
  <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" onclick="toggleHamburgerMenu()"></div>
  <div id="hamburgerPanel" class="absolute top-0 right-0 h-full w-72 shadow-2xl transform transition-transform duration-300 translate-x-full" style="background:#161616;border-left:1px solid rgba(255,255,255,0.07)">

    <!-- Panel header -->
    <div class="flex items-center justify-between px-4" style="height:56px;border-bottom:1px solid rgba(255,255,255,0.06)">
      <div class="flex items-center gap-2.5">
        <img src="/app/logo.svg" alt="KetoCore" class="w-6 h-6" style="filter:drop-shadow(0 0 4px rgba(255,77,0,0.4))">
        <span class="text-sm font-black" style="color:#f5f5f5;font-family:'Plus Jakarta Sans',sans-serif">KetoCore</span>
      </div>
      <button onclick="toggleHamburgerMenu()" aria-label="Cerrar menú" class="w-9 h-9 rounded-full flex items-center justify-center transition-all" style="color:rgba(245,245,245,0.5)">
        <span class="material-symbols-outlined" style="font-size:22px">close</span>
      </button>
    </div>

    <!-- Nav links -->
    <div class="overflow-y-auto pb-20" style="height:calc(100% - 56px)">
      <nav class="p-2 space-y-0.5 mt-1">
        <a href="/app/" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#ff4d00">home</span>
          <span class="font-medium">Inicio</span>
        </a>
        <a href="/app/checklist" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#22c55e">task_alt</span>
          <span class="font-medium">Checklist</span>
        </a>
        <a href="/app/entrenamientos" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#4ade80">fitness_center</span>
          <span class="font-medium">Entrenamientos</span>
        </a>
        <a href="/app/suplementos" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#c084fc">medication</span>
          <span class="font-medium">Suplementos</span>
        </a>
        <a href="/app/alimentos" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#fb923c">restaurant</span>
          <span class="font-medium">Alimentos</span>
        </a>
        <a href="/app/compras" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#60a5fa">shopping_cart</span>
          <span class="font-medium">Lista de Compras</span>
        </a>
        <a href="/app/progreso" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#ff4d00">trending_up</span>
          <span class="font-medium">Mi Progreso</span>
        </a>
        <a href="/app/objetivos" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#ff4d00;font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24">flag</span>
          <span class="font-medium">Mis Objetivos</span>
        </a>
        <a href="/app/comunidad" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:#a78bfa">group</span>
          <span class="font-medium">Comunidad</span>
          <span class="ml-auto text-[9px] font-bold px-1.5 py-0.5 rounded-full" style="background:rgba(167,139,250,0.15);color:#a78bfa">PRONTO</span>
        </a>
        <a href="/app/perfil" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-colors hover:bg-white/5" style="color:#f5f5f5">
          <span class="material-symbols-outlined" style="color:rgba(245,245,245,0.55)">person</span>
          <span class="font-medium">Mi Perfil</span>
        </a>
      </nav>

      <div class="mx-4 my-2" style="height:1px;background:rgba(255,255,255,0.06)"></div>

      <button onclick="handleLogout(); toggleHamburgerMenu();" class="w-full flex items-center gap-3 px-6 py-3 rounded-xl transition-colors hover:bg-red-50/10" style="color:#dc2626">
        <span class="material-symbols-outlined">logout</span>
        <span class="font-medium">Cerrar Sesión</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
function toggleHamburgerMenu() {
  var m = document.getElementById('hamburgerMenu');
  var p = document.getElementById('hamburgerPanel');
  if (!m || !p) return;
  if (m.classList.contains('hidden')) {
    m.classList.remove('hidden');
    requestAnimationFrame(function() { p.classList.remove('translate-x-full'); });
  } else {
    p.classList.add('translate-x-full');
    setTimeout(function() { m.classList.add('hidden'); }, 300);
  }
}
</script>
