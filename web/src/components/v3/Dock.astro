---
// Dock — v3. Cuatro destinos + un botón. El botón central abre una hoja, nunca navega
// (regla dura del handoff). Refleja el estado de alerta escuchando "v3:budget-changed".
interface Props {
  active?: 'hoy' | 'macros' | 'plan' | 'yo';
  fabSheetId?: string;
}

const { active = 'hoy', fabSheetId = 'v3-sheet-registrar' } = Astro.props;

const items = [
  { id: 'hoy', href: '/app/', icon: 'cottage', label: 'Hoy' },
  { id: 'macros', href: '/app/macros', icon: 'donut_small', label: 'Macros' },
];
const itemsRight = [
  { id: 'plan', href: '/app/plan', icon: 'event_note', label: 'Plan' },
  { id: 'yo', href: '/app/perfil', icon: 'person', label: 'Yo' },
];
---

<nav class="v3-dock" id="v3Dock" aria-label="Navegación principal">
  {items.map((item) => (
    <a href={item.href} class:list={['v3-dock-item', item.id === active && 'v3-dock-item--active']}>
      <span class="material-symbols-outlined">{item.icon}</span>
      <span class="v3-dock-item-label">{item.label}</span>
    </a>
  ))}

  <button type="button" class="v3-dock-fab" data-open-sheet={fabSheetId} aria-label="Registrar">
    <span class="material-symbols-outlined">add</span>
  </button>

  {itemsRight.map((item) => (
    <a href={item.href} class:list={['v3-dock-item', item.id === active && 'v3-dock-item--active']}>
      <span class="material-symbols-outlined">{item.icon}</span>
      <span class="v3-dock-item-label">{item.label}</span>
    </a>
  ))}
</nav>

<script is:inline>
(function () {
  if (window.__v3DockInit) return;
  window.__v3DockInit = true;

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-open-sheet]');
    if (!btn) return;
    var id = btn.getAttribute('data-open-sheet');
    if (window.KetoSheet) window.KetoSheet.toggle(id); // nunca navega: solo abre la hoja
  });

  document.addEventListener('v3:budget-changed', function (e) {
    document.querySelectorAll('.v3-dock').forEach(function (dock) {
      dock.classList.toggle('v3-dock--alert', e.detail && e.detail.state === 'over');
    });
  });
})();
</script>
