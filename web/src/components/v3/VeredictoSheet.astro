---
// VeredictoSheet — v3. Decide si un alimento entra en el día. Se monta una vez
// por página (Hoy y Scanner) y se controla vía window.KetoVeredicto (v3-veredicto.js).
// El bloque crema traduce macros a decisión: barra actual-vs-proyectado, no
// usado-vs-límite (por eso reutiliza las clases .v3-bh-bar-* directamente en
// vez de instanciar BudgetHeader, que es semánticamente distinto).
import Sheet from './Sheet.astro';
import Chip from './Chip.astro';
---

<Sheet id="v3-sheet-veredicto" title="Veredicto" subtitle="Margen de hoy · — g netos">
  <div class="v3-decision-card v3-decision-card--cream" style="padding:16px; border-radius:var(--v3-radius-card);">
    <input id="vNameInput" type="text" placeholder="Nombre del alimento" value="Alimento"
      style="background:transparent; border:none; font-family:var(--v3-font-title); font-weight:800; font-size:16px; color:var(--v3-text-on-cream); width:100%; margin-bottom:10px; padding:0;" />

    <div class="v3-bh-bar-track" style="height:9px; background:rgba(26,20,14,0.12);">
      <div id="vBarTrack" class="v3-bh-bar-fill" style="width:0%; background:linear-gradient(90deg, var(--v3-lime-dark), var(--v3-text-on-cream));"></div>
    </div>
    <p id="vSentence" style="font-size:13.5px; margin-top:10px; opacity:0.85;">Calculando impacto en tu margen de hoy…</p>
  </div>

  <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px;">
    <label class="v3-eyebrow">Kcal
      <input id="vTileKcal" type="number" class="v3-num-mono" value="0"
        style="width:100%; background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:10px; padding:8px 4px; margin-top:4px; color:var(--v3-text);" />
    </label>
    <label class="v3-eyebrow">Netos
      <input id="vTileNetos" type="number" class="v3-num-mono" value="0"
        style="width:100%; background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:10px; padding:8px 4px; margin-top:4px; color:var(--v3-text);" />
    </label>
    <label class="v3-eyebrow">Grasa
      <input id="vTileGrasa" type="number" class="v3-num-mono" value="0"
        style="width:100%; background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:10px; padding:8px 4px; margin-top:4px; color:var(--v3-text);" />
    </label>
    <label class="v3-eyebrow">Prot
      <input id="vTileProt" type="number" class="v3-num-mono" value="0"
        style="width:100%; background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:10px; padding:8px 4px; margin-top:4px; color:var(--v3-text);" />
    </label>
  </div>

  <div style="display:flex; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center; gap:10px;">
      <button type="button" id="vQtyMinus" class="v3-sheet-close" aria-label="Menos">−</button>
      <input id="vQtyInput" type="number" value="100" style="width:60px; text-align:center; background:transparent; border:none; color:var(--v3-text); font-family:var(--v3-font-mono);" />
      <span class="v3-eyebrow">g</span>
      <button type="button" id="vQtyPlus" class="v3-sheet-close" aria-label="Más">+</button>
    </div>
    <div id="vVerdictChipWrap"><Chip role="verdict" label="Evaluando" verdict="lime" /></div>
  </div>

  <button type="button" id="vAddBtn" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); width:100%; justify-content:center;">
    Añadir a mi registro
  </button>

  <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
</Sheet>
