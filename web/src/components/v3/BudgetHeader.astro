---
// BudgetHeader — v3. La cifra que manda: carbos netos disponibles.
// No fija el estado de alerta por sí mismo: solo lee variables --v3-*,
// así repinta gratis cuando <html data-v3-alert> cambia (ver day-budget.js).
interface Props {
  used: number;
  limit: number;
  bonus?: number;
  state?: 'ok' | 'warn' | 'over';
  variant?: 'hero' | 'bar';
  label?: string;
}

const { used, limit, bonus = 0, state = 'ok', variant = 'hero', label = 'HOY' } = Astro.props;

const available = Math.max(0, limit - used);
const usedPct = limit > 0 ? Math.min(100, (used / limit) * 100) : 0;
const bonusPct = limit > 0 ? Math.min(100 - usedPct, (bonus / limit) * 100) : 0;
---

<div class={`v3-budget-header v3-budget-header--${variant} v3-bh-wrap`} data-v3-state={state}>
  {bonus > 0 && (
    <span class="v3-bonus-chip">
      <span class="material-symbols-outlined" style="font-size:13px">fitness_center</span>
      +{bonus} g
    </span>
  )}

  <span class="v3-eyebrow">{label}</span>

  <div class="v3-bh-figure">
    <span class="v3-bh-num">{available}</span>
    <span class="v3-bh-unit">g</span>
    <span class="v3-bh-of">de {limit}</span>
  </div>

  <div class="v3-bh-bar-track">
    <div class="v3-bh-bar-fill" style={`width:${usedPct}%`}></div>
    {bonus > 0 && <div class="v3-bh-bar-bonus" style={`left:${usedPct}%;width:${bonusPct}%`}></div>}
  </div>

  {variant === 'hero' && (
    <div class="v3-bh-footer">
      <span>{used} usados</span>
      {state === 'warn' && <span class="v3-icon-amber">Margen bajo</span>}
      {state === 'over' && <span class="v3-icon-orange">Fuera de margen</span>}
    </div>
  )}
</div>
