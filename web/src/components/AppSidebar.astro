---
// AppSidebar — navegación completa de la app (rediseño Editorial Bento)
// Desktop >900px: aside fijo 250px. Móvil ≤900px: bottom tab bar (5 items,
// botón central "Escanear") + drawer "Más". Expone toggleHamburgerMenu()
// para los botones de menú existentes en los headers de cada página.

const sections = [
  {
    label: 'Principal',
    links: [
      { id: 'home',     href: '/app/',          icon: 'cottage',     color: '', label: 'Dashboard' },
      { id: 'macros',   href: '/app/macros',    icon: 'donut_small', color: '', label: 'Macros' },
      { id: 'plan',     href: '/app/plan',      icon: 'event_note',  color: '', label: 'Plan Alimenticio' },
      { id: 'recetas',  href: '/app/recetas',   icon: 'menu_book',   color: '', label: 'Recetas' },
    ],
  },
  {
    label: 'Herramientas',
    links: [
      { id: 'checklist',      href: '/app/checklist',      icon: 'task_alt',            color: '#22c55e', label: 'Checklist' },
      { id: 'entrenamientos', href: '/app/entrenamientos', icon: 'fitness_center',      color: '#4ade80', label: 'Entrenamientos' },
      { id: 'alimentos',      href: '/app/alimentos',      icon: 'restaurant',          color: '#fb923c', label: 'Alimentos' },
      { id: 'suplementos',    href: '/app/suplementos',    icon: 'medication',          color: '#f59e0b', label: 'Suplementos' },
      { id: 'compras',        href: '/app/compras',        icon: 'shopping_cart',       color: '#60a5fa', label: 'Lista de Compras' },
      { id: 'scanner',        href: '/app/scanner',        icon: 'center_focus_strong', color: '#22d3ee', label: 'Scanner IA' },
    ],
  },
  {
    label: 'Inteligencia',
    links: [
      { id: 'coach',     href: '/app/coach',     icon: 'psychology', color: '#a78bfa', label: 'Coach IA' },
      { id: 'inspector', href: '/app/inspector', icon: 'analytics',  color: '#ff4d00', label: 'Inspector' },
      { id: 'comunidad', href: '/app/comunidad', icon: 'groups',     color: '#f472b6', label: 'Comunidad', badge: 'PRONTO' },
    ],
  },
  {
    label: 'Progreso & Perfil',
    links: [
      { id: 'progreso',  href: '/app/progreso',  icon: 'trending_up', color: '#ff4d00', label: 'Mi Progreso' },
      { id: 'objetivos', href: '/app/objetivos', icon: 'flag',        color: '#ff4d00', label: 'Mis Objetivos' },
      { id: 'perfil',    href: '/app/perfil',    icon: 'person',      color: '', label: 'Mi Perfil' },
    ],
  },
];

// Drawer móvil "Más" — agrupado igual que el aside de escritorio (antes era
// una grilla plana de 15 items sin jerarquía). Dashboard/Macros/Plan/Scanner
// quedan fuera: ya tienen su propio tab fijo en la bottom bar.
const drawerSections = [
  {
    label: 'Herramientas',
    links: [
      { href: '/app/recetas',        icon: 'menu_book',      color: '#fb923c', label: 'Recetas' },
      { href: '/app/checklist',      icon: 'task_alt',       color: '#22c55e', label: 'Checklist' },
      { href: '/app/entrenamientos', icon: 'fitness_center', color: '#4ade80', label: 'Entrenar' },
      { href: '/app/alimentos',      icon: 'restaurant',     color: '#fb923c', label: 'Alimentos' },
      { href: '/app/suplementos',    icon: 'medication',     color: '#f59e0b', label: 'Suplementos' },
      { href: '/app/compras',        icon: 'shopping_cart',  color: '#60a5fa', label: 'Compras' },
    ],
  },
  {
    label: 'Inteligencia',
    links: [
      { href: '/app/coach',     icon: 'psychology', color: '#a78bfa', label: 'Coach IA' },
      { href: '/app/inspector', icon: 'analytics',  color: '#ff4d00', label: 'Inspector' },
      { href: '/app/comunidad', icon: 'groups',     color: '#f472b6', label: 'Comunidad', badge: 'PRONTO' },
    ],
  },
  {
    label: 'Progreso & Perfil',
    links: [
      { href: '/app/progreso',  icon: 'trending_up', color: '#ff4d00', label: 'Progreso' },
      { href: '/app/objetivos', icon: 'flag',        color: '#ff4d00', label: 'Objetivos' },
      { href: '/app/perfil',    icon: 'person',      color: '',       label: 'Mi Perfil' },
    ],
  },
  {
    label: 'Más',
    links: [
      { href: '/app/guia',  icon: 'help',        color: '#60a5fa', label: 'Guía' },
      { id: 'demo', href: '/app/demo/', icon: 'play_circle', color: '#ff4d00', label: 'Modo Prueba' },
      { href: '/',          icon: 'language',    color: '#22d3ee', label: 'Sitio Web', web: true },
    ],
  },
];

// Sheet "Agregar" del botón central — reemplaza el salto directo a Scanner.
const quickAddLinks = [
  { href: '/app/scanner',   icon: 'center_focus_strong', color: '#22d3ee', label: 'Escanear' },
  { href: '/app/alimentos', icon: 'restaurant',          color: '#fb923c', label: 'Alimentos' },
  { href: '/app/checklist', icon: 'task_alt',            color: '#22c55e', label: 'Checklist' },
];
---

<!-- ===== DESKTOP ASIDE ===== -->
<aside id="appSidebar">
  <div class="kcs-logo">
    <a href="/app/" class="kcs-logo-link">
      <img src="/app/logo.svg" alt="KetoCore" class="kcs-logo-img" width="36" height="36">
      <span class="kcs-logo-text">
        <span class="kcs-brand">KetoCore</span>
        <span class="kcs-tagline">Nutrition AI</span>
      </span>
    </a>
  </div>

  <nav class="kcs-nav">
    {sections.map(section => (
      <>
        <p class="kcs-label">{section.label}</p>
        {section.links.map(link => (
          <a href={link.href} data-nav={link.id} class="kcs-link">
            <span class="material-symbols-outlined kcs-ic" style={link.color ? `color:${link.color}` : ''}>{link.icon}</span>
            <span>{link.label}</span>
            {link.badge && <span class="kcs-badge">{link.badge}</span>}
          </a>
        ))}
      </>
    ))}
    <a href="/app/demo/" id="kcsDemoLink" class="kcs-demo">
      <span class="material-symbols-outlined icon-filled" style="font-size:16px">play_circle</span>
      <span data-label>Modo Prueba (Demo)</span>
      <span class="kcs-demo-dot"></span>
    </a>
    <a href="/" class="kcs-demo kc-web-link" style="background:transparent;border-color:rgba(255,240,225,0.1);color:rgba(247,244,240,0.55);margin-top:6px">
      <span class="material-symbols-outlined" style="font-size:16px">language</span>
      <span>Volver al sitio web</span>
    </a>
    <button type="button" class="kcs-demo kc-install-btn" onclick="kcInstallApp()" style="background:rgba(34,197,94,0.08);border-color:rgba(34,197,94,0.2);color:#22c55e;margin-top:6px;width:calc(100% - 0px);cursor:pointer;font-family:inherit">
      <span class="material-symbols-outlined" style="font-size:16px">install_mobile</span>
      <span>Instalar app</span>
    </button>
  </nav>

  <div class="kcs-foot">
    <a href="/app/perfil" class="kcs-user">
      <span id="sbAvatar" class="kcs-avatar">?</span>
      <span class="kcs-user-info">
        <span id="sbName" class="kcs-user-name">--</span>
        <span id="sbSub" class="kcs-user-sub">keto tracker</span>
      </span>
      <span class="material-symbols-outlined" style="font-size:18px;color:rgba(247,244,240,0.3)">expand_more</span>
    </a>
  </div>
</aside>

<!-- ===== MOBILE BOTTOM TAB BAR ===== -->
<nav id="kcTabbar" aria-label="Navegación principal">
  <a href="/app/"       data-tab="home"   class="kct-item"><span class="material-symbols-outlined kct-ic">cottage</span><span class="kct-lbl">Inicio</span></a>
  <a href="/app/macros" data-tab="macros" class="kct-item"><span class="material-symbols-outlined kct-ic">donut_small</span><span class="kct-lbl">Macros</span></a>
  <button type="button" onclick="toggleQuickAdd()" data-tab="add" class="kct-item" aria-label="Agregar" aria-haspopup="true">
    <span class="kct-scan"><span class="material-symbols-outlined" style="font-size:26px;color:#fff">add</span></span>
    <span class="kct-lbl">Agregar</span>
  </button>
  <a href="/app/plan"   data-tab="plan"   class="kct-item"><span class="material-symbols-outlined kct-ic">event_note</span><span class="kct-lbl">Plan</span></a>
  <button type="button" onclick="toggleHamburgerMenu()" class="kct-item" aria-label="Más opciones"><span class="material-symbols-outlined kct-ic">menu</span><span class="kct-lbl">Más</span></button>
</nav>

<!-- ===== MOBILE DRAWER ===== -->
<div id="kcDrawer" aria-hidden="true">
  <div class="kcd-scrim" onclick="toggleHamburgerMenu()"></div>
  <div class="kcd-sheet" role="dialog" aria-label="Menú">
    <div class="kcd-handle-row"><span class="kcd-handle"></span></div>
    <div class="kcd-user-row">
      <span id="kcdAvatar" class="kcs-avatar" style="width:40px;height:40px;font-size:15px">?</span>
      <span class="kcs-user-info">
        <span id="kcdName" class="kcs-user-name" style="font-size:14px">--</span>
        <span id="kcdSub" class="kcs-user-sub" style="font-size:11px">keto tracker</span>
      </span>
      <button type="button" class="kcd-close" onclick="toggleHamburgerMenu()" aria-label="Cerrar menú">
        <span class="material-symbols-outlined" style="font-size:20px;color:rgba(247,244,240,0.6)">close</span>
      </button>
    </div>
    <div class="kcd-grid">
      {drawerSections.map((section, i) => (
        <>
          <button type="button" class="kcd-label" onclick={`toggleDrawerSection(${i})`} aria-expanded="false" aria-controls={`kcd-section-${i}`}>
            <span>{section.label}</span>
            <span class="material-symbols-outlined kcd-label-chevron" data-chevron={i}>expand_more</span>
          </button>
          <div class="kcd-row kcd-row-collapsed" id={`kcd-section-${i}`}>
            {section.links.map(link => (
              <a href={link.href} id={link.id === 'demo' ? 'kcdDemoLink' : undefined} class:list={['kcd-link', { 'kc-web-link': link.web }]}>
                <span class="material-symbols-outlined" style={`font-size:21px;color:${link.color || 'rgba(247,244,240,0.6)'}`}>{link.icon}</span>
                <span data-label>{link.label}</span>
                {link.badge && <span class="kcd-badge">{link.badge}</span>}
              </a>
            ))}
          </div>
        </>
      ))}
    </div>
    <div class="kcd-footer">
      <button type="button" class="kcd-foot-btn kc-install-btn" onclick="kcInstallApp()">
        <span class="material-symbols-outlined" style="font-size:19px;color:#22c55e">install_mobile</span>
        <span>Instalar app</span>
      </button>
      <button type="button" class="kcd-foot-btn kcd-foot-danger" onclick="kcLogout()">
        <span class="material-symbols-outlined" style="font-size:19px">logout</span>
        <span>Salir</span>
      </button>
    </div>
  </div>
</div>

<!-- ===== QUICK ADD SHEET (botón central) ===== -->
<div id="kcQuickAdd" aria-hidden="true">
  <div class="kcd-scrim" onclick="toggleQuickAdd()"></div>
  <div class="kcqa-sheet" role="dialog" aria-label="Agregar">
    <div class="kcd-handle-row"><span class="kcd-handle"></span></div>
    <p class="kcqa-title">¿Qué quieres registrar?</p>
    <div class="kcqa-row">
      {quickAddLinks.map(link => (
        <a href={link.href} class="kcqa-item">
          <span class="kcqa-ic" style={`background:${link.color}26`}>
            <span class="material-symbols-outlined" style={`font-size:22px;color:${link.color}`}>{link.icon}</span>
          </span>
          <span>{link.label}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* ── Desktop aside ── */
#appSidebar {
  display: none; /* mostrado ≥901px vía media query global (AppLayout) */
  position: fixed;
  top: 0; left: 0; bottom: 0;
  width: 250px;
  flex-direction: column;
  z-index: 60;
  background: #0f0d0a;
  border-right: 1px solid rgba(255,240,225,0.06);
  font-family: 'Inter', sans-serif;
}
.kcs-logo { height: 76px; display: flex; align-items: center; padding: 0 22px; flex-shrink: 0; }
.kcs-logo-link { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.kcs-logo-img { width: 36px; height: 36px; border-radius: 10px; filter: drop-shadow(0 0 12px rgba(255,77,0,0.45)); }
.kcs-logo-text { line-height: 1.1; }
.kcs-brand { display: block; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 900; font-size: 16px; letter-spacing: -0.01em; color: #f7f4f0; }
.kcs-tagline { display: block; font-size: 9px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #ff4d00; }

.kcs-nav { flex: 1; overflow-y: auto; padding: 8px 14px; scrollbar-width: thin; scrollbar-color: rgba(255,77,0,0.3) transparent; }
.kcs-nav::-webkit-scrollbar { width: 6px; }
.kcs-nav::-webkit-scrollbar-thumb { background: rgba(255,77,0,0.3); border-radius: 10px; }

.kcs-label {
  font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
  color: rgba(255,240,225,0.55); padding: 0 8px; margin: 18px 0 8px;
}
.kcs-nav .kcs-label:first-child { margin-top: 12px; }

.kcs-link {
  display: flex; align-items: center; gap: 12px;
  padding: 11px 14px; border-radius: 12px; margin-bottom: 3px;
  font-size: 14px; font-weight: 500; text-decoration: none;
  color: rgba(247,244,240,0.55);
  transition: background .13s, color .13s;
  white-space: nowrap;
}
.kcs-link:hover { background: rgba(255,255,255,0.045); color: rgba(247,244,240,0.92); }
.kcs-ic { font-size: 20px; flex-shrink: 0; color: rgba(247,244,240,0.4); font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
.kcs-link.kcs-active { background: #ff4d00; color: #0b0a08; font-weight: 700; }
.kcs-link.kcs-active .kcs-ic { color: #0b0a08 !important; font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24; }
.kcs-badge {
  margin-left: auto; font-size: 8px; font-weight: 800; padding: 2px 6px; border-radius: 999px;
  background: rgba(244,114,182,0.12); color: #f472b6; letter-spacing: 0.05em;
}
.kcs-link.kcs-active .kcs-badge { background: rgba(11,10,8,0.18); color: #0b0a08; }

.kcs-demo {
  display: flex; align-items: center; gap: 8px;
  margin: 18px 0 6px; padding: 10px 14px; border-radius: 12px;
  background: rgba(255,77,0,0.08); border: 1px solid rgba(255,77,0,0.2);
  color: #ff4d00; font-size: 12px; font-weight: 700; text-decoration: none;
  transition: background .13s;
}
.kcs-demo:hover { background: rgba(255,77,0,0.15); }
.kcs-demo-dot { margin-left: auto; width: 6px; height: 6px; border-radius: 50%; background: #ff4d00; animation: kcsPulse 2s infinite; }
@keyframes kcsPulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

.kcs-foot { padding: 16px; flex-shrink: 0; }
.kcs-user {
  display: flex; align-items: center; gap: 11px;
  padding: 12px; border-radius: 16px;
  background: #161310; border: 1px solid rgba(255,240,225,0.06);
  text-decoration: none; transition: background .13s;
}
.kcs-user:hover { background: #1e1a15; }
.kcs-avatar {
  width: 38px; height: 38px; border-radius: 12px; flex-shrink: 0;
  background: linear-gradient(135deg, #ff4d00, #fb923c);
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 14px; color: #fff;
}
.kcs-user-info { flex: 1; min-width: 0; line-height: 1.3; display: flex; flex-direction: column; }
.kcs-user-name { font-size: 13px; font-weight: 700; color: #f7f4f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kcs-user-sub { font-size: 10.5px; color: rgba(247,244,240,0.35); }

/* ── Mobile bottom tab bar ── */
#kcTabbar {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 60;
  height: 68px; display: flex; align-items: stretch;
  background: rgba(15,13,10,0.94);
  backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
  border-top: 1px solid rgba(255,240,225,0.08);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  font-family: 'Inter', sans-serif;
}
.kct-item {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
  text-decoration: none; color: rgba(247,244,240,0.5);
  background: none; border: none; cursor: pointer; font-family: inherit;
  transition: color .15s;
}
.kct-ic { font-size: 23px; font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
.kct-lbl { font-size: 11px; font-weight: 600; }
.kct-item.kct-active { color: #ff4d00; }
.kct-item.kct-active .kct-ic { font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24; }
.kct-scan {
  width: 46px; height: 34px; margin-top: -14px; border-radius: 14px;
  background: #ff4d00; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 16px rgba(255,77,0,0.4);
}
.kct-item:active .kct-scan { transform: scale(0.94); }

/* ── Mobile drawer ── */
#kcDrawer { position: fixed; inset: 0; z-index: 70; display: none; font-family: 'Inter', sans-serif; }
#kcDrawer.open { display: block; }
.kcd-scrim { position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px); }
.kcd-sheet {
  position: absolute; bottom: 0; left: 0; right: 0;
  max-height: 82vh; overflow-y: auto;
  background: #1a1613;
  border-top-left-radius: 24px; border-top-right-radius: 24px;
  border-top: 1px solid rgba(255,240,225,0.1);
  padding: 10px 16px calc(24px + env(safe-area-inset-bottom, 0px));
  animation: kcdUp .22s cubic-bezier(.4,0,.2,1);
}
@keyframes kcdUp { from { transform: translateY(24px); opacity: 0.6; } to { transform: translateY(0); opacity: 1; } }
.kcd-handle-row { display: flex; align-items: center; justify-content: center; padding: 10px 0 6px; }
.kcd-handle { width: 40px; height: 4px; border-radius: 100px; background: rgba(255,240,225,0.2); }
.kcd-user-row {
  display: flex; align-items: center; gap: 11px;
  padding: 8px 6px 16px; border-bottom: 1px solid rgba(255,240,225,0.06); margin-bottom: 12px;
}
.kcd-close {
  width: 34px; height: 34px; border-radius: 11px; flex-shrink: 0;
  background: #231e18; border: 1px solid rgba(255,240,225,0.08);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
}
.kcd-grid { display: flex; flex-direction: column; }
.kcd-label {
  display: flex; align-items: center; justify-content: space-between; width: 100%;
  font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
  color: rgba(255,240,225,0.6); padding: 10px 4px; margin: 8px 0 2px;
  background: none; border: none; cursor: pointer; font-family: inherit;
}
.kcd-grid > .kcd-label:first-child { margin-top: 0; }
.kcd-label-chevron { font-size: 18px !important; transition: transform .18s; color: rgba(255,240,225,0.4); }
.kcd-label[aria-expanded="false"] .kcd-label-chevron { transform: rotate(-90deg); }
.kcd-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; overflow: hidden; }
.kcd-row.kcd-row-collapsed { display: none; }
.kcd-link {
  position: relative;
  display: flex; align-items: center; gap: 11px;
  padding: 14px; border-radius: 14px;
  background: #231e18; border: none; cursor: pointer;
  text-decoration: none; color: #f7f4f0;
  font-size: 14.5px; font-weight: 600; font-family: inherit; text-align: left;
  transition: background .13s;
}
.kcd-link:hover { background: #2b241c; }
.kcd-badge {
  margin-left: auto; font-size: 8px; font-weight: 800; padding: 2px 6px; border-radius: 999px;
  background: rgba(244,114,182,0.12); color: #f472b6; letter-spacing: 0.05em; white-space: nowrap;
}
.kcd-footer {
  display: flex; flex-direction: column; gap: 8px;
  margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(255,240,225,0.06);
}
.kcd-foot-btn {
  display: flex; align-items: center; gap: 11px;
  padding: 13px 14px; border-radius: 14px;
  background: #231e18; border: none; cursor: pointer;
  text-decoration: none; color: #f7f4f0;
  font-size: 14.5px; font-weight: 600; font-family: inherit; text-align: left;
  transition: background .13s;
}
.kcd-foot-btn:hover { background: #2b241c; }
.kcd-foot-danger { color: #ef4444; }

/* ── Quick-add sheet (botón central "+") ── */
#kcQuickAdd { position: fixed; inset: 0; z-index: 70; display: none; font-family: 'Inter', sans-serif; }
#kcQuickAdd.open { display: block; }
.kcqa-sheet {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: #1a1613;
  border-top-left-radius: 24px; border-top-right-radius: 24px;
  border-top: 1px solid rgba(255,240,225,0.1);
  padding: 10px 16px calc(28px + env(safe-area-inset-bottom, 0px));
  animation: kcdUp .22s cubic-bezier(.4,0,.2,1);
}
.kcqa-title { font-size: 15px; font-weight: 700; color: #f7f4f0; text-align: center; margin: 4px 0 16px; }
.kcqa-row { display: flex; gap: 10px; }
.kcqa-item {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;
  padding: 16px 8px; border-radius: 16px;
  background: #231e18; text-decoration: none; color: #f7f4f0;
  font-size: 12.5px; font-weight: 600; text-align: center;
  transition: background .13s;
}
.kcqa-item:hover { background: #2b241c; }
.kcqa-ic { width: 44px; height: 44px; border-radius: 14px; display: flex; align-items: center; justify-content: center; }

/* Desktop: ocultar bottom bar, drawer y quick-add */
@media (min-width: 901px) {
  #kcTabbar, #kcDrawer, #kcQuickAdd { display: none !important; }
}
</style>

<script is:inline>
// Drawer global (los headers de página llaman toggleHamburgerMenu())
function toggleHamburgerMenu() {
  var d = document.getElementById('kcDrawer');
  if (!d) return;
  var qa = document.getElementById('kcQuickAdd');
  if (qa) { qa.classList.remove('open'); qa.setAttribute('aria-hidden', 'true'); }
  var open = d.classList.toggle('open');
  d.setAttribute('aria-hidden', open ? 'false' : 'true');
  document.body.style.overflow = open ? 'hidden' : '';
}
function toggleQuickAdd() {
  var qa = document.getElementById('kcQuickAdd');
  if (!qa) return;
  var d = document.getElementById('kcDrawer');
  if (d) { d.classList.remove('open'); d.setAttribute('aria-hidden', 'true'); }
  var open = qa.classList.toggle('open');
  qa.setAttribute('aria-hidden', open ? 'false' : 'true');
  document.body.style.overflow = open ? 'hidden' : '';
}
// Secciones plegables del drawer "Más" (Herramientas / Inteligencia / etc.)
function toggleDrawerSection(i) {
  var row = document.getElementById('kcd-section-' + i);
  var btn = document.querySelector('.kcd-label[aria-controls="kcd-section-' + i + '"]');
  if (!row || !btn) return;
  var collapsed = row.classList.toggle('kcd-row-collapsed');
  btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
}
// Instalación de la PWA
window.kcInstallPrompt = window.kcInstallPrompt || null;
window.addEventListener('beforeinstallprompt', function (e) {
  e.preventDefault();
  window.kcInstallPrompt = e;
});
function kcInstallApp() {
  var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  if (standalone) {
    if (typeof window.showToast === 'function') window.showToast('La app ya está instalada ✓');
    else alert('La app ya está instalada.');
    return;
  }
  if (window.kcInstallPrompt) {
    window.kcInstallPrompt.prompt();
    window.kcInstallPrompt.userChoice.then(function () { window.kcInstallPrompt = null; });
    return;
  }
  var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
  alert(isIOS
    ? 'En iPhone/iPad: toca el botón Compartir de Safari y elige "Añadir a pantalla de inicio".'
    : 'Abre el menú de tu navegador (⋮) y elige "Instalar aplicación" o "Añadir a pantalla de inicio".');
}
(function () {
  var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  if (!standalone) return;
  document.addEventListener('DOMContentLoaded', function () {
    // Ocultar botones de instalación: ya corre como app instalada
    document.querySelectorAll('.kc-install-btn').forEach(function (b) { b.style.display = 'none'; });
    // Con scope "/", el sitio web se navega dentro del shell de la app instalada.
  });
})();
function kcLogout() {
  if (typeof handleLogout === 'function') { handleLogout(); return; }
  try {
    localStorage.removeItem('ketocore_user_id');
    localStorage.removeItem('KetoCore_guest');
  } catch (e) {}
  window.location.href = '/app/welcome';
}

(function () {
  // Estado activo por URL (aside + tabs)
  var path = window.location.pathname.replace(/\/+$/, '') || '/app';
  var id = path === '/app' ? 'home' : path.replace('/app/', '').split('/')[0];
  document.querySelectorAll('.kcs-link[data-nav]').forEach(function (a) {
    if (a.getAttribute('data-nav') === id) a.classList.add('kcs-active');
  });
  document.querySelectorAll('.kct-item[data-tab]').forEach(function (a) {
    if (a.getAttribute('data-tab') === id) a.classList.add('kct-active');
  });

  // Datos de usuario
  document.addEventListener('DOMContentLoaded', function () {
    try {
      var parse = typeof safeParseJSON === 'function'
        ? safeParseJSON
        : function (s, f) { try { return JSON.parse(s) || f; } catch (e) { return f; } };
      var profile = parse(localStorage.getItem('keto_profile'), {});
      var streak  = parse(localStorage.getItem('ketoStreak'), {});
      var name     = profile.nombre || profile.name || 'Usuario';
      var initials = name.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase() || '?';
      var days     = streak.currentStreak || 0;
      var sub      = days > 0 ? 'Racha · Día ' + days : 'keto tracker';
      ['sbAvatar', 'kcdAvatar'].forEach(function (i) { var e = document.getElementById(i); if (e) e.textContent = initials; });
      ['sbName', 'kcdName'].forEach(function (i) { var e = document.getElementById(i); if (e) e.textContent = name; });
      ['sbSub', 'kcdSub'].forEach(function (i) { var e = document.getElementById(i); if (e) e.textContent = sub; });

      // Link "Modo Prueba": en modo demo se convierte en CTA de registro
      // (ya estás en la vista de prueba); para una cuenta real, se oculta
      // por completo -- no tiene sentido invitar a un usuario real a
      // "probar" y pisar su propia sesión.
      var demoMode = localStorage.getItem('ketocore_demo_mode') === '1';
      var realUser = !!localStorage.getItem('ketocore_user_id') && !demoMode;
      ['kcsDemoLink', 'kcdDemoLink'].forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        if (realUser) {
          el.style.display = 'none';
        } else if (demoMode) {
          el.href = '/app/welcome';
          var label = el.querySelector('[data-label]');
          if (label) label.textContent = 'Crear cuenta gratis';
        }
      });
    } catch (e) { /* storage no disponible */ }
  });
})();
</script>
