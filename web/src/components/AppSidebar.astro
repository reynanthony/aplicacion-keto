---
// AppSidebar — desktop navigation rail (hidden on mobile via CSS)
---

<aside id="appSidebar">

  <!-- Logo -->
  <div class="sb-logo-wrap">
    <a href="/app/" class="sb-logo-link">
      <img src="/app/logo.svg" alt="KetoCore" class="sb-logo-img">
      <div>
        <span class="sb-brand">KetoCore</span>
        <span class="sb-tagline">Nutrition AI</span>
      </div>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="sb-nav">

    <!-- Demo banner -->
    <a href="/app/demo/" class="sb-demo-entry">
      <span class="material-symbols-outlined icon-filled" style="font-size:16px;color:#ff4d00">play_circle</span>
      <span>Explorar Demo</span>
      <span class="sb-demo-dot"></span>
    </a>

    <p class="sb-section-label">Principal</p>
    <a href="/app/"              data-nav="home"          class="sb-link"><span class="material-symbols-outlined sb-icon">cottage</span><span>Dashboard</span></a>
    <a href="/app/macros"        data-nav="macros"        class="sb-link"><span class="material-symbols-outlined sb-icon">donut_small</span><span>Macros</span></a>
    <a href="/app/plan"          data-nav="plan"          class="sb-link"><span class="material-symbols-outlined sb-icon">event_note</span><span>Plan Alimenticio</span></a>
    <a href="/app/recetas"       data-nav="recetas"       class="sb-link"><span class="material-symbols-outlined sb-icon">menu_book</span><span>Recetas</span></a>

    <p class="sb-section-label" style="margin-top:14px">Herramientas</p>
    <a href="/app/checklist"     data-nav="checklist"     class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#22c55e">task_alt</span><span>Checklist</span></a>
    <a href="/app/entrenamientos"data-nav="entrenamientos"class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#4ade80">fitness_center</span><span>Entrenamientos</span></a>
    <a href="/app/alimentos"     data-nav="alimentos"     class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#fb923c">restaurant</span><span>Alimentos</span></a>
    <a href="/app/suplementos"   data-nav="suplementos"   class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#c084fc">medication</span><span>Suplementos</span></a>
    <a href="/app/compras"       data-nav="compras"       class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#60a5fa">shopping_cart</span><span>Lista de Compras</span></a>

    <p class="sb-section-label" style="margin-top:14px">Inteligencia</p>
    <a href="/app/coach"          data-nav="coach"         class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#a78bfa">psychology</span><span>Coach IA</span></a>
    <a href="/app/inspector"      data-nav="inspector"     class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#ff4d00">analytics</span><span>Inspector</span></a>

    <p class="sb-section-label" style="margin-top:14px">Progreso & Perfil</p>
    <a href="/app/progreso"   data-nav="progreso"   class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#ff4d00">trending_up</span><span>Mi Progreso</span></a>
    <a href="/app/objetivos"  data-nav="objetivos"  class="sb-link"><span class="material-symbols-outlined sb-icon" style="color:#ff4d00;font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24">flag</span><span>Mis Objetivos</span></a>
    <a href="/app/comunidad"  data-nav="comunidad"  class="sb-link">
      <span class="material-symbols-outlined sb-icon" style="color:#a78bfa">group</span>
      <span>Comunidad</span>
      <span class="sb-badge">PRONTO</span>
    </a>
    <a href="/app/perfil"     data-nav="perfil"     class="sb-link"><span class="material-symbols-outlined sb-icon">person</span><span>Mi Perfil</span></a>

  </nav>

  <!-- Bottom panel -->
  <div class="sb-bottom">
    <!-- Quick stats -->
    <div class="sb-stats">
      <div class="sb-stat-card">
        <p id="sbStreak" class="sb-stat-val" style="color:#ff4d00">--</p>
        <p class="sb-stat-lbl">Racha</p>
      </div>
      <div class="sb-stat-card">
        <p id="sbScore" class="sb-stat-val">--</p>
        <p class="sb-stat-lbl">Score</p>
      </div>
    </div>
    <!-- User row -->
    <div class="sb-user">
      <div id="sbAvatar" class="sb-avatar">?</div>
      <div class="sb-user-info">
        <p id="sbName" class="sb-user-name">--</p>
        <p class="sb-user-sub">keto tracker</p>
      </div>
      <button onclick="handleLogout()" title="Cerrar sesión" class="sb-logout">
        <span class="material-symbols-outlined" style="font-size:16px;color:#dc2626">logout</span>
      </button>
    </div>
  </div>

</aside>

<style is:global>
/* ── Sidebar shell ── */
#appSidebar {
  display: none; /* shown via media query in AppLayout */
  position: fixed;
  top: 0; left: 0; bottom: 0;
  width: 248px;
  flex-direction: column;
  z-index: 60;
  background: #0f0f0f;
  border-right: 1px solid rgba(255,255,255,0.07);
  overflow: hidden;
}

/* ── Logo ── */
.sb-logo-wrap {
  height: 60px;
  display: flex;
  align-items: center;
  padding: 0 18px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  flex-shrink: 0;
}
.sb-logo-link { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.sb-logo-img  { width: 30px; height: 30px; filter: drop-shadow(0 0 8px rgba(255,77,0,0.5)); }
.sb-brand {
  display: block;
  font-size: 14px; font-weight: 900;
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: linear-gradient(to right, #ff4d00, #fb923c);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; line-height: 1.2;
}
.sb-tagline {
  display: block;
  font-size: 9px; color: rgba(255,255,255,0.28);
  font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
}

/* ── Nav ── */
.sb-nav {
  flex: 1; overflow-y: auto; padding: 14px 10px;
  scrollbar-width: none;
}
.sb-nav::-webkit-scrollbar { display: none; }

.sb-section-label {
  font-size: 9px; font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: rgba(255,255,255,0.22);
  padding: 0 10px; margin: 0 0 5px;
}

.sb-link {
  display: flex; align-items: center; gap: 9px;
  padding: 8px 10px; border-radius: 9px;
  font-size: 13px; font-weight: 500;
  color: rgba(245,245,245,0.5);
  text-decoration: none;
  transition: background 0.12s, color 0.12s;
  margin-bottom: 1px;
  font-family: 'Inter', sans-serif;
  white-space: nowrap;
}
.sb-link:hover { background: rgba(255,255,255,0.05); color: rgba(245,245,245,0.85); }
.sb-link.sb-active {
  background: rgba(255,77,0,0.1);
  color: #ff4d00; font-weight: 600;
}
.sb-link.sb-active .sb-icon {
  color: #ff4d00 !important;
  font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}
.sb-icon {
  font-size: 18px; flex-shrink: 0; width: 20px; text-align: center;
  color: rgba(245,245,245,0.3);
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}
.sb-badge {
  margin-left: auto;
  font-size: 8px; font-weight: 800;
  padding: 2px 6px; border-radius: 999px;
  background: rgba(167,139,250,0.12); color: #a78bfa;
  letter-spacing: 0.05em;
}

/* ── Bottom panel ── */
.sb-bottom {
  padding: 12px;
  border-top: 1px solid rgba(255,255,255,0.06);
  flex-shrink: 0;
}
.sb-stats {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px;
}
.sb-stat-card {
  background: #161616;
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 10px; padding: 9px;
  text-align: center;
}
.sb-stat-val {
  font-size: 18px; font-weight: 900; color: #f5f5f5;
  font-family: 'Plus Jakarta Sans', sans-serif; line-height: 1;
}
.sb-stat-lbl {
  font-size: 9px; color: rgba(255,255,255,0.28);
  text-transform: uppercase; letter-spacing: 0.08em; margin-top: 3px;
}
.sb-user { display: flex; align-items: center; gap: 9px; }
.sb-avatar {
  width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg,#ff4d00,#fb923c);
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 12px; color: #fff;
}
.sb-user-info { flex: 1; min-width: 0; }
.sb-user-name { font-size: 12px; font-weight: 700; color: #f5f5f5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sb-user-sub  { font-size: 10px; color: rgba(255,255,255,0.28); }
.sb-logout {
  width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
  background: rgba(220,38,38,0.06); border: 1px solid rgba(220,38,38,0.14);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: background 0.15s;
}
.sb-logout:hover { background: rgba(220,38,38,0.14); }

/* Demo entry button */
.sb-demo-entry {
  display: flex; align-items: center; gap: 8px;
  margin: 10px 10px 6px;
  padding: 8px 12px; border-radius: 10px;
  background: rgba(255,77,0,0.08);
  border: 1px solid rgba(255,77,0,0.2);
  color: #ff4d00; font-size: 12px; font-weight: 700;
  text-decoration: none; cursor: pointer;
  transition: background 0.15s;
}
.sb-demo-entry:hover { background: rgba(255,77,0,0.15); }
.sb-demo-dot {
  margin-left: auto; width: 6px; height: 6px; border-radius: 50%;
  background: #ff4d00; animation: sbDemoPulse 2s infinite;
}
@keyframes sbDemoPulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
</style>

<script is:inline>
(function () {
  // Mark active link based on current path
  var path = window.location.pathname.replace(/\/+$/, '') || '/app';
  var map = {
    '/app': 'home', '/app/macros': 'macros', '/app/plan': 'plan',
    '/app/recetas': 'recetas', '/app/checklist': 'checklist',
    '/app/entrenamientos': 'entrenamientos', '/app/alimentos': 'alimentos',
    '/app/suplementos': 'suplementos', '/app/compras': 'compras',
    '/app/progreso': 'progreso', '/app/objetivos': 'objetivos',
    '/app/comunidad': 'comunidad', '/app/perfil': 'perfil',
    '/app/coach': 'coach', '/app/inspector': 'inspector'
  };
  var active = map[path] || 'home';
  document.querySelectorAll('.sb-link[data-nav]').forEach(function (a) {
    if (a.getAttribute('data-nav') === active) a.classList.add('sb-active');
  });

  // Populate user data once DOM + utils are ready
  document.addEventListener('DOMContentLoaded', function () {
    try {
      var profile = safeParseJSON(localStorage.getItem('keto_profile'), {});
      var streak  = safeParseJSON(localStorage.getItem('ketoStreak'), {});
      var name     = profile.nombre || profile.name || 'Usuario';
      var initials = name.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase() || '?';
      var days     = streak.currentStreak || 0;

      var el = function (id) { return document.getElementById(id); };
      if (el('sbName'))   el('sbName').textContent   = name;
      if (el('sbAvatar')) el('sbAvatar').textContent  = initials;
      if (el('sbStreak')) el('sbStreak').textContent  = days + 'd';
      // Simplified health score for sidebar display
      var score = days ? Math.min(100, Math.round(days * 2.2 + 28)) : '--';
      if (el('sbScore'))  el('sbScore').textContent   = score;
    } catch (e) { /* utils.js not loaded on this page */ }
  });
})();
</script>
