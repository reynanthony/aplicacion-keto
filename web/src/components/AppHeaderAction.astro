---
// AppHeaderAction — variante del header fijo móvil para pantallas con título
// propio + un botón de acción principal (Guardar, Registrar, etc.).
// Extraído en F1 (2026-09-25): objetivos/perfil/progreso repetían este mismo
// shell cambiando solo el título y el botón. Ver docs/DESIGN-SYSTEM.md.
//
// El botón de acción va como children (slot) porque su label/onclick/estilo
// cambia por pantalla. La hamburguesa (toggleHamburgerMenu) y el título son
// fijos. Solo marcado — no mueve JS de las páginas.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-40 h-14 px-4 flex items-center justify-between" style="background:rgba(19,19,21,0.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,240,225,0.06)">
  <a href="/app/" class="flex items-center gap-3" style="text-decoration:none">
    <img src="/app/logo.svg" alt="KetoCore" class="w-7 h-7" style="filter:drop-shadow(0 0 6px rgba(255,77,0,0.4))">
    <h1 class="text-base font-black" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">{title}</h1>
  </a>
  <div class="flex items-center gap-2">
    <slot />
    <button onclick="toggleHamburgerMenu()" aria-label="Menú" class="w-9 h-9 rounded-full flex items-center justify-center" style="background:#1e1a15;color:rgba(247,244,240,0.6);border:1px solid rgba(255,240,225,0.06)">
      <span class="material-symbols-outlined" style="font-size:20px">menu</span>
    </button>
  </div>
</header>
