---
// Nav — KetoTopNav del rediseño Editorial Bento (sitio de marketing, tema claro)
// Desktop >820px: sticky translúcida con blur + links + CTA "Entrar a la app".
// Móvil ≤820px: logo + hamburguesa que abre panel lateral.
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/protocolos',   label: 'Protocolos' },
  { href: '/aprender',     label: 'Aprender' },
  { href: '/recetas',      label: 'Recetas' },
  { href: '/herramientas', label: 'Herramientas' },
  { href: '/retos',        label: 'Retos' },
  { href: '/historias',    label: 'Historias' },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + '/');
}
---

<nav id="site-nav" class="ktn">
  <a href="/" class="ktn-logo">
    <img src="/logo.svg" alt="KetoCore" width="34" height="34">
    <span>KetoCore</span>
  </a>

  <div class="ktn-desk">
    {navLinks.map(link => (
      <a href={link.href} class:list={['ktn-link', { active: isActive(link.href) }]}>{link.label}</a>
    ))}
    <a href="/app/" class="ktn-cta">Entrar a la app</a>
  </div>

  <button type="button" id="ktn-open" class="ktn-burger" aria-label="Abrir menú">
    <span class="material-symbols-outlined" style="font-size:24px;color:#1a140e">menu</span>
  </button>
</nav>

<!-- Panel móvil -->
<div id="ktn-menu" class="ktn-menu" aria-hidden="true">
  <div class="ktn-scrim"></div>
  <div class="ktn-panel">
    <div class="ktn-panel-head">
      <span>Menú</span>
      <button type="button" id="ktn-close" class="ktn-x" aria-label="Cerrar menú">
        <span class="material-symbols-outlined" style="font-size:22px;color:#1a140e">close</span>
      </button>
    </div>
    {navLinks.map(link => (
      <a href={link.href} class="ktn-m-link">{link.label}</a>
    ))}
    <a href="/app/demo/" class="ktn-m-link" style="color:#ff4d00">Probar demo gratis</a>
    <a href="/app/" class="ktn-m-cta">Entrar a la app</a>
    <button type="button" id="ktn-install" class="ktn-m-cta" style="background:#1a140e;border:none;cursor:pointer;font-family:var(--font-display)">
      Instalar app en tu móvil
    </button>
  </div>
</div>

<style>
.ktn {
  position: sticky; top: 0; z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 32px;
  background: rgba(244,239,230,0.85);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(26,20,14,0.06);
  font-family: var(--font-body);
}
.ktn-logo { display: flex; align-items: center; gap: 11px; text-decoration: none; flex-shrink: 0; }
.ktn-logo img { width: 34px; height: 34px; border-radius: 10px; }
.ktn-logo span {
  font-family: var(--font-display); font-weight: 900; font-size: 18px;
  letter-spacing: -0.02em; color: #1a140e;
}
.ktn-desk { display: flex; align-items: center; gap: 30px; }
.ktn-link { font-size: 14px; font-weight: 500; color: rgba(26,20,14,0.62); text-decoration: none; transition: color .13s; }
.ktn-link:hover { color: #1a140e; }
.ktn-link.active { color: #ff4d00; font-weight: 700; }
.ktn-cta {
  display: flex; align-items: center; gap: 7px; height: 42px; padding: 0 20px;
  border-radius: 12px; background: #ff4d00; color: #fff;
  font-family: var(--font-display); font-weight: 700; font-size: 13.5px;
  text-decoration: none; box-shadow: 0 4px 14px rgba(255,77,0,0.28);
  transition: transform .14s, box-shadow .14s;
}
.ktn-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(255,77,0,0.34); }
.ktn-burger {
  display: none; width: 44px; height: 44px; border-radius: 12px;
  background: #fff; border: 1px solid rgba(26,20,14,0.1); cursor: pointer;
  align-items: center; justify-content: center;
}

.ktn-menu { position: fixed; inset: 0; z-index: 70; display: none; font-family: var(--font-body); }
.ktn-menu.open { display: block; }
.ktn-scrim { position: absolute; inset: 0; background: rgba(26,20,14,0.4); }
.ktn-panel {
  position: absolute; top: 0; right: 0; bottom: 0; width: 80%; max-width: 320px;
  background: #f4efe6; padding: 22px;
  display: flex; flex-direction: column; gap: 6px;
  overflow-y: auto;
}
.ktn-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.ktn-panel-head span { font-family: var(--font-display); font-weight: 900; font-size: 17px; color: #1a140e; }
.ktn-x {
  width: 38px; height: 38px; border-radius: 11px;
  background: #fff; border: 1px solid rgba(26,20,14,0.1); cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.ktn-m-link {
  padding: 14px 16px; border-radius: 12px;
  font-size: 15px; font-weight: 600; color: #1a140e; text-decoration: none; background: #fff;
}
.ktn-m-cta {
  margin-top: 8px; padding: 15px; border-radius: 13px; text-align: center;
  font-family: var(--font-display); font-weight: 700; font-size: 15px;
  color: #fff; text-decoration: none; background: #ff4d00;
}

@media (max-width: 820px) {
  .ktn { padding: 14px 16px; }
  .ktn-desk { display: none; }
  .ktn-burger { display: flex; }
}
</style>

<script>
  const menu = document.getElementById('ktn-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('open', open);
    menu?.setAttribute('aria-hidden', open ? 'false' : 'true');
    document.body.style.overflow = open ? 'hidden' : '';
  };
  document.getElementById('ktn-open')?.addEventListener('click', () => setOpen(true));
  document.getElementById('ktn-close')?.addEventListener('click', () => setOpen(false));
  menu?.querySelector('.ktn-scrim')?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));

  // Instalación de la PWA desde el sitio web
  let installPrompt: any = null;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    installPrompt = e;
  });
  const installBtn = document.getElementById('ktn-install');
  const standalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator as any).standalone === true;
  if (standalone && installBtn) installBtn.style.display = 'none';
  installBtn?.addEventListener('click', () => {
    if (installPrompt) {
      installPrompt.prompt();
      installPrompt.userChoice.then(() => { installPrompt = null; });
      return;
    }
    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
    alert(isIOS
      ? 'En iPhone/iPad: toca el botón Compartir de Safari y elige "Añadir a pantalla de inicio".'
      : 'Abre el menú de tu navegador (⋮) y elige "Instalar aplicación" o "Añadir a pantalla de inicio".');
  });
</script>
