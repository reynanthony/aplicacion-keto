---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/aprender', label: 'Aprender' },
  { href: '/recetas', label: 'Recetas' },
  { href: '/alimentos', label: 'Alimentos' },
  { href: '/protocolos', label: 'Protocolos' },
  { href: '/herramientas', label: 'Herramientas' },
];

const moreLinks = [
  { href: '/comunidad', label: 'Comunidad', icon: 'groups' },
  { href: '/retos', label: 'Retos', icon: 'emoji_events' },
  { href: '/historias', label: 'Historias', icon: 'stars' },
  { href: '/academia', label: 'Academia', icon: 'school' },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + '/');
}
---

<nav id="site-nav" style="position:fixed;top:0;left:0;right:0;z-index:100;border-bottom:1px solid var(--c-border);background:rgba(250,250,248,0.95);backdrop-filter:blur(18px);transition:transform 0.3s;box-shadow:0 1px 0 rgba(26,20,14,0.06)">
  <div class="wrap" style="height:60px;display:flex;align-items:center;justify-content:space-between;gap:2rem">

    <!-- Logo -->
    <a href="/" style="display:flex;align-items:center;gap:0.625rem;text-decoration:none;flex-shrink:0">
      <img src="/logo.svg" alt="KetoCore" width="30" height="30" style="filter:drop-shadow(0 0 6px rgba(255,77,0,.4))">
      <span style="font-family:var(--font-display);font-weight:900;font-size:1.0625rem;color:var(--c-primary);letter-spacing:-0.02em">KetoCore</span>
    </a>

    <!-- Desktop nav -->
    <div id="desktop-nav" style="display:flex;align-items:center;gap:0.25rem;flex:1;max-width:680px">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-a${isActive(link.href) ? ' active' : ''}`}
          style="padding:0.375rem 0.75rem;border-radius:8px;transition:background 0.15s,color 0.15s"
        >
          {link.label}
        </a>
      ))}

      <!-- Más dropdown -->
      <div class="nav-dropdown" style="position:relative">
        <button class="nav-a nav-dropdown-btn" style="display:flex;align-items:center;gap:0.25rem;padding:0.375rem 0.75rem;border-radius:8px;background:transparent;border:none;cursor:pointer;font-family:var(--font-display);font-size:0.875rem;font-weight:600;color:var(--c-text-muted);transition:color 0.15s">
          Más
          <span class="icon" style="font-size:16px">expand_more</span>
        </button>
        <div class="nav-dropdown-menu" style="position:absolute;top:calc(100% + 0.5rem);left:0;background:var(--c-surface);border:1px solid var(--c-border-2);border-radius:14px;padding:0.5rem;min-width:180px;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity 0.15s,transform 0.15s;box-shadow:0 8px 24px rgba(26,20,14,0.12)">
          {moreLinks.map(link => (
            <a href={link.href} style="display:flex;align-items:center;gap:0.625rem;padding:0.625rem 0.875rem;border-radius:8px;text-decoration:none;color:var(--c-text-muted);font-size:0.875rem;font-weight:600;transition:background 0.15s,color 0.15s" class="nav-more-link">
              <span class="icon" style="font-size:18px;color:var(--c-primary)">{link.icon}</span>
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- CTA buttons -->
    <div style="display:flex;align-items:center;gap:0.75rem;flex-shrink:0">
      <a href="/app/welcome.html" class="nav-a" style="display:none" id="nav-login">Entrar</a>
      <a href="/app/welcome.html" class="btn btn-sm">Empezar gratis</a>
      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" style="display:none;background:none;border:none;color:var(--c-text);cursor:pointer;padding:0.25rem" aria-label="Menú">
        <span class="icon" style="font-size:24px">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" style="display:none;border-top:1px solid var(--c-border);background:var(--c-surface)">
    <div style="padding:1rem 1.5rem;display:flex;flex-direction:column;gap:0.25rem">
      {[...navLinks, ...moreLinks].map(link => (
        <a href={link.href} style="padding:0.75rem 1rem;border-radius:10px;text-decoration:none;color:var(--c-text-muted);font-weight:600;font-family:var(--font-display);font-size:0.9375rem;transition:background 0.15s,color 0.15s" class="mobile-nav-link">
          {link.label}
        </a>
      ))}
      <div style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid var(--c-border);display:flex;gap:0.75rem">
        <a href="/app/welcome.html" class="btn-ghost" style="flex:1;justify-content:center;padding:0.625rem 1rem;font-size:0.875rem">Entrar</a>
        <a href="/app/welcome.html" class="btn" style="flex:1;justify-content:center;padding:0.625rem 1rem;font-size:0.875rem">Empezar gratis</a>
      </div>
    </div>
  </div>
</nav>

<!-- Spacer for fixed nav -->
<div style="height:60px"></div>

<style>
  @media (min-width: 768px) {
    #nav-login { display: inline !important; }
  }
  @media (max-width: 767px) {
    #desktop-nav { display: none !important; }
    #mobile-menu-btn { display: block !important; }
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1 !important;
    pointer-events: all !important;
    transform: translateY(0) !important;
  }
  .nav-more-link:hover { background: var(--c-surface-2) !important; color: var(--c-text) !important; }
  .nav-a:hover, .mobile-nav-link:hover { background: rgba(255,255,255,0.04) !important; color: var(--c-text) !important; }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.style.display === 'block';
    if (menu) menu.style.display = open ? 'none' : 'block';
    const icon = btn?.querySelector('.icon');
    if (icon) icon.textContent = open ? 'menu' : 'close';
  });

  // Hide nav on scroll down, show on scroll up
  let lastY = 0;
  const nav = document.getElementById('site-nav');
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > 100) {
      if (nav) nav.style.transform = y > lastY ? 'translateY(-100%)' : 'translateY(0)';
    } else {
      if (nav) nav.style.transform = 'translateY(0)';
    }
    lastY = y;
  }, { passive: true });
</script>
