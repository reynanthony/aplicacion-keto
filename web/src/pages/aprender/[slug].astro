---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(a => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const related = (await getCollection('articles'))
  .filter(a => a.id !== article.id && a.data.category === article.data.category)
  .slice(0, 3);
---

<Layout title={article.data.title} description={article.data.description} image={article.data.image}>

<!-- Article header -->
<article>
  {article.data.image && (
    <div style="height:400px;overflow:hidden;position:relative">
      <img src={article.data.image} alt={article.data.title} style="width:100%;height:100%;object-fit:cover">
      <div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(250,250,248,0) 40%,rgba(250,250,248,1) 100%)"></div>
    </div>
  )}

  <div class="wrap" style="max-width:760px;margin:0 auto;padding-top:2rem">
    <!-- Breadcrumb -->
    <nav style="display:flex;align-items:center;gap:0.5rem;margin-bottom:2rem;font-size:0.8125rem;color:var(--c-text-dim)">
      <a href="/" style="color:var(--c-text-dim);text-decoration:none;hover:color:var(--c-text)">Inicio</a>
      <span>›</span>
      <a href="/aprender" style="color:var(--c-text-dim);text-decoration:none">Aprender</a>
      <span>›</span>
      <span style="color:var(--c-text-muted)">{article.data.category}</span>
    </nav>

    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;flex-wrap:wrap">
      <span class="chip">{article.data.category}</span>
      <span class="badge">{article.data.difficulty}</span>
      <span style="font-size:0.8125rem;color:var(--c-text-dim)">{article.data.readTime} min de lectura</span>
      <span style="font-size:0.8125rem;color:var(--c-text-dim)">·</span>
      <span style="font-size:0.8125rem;color:var(--c-text-dim)">{article.data.author}</span>
    </div>

    <h1 class="d" style="font-size:clamp(1.875rem,4vw,3rem);margin-bottom:1rem">{article.data.title}</h1>
    <p style="font-size:1.125rem;color:var(--c-text-muted);line-height:1.7;margin-bottom:3rem;border-bottom:1px solid var(--c-border);padding-bottom:2rem">{article.data.description}</p>

    <!-- Article body -->
    <div class="prose">
      <Content />
    </div>

    <!-- Tags -->
    {article.data.tags.length > 0 && (
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:3rem;padding-top:2rem;border-top:1px solid var(--c-border)">
        {article.data.tags.map(tag => <span class="badge" style="padding:0.375rem 0.875rem">#{tag}</span>)}
      </div>
    )}

    <!-- CTA box -->
    <div class="card" style="padding:2rem;margin-top:3rem;text-align:center;background:var(--c-surface)">
      <p style="font-family:var(--font-display);font-weight:800;font-size:1.125rem;margin-bottom:0.75rem">¿Listo para aplicar esto?</p>
      <p style="color:var(--c-text-muted);font-size:0.875rem;margin-bottom:1.5rem">Obtén un protocolo personalizado basado en tus objetivos.</p>
      <a href="/app/welcome" class="btn">Crear cuenta gratuita</a>
    </div>
  </div>
</article>

<!-- Related articles -->
{related.length > 0 && (
  <section class="section" style="background:var(--c-surface)">
    <div class="wrap">
      <h2 style="font-family:var(--font-display);font-weight:800;font-size:1.25rem;margin-bottom:1.5rem">Artículos relacionados</h2>
      <div class="grid-3">
        {related.map(a => (
          <a href={`/aprender/${a.id}`} class="card card-link">
            {a.data.image && <img src={a.data.image} alt={a.data.title} loading="lazy" style="width:100%;height:160px;object-fit:cover">}
            <div style="padding:1.25rem">
              <span class="chip" style="margin-bottom:0.75rem;display:inline-block">{a.data.category}</span>
              <h3 style="font-family:var(--font-display);font-size:0.9375rem;font-weight:800;line-height:1.35" class="line-clamp-2">{a.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

</Layout>
