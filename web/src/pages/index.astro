---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const allRecipes = await getCollection('recipes');
const allProtocols = await getCollection('protocols');
const allFoods = await getCollection('foods');
const articles = allArticles.filter(a => a.data.featured).slice(0, 3);
const recipes = allRecipes.filter(r => r.data.featured).slice(0, 6);
const protocols = allProtocols.filter(p => p.data.featured).slice(0, 3);
const stories = (await getCollection('stories')).filter(s => s.data.featured).slice(0, 2);
const challenges = (await getCollection('challenges')).filter(c => c.data.active).slice(0, 3);

const recipeCount = allRecipes.length;
const articleCount = allArticles.length;
const protocolCount = allProtocols.length;
const foodCount = allFoods.length;
---

<Layout title="Transforma tu salud metabólica" description={`La plataforma de salud metabólica más completa. ${recipeCount} recetas keto, calculadoras, protocolos y guías. Empieza gratis hoy.`}>


<!-- HERO -->
<section style="padding:4rem 0 4rem;position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 50% at 50% -10%,rgba(255,77,0,0.12),transparent);pointer-events:none"></div>
  <div class="wrap" style="position:relative;z-index:1">
    <div id="hero-grid" style="display:grid;grid-template-columns:1.05fr 0.95fr;gap:56px;align-items:center">
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 15px;border-radius:100px;background:rgba(255,77,0,0.09);border:1px solid rgba(255,77,0,0.16);margin-bottom:26px">
          <span style="width:7px;height:7px;border-radius:50%;background:#ff4d00"></span>
          <span style="font-size:12.5px;font-weight:700;color:#c23400;letter-spacing:0.01em">Tus macros exactos, calculados en segundos</span>
        </div>
        <h1 class="d" style="font-weight:900;font-size:clamp(40px,5.5vw,60px);line-height:0.98;letter-spacing:-0.04em;margin-bottom:22px">Keto que <span style="color:#ff4d00">piensa</span> por ti</h1>
        <p style="font-size:18px;line-height:1.6;color:rgba(26,20,14,0.6);max-width:480px;margin-bottom:34px">Deja de adivinar tus macros. KetoCore calcula tu plan, te dice qué comer hoy y ajusta el rumbo con IA que conoce tu progreso.</p>
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:14px">
          <a href="/app/demo/" style="display:flex;align-items:center;gap:8px;height:54px;padding:0 28px;border-radius:15px;background:#ff4d00;color:#fff;font-family:var(--font-display);font-weight:700;font-size:16px;box-shadow:0 6px 20px rgba(255,77,0,0.3);text-decoration:none;transition:transform .14s"><span class="icon icon-fill" style="font-size:20px">play_circle</span>Probar el demo gratis</a>
          <a href="/#precios" style="display:flex;align-items:center;gap:8px;height:54px;padding:0 24px;border-radius:15px;background:transparent;border:1.5px solid rgba(26,20,14,0.14);font-family:var(--font-display);font-weight:700;font-size:15px;color:#1a140e;text-decoration:none">Suscribirse<span class="icon" style="font-size:20px">arrow_forward</span></a>
        </div>
        <p style="font-size:0.8125rem;color:var(--c-text-dim)">Demo completo sin registro · {recipeCount} recetas verificadas · Sin publicidad</p>
      </div>

      <!-- Mockup de la app (dark, flotante) -->
      <div id="hero-mock" aria-hidden="true" style="display:flex;justify-content:center">
        <div style="width:340px;border-radius:32px;background:#0b0a08;border:1px solid rgba(255,240,225,0.08);box-shadow:0 40px 80px rgba(26,20,14,0.35);padding:22px;transform:rotate(2deg)">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
            <img src="/logo.svg" alt="" width="22" height="22" style="border-radius:6px">
            <span style="font-family:var(--font-display);font-weight:900;font-size:13px;color:#f7f4f0">KetoCore</span>
            <span style="margin-left:auto;font-size:10px;font-weight:700;padding:4px 10px;border-radius:100px;background:rgba(34,197,94,0.14);color:#22c55e">En cetosis</span>
          </div>
          <div style="background:linear-gradient(150deg,#ff5a12,#e63f00);border-radius:20px;padding:18px;margin-bottom:12px">
            <div style="font-size:10px;font-weight:800;letter-spacing:0.06em;color:rgba(26,14,5,0.8)">HEALTH SCORE</div>
            <div style="font-family:var(--font-display);font-weight:900;font-size:54px;line-height:0.9;color:#1a0e05;font-variant-numeric:tabular-nums">82</div>
            <div style="font-size:11px;font-weight:600;color:rgba(26,14,5,0.7);margin-top:4px">de 100 · Excelente</div>
          </div>
          <div style="background:#f3ede3;border-radius:20px;padding:16px;margin-bottom:12px;color:#1a140e">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><span style="font-size:10px;font-weight:800;letter-spacing:0.04em;color:rgba(26,20,14,0.55)">CALORÍAS DE HOY</span><span style="font-size:9px;font-weight:700;padding:3px 8px;border-radius:100px;background:rgba(22,163,74,0.14);color:#15803d">En meta</span></div>
            <div style="font-family:var(--font-display);font-weight:900;font-size:28px;line-height:1;font-variant-numeric:tabular-nums">1 340 <span style="font-size:12px;font-weight:600;color:rgba(26,20,14,0.5)">/ 1 650 kcal</span></div>
            <div style="height:7px;border-radius:100px;background:rgba(26,20,14,0.09);overflow:hidden;margin-top:10px"><div style="height:100%;width:81%;border-radius:100px;background:#ff4d00"></div></div>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:16px;padding:14px"><div style="font-size:9px;font-weight:700;color:rgba(247,244,240,0.5)">Racha</div><div style="font-family:var(--font-display);font-weight:900;font-size:22px;color:#f7f4f0">18 <span style="font-size:11px;color:rgba(247,244,240,0.4)">días</span></div></div>
            <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:16px;padding:14px"><div style="font-size:9px;font-weight:700;color:rgba(247,244,240,0.5)">Carbos netos</div><div style="font-family:var(--font-display);font-weight:900;font-size:22px;color:#22d3ee">17 <span style="font-size:11px;color:rgba(247,244,240,0.4)">/ 25 g</span></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- STATS -->
<section style="padding:0 0 4rem">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem" id="stats-grid">
      <div class="stat-card">
        <span class="icon icon-fill" style="color:var(--c-primary);font-size:28px;margin-bottom:0.5rem;display:block">restaurant_menu</span>
        <div class="stat-value">{recipeCount}</div>
        <div class="stat-label">Recetas verificadas</div>
      </div>
      <div class="stat-card">
        <span class="icon icon-fill" style="color:var(--c-primary);font-size:28px;margin-bottom:0.5rem;display:block">menu_book</span>
        <div class="stat-value">{articleCount}</div>
        <div class="stat-label">Artículos con respaldo científico</div>
      </div>
      <div class="stat-card">
        <span class="icon icon-fill" style="color:var(--c-primary);font-size:28px;margin-bottom:0.5rem;display:block">route</span>
        <div class="stat-value">{protocolCount}</div>
        <div class="stat-label">Protocolos estructurados</div>
      </div>
      <div class="stat-card">
        <span class="icon icon-fill" style="color:var(--c-primary);font-size:28px;margin-bottom:0.5rem;display:block">nutrition</span>
        <div class="stat-value">{foodCount}</div>
        <div class="stat-label">Alimentos en la base de datos</div>
      </div>
    </div>
  </div>
</section>

<hr class="rule">

<!-- HOW IT WORKS -->
<section class="section">
  <div class="wrap">
    <div class="section-header">
      <span class="chip">Cómo funciona</span>
      <h2 class="d">De visitante a transformación</h2>
      <p>Un sistema en tres pasos diseñado para que el conocimiento se convierta en acción real.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem" id="steps-grid">
      <div class="card" style="padding:2rem">
        <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;color:var(--c-primary);opacity:0.2;line-height:1;margin-bottom:1rem">01</div>
        <p style="font-size:0.65rem;font-weight:700;color:var(--c-primary);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.75rem">Descubres</p>
        <h3 style="font-family:var(--font-display);font-size:1.25rem;font-weight:800;margin-bottom:0.75rem;line-height:1.3">Aprende cómo funciona tu metabolismo</h3>
        <p style="color:var(--c-text-muted);font-size:0.875rem;line-height:1.7;margin-bottom:1.25rem">Artículos respaldados por ciencia, protocolos detallados, calculadoras de macros. Todo el conocimiento necesario, organizado y accesible.</p>
        <div style="display:flex;gap:0.375rem;flex-wrap:wrap">
          <span class="badge">{recipeCount} recetas</span>
          <span class="badge">Calculadoras</span>
          <span class="badge">Protocolos</span>
        </div>
      </div>

      <div class="card" style="padding:2rem;background:var(--c-surface-2)">
        <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;color:var(--c-green);opacity:0.2;line-height:1;margin-bottom:1rem">02</div>
        <p style="font-size:0.65rem;font-weight:700;color:var(--c-green);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.75rem">Te registras</p>
        <h3 style="font-family:var(--font-display);font-size:1.25rem;font-weight:800;margin-bottom:0.75rem;line-height:1.3">Crea tu perfil metabólico único</h3>
        <p style="color:var(--c-text-muted);font-size:0.875rem;line-height:1.7;margin-bottom:1.25rem">Peso, objetivo, actividad. KetoCore calcula tus macros exactos y genera tu primer plan personalizado en segundos.</p>
        <div style="display:flex;gap:0.375rem;flex-wrap:wrap">
          <span class="badge">Macros auto</span>
          <span class="badge">Plan semanal</span>
        </div>
      </div>

      <div class="card" style="padding:2rem;background:rgba(255,77,0,0.03);border-color:rgba(255,77,0,0.1)">
        <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;color:var(--c-primary);opacity:0.15;line-height:1;margin-bottom:1rem">03</div>
        <p style="font-size:0.65rem;font-weight:700;color:var(--c-primary);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.75rem">Ejecutas</p>
        <h3 style="font-family:var(--font-display);font-size:1.25rem;font-weight:800;margin-bottom:0.75rem;line-height:1.3">La app te dice qué hacer hoy</h3>
        <p style="color:var(--c-text-muted);font-size:0.875rem;line-height:1.7;margin-bottom:1.25rem">Qué comer, cuándo entrenar, qué suplementar. Sin adivinar. Sin calcular. Solo seguir el plan.</p>
        <div style="display:flex;gap:0.375rem;flex-wrap:wrap">
          <span class="badge" style="background:var(--c-primary-dim);color:var(--c-primary)">Plan diario</span>
          <span class="badge" style="background:var(--c-primary-dim);color:var(--c-primary)">Seguimiento</span>
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="rule">

<!-- FEATURED RECIPES -->
<section class="section" style="background:var(--c-surface)">
  <div class="wrap">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem">
      <div>
        <span class="chip" style="margin-bottom:0.75rem;display:inline-block">Biblioteca pública</span>
        <h2 class="d" style="font-size:clamp(1.625rem,2.8vw,2.25rem)">{recipeCount} recetas keto verificadas</h2>
        <p style="color:var(--c-text-dim);font-size:0.8125rem;margin-top:0.375rem">Macros calculados · Sin trampa · Cetosis asegurada</p>
      </div>
      <a href="/recetas" style="color:var(--c-primary);font-size:0.875rem;font-weight:600;text-decoration:none;white-space:nowrap">Ver todas →</a>
    </div>
    <div class="scroll-x">
      {recipes.map(r => (
        <a href={`/recetas/${r.id}`} style="flex-shrink:0;width:200px;text-decoration:none;color:inherit">
          <div class="card" style="width:200px">
            {r.data.image && <img src={r.data.image} alt={r.data.title} loading="lazy" style="width:100%;height:130px;object-fit:cover">}
            <div style="padding:0.875rem">
              <span style={`font-size:0.6rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:${r.data.mealType === 'Desayuno' ? 'var(--c-primary)' : r.data.mealType === 'Almuerzo' ? 'var(--c-gold)' : '#818cf8'}`}>{r.data.mealType}</span>
              <p style="font-weight:700;font-size:0.875rem;margin:0.3rem 0 0.5rem;line-height:1.3" class="line-clamp-2">{r.data.title}</p>
              <div style="display:flex;gap:0.75rem">
                <span style="font-size:0.7rem;color:var(--c-text-dim)">{r.data.calories} kcal</span>
                <span style="font-size:0.7rem;color:var(--c-green);font-weight:600">{r.data.netCarbs}g net carbs</span>
              </div>
            </div>
          </div>
        </a>
      ))}
      <a href="/app/welcome" style="flex-shrink:0;width:160px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.625rem;background:var(--c-surface-2);border-radius:14px;border:1px solid var(--c-border);text-decoration:none;color:var(--c-text-dim);padding:1.5rem;text-align:center">
        <span style="font-size:1.25rem">→</span>
        <p style="font-size:0.8125rem;font-weight:600;line-height:1.4">Ver las {recipeCount} recetas</p>
      </a>
    </div>
  </div>
</section>

<hr class="rule">

<!-- PROTOCOLS -->
<section class="section">
  <div class="wrap">
    <div class="section-header">
      <span class="chip">Protocolos</span>
      <h2 class="d">Sistemas probados. No dietas.</h2>
      <p>Cada protocolo es un sistema estructurado con objetivo, duración, alimentos y estrategias de ejecución.</p>
    </div>
    <div class="grid-3">
      {protocols.map(p => (
        <a href={`/protocolos/${p.id}`} class="card card-link" style="padding:1.75rem">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
            <span class="chip">{p.data.category}</span>
            <span class="badge">{p.data.difficulty}</span>
          </div>
          <h3 style="font-family:var(--font-display);font-size:1.0625rem;font-weight:800;margin-bottom:0.625rem;line-height:1.3">{p.data.title}</h3>
          <p style="color:var(--c-text-muted);font-size:0.8125rem;line-height:1.6;margin-bottom:1.25rem" class="line-clamp-3">{p.data.description}</p>
          <div style="display:flex;align-items:center;gap:1rem;font-size:0.75rem;color:var(--c-text-dim)">
            <span style="display:flex;align-items:center;gap:0.25rem">
              <span class="icon" style="font-size:14px">schedule</span>
              {p.data.duration}
            </span>
          </div>
        </a>
      ))}
    </div>
    <div style="text-align:center;margin-top:2.5rem">
      <a href="/protocolos" class="btn-ghost">Ver todos los protocolos</a>
    </div>
  </div>
</section>

<hr class="rule">

<!-- FEATURED ARTICLES -->
<section class="section" style="background:var(--c-surface)">
  <div class="wrap">
    <div class="section-header">
      <span class="chip">Centro de aprendizaje</span>
      <h2 class="d">Ciencia real. Sin mitos.</h2>
      <p>Artículos escritos con fuentes científicas, explicados en lenguaje claro.</p>
    </div>
    <div class="grid-3">
      {articles.map(a => (
        <a href={`/aprender/${a.id}`} class="card card-link">
          {a.data.image && <img src={a.data.image} alt={a.data.title} loading="lazy" style="width:100%;height:180px;object-fit:cover">}
          <div style="padding:1.25rem">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem">
              <span class="chip">{a.data.category}</span>
              <span style="font-size:0.7rem;color:var(--c-text-dim)">{a.data.readTime} min</span>
            </div>
            <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:800;line-height:1.35;margin-bottom:0.5rem" class="line-clamp-2">{a.data.title}</h3>
            <p style="font-size:0.8125rem;color:var(--c-text-muted);line-height:1.6" class="line-clamp-2">{a.data.description}</p>
          </div>
        </a>
      ))}
    </div>
    <div style="text-align:center;margin-top:2.5rem">
      <a href="/aprender" class="btn-ghost">Ver todos los artículos</a>
    </div>
  </div>
</section>

<hr class="rule">

<!-- SUCCESS STORIES PREVIEW -->
<section class="section">
  <div class="wrap">
    <div class="section-header">
      <span class="chip">Transformaciones reales</span>
      <h2 class="d">Resultados que hablan.</h2>
      <p>Historias reales de personas que usaron KetoCore y transformaron su salud.</p>
    </div>
    <div class="grid-2">
      {stories.map(s => (
        <div class="card" style="padding:2rem">
          <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem">
            <div style="width:52px;height:52px;border-radius:50%;background:var(--c-primary-dim);border:2px solid var(--c-primary-border);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <span class="icon icon-fill" style="color:var(--c-primary);font-size:24px">person</span>
            </div>
            <div>
              <p style="font-family:var(--font-display);font-weight:800;font-size:1rem">{s.data.name}</p>
              <p style="font-size:0.75rem;color:var(--c-text-dim)">{s.data.age} años · {s.data.protocol}</p>
            </div>
            <div style="margin-left:auto;text-align:right;flex-shrink:0">
              <p style="font-family:var(--font-display);font-weight:900;font-size:1.75rem;color:var(--c-primary);letter-spacing:-0.03em">-{s.data.weightLost}kg</p>
              <p style="font-size:0.7rem;color:var(--c-text-dim)">en {s.data.duration}</p>
            </div>
          </div>
          <a href={`/historias/${s.id}`} style="display:inline-flex;align-items:center;gap:0.375rem;font-size:0.8125rem;color:var(--c-primary);font-weight:600;text-decoration:none">
            Leer historia completa <span class="icon" style="font-size:16px">arrow_forward</span>
          </a>
        </div>
      ))}
    </div>
    <div style="text-align:center;margin-top:2.5rem">
      <a href="/historias" class="btn-ghost">Ver todas las historias</a>
    </div>
  </div>
</section>

<hr class="rule">

<!-- PRICING -->
<section id="precios" class="section">
  <div class="wrap">
    <div style="text-align:center;margin-bottom:44px">
      <span style="font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#ff4d00">Precios</span>
      <h2 class="d" style="font-weight:900;font-size:clamp(30px,4vw,40px);letter-spacing:-0.03em;margin:12px 0 10px">Empieza gratis. Sube cuando quieras.</h2>
      <p style="font-size:16px;color:rgba(26,20,14,0.55);max-width:480px;margin:0 auto;line-height:1.55">Sin tarjeta para empezar. Cancela en un clic.</p>
    </div>
    <div id="pricing-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:820px;margin:0 auto">
      <div class="card" style="background:#fff;border:1px solid rgba(26,20,14,0.08);border-radius:26px;padding:34px">
        <div style="font-family:var(--font-display);font-weight:800;font-size:16px;margin-bottom:6px">Demo</div>
        <div style="display:flex;align-items:baseline;gap:6px;margin-bottom:8px"><span style="font-family:var(--font-display);font-weight:900;font-size:46px;font-variant-numeric:tabular-nums">$0</span><span style="font-size:14px;color:rgba(26,20,14,0.5)">/ sin registro</span></div>
        <p style="font-size:13.5px;color:rgba(26,20,14,0.55);margin-bottom:24px;line-height:1.55">Recorre la app completa con datos de ejemplo antes de suscribirte.</p>
        <div style="display:flex;flex-direction:column;gap:13px;margin-bottom:28px">
          <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span class="icon icon-fill" style="color:#16a34a;font-size:20px">check_circle</span>Dashboard, plan y recetas de muestra</div>
          <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span class="icon icon-fill" style="color:#16a34a;font-size:20px">check_circle</span>Sin cuenta ni tarjeta</div>
          <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span class="icon icon-fill" style="color:#16a34a;font-size:20px">check_circle</span>Contenido web ilimitado</div>
          <div style="display:flex;align-items:center;gap:10px;font-size:14px;color:rgba(26,20,14,0.4)"><span class="icon" style="font-size:20px">remove</span>Datos propios y sincronización</div>
        </div>
        <a href="/app/demo/" style="display:flex;align-items:center;justify-content:center;height:50px;border-radius:14px;background:#f4efe6;border:1.5px solid rgba(26,20,14,0.12);font-family:var(--font-display);font-weight:700;font-size:15px;color:#1a140e;text-decoration:none">Probar el demo</a>
      </div>
