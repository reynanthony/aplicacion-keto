---
// Progreso — v3. Peso + sparkline lima, DecisionCard con proyección temporal
// (aritmética simple sobre keto_weight_history, no un modelo médico), 3 tiles
// (racha/comidas/Health Score — este último ya se reutilizaba en la versión
// anterior vía HealthScoreEngine) y DataRow de medidas corporales (100% nuevo,
// no existía ningún dato de medidas en el repo).
import AppLayout from '../../layouts/AppLayout.astro';
import DataRow from '../../components/v3/DataRow.astro';
import DecisionCard from '../../components/v3/DecisionCard.astro';
import Sheet from '../../components/v3/Sheet.astro';
import Dock from '../../components/v3/Dock.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Progreso" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <p class="v3-eyebrow">Progreso</p>

      <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-card); padding:20px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between;">
          <div>
            <div class="v3-eyebrow" style="margin-bottom:6px;">Peso actual</div>
            <div style="display:flex; align-items:baseline; gap:6px;">
              <span id="pgCurrentWeight" class="v3-num-mono" style="font-size:34px; color:var(--v3-lime);">--</span>
              <span style="font-size:14px; color:var(--v3-text-40);">kg</span>
            </div>
          </div>
          <div style="text-align:right;">
            <div class="v3-eyebrow" style="margin-bottom:6px;">Meta</div>
            <span id="pgGoalWeight" class="v3-num-mono" style="font-size:16px;">-- kg</span>
          </div>
        </div>
        <div style="position:relative; height:70px; margin-top:14px;">
          <svg id="pgWeightChart" width="100%" height="70" viewBox="0 0 540 70" preserveAspectRatio="none">
            <text x="270" y="38" text-anchor="middle" fill="var(--v3-text-40)" font-size="11">Sin registros de peso</text>
          </svg>
        </div>
      </div>

      <DecisionCard id="pg-projection" variant="cream" buttonLabel="Registrar peso" title="Cargando…">
        <span id="pgProjectionBody"></span>
      </DecisionCard>

      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:10px;">
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:14px; text-align:center;">
          <div id="pgStreak" class="v3-num-mono" style="font-size:22px; justify-content:center; color:var(--v3-lime);">0</div>
          <div class="v3-eyebrow" style="margin-top:4px; font-size:10px;">Racha</div>
        </div>
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:14px; text-align:center;">
          <div id="pgMeals" class="v3-num-mono" style="font-size:22px; justify-content:center;">0</div>
          <div class="v3-eyebrow" style="margin-top:4px; font-size:10px;">Comidas hoy</div>
        </div>
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:14px; text-align:center;">
          <div id="pgHealthScore" class="v3-num-mono" style="font-size:22px; justify-content:center; color:var(--v3-amber);">--</div>
          <div class="v3-eyebrow" style="margin-top:4px; font-size:10px;">Health Score</div>
        </div>
      </div>

      <section>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
          <p class="v3-eyebrow" style="margin:0;">Medidas</p>
          <button type="button" id="pgAddMeasureBtn" class="v3-chip v3-chip--filter">+ Añadir</button>
        </div>
        <div id="pgMeasureForm" style="display:none; background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:14px; margin-bottom:10px; flex-direction:column; gap:8px;">
          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px;">
            <label class="v3-eyebrow">Cintura
              <input id="pgCintura" type="number" style="width:100%; background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:8px; padding:8px 4px; margin-top:4px; color:var(--v3-text); font-family:var(--v3-font-mono);" />
            </label>
            <label class="v3-eyebrow">Cadera
              <input id="pgCadera" type="number" style="width:100%; background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:8px; padding:8px 4px; margin-top:4px; color:var(--v3-text); font-family:var(--v3-font-mono);" />
            </label>
            <label class="v3-eyebrow">Pecho
              <input id="pgPecho" type="number" style="width:100%; background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:8px; padding:8px 4px; margin-top:4px; color:var(--v3-text); font-family:var(--v3-font-mono);" />
            </label>
          </div>
          <button type="button" id="pgSaveMeasureBtn" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">Guardar medida</button>
        </div>
        <div id="pgMeasureList"></div>
        <div style="display:none"><DataRow id="_v3-datarow-script-anchor-progreso" title="" /></div>
      </section>

    </main>

    <VeredictoSheet />
    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>
      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>
    <Dock active="yo" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/modules/health-score.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    function fmtDec(n) { return n != null ? parseFloat(n).toFixed(1) : '--'; }

    function getSortedWeightHistory() {
      var h = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
      if (!Array.isArray(h)) h = [];
      return h.slice().sort(function (a, b) { return new Date(a.date || a.fecha) - new Date(b.date || b.fecha); });
    }

    function renderProgreso() {
      var profile = safeParseJSON(localStorage.getItem('keto_profile'), {});
      var sorted = getSortedWeightHistory();
      var goalW = parseFloat(profile.goalWeight || profile.pesoObjetivo) || 0;
      var startW = parseFloat(profile.startWeight || profile.pesoInicial) || (sorted.length ? sorted[0].weight : 0);
      var currentW = sorted.length ? parseFloat(sorted[sorted.length - 1].weight || sorted[sorted.length - 1].peso) : (parseFloat(profile.weight) || 0);

      document.getElementById('pgCurrentWeight').textContent = currentW ? fmtDec(currentW) : '--';
      document.getElementById('pgGoalWeight').textContent = goalW ? fmtDec(goalW) + ' kg' : '-- kg';

      // Sparkline (últimos 28 días), técnica ya existente en la versión anterior, re-temeada a lima
      var svgEl = document.getElementById('pgWeightChart');
      var pts = [];
      for (var i = 27; i >= 0; i--) {
        var d = new Date(); d.setDate(d.getDate() - i);
        var dk = d.toISOString().slice(0, 10);
        var entry = sorted.find(function (h) { return (h.date || h.fecha) === dk; });
        if (entry) pts.push({ x: 27 - i, w: parseFloat(entry.weight || entry.peso) || 0 });
      }
      if (pts.length >= 2) {
        var ws = pts.map(function (p) { return p.w; });
        var minW = Math.min.apply(null, ws) - 1, maxW = Math.max.apply(null, ws) + 1;
        var rangeW = maxW - minW || 1;
        var W = 520, H = 60, padX = 10, padY = 6;
        function px(xi) { return padX + (xi / 27) * W; }
        function py(wi) { return (H + padY) - ((wi - minW) / rangeW) * (H - padY * 2); }
        var line = pts.map(function (p, i) { return (i === 0 ? 'M' : 'L') + px(p.x).toFixed(1) + ' ' + py(p.w).toFixed(1); }).join(' ');
        var area = line + ' L' + px(pts[pts.length - 1].x).toFixed(1) + ' ' + (H + padY) + ' L' + px(pts[0].x).toFixed(1) + ' ' + (H + padY) + ' Z';
        var dots = pts.map(function (p) { return '<circle cx="' + px(p.x).toFixed(1) + '" cy="' + py(p.w).toFixed(1) + '" r="3" fill="var(--v3-lime)"/>'; }).join('');
        svgEl.innerHTML =
          '<defs><linearGradient id="pgg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#c8f560" stop-opacity="0.3"/><stop offset="100%" stop-color="#c8f560" stop-opacity="0"/></linearGradient></defs>' +
          '<path d="' + area + '" fill="url(#pgg)"/>' +
          '<path d="' + line + '" fill="none" stroke="var(--v3-lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' + dots;
      } else if (pts.length === 1) {
        svgEl.innerHTML = '<text x="270" y="38" text-anchor="middle" fill="var(--v3-text-40)" font-size="11">Registra más días para ver la tendencia</text>';
      }

      // Proyección: regresión simple sobre el propio historial (aritmética, no un modelo médico)
      var card = document.querySelector('[data-decision-id="pg-projection"]');
      var titleEl = card.querySelector('.v3-decision-card-title');
      var bodyEl = document.getElementById('pgProjectionBody');
      if (!goalW || sorted.length < 2) {
        titleEl.textContent = 'Registra tu peso para ver tu proyección';
        bodyEl.textContent = sorted.length < 2 ? 'Necesitas al menos 2 registros de peso para calcular una tendencia.' : 'Configura tu meta de peso en Ajustes.';
      } else {
        var first = sorted[0], last = sorted[sorted.length - 1];
        var days = Math.max(1, (new Date(last.date || last.fecha) - new Date(first.date || first.fecha)) / 86400000);
        var totalChange = parseFloat(last.weight || last.peso) - parseFloat(first.weight || first.peso);
        var perDay = totalChange / days;
        var remaining = goalW - currentW;
        titleEl.textContent = 'Meta: ' + fmtDec(goalW) + ' kg';
        if (Math.abs(remaining) < 0.5) {
          bodyEl.textContent = 'Ya estás en tu meta o muy cerca — ¡sigue así!';
        } else if (Math.abs(perDay) < 0.005) {
          bodyEl.textContent = 'Tu peso se mantiene estable — sigue registrando para ver una tendencia.';
        } else if (Math.sign(perDay) === Math.sign(remaining)) {
          var daysToGoal = Math.round(remaining / perDay);
          bodyEl.textContent = 'A tu ritmo actual (' + fmtDec(Math.abs(perDay)) + ' kg/día), llegarías a tu meta en ~' + daysToGoal + ' días.';
        } else {
          bodyEl.textContent = 'Tu peso se mueve en dirección contraria a tu meta por ahora.';
        }
      }
      var sub = document.querySelector('#v3-sheet-registrar .v3-sheet-subtitle');
      if (sub && window.KetoBudget) sub.textContent = 'Margen de hoy · ' + Math.round(window.KetoBudget.compute().available) + ' g netos';

      // Tiles
      var streak = safeParseJSON(localStorage.getItem('ketoStreak'), { currentStreak: 0 });
      document.getElementById('pgStreak').textContent = streak.currentStreak || 0;
      document.getElementById('pgMeals').textContent = window.KetoMealLog.getRecentItems(999).length;
      if (typeof HealthScoreEngine !== 'undefined') {
        var hs = HealthScoreEngine.calculate();
        document.getElementById('pgHealthScore').textContent = hs.total;
      }

      renderMeasurements();
    }

    function renderMeasurements() {
      var list = safeParseJSON(localStorage.getItem('keto_measurements'), []);
      var el = document.getElementById('pgMeasureList');
      if (!list.length) {
        el.innerHTML = '<p style="font-size:13px; color:var(--v3-text-40); padding:8px 2px;">Sin medidas registradas todavía.</p>';
        return;
      }
      var sorted = list.slice().sort(function (a, b) { return new Date(b.date) - new Date(a.date); });
      el.innerHTML = sorted.map(function (m, i) {
        var parts = [];
        if (m.cintura) parts.push('Cintura ' + m.cintura + 'cm');
        if (m.cadera) parts.push('Cadera ' + m.cadera + 'cm');
        if (m.pecho) parts.push('Pecho ' + m.pecho + 'cm');
        return '' +
          '<div class="v3-row-wrap" data-row-id="measure-' + i + '">' +
            '<div class="v3-row-actions"><button type="button" class="v3-row-action v3-row-action--delete" style="width:128px" data-remove-measure="' + i + '">Borrar</button></div>' +
            '<div class="v3-row">' +
              '<span class="v3-row-lead v3-row-lead-time">' + m.date + '</span>' +
              '<div class="v3-row-content v3-row-content--pending">' +
                '<div class="v3-row-body"><div class="v3-row-title">' + (parts.join(' · ') || 'Sin datos') + '</div></div>' +
              '</div>' +
            '</div>' +
          '</div>';
      }).join('');
    }

    document.addEventListener('DOMContentLoaded', function () {
      renderProgreso();

      document.getElementById('pgAddMeasureBtn').addEventListener('click', function () {
        var form = document.getElementById('pgMeasureForm');
        form.style.display = form.style.display === 'none' ? 'flex' : 'none';
      });
      document.getElementById('pgSaveMeasureBtn').addEventListener('click', function () {
        var list = safeParseJSON(localStorage.getItem('keto_measurements'), []);
        list.push({
          date: new Date().toISOString().slice(0, 10),
          cintura: document.getElementById('pgCintura').value || null,
          cadera: document.getElementById('pgCadera').value || null,
          pecho: document.getElementById('pgPecho').value || null
        });
        localStorage.setItem('keto_measurements', JSON.stringify(list));
        document.getElementById('pgMeasureForm').style.display = 'none';
        document.getElementById('pgCintura').value = '';
        document.getElementById('pgCadera').value = '';
        document.getElementById('pgPecho').value = '';
        renderMeasurements();
      });
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-remove-measure]');
        if (!el) return;
        var idx = parseInt(el.getAttribute('data-remove-measure'));
        var list = safeParseJSON(localStorage.getItem('keto_measurements'), []);
        var sorted = list.slice().sort(function (a, b) { return new Date(b.date) - new Date(a.date); });
        var target = sorted[idx];
        list = list.filter(function (m) { return m !== target; });
        localStorage.setItem('keto_measurements', JSON.stringify(list));
        renderMeasurements();
      });
      document.addEventListener('v3:decision-action', function (e) {
        if (e.detail.id !== 'pg-projection') return;
        var val = prompt('¿Cuánto pesas hoy? (kg)');
        var num = parseFloat(val);
        if (isNaN(num) || num < 20 || num > 300) return;
        var history = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
        if (!Array.isArray(history)) history = [];
        var today = new Date().toISOString().slice(0, 10);
        var idx = history.findIndex(function (h) { return (h.date || h.fecha) === today; });
        if (idx >= 0) history[idx].weight = num; else history.push({ date: today, weight: num });
        localStorage.setItem('keto_weight_history', JSON.stringify(history));
        renderProgreso();
      });
    });
  </script>
</AppLayout>
