---
// Progreso — UI v2 (HUD) con datos reales (kc-adapter). Sin MeasureList ni
// "Grasa corporal" (KetoCore no mide medidas/composición). Respaldo: progreso.astro.bak
import AppShell from '../../layouts/AppShell.astro';
import Segmented from '../../components/kc/Segmented.astro';
import TrendCard from '../../components/kc/TrendCard.astro';
import StatCard from '../../components/kc/StatCard.astro';
import MeasureList from '../../components/kc/MeasureList.astro';
import WeekBars from '../../components/kc/WeekBars.astro';
import Icon from '../../components/kc/Icon.astro';
---
<AppShell title="Progreso" screen="progreso">
  <div>
    <div class="kc-hero-sub" data-kc-text="subtitle">&nbsp;</div>
    <h1 class="kc-hero"><em><span data-kc-text="weight.lost" data-kc-fmt="1">—</span> kg</em> menos desde el inicio</h1>
  </div>

  <Segmented group="range" label="Periodo" selected="30d" options={[
    { value: '7d', label: '7D' }, { value: '30d', label: '30D' }, { value: '90d', label: '90D' }, { value: 'all', label: 'Todo' },
  ]} />

  <TrendCard path="weight" eyebrow="Peso" />

  <div class="kc-grid">
    <StatCard label="Hacia la meta" path="stats.goal" unit="%" color="amber" />
    <StatCard label="IMC" path="stats.bmi" color="cyan" fmt="1" />
    <StatCard label="Grasa corporal" path="stats.fat" unit="%" color="mint" fmt="1" />
    <StatCard label="Ritmo semanal" path="stats.rate" unit="kg" color="amber" fmt="1" />
  </div>

  <button class="kc-btn kc-btn--primary kc-btn--block" type="button" data-kc-action="log:weight"><Icon name="scale" />Registrar peso de hoy</button>

  <MeasureList />
  <WeekBars path="adherence" />

  <div class="kc-sheet" id="kc-measure" role="dialog" aria-modal="true" aria-hidden="true" inert>
    <div class="kc-sheet__grab"></div>
    <div class="kc-card__head" style="margin:0">
      <div><div class="kc-eyebrow">Composición</div><h2 class="kc-card__title">Registrar medidas</h2></div>
      <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" type="button" data-kc-sheet-close aria-label="Cerrar"><Icon name="plus" class="kc-rot45" /></button>
    </div>
    <div class="kc-field-2">
      <label class="kc-field"><span class="kc-label">Cintura (cm)</span><input class="kc-input" id="m-cintura" type="number" inputmode="decimal" placeholder="—" /></label>
      <label class="kc-field"><span class="kc-label">Cadera (cm)</span><input class="kc-input" id="m-cadera" type="number" inputmode="decimal" placeholder="—" /></label>
      <label class="kc-field"><span class="kc-label">Masa magra (kg)</span><input class="kc-input" id="m-magra" type="number" inputmode="decimal" placeholder="—" /></label>
      <label class="kc-field"><span class="kc-label">Grasa corporal (%)</span><input class="kc-input" id="m-grasa" type="number" inputmode="decimal" placeholder="—" /></label>
    </div>
    <button class="kc-btn kc-btn--primary kc-btn--block" type="button" data-kc-save="measure" style="margin-top:6px">Guardar medidas</button>
  </div>
  <div class="kc-scrim" data-kc-scrim="kc-measure"></div>

  <Fragment slot="scripts">
    <script is:inline src="/app/utils.js"></script>
    <script is:inline src="/app/modules/meal-plan.js"></script>
    <script is:inline src="/app/modules/health-score.js"></script>
    <script is:inline src="/app/kc-adapter.js"></script>
  </Fragment>
</AppShell>
