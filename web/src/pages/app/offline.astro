---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Sin Conexión" authGuard={false}>
<div class="min-h-screen flex items-center justify-center p-4">
    <div class="kc-tile text-center" style="max-width:380px;padding:38px 32px">
      <span class="material-symbols-outlined mb-4" style="font-size:64px;color:var(--c-primary)">wifi_off</span>
      <h1 class="kc-h1" style="font-size:26px;margin-bottom:10px">Sin conexión</h1>
      <p class="kc-sub" style="margin-top:0;margin-bottom:26px">
        No tienes conexión a internet. KetoCore funciona offline,
        tus datos se guardarán localmente y se sincronizarán cuando vuelvas a conectarte.
      </p>
      <a href="/app/" class="kc-btn" style="width:100%">
        <span class="material-symbols-outlined" style="font-size:18px">home</span>
        Volver al inicio
      </a>
      <button onclick="window.location.reload()" class="kc-btn-ghost" style="width:100%;margin-top:10px;background:transparent;border-color:transparent">
        Reintentar
      </button>
    </div>
  </div>

</AppLayout>
