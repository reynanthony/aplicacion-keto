---
// Compras / Despensa — UI v2 (HUD nativo). Reescrito del puente .app-hud a
// markup kc-* real; los generadores de compras.js emiten ahora tarjetas HUD.
// Fila de KPIs del inventario (kcal / alimentos / stock / categorías).
// Lógica y datos intactos (compras.js + inspector keto). Respaldo: compras.astro.bak
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="Compras" screen="compras">
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}

/* Tabs segmentados */
.kc .cmp-tabs{display:flex;gap:6px;background:var(--kc-surface-2);border:1px solid var(--kc-line);border-radius:var(--kc-radius-md);padding:4px}
.kc .cmp-tab{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:38px;border:0;background:transparent;color:var(--kc-ink-3);font:600 13px var(--kc-font-sans);border-radius:var(--kc-radius-sm);cursor:pointer;transition:background .18s,color .18s;white-space:nowrap}
.kc .cmp-tab.is-active{background:var(--kc-amber-fill);color:var(--kc-on-amber);box-shadow:var(--kc-glow-amber)}
.kc .cmp-tab .material-symbols-outlined{font-size:17px}

/* Tarjeta de categoría (despensa) */
.kc .cmp-cat{background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-md);padding:14px;margin-bottom:10px}
.kc .cmp-cat__h{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.kc .cmp-cat__name{display:flex;align-items:center;gap:8px;font:600 14px var(--kc-font-sans);color:var(--kc-ink);min-width:0}
.kc .cmp-cat__name .material-symbols-outlined{font-size:19px}
.kc .cmp-cat__count{font:500 11px var(--kc-font-mono);color:var(--kc-ink-3)}
.kc .cmp-cat__cal{font:700 13px var(--kc-font-mono);white-space:nowrap}
.kc .cmp-row{display:flex;align-items:center;gap:8px;background:var(--kc-surface-2);border-radius:var(--kc-radius-sm);padding:9px 10px}
.kc .cmp-row+.cmp-row{margin-top:6px}
.kc .cmp-row__main{flex:1;min-width:0}
.kc .cmp-row__name{font:600 12.5px var(--kc-font-sans);color:var(--kc-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kc .cmp-row__meta{display:flex;align-items:center;gap:6px;margin-top:3px}
.kc .cmp-row__bar{flex:1;height:4px;background:var(--kc-surface-1);border-radius:2px;overflow:hidden}
.kc .cmp-row__bar i{display:block;height:100%;border-radius:2px}
.kc .cmp-row__stock{font:500 10px var(--kc-font-mono);white-space:nowrap}
.kc .cmp-row__cal{text-align:right;min-width:44px;font:700 12px var(--kc-font-sans);color:var(--kc-ink)}
.kc .cmp-row__cal small{font:500 9px var(--kc-font-mono);color:var(--kc-ink-3)}
.kc .cmp-step{width:26px;height:26px;border-radius:7px;background:var(--kc-surface-1);border:1px solid var(--kc-line-strong);color:var(--kc-ink);font-size:14px;line-height:1;cursor:pointer;padding:0;flex-shrink:0}
.kc .cmp-del{width:26px;height:26px;border-radius:7px;background:color-mix(in oklab,var(--kc-red) 15%,transparent);border:0;color:var(--kc-red);font-size:14px;line-height:1;cursor:pointer;padding:0;flex-shrink:0}

/* Grupos de "Agregar" */
.kc .cmp-groupt{display:flex;align-items:center;gap:8px;font:600 11px/14px var(--kc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--kc-ink-3);margin:16px 0 8px}
.kc .cmp-groupt:first-child{margin-top:0}
.kc .cmp-groupt .dot{width:8px;height:8px;border-radius:3px}
.kc .cmp-food{display:flex;align-items:center;gap:10px;background:var(--kc-surface-2);border-radius:var(--kc-radius-sm);padding:10px 12px;cursor:pointer;transition:background .18s}
.kc .cmp-food+.cmp-food{margin-top:6px}
.kc .cmp-food:active{transform:scale(.99)}
.kc .cmp-food__name{flex:1;min-width:0;font:600 13px var(--kc-font-sans);color:var(--kc-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kc .cmp-food__g{font:500 11px var(--kc-font-mono);color:var(--kc-ink-3);white-space:nowrap}

/* Lista "Desde plan" */
.kc .cmp-plan{display:flex;align-items:center;gap:12px;background:var(--kc-surface-2);border-radius:var(--kc-radius-md);padding:12px}
.kc .cmp-plan+.cmp-plan{margin-top:8px}
.kc .cmp-plan__main{flex:1;min-width:0}
.kc .cmp-plan__name{font:600 13px var(--kc-font-sans);color:var(--kc-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kc .cmp-plan__sub{font:500 11.5px var(--kc-font-mono);color:var(--kc-ink-3);margin-top:2px}
.kc .cmp-plan__flag{font:700 11px var(--kc-font-mono);white-space:nowrap}

/* Estado vacío */
.kc .cmp-empty{background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-md);padding:32px 20px;text-align:center}
.kc .cmp-empty .material-symbols-outlined{font-size:44px;color:var(--kc-ink-3);opacity:.5}
.kc .cmp-empty p{font:500 13px var(--kc-font-sans);color:var(--kc-ink-2);margin-top:10px}
.kc .cmp-empty p.sub{font-size:12px;color:var(--kc-ink-3);margin-top:2px}

/* Modal agregar (hoja inferior) */
.kc .cmp-modal{position:fixed;inset:0;z-index:60;display:flex;align-items:flex-end;justify-content:center}
.kc .cmp-modal.hidden{display:none}
.kc .cmp-modal__scrim{position:absolute;inset:0;background:rgba(0,0,0,.72);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
.kc .cmp-modal__panel{position:relative;width:100%;max-width:480px;max-height:88dvh;overflow-y:auto;background:var(--kc-surface-1);border:1px solid var(--kc-line);border-bottom:0;border-radius:var(--kc-radius-xl) var(--kc-radius-xl) 0 0;box-shadow:var(--kc-shadow-float);padding:18px 18px calc(20px + env(safe-area-inset-bottom))}
.kc .cmp-block{background:var(--kc-surface-2);border-radius:var(--kc-radius-md);padding:12px 14px;margin-bottom:14px}
.kc .cmp-qty{display:flex;align-items:center;gap:10px}
.kc .cmp-qty input{flex:1;height:48px;text-align:center;font:700 19px var(--kc-font-sans);color:var(--kc-ink);background:var(--kc-surface-2);border:1px solid var(--kc-line-strong);border-radius:var(--kc-radius-md);-webkit-appearance:none;appearance:none}
.kc .cmp-qtybtn{width:48px;height:48px;flex-shrink:0}

/* Toast */
.kc .cmp-toast{position:fixed;bottom:calc(96px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);z-index:70;display:flex;align-items:center;gap:10px;padding:12px 20px;border-radius:var(--kc-radius-pill);background:var(--kc-surface-1);border:1px solid var(--kc-line-strong);box-shadow:var(--kc-shadow-float);font:600 13px var(--kc-font-sans);color:var(--kc-ink)}
.kc .cmp-toast.hidden{display:none}
</style>

<!-- Hero -->
<div>
  <div class="kc-hero-sub">Control de inventario</div>
  <h1 class="kc-hero">Mi <em>despensa</em></h1>
</div>

<!-- KPIs -->
<div class="kc-grid">
  <div class="kc-stat kc-c-amber">
    <div class="kc-stat__top"><span class="kc-label">Inventario</span></div>
    <div class="kc-stat__val"><span id="kpiKcal">0</span><small>kcal</small></div>
  </div>
  <div class="kc-stat kc-c-cyan">
    <div class="kc-stat__top"><span class="kc-label">Alimentos</span></div>
    <div class="kc-stat__val" id="kpiItems">0</div>
  </div>
  <div class="kc-stat kc-c-mint">
    <div class="kc-stat__top"><span class="kc-label">Stock</span></div>
    <div class="kc-stat__val" id="kpiStock">0</div>
  </div>
  <div class="kc-stat kc-c-amber">
    <div class="kc-stat__top"><span class="kc-label">Categorías</span></div>
    <div class="kc-stat__val"><span id="kpiCats">0</span><small>/6</small></div>
    <div class="kc-bar kc-c-amber"><i id="kpiCatsBar"></i></div>
  </div>
</div>

<!-- Tabs -->
<div class="cmp-tabs">
  <button id="tabDespensa" class="cmp-tab is-active" onclick="switchTab('despensa')"><span class="material-symbols-outlined">inventory_2</span>Despensa</button>
  <button id="tabAvailable" class="cmp-tab" onclick="switchTab('available')"><span class="material-symbols-outlined">add_circle</span>Agregar</button>
  <button id="tabPlan" class="cmp-tab" onclick="switchTab('plan')"><span class="material-symbols-outlined">calendar_today</span>Plan</button>
</div>

<section id="despensaSection"><div id="despensaList"></div></section>
<section id="availableSection" class="hidden"><div id="availableList"></div></section>
<section id="planSection" class="hidden"><div id="planShoppingList"></div></section>

<!-- Modal agregar -->
<div id="addModal" class="cmp-modal hidden">
  <div class="cmp-modal__scrim" onclick="closeAddModal()"></div>
  <div class="cmp-modal__panel">
    <header class="kc-card__head" style="margin-bottom:14px">
      <div style="min-width:0"><div class="kc-eyebrow">Agregar a despensa</div><h3 class="kc-card__title" id="addFoodName" style="margin-top:4px">Alimento</h3><div id="addRiskInfo"></div></div>
      <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeAddModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
    </header>
    <div class="cmp-block"><div class="kc-label" style="margin-bottom:4px">Presentación</div><div id="addFoodPortion" style="font:600 13px var(--kc-font-sans);color:var(--kc-ink)"></div></div>
    <div style="margin-bottom:14px"><div class="kc-label" style="margin-bottom:8px">Unidad</div><div id="unitSelector"></div></div>
    <div style="margin-bottom:14px"><div class="kc-label" style="margin-bottom:8px">Cantidad</div>
      <div class="cmp-qty">
        <button class="kc-btn kc-btn--secondary kc-btn--icon cmp-qtybtn" onclick="var i=document.getElementById('addQuantity');i.value=Math.max(0.1,(parseFloat(i.value)||0)-1);updateAddPreview()">−</button>
        <input type="number" id="addQuantity" value="1" min="0.1" max="10000" step="0.1">
        <button class="kc-btn kc-btn--secondary kc-btn--icon cmp-qtybtn" onclick="var i=document.getElementById('addQuantity');i.value=Math.min(10000,(parseFloat(i.value)||0)+1);updateAddPreview()">+</button>
      </div>
    </div>
    <div class="cmp-block" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <span class="kc-label">Total en gramos</span><span id="addPreview" style="font:800 22px var(--kc-font-sans);color:var(--kc-amber)">0 g</span>
    </div>
    <div style="display:flex;gap:10px">
      <button class="kc-btn kc-btn--secondary kc-btn--block" onclick="closeAddModal()">Cancelar</button>
      <button class="kc-btn kc-btn--primary kc-btn--block" onclick="confirmAdd()">Agregar</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="cmp-toast hidden">
  <span class="material-symbols-outlined" style="color:var(--kc-mint);font-size:20px;font-variation-settings:'FILL' 1">check_circle</span>
  <span id="toastMessage">Guardado</span>
</div>

<Fragment slot="scripts">
  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/data/keto-inspector-ingredientes.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/keto-inspector-api.js"></script>
  <script is:inline src="/app/modules/keto-inspector-ui.js"></script>
  <script is:inline src="/app/compras.js?v=6"></script>
</Fragment>
</AppShell>
