---
// Compras — v3. Progreso + 3 tiles + secciones Frescos/Despensa con DataRow
// check. "Vive dentro de Plan" en la IA final del handoff; mientras Plan no
// se rediseñe (paso dedicado aparte), esta pantalla sigue alcanzable por la
// misma ruta /app/compras (AppSidebar no se toca, su enlace sigue sirviendo).
import AppLayout from '../../layouts/AppLayout.astro';
import DataRow from '../../components/v3/DataRow.astro';
import Dock from '../../components/v3/Dock.astro';
import Sheet from '../../components/v3/Sheet.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Compras" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <div style="display:flex; align-items:center; justify-content:space-between;">
        <p class="v3-eyebrow" style="margin:0;">Compras · próximos 7 días</p>
        <span id="cmpProgress" class="v3-num-mono" style="font-size:14px;">0/0</span>
      </div>
      <div class="v3-bh-bar-track" style="height:6px;"><div id="cmpProgressBar" class="v3-bh-bar-fill" style="width:0%; background:var(--v3-lime);"></div></div>

      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:10px;">
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:14px; text-align:center;">
          <div id="cmpTotal" class="v3-num-mono" style="font-size:22px; justify-content:center;">0</div>
          <div class="v3-eyebrow" style="margin-top:4px; font-size:10px;">Total</div>
        </div>
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:14px; text-align:center;">
          <div id="cmpFalta" class="v3-num-mono" style="font-size:22px; justify-content:center; color:var(--v3-amber);">0</div>
          <div class="v3-eyebrow" style="margin-top:4px; font-size:10px;">Por comprar</div>
        </div>
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:14px; text-align:center;">
          <div id="cmpComprados" class="v3-num-mono" style="font-size:22px; justify-content:center; color:var(--v3-lime);">0</div>
          <div class="v3-eyebrow" style="margin-top:4px; font-size:10px;">Comprados</div>
        </div>
      </div>

      <section>
        <p class="v3-eyebrow" style="margin-bottom:10px;">Frescos</p>
        <div id="cmpFrescos"></div>
      </section>
      <section>
        <p class="v3-eyebrow" style="margin-bottom:10px;">Despensa</p>
        <div id="cmpDespensa"></div>
      </section>
      <div style="display:none"><DataRow id="_v3-datarow-script-anchor-compras" title="" /></div>

    </main>

    <VeredictoSheet />
    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>
      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>
    <Dock active="plan" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/compras.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    var CATEGORY_TO_AISLE = {
      'Verduras': 'Frescos', 'Lácteos': 'Frescos', 'Proteínas': 'Frescos',
      'Grasas': 'Despensa', 'Frutos secos': 'Despensa', 'Otros': 'Despensa'
    };

    function computeNeeded(){
      var needed = {};
      var today = new Date();
      for (var i = 0; i < 7; i++) {
        var d = new Date(today); d.setDate(today.getDate() + i);
        var dk = d.toISOString().slice(0, 10);
        var plan = safeParseJSON(localStorage.getItem('mealPlan_' + dk), {});
        ['desayuno', 'almuerzo', 'cena', 'snacks'].forEach(function (meal) {
          (plan[meal] || []).forEach(function (item) {
            var key = item.id || item.name || 'item';
            if (!needed[key]) needed[key] = { id: item.id, name: item.name || key, totalG: 0, days: 0 };
            needed[key].totalG += parseFloat(item.portion || 100);
            needed[key].days++;
          });
        });
      }
      return Object.values(needed);
    }

    function getCheckedMap(){
      return safeParseJSON(localStorage.getItem('comprasChecked_' + getWeekKey()), {});
    }
    function setChecked(key, checked){
      var map = getCheckedMap();
      map[key] = checked;
      localStorage.setItem('comprasChecked_' + getWeekKey(), JSON.stringify(map));
    }

    function renderCompras(){
      initFoods();
      var foods = getFoods();
      var despensa = getDespensa();
      var checkedMap = getCheckedMap();
      var items = computeNeeded();

      var byAisle = { Frescos: [], Despensa: [] };
      items.forEach(function(item){
        var food = item.id ? foods.find(function(f){ return f.id === item.id; }) : null;
        var aisle = food ? (CATEGORY_TO_AISLE[food.category] || 'Despensa') : 'Despensa';
        var stockG = (item.id && despensa[item.id]) ? (parseFloat(despensa[item.id].stock) || 0) : 0;
        var neededG = Math.round(item.totalG);
        var enough = stockG >= neededG;
        byAisle[aisle].push({
          key: item.id || item.name,
          name: item.name,
          meta: enough ? 'Tienes suficiente' : ('Necesitas ' + neededG + 'g · ' + item.days + (item.days>1?' comidas':' comida')),
          checked: !!checkedMap[item.id || item.name]
        });
      });

      var total = items.length;
      var checkedCount = items.filter(function(it){ return checkedMap[it.id || it.name]; }).length;
      document.getElementById('cmpProgress').textContent = checkedCount + '/' + total;
      document.getElementById('cmpProgressBar').style.width = (total ? Math.round(checkedCount/total*100) : 0) + '%';
      document.getElementById('cmpTotal').textContent = total;
      document.getElementById('cmpFalta').textContent = total - checkedCount;
      document.getElementById('cmpComprados').textContent = checkedCount;

      function renderSection(elId, rows){
        var el = document.getElementById(elId);
        if (!rows.length) { el.innerHTML = '<p style="font-size:13px; color:var(--v3-text-40); padding:8px 2px;">Nada por aquí esta semana.</p>'; return; }
        el.innerHTML = rows.map(function(row){
          return '' +
            '<div class="v3-row-wrap" data-row-id="'+row.key+'">' +
              '<div class="v3-row-actions"><button type="button" class="v3-row-action v3-row-action--edit" style="width:128px" data-toggle-checked="'+row.key+'">'+(row.checked?'Desmarcar':'Comprado')+'</button></div>' +
              '<div class="v3-row">' +
                '<span class="v3-row-lead"><span class="material-symbols-outlined">'+(row.checked?'check_circle':'radio_button_unchecked')+'</span></span>' +
                '<div class="v3-row-content v3-row-content--'+(row.checked?'done':'pending')+'" data-toggle-checked="'+row.key+'" style="cursor:pointer;">' +
                  '<div class="v3-row-body">' +
                    '<div class="v3-row-title">'+escapeHtml(row.name)+'</div>' +
                    '<div class="v3-row-meta">'+row.meta+'</div>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>';
        }).join('');
      }
      renderSection('cmpFrescos', byAisle.Frescos);
      renderSection('cmpDespensa', byAisle.Despensa);
    }

    document.addEventListener('DOMContentLoaded', function () {
      renderCompras();
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-toggle-checked]');
        if (!el) return;
        var key = el.getAttribute('data-toggle-checked');
        var map = getCheckedMap();
        setChecked(key, !map[key]);
        renderCompras();
      });
    });
  </script>
</AppLayout>
