---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Lista de Compras" authGuard={true}>
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
.glass-card{background:rgba(22,19,16,0.7);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
@media(min-width:768px){#cmp-wrap{max-width:none!important;padding-top:1rem;}}
</style>
<header class="fixed top-0 left-0 right-0 z-40 h-14 px-4 flex items-center justify-between" style="background:rgba(19,19,21,0.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,240,225,0.06)">
  <a href="/app/" class="flex items-center gap-3" style="text-decoration:none">
    <img src="/app/logo.svg" alt="KetoCore" class="w-7 h-7" style="filter:drop-shadow(0 0 6px rgba(255,77,0,0.4))">
    <span class="text-base font-black tracking-tight" style="font-family:'Plus Jakarta Sans',sans-serif;color:#f7f4f0">KetoCore</span>
  </a>
  <div class="flex items-center gap-1.5">
    <button onclick="toggleMobileUserMenu()" aria-label="Mi cuenta" class="w-9 h-9 rounded-full flex items-center justify-center overflow-hidden" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06)">
      <img id="mobileHeaderAvatarImg" src="" class="hidden w-full h-full object-cover" alt="Avatar">
      <span id="mobileHeaderAvatarIcon" class="material-symbols-outlined" style="font-size:20px;color:rgba(247,244,240,0.6)">account_circle</span>
    </button>
    <button onclick="toggleHamburgerMenu()" aria-label="Abrir menú" class="w-9 h-9 rounded-full flex items-center justify-center" style="background:#1e1a15;color:rgba(247,244,240,0.6)">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:20px">menu</span>
    </button>
  </div>
</header>

<!-- Mobile User Dropdown -->
<div id="mobileUserDropdown" class="md:hidden fixed top-14 right-4 w-56 rounded-2xl overflow-hidden z-[80] hidden" style="background:#161310;border:1px solid rgba(255,240,225,0.07);box-shadow:0 8px 32px rgba(0,0,0,0.35)">
  <div class="p-3" style="border-bottom:1px solid rgba(255,240,225,0.06)">
    <p class="text-sm font-semibold" style="color:#f7f4f0" id="mobileDropdownUserName">Usuario</p>
    <p class="text-xs mt-0.5" style="color:rgba(247,244,240,0.55)" id="mobileDropdownUserEmail">email@example.com</p>
  </div>
  <div class="p-2">
    <a href="/app/perfil" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-orange-50" style="color:#f7f4f0">
      <span class="material-symbols-outlined text-lg" style="color:rgba(247,244,240,0.55)">person</span>
      <span class="text-sm font-medium">Mi Perfil</span>
    </a>
    <button onclick="handleLogout()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-red-50" style="color:#dc2626">
      <span class="material-symbols-outlined text-lg">logout</span>
      <span class="text-sm font-medium">Cerrar Sesión</span>
    </button>
  </div>
</div>
<main class="main-content pt-14 pb-20 min-h-screen" style="background:#131315">
<div id="cmp-wrap" class="space-y-8 kc-page" style="padding-top:12px">

<!-- Hero Header -->
<div class="relative overflow-hidden bg-surface-container rounded-3xl p-8 md:p-12">
<div class="absolute -top-20 -right-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl"></div>
<div class="absolute -bottom-20 -left-20 w-48 h-48 bg-secondary/10 rounded-full blur-3xl"></div>
<div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
<div>
<span style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00">Control de inventario</span>
<h1 class="kc-h1" style="margin-top:10px">Mi despensa</h1>
<p class="text-on-surface-variant mt-3 max-w-lg">Controla tu stock de alimentos y optimiza tus compras semanalmente.</p>
</div>
<button onclick="switchTab('available');document.getElementById('tabAvailable').click();" class="kc-btn">
<span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">add_circle</span>
Agregar Alimento
</button>
</div>
</div>

<!-- Tab Navigation -->
<div class="flex gap-2 flex-wrap">
<button id="tabDespensa" onclick="switchTab('despensa')" class="px-6 py-3 rounded-2xl text-sm font-bold bg-primary text-white transition-all flex items-center gap-2">
<span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">inventory_2</span>
Mi Despensa
</button>
<button id="tabAvailable" onclick="switchTab('available')" class="px-6 py-3 rounded-2xl text-sm font-bold bg-surface-container text-on-surface-variant transition-all flex items-center gap-2 hover:bg-surface-container-high">
<span class="material-symbols-outlined">add_circle</span>
Agregar Alimentos
</button>
<button id="tabPlan" onclick="switchTab('plan')" class="px-6 py-3 rounded-2xl text-sm font-bold bg-surface-container text-on-surface-variant transition-all flex items-center gap-2 hover:bg-surface-container-high">
<span class="material-symbols-outlined text-secondary">calendar_today</span>
Desde Plan
</button>
</div>

<!-- Mi Despensa Section -->
<section id="despensaSection" class="space-y-6">
<div id="despensaList" class="space-y-4"></div>
</section>

<!-- Desde Plan Section -->
<section id="planSection" class="space-y-6 hidden">
  <div class="bg-surface-container rounded-2xl p-6">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 rounded-xl bg-secondary/20 flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-secondary text-2xl" style="font-variation-settings:'FILL' 1">calendar_today</span>
      </div>
      <div>
        <h4 class="font-headline font-bold text-white">Alimentos de tu plan esta semana</h4>
        <p class="text-on-surface-variant text-sm mt-1">Generado desde los 7 días del plan de alimentación.</p>
      </div>
    </div>
  </div>
  <div id="planShoppingList" class="space-y-3"></div>
</section>

<!-- Available Foods Section -->
<section id="availableSection" class="space-y-6 hidden">
<div class="bg-surface-container rounded-2xl p-6">
<div class="flex items-start gap-4">
<div class="w-12 h-12 rounded-xl bg-secondary/20 flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-secondary text-2xl">info</span>
</div>
<div>
<h4 class="font-headline font-bold text-white">Selecciona alimentos</h4>
<p class="text-on-surface-variant text-sm mt-1">Toca un alimento para agregarlo a tu despensa con cantidad personalizada.</p>
</div>
</div>
</div>
<div id="availableList" class="space-y-4"></div>
</section>

</div>
</main>

<!-- Add Modal -->
<div id="addModal" class="fixed inset-0 z-[60] hidden">
<div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeAddModal()"></div>
<div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
<div class="glass-card rounded-3xl p-8 w-full max-w-md pointer-events-auto border border-primary/20">
<div class="flex justify-between items-center mb-6">
<div>
<h3 class="text-2xl font-headline font-black text-white">Agregar a Despensa</h3>
<p id="addFoodName" class="text-primary mt-1 font-bold"></p>
<div id="addRiskInfo" class="mt-3"></div>
</div>
<button onclick="closeAddModal()" class="w-10 h-10 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-all"><span class="material-symbols-outlined text-lg">close</span></button>
</div>
<div class="bg-surface-container-high rounded-2xl p-4 mb-6">
<p class="text-xs text-on-surface-variant uppercase tracking-wider mb-2">Presentacion por unidad</p>
<p id="addFoodPortion" class="text-white font-bold"></p>
</div>
<div class="mb-6">
<label class="text-xs text-on-surface-variant uppercase tracking-wider block mb-3">Unidad de medida</label>
<div id="unitSelector" class="flex flex-wrap gap-2"></div>
</div>
<div class="mb-6">
<label class="text-xs text-on-surface-variant uppercase tracking-wider block mb-3">Cantidad</label>
<div class="flex items-center gap-3">
<button onclick="var inp=document.getElementById('addQuantity');inp.value=Math.max(0.1,parseFloat(inp.value)-1);updateAddPreview()" class="w-14 h-14 rounded-2xl bg-surface-container-high text-white font-bold text-2xl hover:bg-surface-container-highest transition-all flex items-center justify-center">-</button>
<input type="number" id="addQuantity" value="1" min="0.1" max="10000" step="0.1" class="flex-1 bg-surface-container text-white border border-outline rounded-2xl px-4 py-4 text-center text-2xl font-bold focus:outline-none focus:border-primary">
<button onclick="var inp=document.getElementById('addQuantity');inp.value=Math.min(10000,parseFloat(inp.value)+1);updateAddPreview()" class="w-14 h-14 rounded-2xl bg-surface-container-high text-white font-bold text-2xl hover:bg-surface-container-highest transition-all flex items-center justify-center">+</button>
</div>
</div>
<div class="bg-surface-container-high rounded-2xl p-6 mb-6">
<div class="flex justify-between items-center">
<span class="text-on-surface-variant">Total en gramos:</span>
<span id="addPreview" class="text-3xl font-headline font-black text-primary">0 g</span>
</div>
</div>
<div class="flex gap-3">
<button onclick="closeAddModal()" class="kc-btn-ghost flex-1" style="height:56px">Cancelar</button>
<button onclick="confirmAdd()" class="kc-btn flex-1" style="height:56px">Agregar</button>
</div>
</div>
</div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-28 left-1/2 -translate-x-1/2 z-[70] hidden">
<div class="glass-card rounded-full px-6 py-3 flex items-center gap-3 shadow-lg border border-primary/20">
<span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1">check_circle</span>
<span id="toastMessage" class="text-white font-bold">Guardado!</span>
</div>
</div>


<script is:inline src="/app/utils.js"></script>
<script is:inline src="/app/data/keto-inspector-ingredientes.js"></script>
<script is:inline src="/app/modules/inspectorKeto.js"></script>
<script is:inline src="/app/modules/keto-inspector-api.js"></script>
<script is:inline src="/app/modules/keto-inspector-ui.js"></script>
<script is:inline src="/app/compras.js?v=4"></script>
<script is:inline>
// User Dropdown Menu
function toggleUserMenu() {
  const dropdown = document.getElementById('userDropdown');
  dropdown.classList.toggle('hidden');
  updateDropdownInfo();
}

function toggleMobileUserMenu() {
  const dropdown = document.getElementById('mobileUserDropdown');
  dropdown.classList.toggle('hidden');
  updateDropdownInfo();
}

function updateDropdownInfo() {
  const profile = JSON.parse(localStorage.getItem('keto_profile') || '{}');
  const userName = profile.nombre || profile.name || 'Usuario';
  const userEmail = localStorage.getItem('ketocore_user_email') || 'usuario@ejemplo.com';
  const dn = document.getElementById('dropdownUserName');
  const de = document.getElementById('dropdownUserEmail');
  const mdn = document.getElementById('mobileDropdownUserName');
  const mde = document.getElementById('mobileDropdownUserEmail');
  if(dn) dn.textContent = userName;
  if(de) de.textContent = userEmail;
  if(mdn) mdn.textContent = userName;
  if(mde) mde.textContent = userEmail;
}

function updateHeaderAvatar() {
  const profile = JSON.parse(localStorage.getItem('keto_profile') || '{}');
  const avatarUrl = profile.avatar_url;
  const hi = document.getElementById('headerAvatarImg');
  const hi2 = document.getElementById('headerAvatarIcon');
  const mhi = document.getElementById('mobileHeaderAvatarImg');
  const mhi2 = document.getElementById('mobileHeaderAvatarIcon');
  if (avatarUrl) {
    if(hi) { hi.src = avatarUrl; hi.classList.remove('hidden'); }
    if(hi2) hi2.classList.add('hidden');
    if(mhi) { mhi.src = avatarUrl; mhi.classList.remove('hidden'); }
    if(mhi2) mhi2.classList.add('hidden');
  } else {
    if(hi) hi.classList.add('hidden');
    if(hi2) hi2.classList.remove('hidden');
    if(mhi) mhi.classList.add('hidden');
    if(mhi2) mhi2.classList.remove('hidden');
  }
}

document.addEventListener('click', function(e) {
  const dd = document.getElementById('userDropdown');
  const mdd = document.getElementById('mobileUserDropdown');
  const btn = document.getElementById('profileBtn');
  if (dd && !dd.contains(e.target) && !btn.contains(e.target)) dd.classList.add('hidden');
  if (mdd && !e.target.closest('#mobileUserDropdown') && !e.target.closest('button[onclick="toggleMobileUserMenu()"]')) mdd.classList.add('hidden');
});

async function handleLogout() {
  if (confirm('¿Cerrar sesión?')) {
    await window.supabase.auth.signOut();
    localStorage.removeItem('ketocore_user_id');
    localStorage.removeItem('ketocore_user_email');
    localStorage.removeItem('ketocore_onboarding_done');
    window.location.href = '/app/welcome';
  }
}

updateHeaderAvatar();
</script>

</AppLayout>
