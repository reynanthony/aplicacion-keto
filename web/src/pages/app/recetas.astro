---
// Recetas — v3. Migra header/nav legacy a AppLayout+Dock limpio. Grid de
// recetas queda como cards custom (imagen/gradiente, no encaja en DataRow
// plano). Chips de categoría → Chip v3 real. Los 4 modales centrados
// (detalle/porciones/agregar-al-plan/crear) se consolidan en 2 Sheet: uno de
// detalle (con porciones y agregar-al-plan como secciones internas, no
// sheets separados) y uno de creación. Simplifica los 3 filtros sueltos
// (categoría/favoritos/para-hoy) en un solo estado `currentFilter`. Corrige
// el doble-import de keto-inspector-recetas-integration.js (antes se
// importaba dos veces, doble inicialización).
import AppLayout from '../../layouts/AppLayout.astro';
import Dock from '../../components/v3/Dock.astro';
import Sheet from '../../components/v3/Sheet.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Recetas" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
  </style>
  <style is:global>
    /* is:global a propósito: .rc-card* se construye vía innerHTML en JS, y el
       scope de Astro (atributo data-astro-cq) nunca llega al HTML inyectado
       dinámicamente — un <style> sin is:global simplemente no aplicaría. */
    .v3-field { background: var(--v3-surface-2); border: 1px solid var(--v3-border); border-radius: 12px; padding: 10px 12px; font-size: 14px; color: var(--v3-text); width: 100%; font-family: var(--v3-font-body); }
    .v3-field:focus { outline: none; border-color: var(--v3-lime); }
    .v3-field::placeholder { color: var(--v3-text-40); }
    .rc-card { position: relative; overflow: hidden; border-radius: var(--v3-radius-card); background: var(--v3-surface-1); border: 1px solid var(--v3-border); cursor: pointer; }
    .rc-card-img { height: 100px; display: flex; align-items: center; justify-content: center; position: relative; }
    .rc-card-fav { position: absolute; top: 8px; left: 8px; width: 30px; height: 30px; border-radius: 50%; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .rc-card-badge { position: absolute; top: 8px; right: 8px; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 3px 8px; border-radius: 100px; background: rgba(0,0,0,0.5); color: var(--v3-text); }
    .rc-card-body { padding: 12px; }
    .rc-card-title { font-size: 13px; font-weight: 700; color: var(--v3-text); margin-bottom: 8px; line-height: 1.25; min-height:32px; }
    .rc-card-macros { display: flex; gap: 10px; }
    .rc-card-macro-val { font-size: 12.5px; font-weight: 800; }
    .rc-card-macro-lbl { font-size: 8.5px; color: var(--v3-text-40); text-transform: uppercase; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:10px;">
        <div>
          <p class="v3-eyebrow" style="margin-bottom:6px;">Recetas · <span id="rcTotalCount">--</span> verificadas</p>
          <h1 style="font-family:var(--v3-font-title); font-weight:800; font-size:24px; color:var(--v3-text); line-height:1.15;">Cocina keto, sin adivinar</h1>
        </div>
        <button type="button" id="rcCreateBtn" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); flex-shrink:0; margin-top:24px;">
          <span class="material-symbols-outlined" style="font-size:16px">add</span>
        </button>
      </div>

      <div style="position:relative;">
        <span class="material-symbols-outlined" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--v3-text-40); font-size:18px;">search</span>
        <input id="rcSearchInput" type="text" class="v3-field" style="padding-left:38px;" placeholder="Buscar receta o ingrediente…">
      </div>

      <div class="v3-chip-group" id="rcFilterChips">
        <button type="button" class="v3-chip v3-chip--active" data-filter="all">Todas</button>
        <button type="button" class="v3-chip" data-filter="desayuno">Desayuno</button>
        <button type="button" class="v3-chip" data-filter="almuerzo">Almuerzo</button>
        <button type="button" class="v3-chip" data-filter="cena">Cena</button>
        <button type="button" class="v3-chip" data-filter="snacks">Snacks</button>
        <button type="button" class="v3-chip" data-filter="favorites">
          <span class="material-symbols-outlined" style="font-size:14px;">favorite</span> Favoritos
        </button>
        <button type="button" class="v3-chip" data-filter="macrofit">
          <span class="material-symbols-outlined" style="font-size:14px;">target</span> Para hoy
        </button>
      </div>

      <div id="rcGrid" style="display:grid; grid-template-columns:1fr 1fr; gap:10px;"></div>
      <div id="rcNoResults" class="hidden" style="text-align:center; padding:40px 0;">
        <span class="material-symbols-outlined" style="font-size:40px; color:var(--v3-text-40);">search_off</span>
        <p style="font-size:13px; color:var(--v3-text-40); margin-top:8px;">No se encontraron recetas</p>
      </div>

    </main>

    <VeredictoSheet />

    <Sheet id="v3-sheet-recipe" title="Receta" subtitle="">
      <div id="rcSheetBody"></div>
    </Sheet>

    <Sheet id="v3-sheet-create-recipe" title="Crear receta" subtitle="Se guarda solo en este dispositivo">
      <div style="display:flex; flex-direction:column; gap:10px;">
        <div>
          <label class="v3-eyebrow" style="display:block; margin-bottom:6px; font-size:10px;">Nombre</label>
          <input type="text" id="newRecipeName" class="v3-field" placeholder="Ej: Desayuno Keto">
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
          <div>
            <label class="v3-eyebrow" style="display:block; margin-bottom:6px; font-size:10px;">Categoría</label>
            <select id="newRecipeCategory" class="v3-field">
              <option value="desayuno">Desayuno</option>
              <option value="almuerzo">Almuerzo</option>
              <option value="cena">Cena</option>
              <option value="snacks">Snacks</option>
            </select>
          </div>
          <div>
            <label class="v3-eyebrow" style="display:block; margin-bottom:6px; font-size:10px;">Prep. (min)</label>
            <input type="number" id="newRecipeTime" class="v3-field" value="15" min="1">
          </div>
        </div>
        <div>
          <label class="v3-eyebrow" style="display:block; margin-bottom:6px; font-size:10px;">Instrucciones</label>
          <textarea id="newRecipeInstructions" class="v3-field" rows="3" placeholder="Describe la preparación..."></textarea>
        </div>
        <div>
          <label class="v3-eyebrow" style="display:block; margin-bottom:8px; font-size:10px;">Macros por porción</label>
          <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:6px;">
            <input type="number" id="newRecipeCalories" class="v3-field" style="text-align:center; padding:8px 4px;" placeholder="kcal" value="0" min="0">
            <input type="number" id="newRecipeProtein" class="v3-field" style="text-align:center; padding:8px 4px;" placeholder="Prot" value="0" min="0">
            <input type="number" id="newRecipeFat" class="v3-field" style="text-align:center; padding:8px 4px;" placeholder="Grasa" value="0" min="0">
            <input type="number" id="newRecipeCarbs" class="v3-field" style="text-align:center; padding:8px 4px;" placeholder="Carbs" value="0" min="0">
          </div>
        </div>
        <button type="button" id="rcSaveRecipeBtn" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); width:100%; justify-content:center;">Guardar receta</button>
      </div>
    </Sheet>

    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>
      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>
    <Dock active="yo" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/data-loader.js"></script>
  <script is:inline src="/app/data/recipe-details.js"></script>
  <script is:inline src="/app/modules/keto-inspector.js"></script>
  <script is:inline src="/app/modules/keto-inspector-recetas-integration.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    var RC_CAT = {
      desayuno: { color: 'var(--v3-amber)', icon: 'egg', label: 'Desayuno' },
      almuerzo: { color: 'var(--v3-lime)', icon: 'restaurant', label: 'Almuerzo' },
      cena:     { color: 'var(--v3-violet)', icon: 'dinner_dining', label: 'Cena' },
      snacks:   { color: '#f472b6', icon: 'cookie', label: 'Snacks' }
    };

    var recipesDB = [];
    var currentFilter = 'all'; // 'all' | 'desayuno' | 'almuerzo' | 'cena' | 'snacks' | 'favorites' | 'macrofit'
    var currentRecipeId = null;
    var currentServings = 1;

    function loadRecipes() {
      if (typeof KETO_RECIPES === 'undefined') { console.error('KETO_RECIPES no está definido'); return; }
      recipesDB = Object.keys(KETO_RECIPES).map(function (key) {
        var r = KETO_RECIPES[key];
        return {
          id: key, title: r.title, instructions: r.instructions ? r.instructions.join('. ') : '',
          difficulty: r.difficulty || 'facil', category: r.mealType || r.category,
          prepTime: parseInt(r.prepTime) || 15, calories: r.calories || 0, protein: r.protein || 0,
          fat: r.fat || 0, carbs: r.carbs || 0, source: 'local'
        };
      });
      renderRecipes();
    }

    function allRecipes() {
      return recipesDB.concat(safeParseJSON(localStorage.getItem('customRecipes'), []));
    }

    function getFavorites() {
      return safeParseJSON(localStorage.getItem('recipeFavorites'), []);
    }

    function toggleFavorite(id) {
      var favorites = getFavorites();
      var idx = favorites.indexOf(id);
      if (idx === -1) { favorites.push(id); showToast('Agregado a favoritos', 1500, 'success'); }
      else { favorites.splice(idx, 1); showToast('Eliminado de favoritos', 1500, 'info'); }
      localStorage.setItem('recipeFavorites', JSON.stringify(favorites));
      renderRecipes();
    }

    function getRemainingMacros() {
      var macros = safeParseJSON(localStorage.getItem('keto_macros'), {});
      var today = new Date().toISOString().slice(0, 10);
      var plan = safeParseJSON(localStorage.getItem('mealPlan_' + today), { desayuno: [], almuerzo: [], cena: [], snacks: [] });
      var consumed = { cal: 0, prot: 0, fat: 0, carbs: 0 };
      ['desayuno', 'almuerzo', 'cena', 'snacks'].forEach(function (m) {
        (plan[m] || []).forEach(function (item) {
          consumed.cal += parseFloat(item.calories || 0);
          consumed.prot += parseFloat(item.protein || 0);
          consumed.fat += parseFloat(item.fat || 0);
          consumed.carbs += parseFloat(item.carbs || 0);
        });
      });
      return {
        cal: Math.max(0, (parseInt(macros.calories) || 1800) - consumed.cal),
        prot: Math.max(0, (parseInt(macros.protein) || 160) - consumed.prot),
        fat: Math.max(0, (parseInt(macros.fat) || 150) - consumed.fat),
        carbs: Math.max(0, (parseInt(macros.carbs) || 25) - consumed.carbs)
      };
    }

    function passesFilter(r, favorites, remaining) {
      if (currentFilter === 'favorites') return favorites.indexOf(r.id) !== -1;
      if (currentFilter === 'macrofit') return !!remaining && (r.carbs || 0) <= remaining.carbs + 2 && (r.calories || 0) <= remaining.cal + 50;
      if (currentFilter !== 'all') return r.category === currentFilter;
      return true;
    }

    function renderRecipes() {
      var search = (document.getElementById('rcSearchInput').value || '').toLowerCase();
      var favorites = getFavorites();
      var remaining = currentFilter === 'macrofit' ? getRemainingMacros() : null;
      var all = allRecipes();

      var filtered = all.filter(function (r) {
        if (search && !r.title.toLowerCase().includes(search)) return false;
        return passesFilter(r, favorites, remaining);
      });

      document.getElementById('rcTotalCount').textContent = all.length;
      var grid = document.getElementById('rcGrid');
      var noResults = document.getElementById('rcNoResults');

      if (!filtered.length) {
        grid.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }
      noResults.classList.add('hidden');

      grid.innerHTML = filtered.map(function (recipe) {
        var cat = RC_CAT[recipe.category] || RC_CAT.snacks;
        var isFav = favorites.indexOf(recipe.id) !== -1;
        var fitsToday = remaining && (recipe.carbs || 0) <= remaining.carbs + 2 && (recipe.calories || 0) <= remaining.cal + 50;
        var html = '<div class="rc-card" data-recipe-id="' + recipe.id + '">';
        html += '<div class="rc-card-img" style="background:color-mix(in srgb, ' + cat.color + ' 18%, var(--v3-surface-2));">';
        html += '<span class="material-symbols-outlined" style="font-size:44px; color:' + cat.color + '; opacity:.9;">' + cat.icon + '</span>';
        html += '<span class="rc-card-fav" data-recipe-fav="' + recipe.id + '"><span class="material-symbols-outlined" style="font-size:16px; color:' + (isFav ? '#f472b6' : '#fff') + ';">' + (isFav ? 'favorite' : 'favorite_border') + '</span></span>';
        html += '<span class="rc-card-badge">' + recipe.prepTime + ' min</span>';
        if (fitsToday) html += '<span class="rc-card-badge" style="right:auto; left:8px; top:auto; bottom:8px; background:rgba(200,245,96,0.9); color:var(--v3-text-on-lime);">Cabe hoy</span>';
        html += '</div>';
        html += '<div class="rc-card-body">';
        html += '<div class="rc-card-title">' + escapeHtml(recipe.title) + '</div>';
        html += '<div class="rc-card-macros">';
        html += '<div><div class="rc-card-macro-val" style="color:var(--v3-lime);">' + recipe.carbs + 'g</div><div class="rc-card-macro-lbl">Carbs</div></div>';
        html += '<div><div class="rc-card-macro-val" style="color:var(--v3-amber);">' + recipe.protein + 'g</div><div class="rc-card-macro-lbl">Prot</div></div>';
        html += '<div><div class="rc-card-macro-val" style="color:var(--v3-violet);">' + recipe.fat + 'g</div><div class="rc-card-macro-lbl">Grasa</div></div>';
        html += '</div></div></div>';
        return html;
      }).join('');
    }

    function renderRecipeSheet(recipe) {
      var cat = RC_CAT[recipe.category] || RC_CAT.snacks;
      var favorites = getFavorites();
      var isFav = favorites.indexOf(recipe.id) !== -1;
      currentServings = 1;

      var html = '<div style="display:flex; align-items:center; gap:12px; margin-bottom:14px;">';
      html += '<div style="width:52px; height:52px; border-radius:14px; background:color-mix(in srgb, ' + cat.color + ' 18%, var(--v3-surface-2)); display:flex; align-items:center; justify-content:center; flex-shrink:0;"><span class="material-symbols-outlined" style="font-size:26px; color:' + cat.color + ';">' + cat.icon + '</span></div>';
      html += '<div style="flex:1;"><div style="font-family:var(--v3-font-title); font-weight:800; font-size:16px; color:var(--v3-text);">' + escapeHtml(recipe.title) + '</div>';
      html += '<div style="font-size:11.5px; color:var(--v3-text-40); margin-top:2px;">' + recipe.prepTime + ' min · ' + recipe.difficulty + '</div></div>';
      html += '<span data-recipe-fav="' + recipe.id + '" style="cursor:pointer;"><span class="material-symbols-outlined" style="color:' + (isFav ? '#f472b6' : 'var(--v3-text-40)') + ';">' + (isFav ? 'favorite' : 'favorite_border') + '</span></span>';
      html += '</div>';

      html += '<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:14px;" id="rcSheetMacros">';
      html += macroBox('rcAdjCalories', recipe.calories, 'kcal', 'var(--v3-amber)');
      html += macroBox('rcAdjProtein', recipe.protein, 'g Prot', 'var(--v3-orange-soft)');
      html += macroBox('rcAdjFat', recipe.fat, 'g Grasa', 'var(--v3-violet)');
      html += macroBox('rcAdjCarbs', recipe.carbs, 'g Carbs', 'var(--v3-lime)');
      html += '</div>';

      html += '<p style="font-size:12.5px; line-height:1.55; color:var(--v3-text-70); margin-bottom:16px;">' + escapeHtml(recipe.instructions || 'Sin instrucciones') + '</p>';

      html += '<div style="display:flex; gap:8px; margin-bottom:8px;">';
      html += '<button type="button" id="rcTogglePorciones" class="v3-decision-card-action" style="flex:1; background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;"><span class="material-symbols-outlined" style="font-size:16px">tune</span> Porciones</button>';
      html += '<button type="button" id="rcToggleAddPlan" class="v3-decision-card-action" style="flex:1; background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;"><span class="material-symbols-outlined" style="font-size:16px">add_circle</span> Agregar al plan</button>';
      html += '</div>';

      html += '<div id="rcPorcionesRow" class="hidden" style="display:flex; align-items:center; justify-content:center; gap:20px; padding:14px 0;">';
      html += '<button type="button" id="rcServingsMinus" style="width:38px; height:38px; border-radius:50%; background:var(--v3-surface-2); border:1px solid var(--v3-border); color:var(--v3-text); font-size:18px;">-</button>';
      html += '<span id="rcServingsCount" class="v3-num-mono" style="font-size:22px;">1</span>';
      html += '<button type="button" id="rcServingsPlus" style="width:38px; height:38px; border-radius:50%; background:var(--v3-surface-2); border:1px solid var(--v3-border); color:var(--v3-text); font-size:18px;">+</button>';
      html += '</div>';

      html += '<div id="rcAddPlanRow" class="hidden" style="display:grid; grid-template-columns:1fr 1fr; gap:8px; padding-top:6px;">';
      ['desayuno', 'almuerzo', 'cena', 'snacks'].forEach(function (m) {
        html += '<button type="button" data-add-to-plan="' + m + '" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">' + m.charAt(0).toUpperCase() + m.slice(1) + '</button>';
      });
      html += '</div>';

      document.getElementById('rcSheetBody').innerHTML = html;
    }

    function macroBox(id, val, unit, color) {
      return '<div style="background:var(--v3-surface-2); border-radius:12px; padding:10px 4px; text-align:center;">' +
        '<div id="' + id + '" class="v3-num-mono" style="font-size:15px; justify-content:center; color:' + color + ';">' + val + '</div>' +
        '<div style="font-size:8.5px; color:var(--v3-text-40); text-transform:uppercase; margin-top:2px;">' + unit + '</div></div>';
    }

    function openRecipeSheet(id) {
      var recipe = allRecipes().find(function (r) { return r.id === id; });
      if (!recipe) return;
      currentRecipeId = id;
      renderRecipeSheet(recipe);
      if (window.KetoSheet) window.KetoSheet.toggle('v3-sheet-recipe');
    }

    function updateServingsDisplay(recipe) {
      setText('rcServingsCount', currentServings);
      setText('rcAdjCalories', Math.round(recipe.calories * currentServings));
      setText('rcAdjProtein', Math.round(recipe.protein * currentServings));
      setText('rcAdjFat', Math.round(recipe.fat * currentServings));
      setText('rcAdjCarbs', Math.round(recipe.carbs * currentServings));
    }
    function setText(id, val) { var el = document.getElementById(id); if (el) el.textContent = val; }

    function addToMealPlan(meal) {
      var recipe = allRecipes().find(function (r) { return r.id === currentRecipeId; });
      if (!recipe) { showToast('Receta no encontrada', 2000, 'error'); return; }

      var today = new Date().toISOString().slice(0, 10);
      var planKey = 'mealPlan_' + today;
      var plan = safeParseJSON(localStorage.getItem(planKey), { desayuno: [], almuerzo: [], cena: [], snacks: [] });
      if (!plan[meal]) plan[meal] = [];

      plan[meal].push({
        id: recipe.id, name: recipe.title,
        calories: Math.round(recipe.calories * currentServings),
        protein: Math.round(recipe.protein * currentServings),
        fat: Math.round(recipe.fat * currentServings),
        carbs: Math.round(recipe.carbs * currentServings),
        servings: currentServings
      });
      localStorage.setItem(planKey, JSON.stringify(plan));
      if (window.KetoSheet) window.KetoSheet.toggle('v3-sheet-recipe');
      showToast('Agregado a ' + meal.charAt(0).toUpperCase() + meal.slice(1), 2000, 'success');
    }

    function saveRecipe() {
      var name = document.getElementById('newRecipeName').value.trim();
      if (!name) { showToast('Ingresa un nombre', 2000, 'error'); return; }

      var customRecipes = safeParseJSON(localStorage.getItem('customRecipes'), []);
      customRecipes.push({
        id: 'custom_' + Date.now(), title: name,
        category: document.getElementById('newRecipeCategory').value,
        prepTime: parseInt(document.getElementById('newRecipeTime').value) || 15,
        calories: parseInt(document.getElementById('newRecipeCalories').value) || 0,
        protein: parseInt(document.getElementById('newRecipeProtein').value) || 0,
        fat: parseInt(document.getElementById('newRecipeFat').value) || 0,
        carbs: parseInt(document.getElementById('newRecipeCarbs').value) || 0,
        instructions: document.getElementById('newRecipeInstructions').value.trim() || 'Sin instrucciones',
        difficulty: 'facil'
      });
      localStorage.setItem('customRecipes', JSON.stringify(customRecipes));
      if (window.KetoSheet) window.KetoSheet.toggle('v3-sheet-create-recipe');
      renderRecipes();
      showToast('Receta guardada', 2000, 'success');
    }

    document.addEventListener('DOMContentLoaded', function () {
      loadRecipes();

      document.getElementById('rcSearchInput').addEventListener('input', renderRecipes);
      document.getElementById('rcCreateBtn').addEventListener('click', function () {
        ['newRecipeName', 'newRecipeInstructions'].forEach(function (id) { document.getElementById(id).value = ''; });
        document.getElementById('newRecipeCategory').value = 'desayuno';
        document.getElementById('newRecipeTime').value = '15';
        ['newRecipeCalories', 'newRecipeProtein', 'newRecipeFat', 'newRecipeCarbs'].forEach(function (id) { document.getElementById(id).value = '0'; });
        if (window.KetoSheet) window.KetoSheet.toggle('v3-sheet-create-recipe');
      });
      document.getElementById('rcSaveRecipeBtn').addEventListener('click', saveRecipe);

      document.getElementById('rcFilterChips').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-filter]');
        if (!btn) return;
        currentFilter = btn.getAttribute('data-filter');
        document.querySelectorAll('#rcFilterChips .v3-chip').forEach(function (c) { c.classList.toggle('v3-chip--active', c === btn); });
        renderRecipes();
      });

      document.getElementById('rcGrid').addEventListener('click', function (e) {
        var favBtn = e.target.closest('[data-recipe-fav]');
        if (favBtn) { toggleFavorite(favBtn.getAttribute('data-recipe-fav')); return; }
        var card = e.target.closest('[data-recipe-id]');
        if (card) openRecipeSheet(card.getAttribute('data-recipe-id'));
      });

      document.getElementById('rcSheetBody').addEventListener('click', function (e) {
        var favBtn = e.target.closest('[data-recipe-fav]');
        if (favBtn) {
          toggleFavorite(favBtn.getAttribute('data-recipe-fav'));
          var recipe = allRecipes().find(function (r) { return r.id === currentRecipeId; });
          if (recipe) renderRecipeSheet(recipe);
          return;
        }
        if (e.target.closest('#rcTogglePorciones')) {
          document.getElementById('rcPorcionesRow').classList.toggle('hidden');
          document.getElementById('rcAddPlanRow').classList.add('hidden');
          return;
        }
        if (e.target.closest('#rcToggleAddPlan')) {
          document.getElementById('rcAddPlanRow').classList.toggle('hidden');
          document.getElementById('rcPorcionesRow').classList.add('hidden');
          return;
        }
        var recipe = allRecipes().find(function (r) { return r.id === currentRecipeId; });
        if (e.target.closest('#rcServingsMinus') && recipe) { currentServings = Math.max(0.5, currentServings - 0.5); updateServingsDisplay(recipe); return; }
        if (e.target.closest('#rcServingsPlus') && recipe) { currentServings = Math.min(10, currentServings + 0.5); updateServingsDisplay(recipe); return; }
        var planBtn = e.target.closest('[data-add-to-plan]');
        if (planBtn) addToMealPlan(planBtn.getAttribute('data-add-to-plan'));
      });
    });
  </script>
</AppLayout>
