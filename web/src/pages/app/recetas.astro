function closeRecipeModal(){
document.getElementById("recipeModal").classList.add("hidden");
document.getElementById("recipeModal").classList.remove("flex");
currentRecipeId=null;
}

function openMealPlanModal(id){
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===id});
if(!recipe)return;
currentRecipeId=id;
document.getElementById("mealPlanRecipeName").textContent=recipe.title;
document.getElementById("mealPlanModal").classList.remove("hidden");
document.getElementById("mealPlanModal").classList.add("flex");
closeRecipeModal();
}

function closeMealPlanModal(){
document.getElementById("mealPlanModal").classList.add("hidden");
document.getElementById("mealPlanModal").classList.remove("flex");
}

function addToMealPlan(meal){
if(!currentRecipeId)return;
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===currentRecipeId});
if(!recipe){showToast("Receta no encontrada");return;}

var today=new Date().toISOString().slice(0,10);
var planKey="mealPlan_"+today;
var plan=JSON.parse(localStorage.getItem(planKey)||'{"desayuno":[],"almuerzo":[],"cena":[],"snacks":[]}');
if(!plan[meal])plan[meal]=[];

var adjustedMacros=currentServings>1?{
calories:Math.round(recipe.calories*currentServings),
protein:Math.round(recipe.protein*currentServings),
fat:Math.round(recipe.fat*currentServings),
carbs:Math.round(recipe.carbs*currentServings)
}:{calories:recipe.calories,protein:recipe.protein,fat:recipe.fat,carbs:recipe.carbs};

plan[meal].push({
id:recipe.id,
name:recipe.title,
calories:adjustedMacros.calories,
protein:adjustedMacros.protein,
fat:adjustedMacros.fat,
carbs:adjustedMacros.carbs,
servings:currentServings,
image:recipe.image||""
});

localStorage.setItem(planKey,JSON.stringify(plan));
closeMealPlanModal();
showToast("Agregado a "+(meal.charAt(0).toUpperCase()+meal.slice(1)));
}

function openServingsModal(id){
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===id});
if(!recipe)return;
currentRecipeId=id;
currentServings=1;
currentRecipeMacros={calories:recipe.calories,protein:recipe.protein,fat:recipe.fat,carbs:recipe.carbs};
document.getElementById("servingsRecipeName").textContent=recipe.title;
document.getElementById("servingsCount").textContent=currentServings;
document.getElementById("adjustedCalories").textContent=recipe.calories;
document.getElementById("adjustedProtein").textContent=recipe.protein+"g";
document.getElementById("adjustedFat").textContent=recipe.fat+"g";
document.getElementById("adjustedCarbs").textContent=recipe.carbs+"g";
document.getElementById("servingsModal").classList.remove("hidden");
document.getElementById("servingsModal").classList.add("flex");
closeRecipeModal();
}

function closeServingsModal(){
document.getElementById("servingsModal").classList.add("hidden");
document.getElementById("servingsModal").classList.remove("flex");
}

function changeServings(delta){
currentServings=Math.max(0.5,Math.min(10,currentServings+delta));
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===currentRecipeId});
if(!recipe)return;
document.getElementById("servingsCount").textContent=currentServings;
document.getElementById("adjustedCalories").textContent=Math.round(recipe.calories*currentServings);
document.getElementById("adjustedProtein").textContent=Math.round(recipe.protein*currentServings)+"g";
document.getElementById("adjustedFat").textContent=Math.round(recipe.fat*currentServings)+"g";
document.getElementById("adjustedCarbs").textContent=Math.round(recipe.carbs*currentServings)+"g";
}

function confirmServings(){
currentRecipeMacros={
calories:parseInt(document.getElementById("adjustedCalories").textContent),
protein:parseInt(document.getElementById("adjustedProtein").textContent),
fat:parseInt(document.getElementById("adjustedFat").textContent),
carbs:parseInt(document.getElementById("adjustedCarbs").textContent)
};
closeServingsModal();
openMealPlanModal(currentRecipeId);
}

function openCreateRecipeModal(){
document.getElementById("newRecipeName").value="";
document.getElementById("newRecipeCategory").value="desayuno";
document.getElementById("newRecipeTime").value="15";
document.getElementById("newRecipeInstructions").value="";
document.getElementById("newRecipeCalories").value="0";
document.getElementById("newRecipeProtein").value="0";
document.getElementById("newRecipeFat").value="0";
document.getElementById("newRecipeCarbs").value="0";
document.getElementById("createRecipeModal").classList.remove("hidden");
document.getElementById("createRecipeModal").classList.add("flex");
}

function closeCreateRecipeModal(){
document.getElementById("createRecipeModal").classList.add("hidden");
document.getElementById("createRecipeModal").classList.remove("flex");
}

function saveRecipe(){
var name=document.getElementById("newRecipeName").value.trim();
var category=document.getElementById("newRecipeCategory").value;
var time=parseInt(document.getElementById("newRecipeTime").value)||15;
var instructions=document.getElementById("newRecipeInstructions").value.trim();
var calories=parseInt(document.getElementById("newRecipeCalories").value)||0;
var protein=parseInt(document.getElementById("newRecipeProtein").value)||0;
var fat=parseInt(document.getElementById("newRecipeFat").value)||0;
var carbs=parseInt(document.getElementById("newRecipeCarbs").value)||0;

if(!name){showToast("Ingresa un nombre");return;}

var customRecipes=JSON.parse(localStorage.getItem("customRecipes")||"[]");
customRecipes.push({
id:"custom_"+Date.now(),
title:name,
category:category,
prepTime:time,
calories:calories,
protein:protein,
fat:fat,
carbs:carbs,
image:"",
instructions:instructions||"Sin instrucciones",
difficulty:"easy"
});
localStorage.setItem("customRecipes",JSON.stringify(customRecipes));
closeCreateRecipeModal();
renderRecipes();
showToast("Receta guardada!");
}

function showToast(msg){
var toast=document.getElementById("toast");
if(!toast){
toast=document.createElement("div");
toast.id="toast";
toast.className="fixed bottom-24 left-1/2 -translate-x-1/2 z-[100] glass-card rounded-full px-6 py-3 flex items-center gap-3 shadow-lg transition-all duration-300";
toast.innerHTML='<span class="material-symbols-outlined text-primary">check_circle</span><span class="text-white font-medium"></span>';
document.body.appendChild(toast);
}
toast.querySelector("span:last-child").textContent=msg;
toast.style.opacity="1";
toast.style.transform="translateX(-50%) translateY(0)";
setTimeout(function(){
toast.style.opacity="0";
toast.style.transform="translateX(-50%) translateY(20px)";
},3000);
}

renderRecipes();
</script>

<script is:inline>
// User Dropdown Menu
function toggleUserMenu() {
  const dropdown = document.getElementById('userDropdown');
  dropdown.classList.toggle('hidden');
  updateDropdownInfo();
}

function toggleMobileUserMenu() {
  const dropdown = document.getElementById('mobileUserDropdown');
  dropdown.classList.toggle('hidden');
  updateDropdownInfo();
}

function updateDropdownInfo() {
  const profile = JSON.parse(localStorage.getItem('keto_profile') || '{}');
  const userName = profile.nombre || profile.name || 'Usuario';
  const userEmail = localStorage.getItem('ketocore_user_email') || 'usuario@ejemplo.com';
  const dn = document.getElementById('dropdownUserName');
  const de = document.getElementById('dropdownUserEmail');
  const mdn = document.getElementById('mobileDropdownUserName');
  const mde = document.getElementById('mobileDropdownUserEmail');
  if(dn) dn.textContent = userName;
  if(de) de.textContent = userEmail;
  if(mdn) mdn.textContent = userName;
  if(mde) mde.textContent = userEmail;
}

function updateHeaderAvatar() {
  const profile = JSON.parse(localStorage.getItem('keto_profile') || '{}');
  const avatarUrl = profile.avatar_url;
  const hi = document.getElementById('headerAvatarImg');
  const hi2 = document.getElementById('headerAvatarIcon');
  const mhi = document.getElementById('mobileHeaderAvatarImg');
  const mhi2 = document.getElementById('mobileHeaderAvatarIcon');
  if (avatarUrl) {
    if(hi) { hi.src = avatarUrl; hi.classList.remove('hidden'); }
    if(hi2) hi2.classList.add('hidden');
    if(mhi) { mhi.src = avatarUrl; mhi.classList.remove('hidden'); }
    if(mhi2) mhi2.classList.add('hidden');
  } else {
    if(hi) hi.classList.add('hidden');
    if(hi2) hi2.classList.remove('hidden');
    if(mhi) mhi.classList.add('hidden');
    if(mhi2) mhi2.classList.remove('hidden');
  }
}

document.addEventListener('click', function(e) {
  const dd = document.getElementById('userDropdown');
  const mdd = document.getElementById('mobileUserDropdown');
  const btn = document.getElementById('profileBtn');
  if (dd && !dd.contains(e.target) && !btn.contains(e.target)) dd.classList.add('hidden');
  if (mdd && !e.target.closest('#mobileUserDropdown') && !e.target.closest('button[onclick="toggleMobileUserMenu()"]')) mdd.classList.add('hidden');
});

async function handleLogout() {
  if (confirm('¿Cerrar sesión?')) {
    await window.supabase.auth.signOut();
    localStorage.removeItem('ketocore_user_id');
    localStorage.removeItem('ketocore_user_email');
    localStorage.removeItem('ketocore_onboarding_done');
    window.location.href = '/app/welcome';
  }
}

updateHeaderAvatar();
</script>
