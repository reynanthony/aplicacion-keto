---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Recetas" authGuard={true}>
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
.glass-card{background:rgba(22,19,16,0.8);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1)}
::-webkit-scrollbar{width:8px}
::-webkit-scrollbar-track{background:#131315}
::-webkit-scrollbar-thumb{background:#1e1a15;border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:#2a2a2a}
.shadow-glow{box-shadow:0 0 20px rgba(255,77,0,0.3)}
.shadow-glow-strong{box-shadow:0 0 30px rgba(255,77,0,0.5)}
/* Chips de categoría — rediseño */
.category-btn{border-radius:100px !important;padding:8px 16px !important;font-size:13px !important;font-weight:600 !important;background:#161310;border:1px solid rgba(255,240,225,0.08) !important;color:rgba(247,244,240,0.6);text-transform:none !important;letter-spacing:normal !important;transition:all .14s}
.category-btn:hover{color:#f7f4f0;border-color:rgba(255,240,225,0.18) !important}
.category-btn.active{background:#ff4d00 !important;border-color:#ff4d00 !important;color:#fff !important;font-weight:700 !important}
</style>
<header class="fixed top-0 left-0 right-0 z-40 h-14 px-4 flex items-center justify-between" style="background:rgba(19,19,21,0.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,240,225,0.06)">
  <a href="/app/" class="flex items-center gap-3" style="text-decoration:none">
    <img src="/app/logo.svg" alt="KetoCore" class="w-7 h-7" style="filter:drop-shadow(0 0 6px rgba(255,77,0,0.4))">
    <span class="text-base font-black tracking-tight" style="font-family:'Plus Jakarta Sans',sans-serif;color:#f7f4f0">KetoCore</span>
  </a>
  <div class="flex items-center gap-1.5">
    <button onclick="toggleMobileUserMenu()" aria-label="Mi cuenta" class="w-9 h-9 rounded-full flex items-center justify-center overflow-hidden" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06)">
      <img id="mobileHeaderAvatarImg" src="" class="hidden w-full h-full object-cover" alt="Avatar">
      <span id="mobileHeaderAvatarIcon" class="material-symbols-outlined" style="font-size:20px;color:rgba(247,244,240,0.6)">account_circle</span>
    </button>
    <button onclick="toggleHamburgerMenu()" aria-label="Abrir menú" class="w-9 h-9 rounded-full flex items-center justify-center" style="background:#1e1a15;color:rgba(247,244,240,0.6)">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:20px">menu</span>
    </button>
  </div>
</header>

<!-- Mobile User Dropdown -->
<div id="mobileUserDropdown" class="md:hidden fixed top-14 right-4 w-56 rounded-2xl overflow-hidden z-[80] hidden" style="background:#161310;border:1px solid rgba(255,240,225,0.07);box-shadow:0 8px 32px rgba(0,0,0,0.35)">
  <div class="p-3" style="border-bottom:1px solid rgba(255,240,225,0.06)">
    <p class="text-sm font-semibold" style="color:#f7f4f0" id="mobileDropdownUserName">Usuario</p>
    <p class="text-xs mt-0.5" style="color:rgba(247,244,240,0.55)" id="mobileDropdownUserEmail">email@example.com</p>
  </div>
  <div class="p-2">
    <a href="/app/perfil" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-orange-50" style="color:#f7f4f0">
      <span class="material-symbols-outlined text-lg" style="color:rgba(247,244,240,0.55)">person</span>
      <span class="text-sm font-medium">Mi Perfil</span>
    </a>
    <button onclick="handleLogout()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-red-50" style="color:#dc2626">
      <span class="material-symbols-outlined text-lg">logout</span>
      <span class="text-sm font-medium">Cerrar Sesión</span>
    </button>
  </div>
</div>
<main class="main-content pt-14 pb-20 min-h-screen" style="background:#131315">
<div class="space-y-8 kc-page" style="padding-top:12px">

<header style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:20px">
  <div>
    <div style="font-size:12px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00;margin-bottom:12px">Recetas · <span id="totalRecipesCount">--</span> verificadas</div>
    <h1 class="kc-h1">Cocina keto,<br>sin adivinar</h1>
  </div>
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <button onclick="openCreateRecipeModal()" class="kc-btn" style="height:46px"><span class="material-symbols-outlined" style="font-size:20px">add</span>Nueva receta</button>
  </div>
</header>

<section class="mb-8 flex flex-col gap-4">
<div class="relative" style="max-width:340px">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2" style="color:rgba(247,244,240,0.57);font-size:20px">search</span>
<input id="searchInput" oninput="filterRecipes()" style="width:100%;height:46px;padding:0 16px 0 46px;border-radius:14px;background:#161310;border:1px solid rgba(255,240,225,0.08);color:#f7f4f0;font-size:14px;outline:none" placeholder="Buscar receta o ingrediente…" type="text"/>
</div>
<div class="flex flex-wrap gap-2.5" id="categoryFilters">
<button onclick="setCategory('all')" class="category-btn active bg-primary-container text-white py-3 px-6 rounded-xl text-sm font-bold border border-transparent transition-colors" data-category="all">Todas</button>
<button onclick="setCategory('desayuno')" class="category-btn bg-surface-container-high py-3 px-6 rounded-xl text-sm font-bold border border-outline-variant/20 hover:border-primary-container/50 transition-colors" data-category="desayuno">Desayuno</button>
<button onclick="setCategory('almuerzo')" class="category-btn bg-surface-container-high py-3 px-6 rounded-xl text-sm font-bold border border-outline-variant/20 hover:border-primary-container/50 transition-colors" data-category="almuerzo">Almuerzo</button>
<button onclick="setCategory('cena')" class="category-btn bg-surface-container-high py-3 px-6 rounded-xl text-sm font-bold border border-outline-variant/20 hover:border-primary-container/50 transition-colors" data-category="cena">Cena</button>
<button onclick="setCategory('snacks')" class="category-btn bg-surface-container-high py-3 px-6 rounded-xl text-sm font-bold border border-outline-variant/20 hover:border-primary-container/50 transition-colors" data-category="snacks">Snacks</button>
<button onclick="showFavorites()" class="category-btn bg-surface-container-high py-3 px-6 rounded-xl text-sm font-bold border border-outline-variant/20 hover:border-primary-container/50 transition-colors" data-category="favorites">
<span class="material-symbols-outlined text-secondary" style="font-variation-settings:'FILL' 1">favorite</span>
Favoritos
</button>
<button onclick="showMacroFit()" id="btnParaHoy" class="category-btn bg-surface-container-high py-3 px-6 rounded-xl text-sm font-bold border border-outline-variant/20 hover:border-primary-container/50 transition-colors flex items-center gap-2" data-category="macrofit">
<span class="material-symbols-outlined text-green-400 text-base" style="font-variation-settings:'FILL' 1">target</span>
Para hoy
</button>
</div>
</section>

<div id="recipesGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4"></div>

<div id="noRecipes" class="hidden text-center py-20">
<span class="material-symbols-outlined text-6xl text-on-surface-variant/70 mb-4 block">search_off</span>
<p class="text-on-surface-variant text-lg">No se encontraron recetas</p>
</div>

</div>
</main>

<div id="recipeModal" class="fixed inset-0 z-[60] hidden">
<div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeRecipeModal()"></div>
<div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none overflow-y-auto">
<div class="bg-surface-container-low rounded-[2rem] w-full max-w-2xl max-h-[90vh] overflow-y-auto pointer-events-auto">
<div id="recipeModalContent"></div>
</div>
</div>
</div>

<div id="createRecipeModal" class="fixed inset-0 z-[80] hidden">
<div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeCreateRecipeModal()"></div>
<div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none overflow-y-auto">
<div class="glass-card rounded-3xl p-8 w-full max-w-lg max-h-[90vh] overflow-y-auto pointer-events-auto border border-primary-container/20">
<div class="flex justify-between items-center mb-6">
<h3 class="text-2xl font-headline font-black text-white">Crear Nueva Receta</h3>
<button onclick="closeCreateRecipeModal()" class="w-10 h-10 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-all"><span class="material-symbols-outlined text-lg">close</span></button>
</div>
<div class="space-y-6">
<div>
<label class="text-xs text-on-surface-variant uppercase tracking-wider block mb-2">Nombre de la receta</label>
<input type="text" id="newRecipeName" class="w-full bg-surface-container-high text-white border border-outline rounded-xl px-4 py-3 focus:outline-none focus:border-primary" placeholder="Ej: Desayuno Keto">
</div>
<div>
<label class="text-xs text-on-surface-variant uppercase tracking-wider block mb-2">Categoría</label>
<select id="newRecipeCategory" class="w-full bg-surface-container-high text-white border border-outline rounded-xl px-4 py-3 focus:outline-none focus:border-primary">
<option value="desayuno">Desayuno</option>
<option value="almuerzo">Almuerzo</option>
<option value="cena">Cena</option>
<option value="snacks">Snacks</option>
</select>
</div>
<div>
<label class="text-xs text-on-surface-variant uppercase tracking-wider block mb-2">Tiempo de preparación (min)</label>
<input type="number" id="newRecipeTime" class="w-full bg-surface-container-high text-white border border-outline rounded-xl px-4 py-3 focus:outline-none focus:border-primary" value="15" min="1">
</div>
<div>
<label class="text-xs text-on-surface-variant uppercase tracking-wider block mb-2">Instrucciones</label>
<textarea id="newRecipeInstructions" class="w-full bg-surface-container-high text-white border border-outline rounded-xl px-4 py-3 focus:outline-none focus:border-primary h-32" placeholder="Describe la preparación..."></textarea>
</div>
<div class="bg-surface-container-high rounded-xl p-4">
<p class="text-xs text-primary-container uppercase tracking-wider mb-3">Macros por porción</p>
<div class="grid grid-cols-4 gap-4">
<div><label class="text-[11px] text-on-surface-variant block mb-1">kcal</label><input type="number" id="newRecipeCalories" class="w-full bg-surface-container-low text-white border border-outline rounded-lg px-2 py-2 text-center" value="0" min="0"></div>
<div><label class="text-[11px] text-on-surface-variant block mb-1">Proteína</label><input type="number" id="newRecipeProtein" class="w-full bg-surface-container-low text-white border border-outline rounded-lg px-2 py-2 text-center" value="0" min="0"></div>
<div><label class="text-[11px] text-on-surface-variant block mb-1">Grasa</label><input type="number" id="newRecipeFat" class="w-full bg-surface-container-low text-white border border-outline rounded-lg px-2 py-2 text-center" value="0" min="0"></div>
<div><label class="text-[11px] text-on-surface-variant block mb-1">Carbs</label><input type="number" id="newRecipeCarbs" class="w-full bg-surface-container-low text-white border border-outline rounded-lg px-2 py-2 text-center" value="0" min="0"></div>
</div>
</div>
</div>
<div class="flex gap-3 mt-6">
<button onclick="closeCreateRecipeModal()" class="flex-1 py-4 rounded-xl bg-surface-container-high text-white font-medium hover:bg-surface-container-highest transition-colors">Cancelar</button>
<button onclick="saveRecipe()" class="flex-1 py-4 rounded-xl bg-primary-container text-white font-bold hover:opacity-90 transition-colors">Guardar</button>
</div>
</div>
</div>
</div>

<div id="mealPlanModal" class="fixed inset-0 z-[70] hidden">
<div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeMealPlanModal()"></div>
<div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
<div class="glass-card rounded-2xl p-6 w-full max-w-sm pointer-events-auto border border-primary-container/20">
<div class="flex justify-between items-center mb-6">
<h3 class="text-xl font-headline font-bold text-white">Agregar al Plan</h3>
<button onclick="closeMealPlanModal()" class="w-11 h-11 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-all"><span class="material-symbols-outlined text-lg">close</span></button>
</div>
<p id="mealPlanRecipeName" class="text-primary-container mb-4"></p>
<div class="space-y-3">
<button onclick="addToMealPlan('desayuno')" class="w-full py-4 rounded-xl bg-yellow-500/20 text-yellow-400 font-bold hover:bg-yellow-500/30 transition-colors flex items-center justify-center gap-2">
<span class="material-symbols-outlined">wb_sunny</span> Desayuno
</button>
<button onclick="addToMealPlan('almuerzo')" class="w-full py-4 rounded-xl bg-orange-500/20 text-orange-400 font-bold hover:bg-orange-500/30 transition-colors flex items-center justify-center gap-2">
<span class="material-symbols-outlined">light_mode</span> Almuerzo
</button>
<button onclick="addToMealPlan('cena')" class="w-full py-4 rounded-xl bg-purple-500/20 text-purple-400 font-bold hover:bg-purple-500/30 transition-colors flex items-center justify-center gap-2">
<span class="material-symbols-outlined">nightlight</span> Cena
</button>
<button onclick="addToMealPlan('snacks')" class="w-full py-4 rounded-xl bg-pink-500/20 text-pink-400 font-bold hover:bg-pink-500/30 transition-colors flex items-center justify-center gap-2">
<span class="material-symbols-outlined">cookie</span> Snacks
</button>
</div>
</div>
</div>
</div>

<div id="servingsModal" class="fixed inset-0 z-[75] hidden">
<div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeServingsModal()"></div>
<div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
<div class="glass-card rounded-2xl p-6 w-full max-w-sm pointer-events-auto border border-primary-container/20">
<div class="flex justify-between items-center mb-6">
<h3 class="text-xl font-headline font-bold text-white">Ajustar Porciones</h3>
<button onclick="closeServingsModal()" class="w-11 h-11 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-all"><span class="material-symbols-outlined text-lg">close</span></button>
</div>
<div class="text-center">
<p id="servingsRecipeName" class="text-white font-bold mb-4"></p>
<div class="flex items-center justify-center gap-6 mb-6">
<button onclick="changeServings(-1)" class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-white text-2xl hover:bg-primary-container transition-colors">-</button>
<span id="servingsCount" class="text-4xl font-black text-primary-container">1</span>
<button onclick="changeServings(1)" class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-white text-2xl hover:bg-primary-container transition-colors">+</button>
</div>
<div class="bg-surface-container-high rounded-xl p-4 mb-6">
<p class="text-xs text-on-surface-variant uppercase tracking-wider mb-2">Macros ajustados</p>
<div class="grid grid-cols-4 gap-4 text-center">
<div><span id="adjustedCalories" class="text-xl font-bold text-yellow-400">0</span><span class="text-[11px] text-on-surface-variant block">kcal</span></div>
<div><span id="adjustedProtein" class="text-xl font-bold text-orange-400">0g</span><span class="text-[11px] text-on-surface-variant block">Prot</span></div>
<div><span id="adjustedFat" class="text-xl font-bold text-yellow-300">0g</span><span class="text-[11px] text-on-surface-variant block">Grasa</span></div>
<div><span id="adjustedCarbs" class="text-xl font-bold text-cyan-400">0g</span><span class="text-[11px] text-on-surface-variant block">Carbs</span></div>
</div>
</div>
<button onclick="confirmServings()" class="w-full py-4 rounded-xl kinetic-gradient text-white font-black hover:opacity-90 transition-colors">Aplicar</button>
</div>
</div>
</div>
</div>

<script is:inline src="/app/utils.js"></script>
<script is:inline src="/app/data-loader.js"></script>
<script is:inline src="/app/data/recipe-details.js"></script>
<script is:inline src="/app/modules/keto-inspector.js"></script>
<script is:inline src="/app/modules/keto-inspector-recetas-integration.js"></script>
<script is:inline>
// Recetas de recipe-details.js (única fuente)
var recipesDB = [];

function loadRecipes() {
    console.log('[loadRecipes] Ejecutando, KETO_RECIPES existe:', typeof KETO_RECIPES !== 'undefined');
    if (typeof KETO_RECIPES !== 'undefined') {
        recipesDB = Object.keys(KETO_RECIPES).map(function(key) {
            var r = KETO_RECIPES[key];
            return {
                id: key,
                title: r.title,
                description: r.tips || '',
                instructions: r.instructions ? r.instructions.join('. ') : '',
                difficulty: r.difficulty || 'facil',
                category: r.mealType || r.category,
                prepTime: parseInt(r.prepTime) || 15,
                image: r.image || '',
                calories: r.calories || 0,
                protein: r.protein || 0,
                fat: r.fat || 0,
                carbs: r.carbs || 0,
                netCarbs: r.netCarbs || 0,
                fiber: r.fiber || 0,
                source: 'local'
            };
        });
        console.log('✅ Cargadas', recipesDB.length, 'recetas de recipe-details.js');
        renderRecipes();
        return true;
    }
    console.error('❌ KETO_RECIPES no está definido');
    return false;
}

// Ejecutar carga de recetas al iniciar
loadRecipes();

var currentCategory="all";
var showFavoritesOnly=false;
var showMacroFitOnly=false;

function getRemainingMacros(){
  var macros=safeParseJSON(localStorage.getItem('keto_macros'),{});
  var today=new Date().toISOString().slice(0,10);
  var plan=safeParseJSON(localStorage.getItem('mealPlan_'+today),{desayuno:[],almuerzo:[],cena:[],snacks:[]});
  var consumed={cal:0,prot:0,fat:0,carbs:0};
  ['desayuno','almuerzo','cena','snacks'].forEach(function(m){
    (plan[m]||[]).forEach(function(item){
      consumed.cal+=parseFloat(item.calories||0);
      consumed.prot+=parseFloat(item.protein||0);
      consumed.fat+=parseFloat(item.fat||0);
      consumed.carbs+=parseFloat(item.carbs||0);
    });
  });
  return {
    cal:Math.max(0,(parseInt(macros.calories)||1800)-consumed.cal),
    prot:Math.max(0,(parseInt(macros.protein)||160)-consumed.prot),
    fat:Math.max(0,(parseInt(macros.fat)||150)-consumed.fat),
    carbs:Math.max(0,(parseInt(macros.carbs)||25)-consumed.carbs)
  };
}

function showMacroFit(){
  showMacroFitOnly=true;
  showFavoritesOnly=false;
  currentCategory='all';
  document.querySelectorAll('.category-btn').forEach(function(btn){
    btn.classList.remove('bg-primary','bg-primary-container','text-white','active');
    btn.classList.add('bg-surface-container-high');
  });
  var btn=document.getElementById('btnParaHoy');
  if(btn){ btn.classList.add('bg-green-500/20','text-green-400','active'); btn.classList.remove('bg-surface-container-high'); }
  renderRecipes();
}
var currentRecipeId=null;
var currentServings=1;
var currentRecipeMacros={};

function getFavorites(){
var stored=localStorage.getItem("recipeFavorites");
if(stored){try{return JSON.parse(stored)}catch(e){}}
return[];
}

function toggleFavorite(id){
var favorites=getFavorites();
var idx=favorites.indexOf(id);
if(idx===-1){favorites.push(id);showToast("Agregado a favoritos")}else{favorites.splice(idx,1);showToast("Eliminado de favoritos")}
localStorage.setItem("recipeFavorites",JSON.stringify(favorites));
renderRecipes();
}

function setCategory(cat){
currentCategory=cat;
showFavoritesOnly=false;
showMacroFitOnly=false;
document.querySelectorAll(".category-btn").forEach(function(btn){
btn.classList.remove("bg-primary","text-white","active");
btn.classList.add("bg-surface-container");
});
event.target.closest(".category-btn").classList.add("bg-primary","text-white","active");
renderRecipes();
}

function showFavorites(){
showFavoritesOnly=true;
showMacroFitOnly=false;
currentCategory="all";
document.querySelectorAll(".category-btn").forEach(function(btn){
btn.classList.remove("bg-primary","text-white","active");
btn.classList.add("bg-surface-container");
});
renderRecipes();
}

function filterRecipes(){
renderRecipes();
}

function renderRecipes(){
var container=document.getElementById("recipesGrid");
var noRecipes=document.getElementById("noRecipes");
var search=document.getElementById("searchInput").value.toLowerCase();
var favorites=getFavorites();
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var remaining=showMacroFitOnly?getRemainingMacros():null;
var filtered=all.filter(function(r){
if(showFavoritesOnly&&favorites.indexOf(r.id)===-1)return false;
if(currentCategory!=="all"&&r.category!==currentCategory)return false;
if(search&&!r.title.toLowerCase().includes(search))return false;
if(showMacroFitOnly&&remaining){
  if((r.carbs||0)>remaining.carbs+2)return false;
  if((r.calories||0)>remaining.cal+50)return false;
}
return true;
});

if(filtered.length===0){
container.innerHTML="";
noRecipes.classList.remove("hidden");
return;
}
noRecipes.classList.add("hidden");

var html="";
filtered.forEach(function(recipe,i){
var isFavorite=favorites.indexOf(recipe.id)!==-1;
var isFirst=i===0&&!search&&!showFavoritesOnly&&currentCategory==="all";
var catColors={desayuno:"bg-yellow-500/20 text-yellow-400",almuerzo:"bg-orange-500/20 text-orange-400",cena:"bg-purple-500/20 text-purple-400",snacks:"bg-pink-500/20 text-pink-400"};
var catLabels={desayuno:"Desayuno",almuerzo:"Almuerzo",cena:"Cena",snacks:"Snacks"};
var catGradients={desayuno:"linear-gradient(135deg, #3a2410, #1e1509)",almuerzo:"linear-gradient(135deg, #0f2818, #0a1a10)",cena:"linear-gradient(135deg, #3a1810, #1e0d09)",snacks:"linear-gradient(135deg, #38162a, #200c17)"};
var catIconColors={desayuno:"#ff4d00",almuerzo:"#22c55e",cena:"#fb923c",snacks:"#f472b6"};
var catIcons={desayuno:"egg",almuerzo:"restaurant",cena:"dinner_dining",snacks:"cookie"};

html+='<article class="group relative overflow-hidden rounded-[2rem] '+(isFirst?"md:col-span-2 lg:col-span-2 xl:col-span-2":"")+' bg-surface-container transition-all duration-500 hover:shadow-[0_0_40px_rgba(255,144,105,0.1)] cursor-pointer" onclick="openRecipeModal(\''+recipe.id+'\')">';
html+='<div class="h-48 md:h-64 w-full overflow-hidden relative flex items-center justify-center" style="background:'+catGradients[recipe.category]+';">';
