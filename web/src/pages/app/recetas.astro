---
// Recetas — UI v2 (HUD nativo). Reescrito a markup kc-* real: hero, fila de
// KPIs (total / favoritas / para hoy / categorías) y grid de tarjetas con
// imagen. Modales (detalle, crear, plan, porciones) con panel kc-* propio.
// Lógica y datos intactos (recipe-details.js + inspector keto). Respaldo:
// recetas.astro.bak
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="Recetas" screen="recetas">
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}

/* KPIs */
.kc .rec-kpis .kc-stat__val{font-size:22px;line-height:26px}

/* Acciones */
.kc .rec-actions{display:flex;justify-content:flex-end}

/* Filtros */
.kc .rec-filters{display:flex;flex-wrap:wrap;gap:8px}
.kc .rec-chip{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;border-radius:var(--kc-radius-pill);background:var(--kc-surface-2);border:1px solid var(--kc-line);color:var(--kc-ink-2);font:600 13px var(--kc-font-sans);cursor:pointer;transition:background .15s,color .15s,border-color .15s}
.kc .rec-chip .material-symbols-outlined{font-size:16px}
.kc .rec-chip.is-active{background:var(--kc-amber-fill);color:var(--kc-on-amber);border-color:transparent}
.kc .rec-chip.is-fav.is-active{background:var(--kc-red);color:#fff}
.kc .rec-chip.is-fit.is-active{background:var(--kc-mint);color:var(--kc-bg)}

/* Grid de recetas */
.kc .rec-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.kc .rec-card{position:relative;background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-lg);overflow:hidden;cursor:pointer;transition:transform .18s var(--kc-ease)}
.kc .rec-card:active{transform:scale(.98)}
.kc .rec-card__media{position:relative;height:148px;display:flex;align-items:center;justify-content:center;overflow:hidden}
.kc .rec-card__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.kc .rec-card__media .material-symbols-outlined{position:relative;z-index:1;font-size:60px;opacity:.9}
.kc .rec-card__media[data-cat="desayuno"]{background:radial-gradient(120% 120% at 50% 0%,color-mix(in oklab,var(--kc-amber) 24%,transparent),transparent 65%),var(--kc-surface-2)}
.kc .rec-card__media[data-cat="desayuno"] .material-symbols-outlined{color:var(--kc-amber)}
.kc .rec-card__media[data-cat="almuerzo"]{background:radial-gradient(120% 120% at 50% 0%,color-mix(in oklab,var(--kc-mint) 24%,transparent),transparent 65%),var(--kc-surface-2)}
.kc .rec-card__media[data-cat="almuerzo"] .material-symbols-outlined{color:var(--kc-mint)}
.kc .rec-card__media[data-cat="cena"]{background:radial-gradient(120% 120% at 50% 0%,color-mix(in oklab,var(--kc-cyan) 24%,transparent),transparent 65%),var(--kc-surface-2)}
.kc .rec-card__media[data-cat="cena"] .material-symbols-outlined{color:var(--kc-cyan)}
.kc .rec-card__media[data-cat="snacks"]{background:radial-gradient(120% 120% at 50% 0%,color-mix(in oklab,var(--kc-red) 24%,transparent),transparent 65%),var(--kc-surface-2)}
.kc .rec-card__media[data-cat="snacks"] .material-symbols-outlined{color:var(--kc-red)}
.kc .rec-card__badges{position:absolute;top:8px;right:8px;z-index:2;display:flex;flex-direction:column;align-items:flex-end;gap:5px}
.kc .rec-card__pill{font:700 10px/1 var(--kc-font-mono);color:#fff;background:rgba(0,0,0,.45);backdrop-filter:blur(6px);padding:4px 8px;border-radius:var(--kc-radius-pill);display:flex;align-items:center;gap:4px;white-space:nowrap}
.kc .rec-card__pill .material-symbols-outlined{font-size:12px}
.kc .rec-card__fav{position:absolute;top:8px;left:8px;z-index:2;width:30px;height:30px;border:0;border-radius:50%;background:rgba(0,0,0,.45);backdrop-filter:blur(6px);display:grid;place-items:center;color:rgba(255,255,255,.7);cursor:pointer;padding:0}
.kc .rec-card__fav .material-symbols-outlined{font-size:17px}
.kc .rec-card__fav[data-fav="1"]{color:var(--kc-red)}
.kc .rec-card__body{padding:12px}
.kc .rec-card__title{font:700 14px/18px var(--kc-font-sans);color:var(--kc-ink);margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.kc .rec-card__macros{display:flex;align-items:center;gap:10px}
.kc .rec-card__macros div{display:flex;flex-direction:column}
.kc .rec-card__macros b{font:700 14px var(--kc-font-sans);color:var(--kc-ink)}
.kc .rec-card__macros span{font:600 9px/1.3 var(--kc-font-mono);letter-spacing:.05em;text-transform:uppercase;color:var(--kc-ink-3)}
.kc .rec-card__div{width:1px;height:22px;background:var(--kc-line-strong)}

/* Tarjeta destacada (primer resultado) */
.kc .rec-card--feat{grid-column:span 2}
.kc .rec-card--feat .rec-card__media{height:190px}

/* Estado vacío */
.kc .rec-empty{background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-md);padding:40px 20px;text-align:center}
.kc .rec-empty .material-symbols-outlined{font-size:44px;color:var(--kc-ink-3);opacity:.5}
.kc .rec-empty p{font:500 13px var(--kc-font-sans);color:var(--kc-ink-2);margin-top:10px}

/* Modales */
.kc .rec-modal{position:fixed;inset:0;z-index:60;align-items:center;justify-content:center;padding:16px}
.kc .rec-modal.hidden{display:none}
.kc .rec-modal.flex{display:flex}
.kc .rec-modal__scrim{position:absolute;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(4px)}
.kc .rec-modal__panel{position:relative;width:100%;max-width:560px;max-height:90dvh;overflow-y:auto;background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-xl);box-shadow:var(--kc-shadow-float)}
.kc .rec-modal__panel--sm{max-width:380px}
.kc .rec-modal__close{position:absolute;top:14px;right:14px;z-index:2;width:38px;height:38px;border-radius:50%;background:rgba(0,0,0,.45);backdrop-filter:blur(6px);border:0;color:#fff;display:grid;place-items:center;cursor:pointer;padding:0}
.kc .rec-modal__fav{position:absolute;top:14px;left:14px;z-index:2;width:38px;height:38px;border-radius:50%;background:rgba(0,0,0,.45);backdrop-filter:blur(6px);border:0;color:#fff;display:grid;place-items:center;cursor:pointer;padding:0}
.kc .rec-modal__media{height:210px;display:flex;align-items:center;justify-content:center;position:relative;border-radius:var(--kc-radius-xl) var(--kc-radius-xl) 0 0;overflow:hidden}
.kc .rec-modal__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.kc .rec-modal__media .material-symbols-outlined{position:relative;z-index:1;font-size:80px;opacity:.9}
.kc .rec-modal__body{padding:22px}
.kc .rec-mrow{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:18px}
.kc .rec-mrow .kc-label{display:flex;align-items:center;gap:6px}
.kc .rec-mrow .material-symbols-outlined{font-size:17px}
.kc .rec-macros{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:18px}
.kc .rec-mcell{background:var(--kc-surface-2);border-radius:var(--kc-radius-sm);padding:10px 6px;text-align:center}
.kc .rec-mcell b{display:block;font:700 18px var(--kc-font-sans);color:var(--kc-ink)}
.kc .rec-mcell span{font:600 10px var(--kc-font-mono);letter-spacing:.04em;text-transform:uppercase;color:var(--kc-ink-3)}

/* Stepper de porciones */
.kc .rec-stepper{display:flex;align-items:center;justify-content:center;gap:22px;margin:18px 0}
.kc .rec-stepper b{font:700 36px var(--kc-font-sans);color:var(--kc-amber);min-width:40px;text-align:center}
</style>

<div id="rec-wrap">

<!-- Hero -->
<div>
  <div class="kc-hero-sub">Recetas · <span id="totalRecipesCount">--</span> verificadas</div>
  <h1 class="kc-hero">Cocina keto,<br>sin <em>adivinar</em></h1>
</div>

<!-- KPIs -->
<div class="kc-grid rec-kpis">
  <div class="kc-stat kc-c-cyan"><div class="kc-stat__top"><span class="kc-label">Recetas</span></div><div class="kc-stat__val" id="kpiTotal">0</div></div>
  <div class="kc-stat kc-c-amber"><div class="kc-stat__top"><span class="kc-label">Favoritas</span></div><div class="kc-stat__val" id="kpiFavs">0</div></div>
  <div class="kc-stat kc-c-mint"><div class="kc-stat__top"><span class="kc-label">Para hoy</span></div><div class="kc-stat__val" id="kpiFit">0</div></div>
  <div class="kc-stat kc-c-amber">
    <div class="kc-stat__top"><span class="kc-label">Categorías</span></div>
    <div class="kc-stat__val"><span id="kpiCats">0</span><small>/4</small></div>
    <div class="kc-bar kc-c-amber"><i id="kpiCatsBar"></i></div>
  </div>
</div>

<!-- Acción -->
<div class="rec-actions">
  <button class="kc-btn kc-btn--primary kc-btn--sm" onclick="openCreateRecipeModal()"><span class="material-symbols-outlined" style="font-size:18px">add</span>Nueva receta</button>
</div>

<!-- Buscador -->
<div class="kc-search">
  <span class="material-symbols-outlined">search</span>
  <input id="searchInput" oninput="filterRecipes()" placeholder="Buscar receta o ingrediente…" type="text">
</div>

<!-- Filtros -->
<div class="rec-filters" id="categoryFilters">
  <button type="button" class="rec-chip is-active" onclick="setCategory('all')" data-category="all">Todas</button>
  <button type="button" class="rec-chip" onclick="setCategory('desayuno')" data-category="desayuno"><span class="material-symbols-outlined">egg</span>Desayuno</button>
  <button type="button" class="rec-chip" onclick="setCategory('almuerzo')" data-category="almuerzo"><span class="material-symbols-outlined">restaurant</span>Almuerzo</button>
  <button type="button" class="rec-chip" onclick="setCategory('cena')" data-category="cena"><span class="material-symbols-outlined">dinner_dining</span>Cena</button>
  <button type="button" class="rec-chip" onclick="setCategory('snacks')" data-category="snacks"><span class="material-symbols-outlined">cookie</span>Snacks</button>
  <button type="button" class="rec-chip is-fav" onclick="showFavorites()" data-category="favorites"><span class="material-symbols-outlined">favorite</span>Favoritos</button>
  <button type="button" class="rec-chip is-fit" onclick="showMacroFit()" id="btnParaHoy" data-category="macrofit"><span class="material-symbols-outlined">target</span>Para hoy</button>
</div>

<!-- Grid -->
<div id="recipesGrid" class="rec-grid"></div>

<!-- Vacío -->
<div id="noRecipes" class="rec-empty hidden">
  <span class="material-symbols-outlined">search_off</span>
  <p>No se encontraron recetas</p>
</div>

</div>

<!-- Modal detalle receta -->
<div id="recipeModal" class="rec-modal hidden">
  <div class="rec-modal__scrim" onclick="closeRecipeModal()"></div>
  <div class="rec-modal__panel">
    <div id="recipeModalContent"></div>
  </div>
</div>

<!-- Modal crear receta -->
<div id="createRecipeModal" class="rec-modal hidden">
  <div class="rec-modal__scrim" onclick="closeCreateRecipeModal()"></div>
  <div class="rec-modal__panel">
    <div class="kc-card__head" style="padding:22px 22px 0">
      <h3 class="kc-card__title">Crear nueva receta</h3>
      <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeCreateRecipeModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
    </div>
    <div style="padding:16px 22px 22px">
      <div class="kc-field">
        <label class="kc-label">Nombre de la receta</label>
        <input type="text" id="newRecipeName" class="kc-input" placeholder="Ej: Desayuno Keto">
      </div>
      <div class="kc-field-2" style="margin-bottom:12px">
        <div class="kc-field" style="margin-bottom:0">
          <label class="kc-label">Categoría</label>
          <select id="newRecipeCategory" class="kc-input">
            <option value="desayuno">Desayuno</option>
            <option value="almuerzo">Almuerzo</option>
            <option value="cena">Cena</option>
            <option value="snacks">Snacks</option>
          </select>
        </div>
        <div class="kc-field" style="margin-bottom:0">
          <label class="kc-label">Prep. (min)</label>
          <input type="number" id="newRecipeTime" class="kc-input" value="15" min="1">
        </div>
      </div>
      <div class="kc-field">
        <label class="kc-label">Instrucciones</label>
        <textarea id="newRecipeInstructions" class="kc-input" style="height:90px;padding-top:10px;resize:vertical" placeholder="Describe la preparación…"></textarea>
      </div>
      <div class="kc-label" style="margin-bottom:8px">Macros por porción</div>
      <div class="rec-macros" style="margin-bottom:18px">
        <div class="rec-mcell"><input type="number" id="newRecipeCalories" class="kc-input" style="height:40px;padding:0;text-align:center" value="0" min="0"><span>kcal</span></div>
        <div class="rec-mcell"><input type="number" id="newRecipeProtein" class="kc-input" style="height:40px;padding:0;text-align:center" value="0" min="0"><span>Prot</span></div>
        <div class="rec-mcell"><input type="number" id="newRecipeFat" class="kc-input" style="height:40px;padding:0;text-align:center" value="0" min="0"><span>Grasa</span></div>
        <div class="rec-mcell"><input type="number" id="newRecipeCarbs" class="kc-input" style="height:40px;padding:0;text-align:center" value="0" min="0"><span>Carbs</span></div>
      </div>
      <div style="display:flex;gap:10px">
        <button class="kc-btn kc-btn--secondary kc-btn--block" onclick="closeCreateRecipeModal()">Cancelar</button>
        <button class="kc-btn kc-btn--primary kc-btn--block" onclick="saveRecipe()">Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal agregar al plan -->
<div id="mealPlanModal" class="rec-modal hidden">
  <div class="rec-modal__scrim" onclick="closeMealPlanModal()"></div>
  <div class="rec-modal__panel rec-modal__panel--sm">
    <div class="kc-card__head" style="padding:20px 20px 0">
      <h3 class="kc-card__title">Agregar al plan</h3>
      <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeMealPlanModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
    </div>
    <p id="mealPlanRecipeName" class="kc-label" style="padding:6px 20px 0;font-size:13px"></p>
    <div style="padding:16px 20px 20px;display:flex;flex-direction:column;gap:8px">
      <button class="kc-btn kc-btn--secondary kc-btn--block" style="justify-content:flex-start" onclick="addToMealPlan('desayuno')"><span class="material-symbols-outlined" style="color:var(--kc-amber)">wb_sunny</span>Desayuno</button>
      <button class="kc-btn kc-btn--secondary kc-btn--block" style="justify-content:flex-start" onclick="addToMealPlan('almuerzo')"><span class="material-symbols-outlined" style="color:var(--kc-mint)">light_mode</span>Almuerzo</button>
      <button class="kc-btn kc-btn--secondary kc-btn--block" style="justify-content:flex-start" onclick="addToMealPlan('cena')"><span class="material-symbols-outlined" style="color:var(--kc-cyan)">nightlight</span>Cena</button>
      <button class="kc-btn kc-btn--secondary kc-btn--block" style="justify-content:flex-start" onclick="addToMealPlan('snacks')"><span class="material-symbols-outlined" style="color:var(--kc-red)">cookie</span>Snacks</button>
    </div>
  </div>
</div>

<!-- Modal porciones -->
<div id="servingsModal" class="rec-modal hidden">
  <div class="rec-modal__scrim" onclick="closeServingsModal()"></div>
  <div class="rec-modal__panel rec-modal__panel--sm">
    <div class="kc-card__head" style="padding:20px 20px 0">
      <h3 class="kc-card__title">Ajustar porciones</h3>
      <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeServingsModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
    </div>
    <div style="padding:6px 20px 20px;text-align:center">
      <p id="servingsRecipeName" class="kc-card__title" style="font-size:15px;margin-top:0"></p>
      <div class="rec-stepper">
        <button class="kc-btn kc-btn--secondary kc-btn--icon" onclick="changeServings(-1)" aria-label="Menos">−</button>
        <b id="servingsCount">1</b>
        <button class="kc-btn kc-btn--secondary kc-btn--icon" onclick="changeServings(1)" aria-label="Más">+</button>
      </div>
      <div class="rec-macros" style="margin-bottom:16px">
        <div class="rec-mcell"><b id="adjustedCalories">0</b><span>kcal</span></div>
        <div class="rec-mcell"><b id="adjustedProtein">0g</b><span>Prot</span></div>
        <div class="rec-mcell"><b id="adjustedFat">0g</b><span>Grasa</span></div>
        <div class="rec-mcell"><b id="adjustedCarbs">0g</b><span>Carbs</span></div>
      </div>
      <button class="kc-btn kc-btn--primary kc-btn--block" onclick="confirmServings()">Aplicar</button>
    </div>
  </div>
</div>

<Fragment slot="scripts">
<script is:inline src="/app/utils.js"></script>
<script is:inline src="/app/data-loader.js"></script>
<script is:inline src="/app/data/recipe-details.js"></script>
<script is:inline src="/app/modules/keto-inspector.js"></script>
<script is:inline src="/app/data/keto-inspector-ingredientes.js"></script>
<script is:inline src="/app/modules/inspectorKeto.js"></script>
<script is:inline src="/app/modules/keto-inspector-recetas-integration.js"></script>
<script is:inline>
// Recetas de recipe-details.js (única fuente)
var recipesDB = [];

function loadRecipes() {
    if (typeof KETO_RECIPES !== 'undefined') {
        recipesDB = Object.keys(KETO_RECIPES).map(function(key) {
            var r = KETO_RECIPES[key];
            return {
                id: key,
                title: r.title,
                description: r.tips || '',
                instructions: r.instructions ? r.instructions.join('. ') : '',
                difficulty: r.difficulty || 'facil',
                category: r.mealType || r.category,
                prepTime: parseInt(r.prepTime) || 15,
                image: r.image || '',
                calories: r.calories || 0,
                protein: r.protein || 0,
                fat: r.fat || 0,
                carbs: r.carbs || 0,
                netCarbs: r.netCarbs || 0,
                fiber: r.fiber || 0,
                source: 'local'
            };
        });
        renderRecipes();
        return true;
    }
    console.error('❌ KETO_RECIPES no está definido');
    return false;
}

loadRecipes();

var currentCategory="all";
var showFavoritesOnly=false;
var showMacroFitOnly=false;
var CAT_CLASS={desayuno:"kc-c-amber",almuerzo:"kc-c-mint",cena:"kc-c-cyan",snacks:"kc-c-red"};
var CAT_ICON={desayuno:"egg",almuerzo:"restaurant",cena:"dinner_dining",snacks:"cookie"};
var CAT_LABEL={desayuno:"Desayuno",almuerzo:"Almuerzo",cena:"Cena",snacks:"Snacks"};

function getRemainingMacros(){
  var macros=safeParseJSON(localStorage.getItem('keto_macros'),{});
  var today=new Date().toISOString().slice(0,10);
  var plan=safeParseJSON(localStorage.getItem('mealPlan_'+today),{desayuno:[],almuerzo:[],cena:[],snacks:[]});
  var consumed={cal:0,prot:0,fat:0,carbs:0};
  ['desayuno','almuerzo','cena','snacks'].forEach(function(m){
    (plan[m]||[]).forEach(function(item){
      consumed.cal+=parseFloat(item.calories||0);
      consumed.prot+=parseFloat(item.protein||0);
      consumed.fat+=parseFloat(item.fat||0);
      consumed.carbs+=parseFloat(item.carbs||0);
    });
  });
  return {
    cal:Math.max(0,(parseInt(macros.calories)||1800)-consumed.cal),
    prot:Math.max(0,(parseInt(macros.protein)||160)-consumed.prot),
    fat:Math.max(0,(parseInt(macros.fat)||150)-consumed.fat),
    carbs:Math.max(0,(parseInt(macros.carbs)||25)-consumed.carbs)
  };
}

function setActiveChip(category){
  document.querySelectorAll("#categoryFilters .rec-chip").forEach(function(btn){
    btn.classList.toggle("is-active", btn.dataset.category===category);
  });
}

function showMacroFit(){
  showMacroFitOnly=true;
  showFavoritesOnly=false;
  currentCategory='all';
  setActiveChip('macrofit');
  renderRecipes();
}

var currentRecipeId=null;
var currentServings=1;
var currentRecipeMacros={};

function getFavorites(){
var stored=localStorage.getItem("recipeFavorites");
if(stored){try{return JSON.parse(stored)}catch(e){}}
return[];
}

function toggleFavorite(id){
var favorites=getFavorites();
var idx=favorites.indexOf(id);
if(idx===-1){favorites.push(id);showToast("Agregado a favoritos")}else{favorites.splice(idx,1);showToast("Eliminado de favoritos")}
localStorage.setItem("recipeFavorites",JSON.stringify(favorites));
renderRecipes();
}

function setCategory(cat){
currentCategory=cat;
showFavoritesOnly=false;
showMacroFitOnly=false;
setActiveChip(cat);
renderRecipes();
}

function showFavorites(){
showFavoritesOnly=true;
showMacroFitOnly=false;
currentCategory="all";
setActiveChip('favorites');
renderRecipes();
}

function filterRecipes(){
renderRecipes();
}

function updateKpis(all,favorites,remaining){
document.getElementById("kpiTotal").textContent=all.length;
document.getElementById("kpiFavs").textContent=favorites.length;
var fit=all.filter(function(r){return (r.carbs||0)<=remaining.carbs+2&&(r.calories||0)<=remaining.cal+50}).length;
document.getElementById("kpiFit").textContent=fit;
var cats={};
all.forEach(function(r){if(r.category)cats[r.category]=true});
var catCount=Object.keys(cats).length;
document.getElementById("kpiCats").textContent=catCount;
document.getElementById("kpiCatsBar").style.width=(catCount/4*100)+"%";
}

function renderRecipes(){
var container=document.getElementById("recipesGrid");
var noRecipes=document.getElementById("noRecipes");
var search=document.getElementById("searchInput").value.toLowerCase();
var favorites=getFavorites();
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var remaining=getRemainingMacros();
updateKpis(all,favorites,remaining);

var filtered=all.filter(function(r){
if(showFavoritesOnly&&favorites.indexOf(r.id)===-1)return false;
if(currentCategory!=="all"&&r.category!==currentCategory)return false;
if(search&&!r.title.toLowerCase().includes(search))return false;
if(showMacroFitOnly){
  if((r.carbs||0)>remaining.carbs+2)return false;
  if((r.calories||0)>remaining.cal+50)return false;
}
return true;
});

if(filtered.length===0){
container.innerHTML="";
noRecipes.classList.remove("hidden");
return;
}
noRecipes.classList.add("hidden");

var html="";
filtered.forEach(function(recipe,i){
var isFavorite=favorites.indexOf(recipe.id)!==-1;
var isFeat=i===0&&!search&&!showFavoritesOnly&&!showMacroFitOnly&&currentCategory==="all";
var fitsToday=(recipe.carbs||0)<=remaining.carbs+2&&(recipe.calories||0)<=remaining.cal+50;

html+='<article class="rec-card'+(isFeat?" rec-card--feat":"")+'" onclick="openRecipeModal(\''+recipe.id+'\')">';
html+='<div class="rec-card__media" data-cat="'+recipe.category+'">';
if(recipe.image){
html+='<img loading="lazy" src="'+recipe.image+'" alt="'+recipe.title+'" onerror="this.style.display=\'none\'">';
}
html+='<span class="material-symbols-outlined">'+CAT_ICON[recipe.category]+'</span>';
html+='<div class="rec-card__badges">';
html+='<span class="rec-card__pill">'+CAT_LABEL[recipe.category]+'</span>';
if(fitsToday){html+='<span class="rec-card__pill" style="color:var(--kc-mint)"><span class="material-symbols-outlined">check_circle</span>Cabe hoy</span>';}
html+='<span class="rec-card__pill"><span class="material-symbols-outlined">schedule</span>'+recipe.prepTime+' min</span>';
html+='</div>';
html+='<button class="rec-card__fav" data-fav="'+(isFavorite?"1":"0")+'" onclick="event.stopPropagation();toggleFavorite(\''+recipe.id+'\')" aria-label="Favorito"><span class="material-symbols-outlined" style="font-variation-settings:\'FILL '+(isFavorite?"1":"0")+'\'">'+(isFavorite?"favorite":"favorite_border")+'</span></button>';
html+='</div>';
html+='<div class="rec-card__body">';
html+='<h3 class="rec-card__title">'+recipe.title+'</h3>';
html+='<div class="rec-card__macros">';
html+='<div><b>'+recipe.carbs+'g</b><span>Carbs</span></div>';
html+='<div class="rec-card__div"></div>';
html+='<div><b>'+recipe.protein+'g</b><span>Prot</span></div>';
html+='<div class="rec-card__div"></div>';
html+='<div><b>'+recipe.fat+'g</b><span>Grasa</span></div>';
html+='</div>';
html+='</div>';
html+='</article>';
});

container.innerHTML=html;
}

function openRecipeModal(id){
currentRecipeId=id;
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===id});
if(!recipe)return;
currentServings=1;
currentRecipeMacros={calories:recipe.calories,protein:recipe.protein,fat:recipe.fat,carbs:recipe.carbs};
var isFavorite=getFavorites().indexOf(recipe.id)!==-1;

var html='<div class="rec-modal__media" data-cat="'+recipe.category+'" style="border-radius:0">';
if(recipe.image){
html+='<img loading="lazy" src="'+recipe.image+'" alt="'+recipe.title+'" onerror="this.style.display=\'none\'">';
}
html+='<span class="material-symbols-outlined">'+CAT_ICON[recipe.category]+'</span>';
html+='</div>';
html+='<button class="rec-modal__close" onclick="closeRecipeModal()" aria-label="Cerrar"><span class="material-symbols-outlined">close</span></button>';
html+='<button class="rec-modal__fav" onclick="toggleFavorite(\''+recipe.id+'\')" aria-label="Favorito"><span class="material-symbols-outlined" style="font-variation-settings:\'FILL '+(isFavorite?"1":"0")+'\'">'+(isFavorite?"favorite":"favorite_border")+'</span></button>';
html+='<div class="rec-modal__body">';
html+='<h2 class="kc-card__title" style="font-size:24px;margin-top:0">'+recipe.title+'</h2>';
html+='<div class="rec-mrow">';
html+='<span class="kc-label"><span class="material-symbols-outlined">schedule</span>'+recipe.prepTime+' min</span>';
html+='<span class="kc-label"><span class="material-symbols-outlined">fitness_center</span>'+recipe.difficulty+'</span>';
html+='</div>';
html+='<div class="rec-macros">';
html+='<div class="rec-mcell"><b>'+recipe.calories+'</b><span>kcal</span></div>';
html+='<div class="rec-mcell"><b>'+recipe.protein+'g</b><span>Proteína</span></div>';
html+='<div class="rec-mcell"><b>'+recipe.fat+'g</b><span>Grasa</span></div>';
html+='<div class="rec-mcell"><b>'+recipe.carbs+'g</b><span>Carbs</span></div>';
html+='</div>';
html+='<div style="margin-bottom:20px">';
html+='<div class="kc-eyebrow" style="margin-bottom:8px">Instrucciones</div>';
html+='<p style="font:400 14px/1.6 var(--kc-font-sans);color:var(--kc-ink-2)">'+recipe.instructions+'</p>';
html+='</div>';
html+='<div style="display:flex;gap:10px">';
html+='<button class="kc-btn kc-btn--secondary kc-btn--block" onclick="openServingsModal(\''+recipe.id+'\')"><span class="material-symbols-outlined">tune</span>Porciones</button>';
html+='<button class="kc-btn kc-btn--primary kc-btn--block" onclick="openMealPlanModal(\''+recipe.id+'\')"><span class="material-symbols-outlined" style="font-variation-settings:\'FILL 1\'">add_circle</span>Agregar al plan</button>';
html+='</div>';
html+='</div>';

document.getElementById("recipeModalContent").innerHTML=html;
document.getElementById("recipeModal").classList.remove("hidden");
document.getElementById("recipeModal").classList.add("flex");
}

function closeRecipeModal(){
document.getElementById("recipeModal").classList.add("hidden");
document.getElementById("recipeModal").classList.remove("flex");
currentRecipeId=null;
}

function openMealPlanModal(id){
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===id});
if(!recipe)return;
currentRecipeId=id;
document.getElementById("mealPlanRecipeName").textContent=recipe.title;
document.getElementById("mealPlanModal").classList.remove("hidden");
document.getElementById("mealPlanModal").classList.add("flex");
closeRecipeModal();
}

function closeMealPlanModal(){
document.getElementById("mealPlanModal").classList.add("hidden");
document.getElementById("mealPlanModal").classList.remove("flex");
}

function addToMealPlan(meal){
if(!currentRecipeId)return;
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===currentRecipeId});
if(!recipe){showToast("Receta no encontrada");return;}

var today=new Date().toISOString().slice(0,10);
var planKey="mealPlan_"+today;
var plan=JSON.parse(localStorage.getItem(planKey)||'{"desayuno":[],"almuerzo":[],"cena":[],"snacks":[]}');
if(!plan[meal])plan[meal]=[];

var adjustedMacros=currentServings>1?{
calories:Math.round(recipe.calories*currentServings),
protein:Math.round(recipe.protein*currentServings),
fat:Math.round(recipe.fat*currentServings),
carbs:Math.round(recipe.carbs*currentServings)
}:{calories:recipe.calories,protein:recipe.protein,fat:recipe.fat,carbs:recipe.carbs};

plan[meal].push({
id:recipe.id,
name:recipe.title,
calories:adjustedMacros.calories,
protein:adjustedMacros.protein,
fat:adjustedMacros.fat,
carbs:adjustedMacros.carbs,
servings:currentServings,
image:recipe.image||""
});

localStorage.setItem(planKey,JSON.stringify(plan));
closeMealPlanModal();
showToast("Agregado a "+(meal.charAt(0).toUpperCase()+meal.slice(1)));
}

function openServingsModal(id){
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===id});
if(!recipe)return;
currentRecipeId=id;
currentServings=1;
currentRecipeMacros={calories:recipe.calories,protein:recipe.protein,fat:recipe.fat,carbs:recipe.carbs};
document.getElementById("servingsRecipeName").textContent=recipe.title;
document.getElementById("servingsCount").textContent=currentServings;
document.getElementById("adjustedCalories").textContent=recipe.calories;
document.getElementById("adjustedProtein").textContent=recipe.protein+"g";
document.getElementById("adjustedFat").textContent=recipe.fat+"g";
document.getElementById("adjustedCarbs").textContent=recipe.carbs+"g";
document.getElementById("servingsModal").classList.remove("hidden");
document.getElementById("servingsModal").classList.add("flex");
closeRecipeModal();
}

function closeServingsModal(){
document.getElementById("servingsModal").classList.add("hidden");
document.getElementById("servingsModal").classList.remove("flex");
}

function changeServings(delta){
currentServings=Math.max(0.5,Math.min(10,currentServings+delta));
var all=recipesDB.concat(JSON.parse(localStorage.getItem("customRecipes")||"[]"));
var recipe=all.find(function(r){return r.id===currentRecipeId});
if(!recipe)return;
document.getElementById("servingsCount").textContent=currentServings;
document.getElementById("adjustedCalories").textContent=Math.round(recipe.calories*currentServings);
document.getElementById("adjustedProtein").textContent=Math.round(recipe.protein*currentServings)+"g";
document.getElementById("adjustedFat").textContent=Math.round(recipe.fat*currentServings)+"g";
document.getElementById("adjustedCarbs").textContent=Math.round(recipe.carbs*currentServings)+"g";
}

function confirmServings(){
currentRecipeMacros={
calories:parseInt(document.getElementById("adjustedCalories").textContent),
protein:parseInt(document.getElementById("adjustedProtein").textContent),
fat:parseInt(document.getElementById("adjustedFat").textContent),
carbs:parseInt(document.getElementById("adjustedCarbs").textContent)
};
closeServingsModal();
openMealPlanModal(currentRecipeId);
}

function openCreateRecipeModal(){
document.getElementById("newRecipeName").value="";
document.getElementById("newRecipeCategory").value="desayuno";
document.getElementById("newRecipeTime").value="15";
document.getElementById("newRecipeInstructions").value="";
document.getElementById("newRecipeCalories").value="0";
document.getElementById("newRecipeProtein").value="0";
document.getElementById("newRecipeFat").value="0";
document.getElementById("newRecipeCarbs").value="0";
document.getElementById("createRecipeModal").classList.remove("hidden");
document.getElementById("createRecipeModal").classList.add("flex");
}

function closeCreateRecipeModal(){
document.getElementById("createRecipeModal").classList.add("hidden");
document.getElementById("createRecipeModal").classList.remove("flex");
}

function saveRecipe(){
var name=document.getElementById("newRecipeName").value.trim();
var category=document.getElementById("newRecipeCategory").value;
var time=parseInt(document.getElementById("newRecipeTime").value)||15;
var instructions=document.getElementById("newRecipeInstructions").value.trim();
var calories=parseInt(document.getElementById("newRecipeCalories").value)||0;
var protein=parseInt(document.getElementById("newRecipeProtein").value)||0;
var fat=parseInt(document.getElementById("newRecipeFat").value)||0;
var carbs=parseInt(document.getElementById("newRecipeCarbs").value)||0;

if(!name){showToast("Ingresa un nombre");return;}

var customRecipes=JSON.parse(localStorage.getItem("customRecipes")||"[]");
customRecipes.push({
id:"custom_"+Date.now(),
title:name,
category:category,
prepTime:time,
calories:calories,
protein:protein,
fat:fat,
carbs:carbs,
image:"",
instructions:instructions||"Sin instrucciones",
difficulty:"easy"
});
localStorage.setItem("customRecipes",JSON.stringify(customRecipes));
closeCreateRecipeModal();
renderRecipes();
showToast("Receta guardada!");
}

function showToast(msg){
var toast=document.getElementById("toast");
if(!toast){
toast=document.createElement("div");
toast.id="toast";
toast.style.cssText="position:fixed;bottom:calc(96px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%) translateY(20px);z-index:100;display:flex;align-items:center;gap:10px;padding:12px 20px;border-radius:var(--kc-radius-pill);background:var(--kc-surface-1);border:1px solid var(--kc-line-strong);box-shadow:var(--kc-shadow-float);font:600 13px var(--kc-font-sans);color:var(--kc-ink);opacity:0;transition:opacity .3s,transform .3s";
toast.innerHTML='<span class="material-symbols-outlined" style="color:var(--kc-mint)">check_circle</span><span></span>';
document.body.appendChild(toast);
}
toast.querySelector("span:last-child").textContent=msg;
toast.style.opacity="1";
toast.style.transform="translateX(-50%) translateY(0)";
setTimeout(function(){
toast.style.opacity="0";
toast.style.transform="translateX(-50%) translateY(20px)";
},3000);
}

renderRecipes();
</script>
