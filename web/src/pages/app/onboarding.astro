---
// Configuración inicial (carrusel de 5 pasos) — pre-login, sin AppShell.
// Retokenizado a tokens --kc-* del HUD, sobre AppLayout.
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Configuración Inicial" authGuard={false}>
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
@keyframes fadeInUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
.fade-in { animation: fadeInUp .4s ease-out forwards; }
.onb-icon { width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center; margin: 0 auto 24px; color: var(--c, var(--kc-ink-2)); background: color-mix(in oklab, var(--c, var(--kc-ink-2)) 16%, transparent); }
.onb-icon .material-symbols-outlined { font-size: 44px; }
.onb-list { text-align: left; display: flex; flex-direction: column; gap: 8px; margin-top: 16px; font: 500 13px/18px var(--kc-font-sans); color: var(--kc-ink-2); }
.onb-list li { display: flex; align-items: center; gap: 8px; list-style: none; }
.onb-list .material-symbols-outlined { font-size: 16px; color: var(--kc-mint); }
.dot { width: 8px; height: 8px; border-radius: 50%; transition: all .18s; }
.dot-active { background: var(--kc-amber); transform: scale(1.3); }
.dot-inactive { background: var(--kc-surface-3); }
/* Onboarding: sin sidebar ni bottom-nav. Misma correccion de especificidad
   que welcome.astro (ver comentario ahi) para ganarle a la regla de
   AppLayout.astro que activa el sidebar en desktop. */
html body #appSidebar, html body #kcTabbar, html body #kcDrawer { display: none !important; }
main { margin-left: 0 !important; }
</style>
<div class="kc kc-app" style="min-height:100dvh;display:flex;flex-direction:column">
<div class="flex-1 flex items-center justify-center p-6">
<div class="w-full max-w-md">

<div id="slide1" class="onboarding-step fade-in">
<div class="kc-card" style="text-align:center">
<div class="onb-icon kc-c-amber"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">nutrition</span></div>
<h1 class="kc-card__title" style="font-size:26px;margin-bottom:10px">Bienvenido a KetoCore</h1>
<p class="kc-label" style="font-size:16px;margin-bottom:10px">Tu compañero definitivo para la dieta keto</p>
<p class="kc-label" style="font-size:13px">Planificación de comidas, seguimiento de macros, workouts y más.</p>
</div>
</div>

<div id="slide2" class="onboarding-step hidden">
<div class="kc-card" style="text-align:center">
<div class="onb-icon kc-c-mint"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">restaurant_menu</span></div>
<h2 class="kc-card__title" style="font-size:22px;margin-bottom:10px">Planificación de Comidas</h2>
<p class="kc-label" style="margin-bottom:0">Genera planes de comida automáticamente basados en tu despensa y objetivos.</p>
<ul class="onb-list">
<li><span class="material-symbols-outlined">check_circle</span>Recetas keto optimizadas</li>
<li><span class="material-symbols-outlined">check_circle</span>Seguimiento de macros</li>
<li><span class="material-symbols-outlined">check_circle</span>Lista de compras automática</li>
</ul>
</div>
</div>

<div id="slide3" class="onboarding-step hidden">
<div class="kc-card" style="text-align:center">
<div class="onb-icon kc-c-cyan"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">fitness_center</span></div>
<h2 class="kc-card__title" style="font-size:22px;margin-bottom:10px">Entrenamientos Personalizados</h2>
<p class="kc-label" style="margin-bottom:0">Rutinas de ejercicios adaptadas a tu nivel y objetivos.</p>
<ul class="onb-list">
<li><span class="material-symbols-outlined">check_circle</span>Ejercicios para casa o gym</li>
<li><span class="material-symbols-outlined">check_circle</span>Seguimiento de progreso</li>
<li><span class="material-symbols-outlined">check_circle</span>Calorías quemadas</li>
</ul>
</div>
</div>

<div id="slide4" class="onboarding-step hidden">
<div class="kc-card" style="text-align:center">
<div class="onb-icon kc-c-red"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">medication</span></div>
<h2 class="kc-card__title" style="font-size:22px;margin-bottom:10px">Suplementos Recomendados</h2>
<p class="kc-label" style="margin-bottom:0">Sugerencias personalizadas según tu perfil y objetivos.</p>
<ul class="onb-list">
<li><span class="material-symbols-outlined">check_circle</span>Vitaminas y minerales</li>
<li><span class="material-symbols-outlined">check_circle</span>Electrolitos esenciales</li>
<li><span class="material-symbols-outlined">check_circle</span>Para rendimiento</li>
</ul>
</div>
</div>

<div id="slide5" class="onboarding-step hidden">
<div class="kc-card" style="text-align:center">
<div class="onb-icon kc-c-mint"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">check_circle</span></div>
<h2 class="kc-card__title" style="font-size:22px;margin-bottom:10px">¡Listo para empezar!</h2>
<p class="kc-label" style="margin-bottom:16px">Completa tu perfil y conoce cómo usar la app.</p>
<button onclick="completeOnboarding()" class="kc-btn kc-btn--primary kc-btn--block" style="margin-bottom:8px">Comenzar</button>
<a href="/app/guia" class="kc-link" style="display:block;text-align:center;padding:10px 0">Ver guía de uso →</a>
</div>
</div>

<div class="mt-8 flex justify-center gap-2">
<button onclick="goToSlide(1)" id="dot1" class="dot dot-active"></button>
<button onclick="goToSlide(2)" id="dot2" class="dot dot-inactive"></button>
<button onclick="goToSlide(3)" id="dot3" class="dot dot-inactive"></button>
<button onclick="goToSlide(4)" id="dot4" class="dot dot-inactive"></button>
<button onclick="goToSlide(5)" id="dot5" class="dot dot-inactive"></button>
</div>

<div class="mt-6 flex justify-between">
<button onclick="prevSlide()" id="prevBtn" class="kc-btn kc-btn--ghost hidden">Anterior</button>
<button onclick="nextSlide()" id="nextBtn" class="kc-btn kc-btn--secondary ml-auto">Siguiente</button>
</div>
</div>
</div>

<div class="p-6 text-center">
<button onclick="skipOnboarding()" class="kc-link" style="color:var(--kc-ink-3)">Saltar tour</button>
</div>
</div>

<script is:inline>
var currentSlide = 1;
var totalSlides = 5;

function updateDots() {
  for (var i = 1; i <= totalSlides; i++) {
    var dot = document.getElementById('dot' + i);
    dot.className = 'dot ' + (i === currentSlide ? 'dot-active' : 'dot-inactive');
  }
}

function showSlide(n) {
  for (var i = 1; i <= totalSlides; i++) {
    var slide = document.getElementById('slide' + i);
    if (slide) slide.classList.add('hidden');
  }
  var slide = document.getElementById('slide' + n);
  if (slide) {
    slide.classList.remove('hidden');
    slide.classList.add('fade-in');
  }

  var prevBtn = document.getElementById('prevBtn');
  var nextBtn = document.getElementById('nextBtn');
  if (n === 1) {
    prevBtn.classList.add('hidden');
  } else {
    prevBtn.classList.remove('hidden');
  }
  if (n === totalSlides) {
    nextBtn.classList.add('hidden');
  } else {
    nextBtn.classList.remove('hidden');
  }

  updateDots();
}

function nextSlide() {
  if (currentSlide < totalSlides) {
    currentSlide++;
    showSlide(currentSlide);
  }
}

function prevSlide() {
  if (currentSlide > 1) {
    currentSlide--;
    showSlide(currentSlide);
  }
}

function goToSlide(n) {
  currentSlide = n;
  showSlide(currentSlide);
}

function completeOnboarding() {
  localStorage.setItem('ketocore_onboarding_done', 'true');
  window.location.href = '/app/';
}

function skipOnboarding() {
  localStorage.setItem('ketocore_onboarding_done', 'true');
  window.location.href = '/app/';
}

if (localStorage.getItem('ketocore_onboarding_done')) {
  window.location.href = '/app/';
}
</script>

</AppLayout>
