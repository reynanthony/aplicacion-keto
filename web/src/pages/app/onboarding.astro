---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Configuración Inicial" authGuard={false}>
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
.glass-card{background:rgba(22,22,22,0.7);backdrop-filter:blur(20px);border:1px solid rgba(255,77,0,0.1)}
.onboarding-card{background:linear-gradient(135deg,rgba(255,77,0,0.15) 0%,rgba(22,22,22,0.7) 100%)}
.dot-active{background:#ff4d00;transform:scale(1.3)}
.dot-inactive{background:#484847}
</style>
<div class="flex-1 flex items-center justify-center p-6">
<div class="w-full max-w-md">
<div id="slide1" class="onboarding-step fade-in">
<div class="glass-card rounded-3xl p-8 text-center">
<div class="w-24 h-24 rounded-full bg-primary-container/20 flex items-center justify-center mx-auto mb-6">
<span class="material-symbols-outlined text-5xl text-primary-container" style="font-variation-settings:'FILL' 1">nutrition</span>
</div>
<h1 class="text-3xl font-headline font-bold text-white mb-3">Bienvenido a KetoCore</h1>
<p class="text-on-surface-variant text-lg mb-6">Tu compañero definitivo para la dieta keto</p>
<p class="text-white/60 text-sm">Planificación de comidas, seguimiento de macros, workouts y más.</p>
</div>
</div>

<div id="slide2" class="onboarding-step hidden">
<div class="glass-card rounded-3xl p-8 text-center">
<div class="w-24 h-24 rounded-full bg-yellow-500/20 flex items-center justify-center mx-auto mb-6">
<span class="material-symbols-outlined text-5xl text-yellow-400" style="font-variation-settings:'FILL' 1">restaurant_menu</span>
</div>
<h2 class="text-2xl font-headline font-bold text-white mb-3">Planificación de Comidas</h2>
<p class="text-on-surface-variant mb-4">Genera planes de comida automáticamente basados en tu despensa y objetivos.</p>
<ul class="text-left text-on-surface-variant/70 text-sm space-y-2">
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Recetas keto optimizadas</li>
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Seguimiento de macros</li>
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Lista de compras automática</li>
</ul>
</div>
</div>

<div id="slide3" class="onboarding-step hidden">
<div class="glass-card rounded-3xl p-8 text-center">
<div class="w-24 h-24 rounded-full bg-blue-500/20 flex items-center justify-center mx-auto mb-6">
<span class="material-symbols-outlined text-5xl text-blue-400" style="font-variation-settings:'FILL' 1">fitness_center</span>
</div>
<h2 class="text-2xl font-headline font-bold text-white mb-3">Entrenamientos Personalizados</h2>
<p class="text-on-surface-variant mb-4">Rutinas de ejercicios adaptadas a tu nivel y objetivos.</p>
<ul class="text-left text-on-surface-variant/70 text-sm space-y-2">
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Ejercicios para casa o gym</li>
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Seguimiento de progreso</li>
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Calorías quemadas</li>
</ul>
</div>
</div>

<div id="slide4" class="onboarding-step hidden">
<div class="glass-card rounded-3xl p-8 text-center">
<div class="w-24 h-24 rounded-full bg-purple-500/20 flex items-center justify-center mx-auto mb-6">
<span class="material-symbols-outlined text-5xl text-purple-400" style="font-variation-settings:'FILL' 1">medication</span>
</div>
<h2 class="text-2xl font-headline font-bold text-white mb-3">Suplementos Recomendados</h2>
<p class="text-on-surface-variant mb-4">Sugerencias personalizadas según tu perfil y objetivos.</p>
<ul class="text-left text-on-surface-variant/70 text-sm space-y-2">
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Vitaminas y minerales</li>
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Electrolitos esenciales</li>
<li class="flex items-center gap-2"><span class="material-symbols-outlined text-green-400 text-sm">check_circle</span> Para rendimiento</li>
</ul>
</div>
</div>

<div id="slide5" class="onboarding-step hidden">
<div class="glass-card rounded-3xl p-8 text-center">
<div class="w-24 h-24 rounded-full bg-green-500/20 flex items-center justify-center mx-auto mb-6">
<span class="material-symbols-outlined text-5xl text-green-400" style="font-variation-settings:'FILL' 1">check_circle</span>
</div>
<h2 class="text-2xl font-headline font-bold text-white mb-3">¡Listo para empezar!</h2>
<p class="text-on-surface-variant mb-4">Completa tu perfil y conoce cómo usar la app.</p>
<button onclick="completeOnboarding()" class="w-full py-4 rounded-xl bg-primary-container text-white font-bold text-lg hover:bg-primary-container/80 transition-all mb-3">Comenzar</button>
<a href="/app/guia" class="block py-3 text-primary-container text-sm font-medium hover:underline">Ver guía de uso →</a>
</div>
</div>

<div class="mt-8 flex justify-center gap-2">
<button onclick="goToSlide(1)" id="dot1" class="dot w-3 h-3 rounded-full dot-active transition-all"></button>
<button onclick="goToSlide(2)" id="dot2" class="dot w-3 h-3 rounded-full dot-inactive transition-all"></button>
<button onclick="goToSlide(3)" id="dot3" class="dot w-3 h-3 rounded-full dot-inactive transition-all"></button>
<button onclick="goToSlide(4)" id="dot4" class="dot w-3 h-3 rounded-full dot-inactive transition-all"></button>
<button onclick="goToSlide(5)" id="dot5" class="dot w-3 h-3 rounded-full dot-inactive transition-all"></button>
</div>

<div class="mt-6 flex justify-between">
<button onclick="prevSlide()" id="prevBtn" class="px-6 py-2 rounded-xl text-on-surface-variant hover:text-white transition-colors hidden">Anterior</button>
<button onclick="nextSlide()" id="nextBtn" class="px-6 py-2 rounded-xl bg-surface-container-high text-white font-medium hover:bg-surface-container-highest transition-all ml-auto">Siguiente</button>
</div>
</div>
</div>

<div class="p-6 text-center">
<button onclick="skipOnboarding()" class="text-on-surface-variant text-sm hover:text-white transition-colors">Saltar tour</button>
</div>

<script is:inline>
var currentSlide = 1;
var totalSlides = 5;

function updateDots() {
  for (var i = 1; i <= totalSlides; i++) {
    var dot = document.getElementById('dot' + i);
    if (i === currentSlide) {
      dot.className = 'dot w-3 h-3 rounded-full dot-active transition-all';
    } else {
      dot.className = 'dot w-3 h-3 rounded-full dot-inactive transition-all';
    }
  }
}

function showSlide(n) {
  for (var i = 1; i <= totalSlides; i++) {
    var slide = document.getElementById('slide' + i);
    if (slide) slide.classList.add('hidden');
  }
  var slide = document.getElementById('slide' + n);
  if (slide) {
    slide.classList.remove('hidden');
    slide.classList.add('fade-in');
  }
  
  var prevBtn = document.getElementById('prevBtn');
  var nextBtn = document.getElementById('nextBtn');
  if (n === 1) {
    prevBtn.classList.add('hidden');
  } else {
    prevBtn.classList.remove('hidden');
  }
  if (n === totalSlides) {
    nextBtn.classList.add('hidden');
  } else {
    nextBtn.classList.remove('hidden');
  }
  
  updateDots();
}

function nextSlide() {
  if (currentSlide < totalSlides) {
    currentSlide++;
    showSlide(currentSlide);
  }
}

function prevSlide() {
  if (currentSlide > 1) {
    currentSlide--;
    showSlide(currentSlide);
  }
}

function goToSlide(n) {
  currentSlide = n;
  showSlide(currentSlide);
}

function completeOnboarding() {
  localStorage.setItem('ketocore_onboarding_done', 'true');
  window.location.href = '/app/';
}

function skipOnboarding() {
  localStorage.setItem('ketocore_onboarding_done', 'true');
  window.location.href = '/app/';
}

if (localStorage.getItem('ketocore_onboarding_done')) {
  window.location.href = '/app/';
}
</script>

</AppLayout>
