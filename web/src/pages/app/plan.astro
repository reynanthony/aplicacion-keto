function initPlanStatus() {
  var weekPlan = typeof loadWeeklyPlan === 'function' ? loadWeeklyPlan() : null;
  var btnVer = document.getElementById('btnVerPlanSemanal');
  var badge = document.getElementById('planStatusBadge');
  var banner = document.getElementById('activePlanBanner');
  
  if (weekPlan) {
    var isConfirmed = weekPlan.confirmed || false;
    var generatedDate = weekPlan.generatedAt ? new Date(weekPlan.generatedAt).toLocaleDateString('es-ES', {day:'numeric', month:'short'}) : '';
    
    if (btnVer) btnVer.classList.remove('hidden');
    
    if (badge) {
      badge.classList.remove('hidden');
      if (isConfirmed) {
        badge.className = 'px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1 bg-green-500/20 text-green-400 border border-green-500/30';
        badge.innerHTML = '<span class="material-symbols-outlined text-sm">check_circle</span>Plan Activo';
      } else {
        badge.className = 'px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1 bg-yellow-500/20 text-yellow-400 border border-yellow-500/30';
        badge.innerHTML = '<span class="material-symbols-outlined text-sm">schedule</span>Sin Confirmar';
      }
    }
    
    if (banner && isConfirmed) {
      banner.classList.remove('hidden');
      banner.innerHTML = '<div class="flex items-center gap-3">' +
        '<div class="w-10 h-10 rounded-full bg-green-500/20 flex items-center justify-center">' +
          '<span class="material-symbols-outlined text-green-400">calendar_today</span>' +
        '</div>' +
        '<div class="flex-1">' +
          '<p class="font-bold text-white">Plan Semanal Activo</p>' +
          '<p class="text-xs text-on-surface-variant">Generado el ' + generatedDate + ' - ' + (weekPlan.totalMacros.calories / 7).toFixed(0) + ' kcal/dia promedio</p>' +
        '</div>' +
        '<button onclick="openWeeklyPlanPreview()" class="px-4 py-2 rounded-lg bg-green-500/20 text-green-400 text-xs font-bold hover:bg-green-500/30 transition-all">Ver Plan</button>' +
      '</div>';
    }
  } else {
    if (badge) {
      badge.classList.add('hidden');
    }
    if (banner) {
      banner.classList.add('hidden');
    }
    if (btnVer) {
      btnVer.classList.add('hidden');
    }
  }
}

function checkExistingWeeklyPlan() {
  var weekPlan = typeof loadWeeklyPlan === 'function' ? loadWeeklyPlan() : null;
  var btnVer = document.getElementById('btnVerPlanSemanal');
  if (weekPlan && btnVer) {
    btnVer.classList.remove('hidden');
