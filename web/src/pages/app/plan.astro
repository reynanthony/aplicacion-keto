function confirmShoppingAndApplyPlan() {
  var weekPlan = typeof loadWeeklyPlan === 'function' ? loadWeeklyPlan() : null;
  if (!weekPlan) return;
  
  var despensa = getDespensa();
  var shoppingList = weekPlan.shoppingList || {};
  
  Object.keys(shoppingList).forEach(function(foodId) {
    var item = shoppingList[foodId];
    var quantity = item.toBuy || item.quantity || 0;
    if (quantity > 0) {
      despensa[foodId] = {
        name: item.name,
        stock: quantity,
        unit: item.unit || 'g',
        category: item.category || 'comprado',
        addedAt: new Date().toISOString(),
        macros: item.macros || {}
      };
    }
  });
  
  localStorage.setItem('despensa', JSON.stringify(despensa));
  console.log('[confirmShoppingAndApplyPlan] Agregados a despensa:', Object.keys(despensa).length, 'ingredientes');
  
  weekPlan.confirmed = true;
  weekPlan.confirmedAt = new Date().toISOString();
  
  if (typeof saveWeeklyPlan === 'function') {
    saveWeeklyPlan(weekPlan);
  }
  
  // Asignar plan semanal a cada día
  assignWeeklyPlanToDays(weekPlan);
  
  closeShoppingConfirmation();
  closeWeeklyPlanPreview();
  
  var successModal = document.createElement('div');
  successModal.id = 'successModal';
  successModal.className = 'fixed inset-0 z-[95] flex items-center justify-center bg-black/80 backdrop-blur-sm';
  successModal.innerHTML = '<div class="text-center max-w-sm mx-auto px-6">' +
    '<div class="w-24 h-24 mx-auto mb-6 rounded-full bg-green-500/20 flex items-center justify-center animate-pulse">' +
      '<span class="material-symbols-outlined text-green-400 text-6xl" style="font-variation-settings:\'FILL\' 1">check_circle</span>' +
    '</div>' +
    '<h3 class="text-2xl font-headline font-bold text-white mb-3">¡Plan Activado!</h3>' +
    '<p class="text-on-surface-variant mb-6">Tu plan semanal esta listo. Los ingredientes estan en tu despensa.</p>' +
    '<div class="bg-surface-container-high rounded-xl p-4 mb-6 text-left">' +
      '<p class="text-xs text-on-surface-variant mb-2">Resumen:</p>' +
      '<div class="grid grid-cols-2 gap-3 text-center">' +
        '<div><p class="text-2xl font-bold text-yellow-400">' + (weekPlan.totalMacros.calories / 7).toFixed(0) + '</p><p class="text-xs text-on-surface-variant">kcal/dia</p></div>' +
        '<div><p class="text-2xl font-bold text-cyan-400">' + (weekPlan.totalMacros.netCarbs / 7).toFixed(0) + 'g</p><p class="text-xs text-on-surface-variant">carbos netos</p></div>' +
      '</div>' +
    '</div>' +
    '<p class="text-sm text-on-surface-variant">El plan estara visible en tu calendario diario.</p>' +
  '</div>';
  document.body.appendChild(successModal);
  
  setTimeout(function() {
    var modal = document.getElementById('successModal');
    if (modal) modal.remove();
    initPlanStatus();
  }, 3500);
}

function showWeeklyPlanToast(message) {
  var toast = document.getElementById('weeklyPlanToast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'weeklyPlanToast';
    toast.className = 'fixed bottom-24 left-1/2 -translate-x-1/2 z-[90] transition-all duration-300';
    toast.innerHTML = '<div class="glass-card rounded-full px-6 py-3 flex items-center gap-3 shadow-lg">' +
      '<span class="material-symbols-outlined text-secondary">check_circle</span>' +
      '<span class="text-white font-medium"></span>' +
    '</div>';
    document.body.appendChild(toast);
  }
  toast.querySelector('span:last-child').textContent = message;
  toast.classList.remove('opacity-0', 'translate-y-4');
  toast.classList.add('opacity-100', 'translate-y-0');
  
  setTimeout(function() {
    toast.classList.add('opacity-0', 'translate-y-4');
    toast.classList.remove('opacity-100', 'translate-y-0');
  }, 3000);
}

function openModifyPlanModal() {
  var weekPlan = typeof loadWeeklyPlan === 'function' ? loadWeeklyPlan() : null;
  if (!weekPlan) {
    window.showToast('No hay plan para modificar', 3000, "warning");
    return;
  }
  
  var modal = document.getElementById('modifyPlanModal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'modifyPlanModal';
    modal.className = 'fixed inset-0 z-[85] hidden';
    document.body.appendChild(modal);
  }
  
  modal.innerHTML = getModifyPlanHTML(weekPlan);
  modal.classList.remove('hidden');
  modal.classList.add('flex');
}

function getModifyPlanHTML(weekPlan) {
  var allIngredients = {};
  
  Object.keys(weekPlan.days).forEach(function(dateKey) {
    var day = weekPlan.days[dateKey];
    Object.keys(day.meals).forEach(function(mealType) {
      var meal = day.meals[mealType];
      if (meal.recipe && meal.recipe.ingredients) {
        meal.recipe.ingredients.forEach(function(ing) {
          if (!allIngredients[ing.id]) {
            allIngredients[ing.id] = {
              ...ing,
              recipes: [],
              days: []
            };
          }
          allIngredients[ing.id].recipes.push(meal.recipe.title);
          if (!allIngredients[ing.id].days.includes(dateKey)) {
            allIngredients[ing.id].days.push(dateKey);
          }
        });
      }
    });
  });
  
  var excludedList = typeof userExcludedIngredients !== 'undefined' ? userExcludedIngredients : [];
  
  var html = '<div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeModifyPlanModal()"></div>' +
    '<div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">' +
      '<div class="bg-surface-container rounded-2xl p-5 w-full max-w-lg max-h-[85vh] overflow-hidden flex flex-col pointer-events-auto">' +
        '<div class="flex items-center justify-between mb-4">' +
          '<div class="flex items-center gap-3">' +
            '<div class="w-10 h-10 rounded-xl bg-yellow-500/20 flex items-center justify-center">' +
              '<span class="material-symbols-outlined text-yellow-400">edit</span>' +
            '</div>' +
            '<div>' +
              '<h3 class="text-lg font-headline font-bold text-white">Modificar Plan</h3>' +
              '<p class="text-xs text-on-surface-variant">Excluye alimentos que no comes</p>' +
            '</div>' +
          '</div>' +
          '<button onclick="closeModifyPlanModal()" class="w-11 h-11 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-all">' +
            '<span class="material-symbols-outlined text-lg">close</span>' +
          '</button>' +
        '</div>' +
        
        '<div class="flex gap-2 mb-4">' +
          '<button onclick="showExcludedIngredients()" class="flex-1 py-2 px-3 rounded-lg text-xs font-medium bg-surface-container-high text-white border border-yellow-500/50">' +
            '<span class="material-symbols-outlined text-sm align-middle mr-1">block</span>Excluidos (<span id="excludedCount">' + excludedList.length + '</span>)' +
          '</button>' +
        '</div>' +
        
        '<div class="flex-1 overflow-y-auto space-y-2 max-h-[50vh] pr-1" id="ingredientList">';
  
  var ingredientArray = Object.keys(allIngredients).map(function(id) { return allIngredients[id]; });
  ingredientArray.sort(function(a, b) { return a.name.localeCompare(b.name); });
  
  ingredientArray.forEach(function(ing) {
    var isExcluded = excludedList.includes(ing.id);
    var catColor = getCategoryColor(ing.category);
    
    html += '<div class="ingredient-item flex items-center justify-between p-3 rounded-xl ' + (isExcluded ? 'bg-red-500/10 border border-red-500/30' : 'bg-surface-container-high') + '">';
    html += '<div class="flex-1 min-w-0">';
    html += '<div class="flex items-center gap-2">';
    if (!isExcluded) {
      html += '<span class="w-3 h-3 rounded-full flex-shrink-0" style="background:' + catColor + '"></span>';
    } else {
      html += '<span class="material-symbols-outlined text-red-400 text-sm flex-shrink-0">block</span>';
    }
    html += '<span class="font-medium text-sm ' + (isExcluded ? 'text-white/50 line-through' : 'text-white') + '">' + ing.name + '</span>';
    html += '</div>';
    html += '<p class="text-xs text-on-surface-variant ml-5">' + ing.recipes.slice(0, 2).join(', ') + (ing.recipes.length > 2 ? '...' : '') + '</p>';
    html += '<p class="text-[10px] text-white/60 ml-5">' + ing.quantity + ' ' + (ing.unit || 'g') + ' x ' + ing.days.length + ' dia(s)</p>';
    html += '</div>';
    
    if (isExcluded) {
      html += '<button onclick="includeIngredient(\'' + ing.id + '\'); openModifyPlanModal();" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-green-500/20 text-green-400 hover:bg-green-500/30 transition-all">Incluir</button>';
    } else {
      html += '<button onclick="excludeIngredient(\'' + ing.id + '\'); openModifyPlanModal();" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-red-500/20 text-red-400 hover:bg-red-500/30 transition-all">Excluir</button>';
    }
    html += '</div>';
  });
  
  html += '</div>';
  
  html += '<div class="mt-4 pt-4 border-t border-white/10 space-y-2">';
  html += '<p class="text-xs text-on-surface-variant mb-2">Si excluyes un alimento, el plan se regenerara con recetas alternativas.</p>';
  html += '<button onclick="regeneratePlanWithExclusionsUI(); closeModifyPlanModal();" class="w-full py-3 rounded-xl bg-gradient-to-r from-yellow-500 to-orange-500 text-black font-bold hover:opacity-90 transition-all flex items-center justify-center gap-2">' +
    '<span class="material-symbols-outlined text-sm">refresh</span>Regenerar Plan' +
  '</button>';
  html += '<button onclick="closeModifyPlanModal()" class="w-full py-2 rounded-xl bg-surface-container text-white font-medium hover:bg-surface-container-highest transition-all">' +
    'Cancelar' +
  '</button>';
  html += '</div></div></div>';
  
  return html;
}

function getCategoryColor(category) {
  var colors = {
    'Proteínas': '#ff4d00',
    'Grasas': '#ffb300',
    'Verduras': '#22c55e',
    'Lacteos': '#a855f7',
    'Frutos secos': '#84cc16',
    'Otros': '#6b7280'
  };
  return colors[category] || '#ff4d00';
}

