<div id="panelEntreno" class="hidden space-y-4">
  <!-- Stats row -->
  <div class="grid grid-cols-3 gap-3" id="entrenoStatsRow"></div>
  <!-- Today card -->
  <div id="entrenoTodayCard"></div>
  <!-- Last workouts -->
  <div id="entrenoRecentList"></div>
  <!-- CTA -->
  <a href="/app/entrenamientos" class="flex items-center justify-center gap-2 w-full py-4 rounded-2xl bg-primary-container text-white font-bold text-sm hover:bg-primary-container/80 transition-all mt-2">
    <span class="material-symbols-outlined">fitness_center</span>
