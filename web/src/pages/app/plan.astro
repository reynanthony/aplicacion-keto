var currentFoods=[];
var foodsLoaded = false;

async function loadFoodsFromSupabase() {
  if (foodsLoaded) return;
  
  try {
    const { data, error } = await window.supabase
      .from('alimentos')
      .select('id, nombre, categoria, calorias, proteinas, carbos, grasas')
      .eq('activo', true)
      .order('nombre', { ascending: true });
    
    if (error) {
      console.error('Error Supabase:', error);
      throw error;
    }
    
    if (data && data.length > 0) {
      const foods = data.map(f => ({
        id: f.id,
        name: f.nombre,
        category: mapCategory(f.categoria),
        calories: f.calorias || 0,
        protein: f.proteinas || 0,
        fat: f.grasas || 0,
        carbs: f.carbos || 0,
        portion: 100,
        units: [{name: "gramos", grams: 1}, {name: "kilos", grams: 1000}]
      }));
      
      currentFoods = foods;
      localStorage.setItem("ketoFoods", JSON.stringify(foods));
      localStorage.setItem("ketoFoodsVersion", "1.0");
      foodsLoaded = true;
      console.log('✅ Cargados', foods.length, 'alimentos desde Supabase');
      return foods;
    }
  } catch (e) {
    console.error('Error cargando alimentos desde Supabase:', e);
  }
  
  // Fallback a foods locales
  currentFoods = defaultFoods;
  return defaultFoods;
}

function mapCategory(cat) {
  const map = {
    'proteina': 'Proteínas',
    'grasa': 'Grasas',
    'vegetal': 'Verduras',
    'lacteo': 'Lácteos',
    'fruto_seco': 'Frutos secos',
    'otro': 'Otros'
  };
  return map[cat] || 'Otros';
}

function getAllFoodsForPlan() {
  if (currentFoods.length > 0) return currentFoods;
  
  var stored = safeParseJSON(localStorage.getItem("ketoFoods"), null);
  if (stored && Array.isArray(stored) && stored.length > 0) {
    stored.forEach(function(f) {
      if (!f.units) {
        var def = defaultFoods.find(function(d) { return d.id === f.id; });
        if (def && def.units) f.units = def.units;
      }
    });
    currentFoods = stored;
    return stored;
  }
  return defaultFoods;
}

