            '<p class="text-on-surface-variant text-sm mb-3">' + errorMsg + '</p>' +
            '<p class="text-xs text-yellow-300 mb-2">Compras prioritarias sugeridas:</p>' +
            '<ul class="space-y-1">' + (compras || '<li class="text-xs text-on-surface-variant">Agrega vegetales de hoja, huevos y grasas saludables.</li>') + '</ul></div>';
        } else if (result.rejectedByInspector) {
          var descartadas = Object.keys(result.rejectedByInspector || {}).length;
          summaryDiv.innerHTML = '<div class="text-center py-8"><span class="material-symbols-outlined text-4xl text-yellow-400 mb-2">rule</span><p class="text-white font-medium mt-2">Inspector Keto filtro recetas</p><p class="text-on-surface-variant text-sm mt-1">' + errorMsg + '</p><p class="text-xs text-on-surface-variant/70 mt-2">Recetas excluidas: ' + descartadas + ' | Umbral: > ' + (result.ketoThreshold || 70) + '</p></div>';
        } else {
          summaryDiv.innerHTML = '<div class="text-center py-8"><span class="material-symbols-outlined text-4xl text-on-surface-variant/70 mb-2">menu_book</span><p class="text-on-surface-variant">' + errorMsg + '</p></div>';
        }
        return;
      }
      
      generatedAutoPlan = result;
      renderAutoPlanSummary(result, summaryDiv);
    } else {
      summaryDiv.innerHTML = '<div class="text-center py-8"><p class="text-on-surface-variant">Cargando módulo...</p></div>';
    }
  }, 300);
}

