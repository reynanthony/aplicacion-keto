function removeFromAutoPlan(meal, idx) {
  if (!generatedAutoPlan || !generatedAutoPlan.plan || !generatedAutoPlan.plan[meal]) return;
  
  generatedAutoPlan.plan[meal].splice(idx, 1);
  
  // Recalcular macros
  var total = { calories: 0, protein: 0, fat: 0, carbs: 0 };
  Object.keys(generatedAutoPlan.plan).forEach(function(m) {
    generatedAutoPlan.plan[m].forEach(function(item) {
      total.calories += item.calories || 0;
      total.protein += item.protein || 0;
      total.fat += item.fat || 0;
      total.carbs += item.carbs || 0;
    });
  });
  generatedAutoPlan.resultMacros = total;
  
  // Refresh modal
  showAutoMealDetails(meal);
  renderAutoPlanSummary(generatedAutoPlan, document.getElementById('autoPlanSummary'));
}

function adjustAutoPortion(meal, idx, delta) {
  if (!generatedAutoPlan || !generatedAutoPlan.plan || !generatedAutoPlan.plan[meal] || !generatedAutoPlan.plan[meal][idx]) return;
  
  var item = generatedAutoPlan.plan[meal][idx];
  var oldPortion = item.portion || item.basePortion;
  var newPortion = Math.max(10, item.portion + delta);
  
  var testTotal = { calories: 0, protein: 0, fat: 0, carbs: 0 };
  Object.keys(generatedAutoPlan.plan).forEach(function(m) {
    generatedAutoPlan.plan[m].forEach(function(i, iidx) {
      if (m === meal && iidx === idx) {
        var testRatio = newPortion / (i.basePortion || i.portion);
        testTotal.calories += Math.round((i.baseCalories || i.calories) * testRatio);
        testTotal.protein += Math.round((i.baseProtein || i.protein) * testRatio * 10) / 10;
        testTotal.fat += Math.round((i.baseFat || i.fat) * testRatio * 10) / 10;
        testTotal.carbs += Math.round((i.baseCarbs || i.carbs) * testRatio * 10) / 10;
      } else {
        testTotal.calories += i.calories || 0;
        testTotal.protein += i.protein || 0;
        testTotal.fat += i.fat || 0;
        testTotal.carbs += i.carbs || 0;
      }
    });
  });
  
  var target = generatedAutoPlan.targetMacros || { calories: 2000, protein: 120, fat: 150, carbs: 30 };
  if (testTotal.calories > target.calories || testTotal.protein > target.protein * 1.1) {
    var maxCal = target.calories - (testTotal.calories - item.calories);
    var maxProt = (target.protein * 1.1) - (testTotal.protein - item.protein);
    var calPerGram = (item.baseCalories || item.calories) / (item.basePortion || item.portion);
    var protPerGram = (item.baseProtein || item.protein) / (item.basePortion || item.portion);
    var maxPortionCal = Math.floor(maxCal / calPerGram);
    var maxPortionProt = Math.floor(maxProt / protPerGram);
    var maxPortion = Math.min(maxPortionCal, maxPortionProt, item.portion);
    maxPortion = Math.max(10, Math.floor(maxPortion / 10) * 10);
    
    showMacroLimitModal(meal, idx, item, maxPortion, target, testTotal);
    return;
  }
  
  item.portion = newPortion;
  
  var ratio = newPortion / oldPortion;
  item.calories = Math.round(item.calories * ratio);
  item.protein = Math.round(item.protein * ratio * 10) / 10;
  item.fat = Math.round(item.fat * ratio * 10) / 10;
  item.carbs = Math.round(item.carbs * ratio * 10) / 10;
  
  var total = { calories: 0, protein: 0, fat: 0, carbs: 0 };
  Object.keys(generatedAutoPlan.plan).forEach(function(m) {
    generatedAutoPlan.plan[m].forEach(function(i) {
      total.calories += i.calories || 0;
      total.protein += i.protein || 0;
      total.fat += i.fat || 0;
      total.carbs += i.carbs || 0;
    });
  });
  generatedAutoPlan.resultMacros = total;
  
  showAutoMealDetails(meal);
  renderAutoPlanSummary(generatedAutoPlan, document.getElementById('autoPlanSummary'));
}

function addFoodToAutoMeal(meal) {
  var sessionKey = 'autoPlanWarningMeal_' + currentDay;
  if (!sessionStorage.getItem(sessionKey)) {
    showAutoPlanWarning(function() {
      openAddFoodModalForAutoMeal(meal);
    });
    return;
  }
  openAddFoodModalForAutoMeal(meal);
}

function openAddFoodModalForAutoMeal(meal) {
  var despensa = getDespensa();
  var foods = getFoods();
  var items = Object.keys(despensa).filter(function(k) { return despensa[k] && despensa[k].stock > 0; });
  
  if (items.length === 0) {
    window.showToast('No hay alimentos en la despensa', 3000, "warning");
    return;
  }
  
  var existing = document.getElementById('addFoodModal');
  if (existing) existing.remove();
  
  var modal = document.createElement('div');
  modal.id = 'addFoodModal';
  modal.className = 'fixed inset-0 z-[80] flex items-center justify-center p-4 pointer-events-none';
  modal.innerHTML = '<div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeAddFoodModal()"></div><div class="glass-card rounded-2xl p-5 w-full max-w-xs max-h-[80vh] overflow-y-auto pointer-events-auto"><div class="flex justify-between items-center mb-4"><h3 class="text-lg font-headline font-bold text-white">Agregar a ' + meal + '</h3><button onclick="closeAddFoodModal()" class="w-11 h-11 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-all"><span class="material-symbols-outlined text-lg">close</span></button></div><div class="space-y-2" id="addFoodList"></div></div>';
  
  var listContainer = modal.querySelector('#addFoodList');
  
  items.forEach(function(k) {
    var despensaItem = despensa[k];
    var food = foods.find(function(f) { return f.id === k; });
    var name = food ? food.name : k;
    var stock = despensaItem.stock || 0;
    var cal = food ? (food.calories || 0) : 0;
    var prot = food ? (food.protein || 0) : 0;
    var fat = food ? (food.fat || 0) : 0;
    var carbs = food ? (food.carbs || 0) : 0;
    
    var btn = document.createElement('button');
    btn.className = 'w-full p-3 text-left bg-surface-container rounded-xl hover:bg-primary-container transition text-white';
    btn.onclick = function() { addFoodFromDespensa(meal, k); };
    btn.innerHTML = '<div class="flex justify-between items-start"><div><div class="font-medium">' + name + '</div><div class="text-xs text-white/60 mt-1">Cal: ' + cal + ' | P: ' + prot + 'g | G: ' + fat + 'g | C: ' + carbs + 'g</div></div><div class="text-sm text-white/60">' + stock + 'g</div></div>';
    listContainer.appendChild(btn);
  });
  
  document.body.appendChild(modal);
}

function closeAddFoodModal() {
  var modal = document.getElementById('addFoodModal');
  if (modal) modal.remove();
}

function addFoodFromDespensa(meal, itemKey) {
  var sessionKey = 'autoPlanWarningMeal_' + currentDay;
  if (!sessionStorage.getItem(sessionKey)) {
    showAutoPlanWarning(function() {
      executeAddFoodFromDespensa(meal, itemKey);
    });
    return;
  }
  executeAddFoodFromDespensa(meal, itemKey);
}

function executeAddFoodFromDespensa(meal, itemKey) {
  var despensa = getDespensa();
  var foods = getFoods();
  var item = despensa[itemKey];
  var food = foods.find(function(f) { return f.id === itemKey; });
  if (!item || !generatedAutoPlan || !generatedAutoPlan.plan || !generatedAutoPlan.plan[meal]) return;
  
  var portion = item.stock || 100;
  var basePortion = 100;
  var ratio = portion / basePortion;
  
  var newCal = Math.round((food.calories || 0) * ratio);
  var newProt = Math.round((food.protein || 0) * ratio * 10) / 10;
  var newFat = Math.round((food.fat || 0) * ratio * 10) / 10;
  var newCarbs = Math.round((food.carbs || 0) * ratio * 10) / 10;
  
  var currentTotal = { calories: 0, protein: 0, fat: 0, carbs: 0 };
  Object.keys(generatedAutoPlan.plan).forEach(function(m) {
    generatedAutoPlan.plan[m].forEach(function(i) {
      currentTotal.calories += i.calories || 0;
      currentTotal.protein += i.protein || 0;
      currentTotal.fat += i.fat || 0;
      currentTotal.carbs += i.carbs || 0;
    });
  });
  
  var target = generatedAutoPlan.targetMacros || { calories: 2000, protein: 120, fat: 150, carbs: 30 };
  if (currentTotal.calories + newCal > target.calories || currentTotal.protein + newProt > target.protein * 1.1) {
    var maxCal = target.calories - currentTotal.calories;
    var maxProt = (target.protein * 1.1) - currentTotal.protein;
    var calPerGram = food.calories || 0;
    var protPerGram = food.protein || 0;
    var maxPortionCal = calPerGram > 0 ? Math.floor(maxCal / calPerGram * 100) : 10000;
    var maxPortionProt = protPerGram > 0 ? Math.floor(maxProt / protPerGram * 100) : 10000;
    var maxPortion = Math.min(maxPortionCal, maxPortionProt, portion);
    maxPortion = Math.max(10, Math.floor(maxPortion));
    
    if (maxPortion < 10) {
      showMacroLimitModalForAdd(meal, itemKey, food, portion, target, currentTotal, 0);
    } else {
      showMacroLimitModalForAdd(meal, itemKey, food, maxPortion, target, currentTotal, portion);
    }
    return;
  }
  
  var newItem = {
    name: food ? food.name : itemKey,
    portion: portion,
    basePortion: basePortion,
    baseCalories: food.calories || 0,
    baseProtein: food.protein || 0,
    baseFat: food.fat || 0,
    baseCarbs: food.carbs || 0,
    calories: newCal,
    protein: newProt,
    fat: newFat,
    carbs: newCarbs,
    fromDespensa: true,
    despensaKey: itemKey
  };
  
  generatedAutoPlan.plan[meal].push(newItem);
  
  var total = { calories: 0, protein: 0, fat: 0, carbs: 0 };
  Object.keys(generatedAutoPlan.plan).forEach(function(m) {
    generatedAutoPlan.plan[m].forEach(function(i) {
      total.calories += i.calories || 0;
      total.protein += i.protein || 0;
      total.fat += i.fat || 0;
      total.carbs += i.carbs || 0;
    });
  });
  generatedAutoPlan.resultMacros = total;
  
  closeAddFoodModal();
  showAutoMealDetails(meal);
  renderAutoPlanSummary(generatedAutoPlan, document.getElementById('autoPlanSummary'));
}

function showMacroLimitModal(meal, idx, item, maxPortion, target, testTotal) {
  var existing = document.getElementById('macroLimitModal');
  if (existing) existing.remove();
  
  var currentCal = testTotal.calories - item.calories;
  var currentProt = testTotal.protein - item.protein;
  var currentFat = testTotal.fat - item.fat;
  var currentCarbs = testTotal.carbs - item.carbs;
  var suggestedPortion = maxPortion || item.portion;
  
  var modal = document.createElement('div');
  modal.id = 'macroLimitModal';
  modal.className = 'fixed inset-0 z-[90] flex items-center justify-center p-4 pointer-events-none';
  modal.innerHTML = '<div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeMacroLimitModal()"></div>' +
    '<div class="glass-card rounded-2xl p-5 w-full max-w-sm pointer-events-auto">' +
      '<div class="flex items-center gap-3 mb-4">' +
