function applyGeneratedPlan() {
  if (!generatedAutoPlan || !generatedAutoPlan.plan) return;
  
  if (typeof saveGeneratedMealPlan === 'function') {
    saveGeneratedMealPlan(generatedAutoPlan.plan, currentDay);
  } else {
    localStorage.setItem('mealPlan_' + currentDay, JSON.stringify(generatedAutoPlan.plan));
  }
  
  var sessionKey = 'autoPlanWarningMeal_' + currentDay;
  sessionStorage.setItem(sessionKey, 'true');
  
  showToast('Plan automático aplicado');
  updateMealCardMacros();
  renderMealCardItems();
  initWeekSelector();
  initCalendar();
  setMealPlanMode('manual');
}

