var qty=parseFloat(document.getElementById("tempQty").value)||0;
var units=planFoodUnits[foodId]||food.units||[{name:"gramos",grams:1}];
var unit=units[planCurrentUnit]||units[0];
var totalGrams=Math.round(qty*unit.grams);
var foodPortion=parseFloat(food.portion)||100;
