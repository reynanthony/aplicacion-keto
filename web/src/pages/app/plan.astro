---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Mi Plan" authGuard={true}>
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
.glass-card{background:#161310;backdrop-filter:none;border:1px solid rgba(255,240,225,0.06);border-radius:24px}
.day-btn{border-radius:16px !important;border-width:1px !important}
main .glass-card, main .rounded-2xl { border-radius: 24px; }
.glow-orange{box-shadow:0 0 20px rgba(255,77,0,0.25)}
.meal-card{transition:transform 0.2s ease,box-shadow 0.2s ease}.meal-card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(0,0,0,0.3)}
.macro-bar{transition:width 0.5s cubic-bezier(0.4,0,0.2,1)}
.day-btn{transition:all 0.2s ease}.day-btn:hover{transform:scale(1.05)}
.mode-btn.active{background:linear-gradient(135deg,#ff4d00,#ff6b00);box-shadow:0 4px 15px rgba(255,77,0,0.4)}
.meal-section{position:relative;overflow:hidden}.meal-section::before{content:"";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,77,0,0.3),transparent)}
.meal-item{transition:all 0.2s ease}.meal-item:hover{background:rgba(255,77,0,0.05);border-color:rgba(255,77,0,0.2)}
.meal-item .remove-btn{opacity:0;transition:opacity 0.2s}.meal-item:hover .remove-btn{opacity:1}
.portion-btn{transition:all 0.15s ease}.portion-btn:hover{background:#ff4d00;color:#fff}
.summary-card{background:linear-gradient(135deg,rgba(22,19,16,0.8),rgba(22,19,16,0.9));border:1px solid rgba(255,77,0,0.1)}
.empty-state{background:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(255,77,0,0.02) 10px,rgba(255,77,0,0.02) 20px)}
.food-selector-item{transition:all 0.15s ease}.food-selector-item:hover{background:rgba(255,77,0,0.1);border-color:rgba(255,77,0,0.3)}.food-selector-item:active{transform:scale(0.98)}
.progress-ring{transform:rotate(-90deg)}
.stock-indicator{height:3px;border-radius:2px;background:rgba(255,255,255,0.1)}
.stock-fill{height:100%;border-radius:2px;transition:width 0.3s ease}
.weekly-plan-modal{height:100vh;max-height:100vh}.weekly-plan-modal>div:nth-child(2){height:calc(100vh - 80px);max-height:calc(100vh - 80px)}
.meal-card-preview{transition:all 0.2s ease}.meal-card-preview:hover{background:rgba(255,77,0,0.05)}
.recipe-detail{border-left:2px solid var(--primary-container)}
.ingredient-item{transition:background 0.15s}.ingredient-item:hover{background:rgba(255,255,255,0.05)}
@keyframes pulse-green{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,0.4)}50%{box-shadow:0 0 0 15px rgba(34,197,94,0)}}
.animate-pulse-green{animation:pulse-green 2s infinite}
</style>
<header class="fixed top-0 left-0 right-0 z-40 h-14 px-4 flex items-center justify-between" style="background:rgba(11,10,8,0.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,240,225,0.06)">
  <a href="/app/" class="flex items-center gap-3" style="text-decoration:none">
    <img src="/app/logo.svg" alt="KetoCore" class="w-7 h-7" style="filter:drop-shadow(0 0 6px rgba(255,77,0,0.4))">
    <span class="text-base font-black tracking-tight" style="font-family:'Plus Jakarta Sans',sans-serif;color:#f7f4f0">KetoCore</span>
  </a>
  <div class="flex items-center gap-1.5">
    <button onclick="toggleMobileUserMenu()" aria-label="Mi cuenta" class="w-9 h-9 rounded-full flex items-center justify-center overflow-hidden" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06)">
      <img id="mobileHeaderAvatarImg" src="" class="hidden w-full h-full object-cover" alt="Avatar">
      <span id="mobileHeaderAvatarIcon" class="material-symbols-outlined" style="font-size:20px;color:rgba(247,244,240,0.6)">account_circle</span>
    </button>
    <button onclick="toggleHamburgerMenu()" aria-label="Abrir menú" class="w-9 h-9 rounded-full flex items-center justify-center" style="background:#1e1a15;color:rgba(247,244,240,0.6)">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:20px">menu</span>
    </button>
  </div>
</header>

<!-- Mobile User Dropdown -->
<div id="mobileUserDropdown" class="md:hidden fixed top-14 right-4 w-56 rounded-2xl overflow-hidden z-[80] hidden" style="background:#161310;border:1px solid rgba(255,240,225,0.07);box-shadow:0 8px 32px rgba(0,0,0,0.35)">
  <div class="p-3" style="border-bottom:1px solid rgba(255,240,225,0.06)">
    <p class="text-sm font-semibold" style="color:#f7f4f0" id="mobileDropdownUserName">Usuario</p>
    <p class="text-xs mt-0.5" style="color:rgba(247,244,240,0.55)" id="mobileDropdownUserEmail">email@example.com</p>
  </div>
  <div class="p-2">
    <a href="/app/perfil" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-orange-50" style="color:#f7f4f0">
      <span class="material-symbols-outlined text-lg" style="color:rgba(247,244,240,0.55)">person</span>
      <span class="text-sm font-medium">Mi Perfil</span>
    </a>
    <button onclick="handleLogout()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-red-50" style="color:#dc2626">
      <span class="material-symbols-outlined text-lg">logout</span>
      <span class="text-sm font-medium">Cerrar Sesión</span>
    </button>
  </div>
</div>
<main class="main-content pt-14 px-4 pb-20 min-h-screen" style="background:#0b0a08">
<div class="space-y-6 kc-page" style="padding-top:12px">
<div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:26px;flex-wrap:wrap;gap:20px">
  <div>
    <p id="dateDisplay" style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00;margin-bottom:12px"></p>
    <h1 class="kc-h1">Tu semana,<br>planificada</h1>
  </div>
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <span id="planStatusBadge" class="hidden px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1"></span>
    <button onclick="openWeeklyModal()" class="kc-btn-ghost" style="height:46px;padding:0 18px;font-size:13px"><span class="material-symbols-outlined" style="font-size:18px">calendar_month</span>Semana</button>
    <button onclick="openWeeklyPlanGenerator()" class="kc-btn" style="height:46px"><span class="material-symbols-outlined" style="font-size:20px">auto_awesome</span>Generar plan con IA</button>
  </div>
</div>

<!-- Sub-tabs: Nutrición / Entreno / Suplementación -->
<div class="flex gap-1 mb-5 bg-surface-container rounded-xl p-1">
  <button id="tabNutricion" onclick="switchPlanTab('nutricion')" class="plan-subtab active flex-1 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center justify-center gap-1.5 bg-surface-container-high text-white">
    <span class="material-symbols-outlined text-[18px]">restaurant</span><span>Nutrición</span>
  </button>
  <button id="tabEntreno" onclick="switchPlanTab('entreno')" class="plan-subtab flex-1 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center justify-center gap-1.5 text-white/50 hover:text-white/80">
    <span class="material-symbols-outlined text-[18px]">fitness_center</span><span>Entreno</span>
  </button>
  <button id="tabSuple" onclick="switchPlanTab('suple')" class="plan-subtab flex-1 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center justify-center gap-1.5 text-white/50 hover:text-white/80">
    <span class="material-symbols-outlined text-[18px]">medication</span><span>Suplementos</span>
  </button>
</div>

<div id="panelNutricion">
<!-- Plan Status Banner -->
<div id="activePlanBanner" class="hidden glass-card rounded-xl p-4 mb-4 border-l-4 border-green-500">
</div>
<div id="weekSelector" class="flex gap-1 mb-4 overflow-x-auto pb-2"></div>

<!-- Toggle Modo Manual/Automático -->
<div class="flex items-center justify-between mb-4">
  <div class="mode-selector glass-card p-1 rounded-full inline-flex">
    <button id="manualModeBtn" onclick="setMealPlanMode('manual')" class="mode-btn px-4 py-2 rounded-full text-xs font-medium transition-all flex items-center gap-2 bg-primary-container text-white">
      <span class="material-symbols-outlined text-base">edit</span>Manual
    </button>
    <button id="autoModeBtn" onclick="setMealPlanMode('auto')" class="mode-btn px-4 py-2 rounded-full text-xs font-medium transition-all text-on-surface-variant hover:text-white flex items-center gap-2">
      <span class="material-symbols-outlined text-base">auto_awesome</span>Automático
    </button>
  </div>
  <button id="generateAutoBtn" onclick="generateAndApplyAutoPlan()" class="hidden bg-secondary text-black px-3 py-2 rounded-lg text-xs font-bold flex items-center gap-1 hover:bg-secondary/80 transition-all">
    <span class="material-symbols-outlined text-sm">refresh</span>Generar
  </button>
</div>

<!-- Vista Automática (panel de generación) -->
<div id="autoMealPanel" class="hidden glass-card rounded-xl p-6 mb-6">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h3 class="text-lg font-headline font-bold text-white flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">auto_awesome</span>
        Plan Automático
      </h3>
      <p class="text-xs text-on-surface-variant mt-1">Basado en tus recetas guardadas</p>
    </div>
  </div>
  <div id="autoPlanSummary" class="space-y-3"></div>
  <div class="flex gap-3 mt-4">
    <button onclick="applyGeneratedPlan()" class="flex-1 py-3 rounded-xl bg-primary-container text-white font-bold hover:bg-primary-container/80 transition-all flex items-center justify-center gap-2">
      <span class="material-symbols-outlined">check</span>Aplicar Plan
    </button>
    <button onclick="regenerateAutoPlan()" class="py-3 px-4 rounded-xl bg-surface-container-high text-white hover:bg-surface-container-highest transition-all">
      <span class="material-symbols-outlined">refresh</span>
    </button>
  </div>
</div>

<!-- Botón Plan IA - Modernizado -->
<div class="glass-card rounded-2xl p-4 mb-6 border border-transparent hover:border-primary-container/30 transition-all">
<div class="flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-container/20 to-secondary/20 flex items-center justify-center">
<span class="material-symbols-outlined text-primary-container" style="font-size:20px;">auto_awesome</span>
</div>
<div>
<h3 class="text-white font-medium text-sm">Generar con IA</h3>
<p class="text-xs text-on-surface-variant">Plan personalizado según tus macros</p>
</div>
</div>
<div class="flex gap-2">
<button onclick="openWeeklyPlanGenerator()" class="px-4 py-2 rounded-xl bg-primary-container/10 text-primary-container text-xs font-medium hover:bg-primary-container/20 transition-all flex items-center gap-2">
<span>Crear plan</span>
<span class="material-symbols-outlined text-sm">arrow_forward</span>
</button>
<button onclick="openAIRecipeGenerator()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-purple-500/20 to-pink-500/20 text-purple-400 text-xs font-medium hover:from-purple-500/30 hover:to-pink-500/30 transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm">auto_awesome</span>
<span>IA</span>
</button>
</div>
</div>
</div>



<!-- Resumen (se mantiene igual) -->
<div class="glass-card rounded-2xl p-5 mb-6">
<div class="flex items-center justify-between mb-4">
<span class="text-xs text-on-surface-variant uppercase tracking-wider">Macros del día</span>
<span id="dayDateLabel" class="text-xs text-primary-container"></span>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
<div class="bg-surface-container-high rounded-xl p-4 text-center">
<div class="flex items-center justify-center gap-2 mb-2">
<span class="text-[10px] text-on-surface-variant uppercase tracking-wider">Calorías</span>
</div>
<div class="text-3xl font-black text-yellow-400 mb-1"><span id="currentCal">0</span></div>
<div class="text-xs text-on-surface-variant">/ <span id="targetCal">1800</span> kcal</div>
<div class="h-2 bg-surface rounded-lg mt-2 overflow-hidden">
<div id="calorieBar" class="h-full bg-yellow-400 rounded-lg transition-all" style="width:0%"></div>
</div>
</div>
<div class="bg-surface-container-high rounded-xl p-4 text-center">
<div class="flex items-center justify-center gap-2 mb-2">
<span class="text-[10px] text-on-surface-variant uppercase tracking-wider">Proteína</span>
</div>
<div class="text-3xl font-black text-orange-400 mb-1"><span id="currentProtein">0</span><span class="text-sm text-on-surface-variant">g</span></div>
<div class="text-xs text-on-surface-variant">Meta: <span id="targetProtein">160</span>g</div>
<div class="h-2 bg-surface rounded-lg mt-2 overflow-hidden">
<div id="proteinBar" class="h-full bg-orange-400 rounded-lg transition-all" style="width:0%"></div>
</div>
</div>
<div class="bg-surface-container-high rounded-xl p-4 text-center">
<div class="flex items-center justify-center gap-2 mb-2">
<span class="text-[10px] text-on-surface-variant uppercase tracking-wider">Grasa</span>
</div>
<div class="text-3xl font-black text-yellow-300 mb-1"><span id="currentFat">0</span><span class="text-sm text-on-surface-variant">g</span></div>
<div class="text-xs text-on-surface-variant">Meta: <span id="targetFat">150</span>g</div>
<div class="h-2 bg-surface rounded-lg mt-2 overflow-hidden">
<div id="fatBar" class="h-full bg-yellow-300 rounded-lg transition-all" style="width:0%"></div>
</div>
</div>
<div class="bg-surface-container-high rounded-xl p-4 text-center">
<div class="flex items-center justify-center gap-2 mb-2">
<span class="text-[10px] text-on-surface-variant uppercase tracking-wider">Carbos</span>
</div>
<div class="text-3xl font-black text-cyan-400 mb-1"><span id="currentCarbs">0</span><span class="text-sm text-on-surface-variant">g</span></div>
<div class="text-xs text-on-surface-variant">Meta: <span id="targetCarbs">25</span>g</div>
<div class="h-2 bg-surface rounded-lg mt-2 overflow-hidden">
<div id="carbsBar" class="h-full bg-cyan-400 rounded-lg transition-all" style="width:0%"></div>
</div>
</div>
</div>
<div class="flex items-center justify-between mt-4 pt-4 border-t border-white/10">
<span class="text-xs text-on-surface-variant"><span id="mealCount">0</span> alimentos</span>
<div class="flex gap-2">
<button onclick="copyPlan()" class="text-xs text-primary-container hover:underline">Copiar ayer</button>
<span class="text-white/20">|</span>
<button onclick="resetPlan()" class="text-xs text-error hover:underline">Reiniciar</button>
</div>
</div>
</div>

<!-- Tarjetas de Comidas -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6" id="mealCardsContainer">
<!-- Desayuno -->
<div class="meal-card glass-card rounded-2xl overflow-hidden cursor-pointer transition-all duration-300 hover:shadow-lg hover:shadow-primary-container/10" onclick="toggleMealCard('desayuno')" data-meal="desayuno">
<div class="p-5">
<div class="flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg, #f59e0b20, #fbbf2420)">
<span class="material-symbols-outlined text-2xl" style="color:#f59e0b">egg</span>
</div>
<div>
<h3 class="font-bold text-white">Desayuno</h3>
<p id="desayunoCal" class="text-sm text-on-surface-variant"><span class="text-yellow-400 font-bold">0</span> kcal</p>
</div>
</div>
<div class="flex items-center gap-2">
<span id="desayunoCount" class="text-xs text-on-surface-variant bg-surface-container px-2 py-1 rounded-full">0 items</span>
<span class="material-symbols-outlined text-on-surface-variant transition-transform duration-300" id="desayunoArrow">expand_more</span>
</div>
</div>
<div class="flex gap-3 mt-3 text-xs">
<span class="text-orange-400"><span id="desayunoProtein">0</span>g prot</span>
<span class="text-yellow-300"><span id="desayunoFat">0</span>g grasa</span>
<span class="text-cyan-400"><span id="desayunoCarbs">0</span>g carbs</span>
</div>
</div>
<div id="desayunoDetail" class="hidden border-t border-white/10">
<div class="p-4">
<div id="desayunoItems" class="space-y-2 mb-4"></div>
<button onclick="event.stopPropagation(); openFoodSelector('desayuno')" class="w-full py-3 rounded-xl bg-surface-container text-primary-container font-medium flex items-center justify-center gap-2 hover:bg-surface-container-high transition-all">
<span class="material-symbols-outlined text-sm">add</span>Agregar alimento
</button>
</div>
</div>
</div>

<!-- Almuerzo -->
<div class="meal-card glass-card rounded-2xl overflow-hidden cursor-pointer transition-all duration-300 hover:shadow-lg hover:shadow-primary-container/10" onclick="toggleMealCard('almuerzo')" data-meal="almuerzo">
<div class="p-5">
<div class="flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg, #ea580c20, #f9731620)">
<span class="material-symbols-outlined text-2xl" style="color:#ea580c">restaurant</span>
</div>
<div>
<h3 class="font-bold text-white">Almuerzo</h3>
<p id="almuerzoCal" class="text-sm text-on-surface-variant"><span class="text-yellow-400 font-bold">0</span> kcal</p>
</div>
</div>
<div class="flex items-center gap-2">
<span id="almuerzoCount" class="text-xs text-on-surface-variant bg-surface-container px-2 py-1 rounded-full">0 items</span>
<span class="material-symbols-outlined text-on-surface-variant transition-transform duration-300" id="almuerzoArrow">expand_more</span>
</div>
</div>
<div class="flex gap-3 mt-3 text-xs">
<span class="text-orange-400"><span id="almuerzoProtein">0</span>g prot</span>
<span class="text-yellow-300"><span id="almuerzoFat">0</span>g grasa</span>
<span class="text-cyan-400"><span id="almuerzoCarbs">0</span>g carbs</span>
</div>
</div>
<div id="almuerzoDetail" class="hidden border-t border-white/10">
<div class="p-4">
<div id="almuerzoItems" class="space-y-2 mb-4"></div>
<button onclick="event.stopPropagation(); openFoodSelector('almuerzo')" class="w-full py-3 rounded-xl bg-surface-container text-primary-container font-medium flex items-center justify-center gap-2 hover:bg-surface-container-high transition-all">
<span class="material-symbols-outlined text-sm">add</span>Agregar alimento
</button>
</div>
</div>
</div>

<!-- Cena -->
<div class="meal-card glass-card rounded-2xl overflow-hidden cursor-pointer transition-all duration-300 hover:shadow-lg hover:shadow-primary-container/10" onclick="toggleMealCard('cena')" data-meal="cena">
<div class="p-5">
<div class="flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg, #7c3aed20, #8b5cf620)">
<span class="material-symbols-outlined text-2xl" style="color:#7c3aed">dinner_dining</span>
</div>
<div>
<h3 class="font-bold text-white">Cena</h3>
<p id="cenaCal" class="text-sm text-on-surface-variant"><span class="text-yellow-400 font-bold">0</span> kcal</p>
</div>
</div>
<div class="flex items-center gap-2">
<span id="cenaCount" class="text-xs text-on-surface-variant bg-surface-container px-2 py-1 rounded-full">0 items</span>
<span class="material-symbols-outlined text-on-surface-variant transition-transform duration-300" id="cenaArrow">expand_more</span>
</div>
</div>
<div class="flex gap-3 mt-3 text-xs">
<span class="text-orange-400"><span id="cenaProtein">0</span>g prot</span>
<span class="text-yellow-300"><span id="cenaFat">0</span>g grasa</span>
<span class="text-cyan-400"><span id="cenaCarbs">0</span>g carbs</span>
</div>
</div>
<div id="cenaDetail" class="hidden border-t border-white/10">
<div class="p-4">
<div id="cenaItems" class="space-y-2 mb-4"></div>
<button onclick="event.stopPropagation(); openFoodSelector('cena')" class="w-full py-3 rounded-xl bg-surface-container text-primary-container font-medium flex items-center justify-center gap-2 hover:bg-surface-container-high transition-all">
<span class="material-symbols-outlined text-sm">add</span>Agregar alimento
</button>
</div>
</div>
</div>

<!-- Snacks -->
<div class="meal-card glass-card rounded-2xl overflow-hidden cursor-pointer transition-all duration-300 hover:shadow-lg hover:shadow-primary-container/10" onclick="toggleMealCard('snacks')" data-meal="snacks">
<div class="p-5">
<div class="flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg, #db277720, #ec489920)">
<span class="material-symbols-outlined text-2xl" style="color:#db2777">cookie</span>
</div>
<div>
<h3 class="font-bold text-white">Snacks</h3>
<p id="snacksCal" class="text-sm text-on-surface-variant"><span class="text-yellow-400 font-bold">0</span> kcal</p>
</div>
</div>
<div class="flex items-center gap-2">
<span id="snacksCount" class="text-xs text-on-surface-variant bg-surface-container px-2 py-1 rounded-full">0 items</span>
<span class="material-symbols-outlined text-on-surface-variant transition-transform duration-300" id="snacksArrow">expand_more</span>
</div>
</div>
<div class="flex gap-3 mt-3 text-xs">
<span class="text-orange-400"><span id="snacksProtein">0</span>g prot</span>
<span class="text-yellow-300"><span id="snacksFat">0</span>g grasa</span>
<span class="text-cyan-400"><span id="snacksCarbs">0</span>g carbs</span>
</div>
</div>
<div id="snacksDetail" class="hidden border-t border-white/10">
<div class="p-4">
<div id="snacksItems" class="space-y-2 mb-4"></div>
<button onclick="event.stopPropagation(); openFoodSelector('snacks')" class="w-full py-3 rounded-xl bg-surface-container text-primary-container font-medium flex items-center justify-center gap-2 hover:bg-surface-container-high transition-all">
<span class="material-symbols-outlined text-sm">add</span>Agregar alimento
</button>
</div>
</div>
</div>
</div>

<script is:inline>
if (typeof window.currentDay !== 'string' || !window.currentDay) {
window.currentDay = new Date().toISOString().slice(0, 10);
}
var currentDay = window.currentDay;

// Toggle meal card expansion
function toggleMealCard(meal) {
const detail = document.getElementById(meal + 'Detail');
const arrow = document.getElementById(meal + 'Arrow');
const card = document.querySelector('[data-meal="' + meal + '"]');

if (detail.classList.contains('hidden')) {
detail.classList.remove('hidden');
arrow.style.transform = 'rotate(180deg)';
card.classList.add('border-l-4');
card.style.borderLeftColor = 'var(--primary)';
} else {
detail.classList.add('hidden');
arrow.style.transform = 'rotate(0deg)';
card.classList.remove('border-l-4');
card.style.borderLeftColor = 'transparent';
}
}

// Render meal items inside cards
function renderMealCardItems() {
['desayuno', 'almuerzo', 'cena', 'snacks'].forEach(function(meal) {
const container = document.getElementById(meal + 'Items');
const plan = getMealPlan(currentDay);
const items = plan[meal] || [];

if (items.length === 0) {
container.innerHTML = '<p class="text-center text-on-surface-variant py-4 text-sm">Sin alimentos agregados</p>';
return;
}

var html = '';
items.forEach(function(item, idx) {
var portion = parseFloat(item.portion) || 100;
var totals = KetoMealPlan.itemTotals(item);
var cal = totals.calories, prot = totals.protein, fat = totals.fat, carbs = totals.carbs;

html += '<div class="flex items-center justify-between bg-surface-container rounded-lg p-3">';
html += '<div class="flex-1 min-w-0">';
html += '<p class="text-white text-sm font-medium truncate">' + (item.name || '?') + '</p>';
html += '<p class="text-xs text-on-surface-variant">' + portion + 'g · ' + cal + ' kcal</p>';
html += '</div>';
html += '<button onclick="removeMealItem(\'' + meal + '\', ' + idx + ')" class="w-8 h-8 rounded-lg flex items-center justify-center text-error/60 hover:text-error hover:bg-error/10 transition-colors">';
html += '<span class="material-symbols-outlined text-sm">delete</span>';
html += '</button>';
html += '</div>';
});

container.innerHTML = html;
});
}

// Remove meal item
function removeMealItem(meal, idx) {
var plan = getMealPlan(currentDay);
plan[meal].splice(idx, 1);
saveMealPlanForDate(currentDay, plan);
renderMealPlan();
renderMealCardItems();
updateMealCardMacros();
initWeekSelector();
initCalendar();
}

// Update meal card macros display
function updateMealCardMacros() {
var plan = getMealPlan(currentDay);
var totalCal = 0, totalProt = 0, totalFat = 0, totalCarbs = 0;

['desayuno', 'almuerzo', 'cena', 'snacks'].forEach(function(meal) {
var items = plan[meal] || [];
var mealCal = 0, mealProt = 0, mealFat = 0, mealCarbs = 0;

items.forEach(function(item) {
var totals = KetoMealPlan.itemTotals(item);
mealCal += totals.calories;
mealProt += totals.protein;
mealFat += totals.fat;
mealCarbs += totals.carbs;
});

document.getElementById(meal + 'Cal').innerHTML = '<span class="text-yellow-400 font-bold">' + mealCal + '</span> kcal';
document.getElementById(meal + 'Protein').textContent = mealProt;
document.getElementById(meal + 'Fat').textContent = mealFat;
document.getElementById(meal + 'Carbs').textContent = mealCarbs;
document.getElementById(meal + 'Count').textContent = items.length + ' items';

totalCal += mealCal;
totalProt += mealProt;
totalFat += mealFat;
totalCarbs += mealCarbs;
});

document.getElementById('currentCal').textContent = totalCal;
document.getElementById('currentProtein').textContent = totalProt;
document.getElementById('currentFat').textContent = totalFat;
document.getElementById('currentCarbs').textContent = totalCarbs;

// Update progress bars
var macros = JSON.parse(localStorage.getItem('keto_macros') || '{}');
var targetCal = parseInt(macros.calories) || 1800;
var targetProt = parseInt(macros.protein) || 160;
var targetFat = parseInt(macros.fat) || 150;
var targetCarbs = parseInt(macros.carbs) || 25;

document.getElementById('calorieBar').style.width = Math.min(100, (totalCal / targetCal * 100)) + '%';
document.getElementById('proteinBar').style.width = Math.min(100, (totalProt / targetProt * 100)) + '%';
document.getElementById('fatBar').style.width = Math.min(100, (totalFat / targetFat * 100)) + '%';
document.getElementById('carbsBar').style.width = Math.min(100, (totalCarbs / targetCarbs * 100)) + '%';

document.getElementById('targetCal').textContent = targetCal;
document.getElementById('targetProtein').textContent = targetProt;
document.getElementById('targetFat').textContent = targetFat;
document.getElementById('targetCarbs').textContent = targetCarbs;

document.getElementById('mealCount').textContent = (plan.desayuno.length + plan.almuerzo.length + plan.cena.length + plan.snacks.length);
}

// Initialize calendar
var currentWeekOffset = 0;
function getMealPlanForCalendar(dateKey){
if(typeof getMealPlan==="function"){
try{
var existing=getMealPlan(dateKey);
if(existing&&typeof existing==="object"){return existing;}
}catch(e){}
}
var stored={};
try{
stored=JSON.parse(localStorage.getItem("mealPlan_"+dateKey)||"{}");
}catch(e){
stored={};
}
if(!stored||typeof stored!=="object"||Object.keys(stored).length===0){
stored={desayuno:[],almuerzo:[],cena:[],snacks:[]};
}
if(!stored.desayuno)stored.desayuno=[];
if(!stored.almuerzo)stored.almuerzo=[];
if(!stored.cena)stored.cena=[];
if(!stored.snacks)stored.snacks=[];
return stored;
}
function initCalendar() {
var container = document.getElementById('calendarDays');
if(!container)return;
var today = new Date();
var dayOfWeek = today.getDay();
var monday = new Date(today);
monday.setDate(today.getDate() - (dayOfWeek <= 0 ? 6 : dayOfWeek - 1));
monday.setDate(monday.getDate() + (currentWeekOffset * 7));

var weekDays = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
var html = '';

for (var i = 0; i < 7; i++) {
var d = new Date(monday);
d.setDate(monday.getDate() + i);
if(isNaN(d.getTime()))continue;
var dateKey = d.toISOString().slice(0, 10);
var isToday = dateKey === today.toISOString().slice(0, 10);
var isSelected = dateKey === currentDay;

var plan = getMealPlanForCalendar(dateKey);
var itemCount = (plan.desayuno ? plan.desayuno.length : 0) + (plan.almuerzo ? plan.almuerzo.length : 0) + (plan.cena ? plan.cena.length : 0) + (plan.snacks ? plan.snacks.length : 0);
var hasContent = itemCount > 0;

var bgColor = isSelected ? 'bg-primary-container' : (isToday ? 'bg-surface-container-high' : 'bg-surface-container');
var borderColor = isSelected ? 'border-primary-container' : 'border-transparent';
var dotColor = hasContent ? 'bg-green-500' : 'bg-surface-container-highest';

html += '<button onclick="selectDay(\'' + dateKey + '\')" class="flex flex-col items-center p-2 rounded-xl transition-all ' + bgColor + ' border-2 ' + borderColor + '">';
html += '<span class="text-[10px] uppercase ' + (isToday ? 'text-primary-container font-bold' : 'text-on-surface-variant') + '">' + weekDays[i] + '</span>';
html += '<span class="text-lg font-bold ' + (isSelected || isToday ? 'text-white' : 'text-on-surface') + '">' + d.getDate() + '</span>';
html += '<div class="w-2 h-2 rounded-full mt-1 ' + dotColor + '"></div>';
html += '</button>';
}

container.innerHTML = html;

// Update date label
var selectedDate = new Date(currentDay);
var dateLabel=document.getElementById('dayDateLabel');
if(dateLabel&&!isNaN(selectedDate.getTime())){
dateLabel.textContent = selectedDate.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'short' });
}
}

function navigateWeek(direction) {
currentWeekOffset += direction;
initCalendar();
}

// Override selectDay to also update calendar
if (typeof selectDay === 'function') {
  var originalSelectDay = selectDay;
  selectDay = function(dateKey) {
    originalSelectDay(dateKey);
    initCalendar();
    updateMealCardMacros();
    renderMealCardItems();
  };
}

// Initialize on load
document.addEventListener('DOMContentLoaded', function() {
  initCalendar();
  updateMealCardMacros();
  renderMealCardItems();
});
</script>
