        '</div>' +
        '<div class="bg-surface-container-high rounded-xl p-4">' +
          '<h3 class="text-sm font-bold text-white mb-3">Ingredientes a Evitar (opcional)</h3>' +
          '<textarea id="aiRecipeAvoid" placeholder="Ej: cerdo, mariscos..." class="w-full px-3 py-2 rounded-lg bg-surface-container text-white border border-white/10 focus:border-primary-container resize-none h-20"></textarea>' +
        '</div>' +
        '<div id="aiRecipeResult" class="hidden"></div>' +
      '</div>' +
      '<div class="p-4 bg-surface-container-high border-t border-white/10">' +
        '<button onclick="generateAIReccipe()" id="btnGenerateAIReccipe" class="w-full py-3 rounded-xl bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold hover:opacity-90 transition-all flex items-center justify-center gap-2">' +
          '<span class="material-symbols-outlined">auto_awesome</span>Generar Receta' +
        '</button>' +
      '</div>' +
    '</div>';
}

var selectedAIMealType = 'almuerzo';

function selectMealTypeForAI(mealType) {
  selectedAIMealType = mealType;
  var types = ['desayuno', 'almuerzo', 'cena', 'snacks'];
  types.forEach(function(t) {
    var btn = document.getElementById('aiType' + t.charAt(0).toUpperCase() + t.slice(1));
    if (btn) {
      if (t === mealType) {
        btn.classList.add('border-primary-container', 'bg-primary-container/30');
        btn.classList.remove('border-transparent');
      } else {
        btn.classList.remove('border-primary-container', 'bg-primary-container/30');
        btn.classList.add('border-transparent');
      }
    }
  });
}

async function generateAIReccipe() {
  var btn = document.getElementById('btnGenerateAIReccipe');
  var resultDiv = document.getElementById('aiRecipeResult');
  
  if (!window.KetoAI) {
    window.showToast('IA no disponible. Usa el generador normal.', 3000, 'warning');
    return;
  }
  
  var macros = {
    calories: parseInt(document.getElementById('aiRecipeCalories').value) || 400,
    netCarbs: parseInt(document.getElementById('aiRecipeNetCarbs').value) || 8,
    protein: parseInt(document.getElementById('aiRecipeProtein').value) || 25,
    fat: parseInt(document.getElementById('aiRecipeFat').value) || 30
  };
  
  var evitar = document.getElementById('aiRecipeAvoid').value.split(',').map(function(s) { return s.trim(); }).filter(function(s) { return s.length > 0; });
  
  btn.disabled = true;
  btn.innerHTML = '<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> Generando...';
  resultDiv.classList.add('hidden');
  
  try {
    var receta = await window.KetoAI.generarRecetaKeto(selectedAIMealType, macros);
    
    if (receta) {
      resultDiv.innerHTML = '<div class="bg-green-500/10 border border-green-500/30 rounded-xl p-4">' +
        '<div class="flex items-center gap-2 mb-3">' +
          '<span class="material-symbols-outlined text-green-400">check_circle</span>' +
          '<h4 class="font-bold text-white">¡Receta Generada!</h4>' +
        '</div>' +
        '<div class="bg-surface-container rounded-lg p-3 mb-3">' +
          '<h5 class="font-bold text-white text-lg">' + receta.nombre + '</h5>' +
          '<div class="flex gap-3 text-xs mt-2 text-on-surface-variant">' +
            '<span>Tiempo: ' + (receta.tiempoPrep || 20) + ' min</span>' +
            '<span>Dificultad: ' + (receta.dificultad || 'fácil') + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="bg-surface-container rounded-lg p-3 mb-3">' +
          '<h5 class="text-sm font-bold text-white mb-2">Ingredientes</h5>' +
          '<ul class="text-sm text-white/80 space-y-1">';
      
      (receta.ingredientes || []).forEach(function(ing) {
        resultDiv.innerHTML += '<li>• ' + (ing.cantidad || '') + ' ' + (ing.nombre || ing) + '</li>';
      });
      
      resultDiv.innerHTML += '</ul></div>' +
        '<div class="flex gap-2 mt-4">' +
          '<button onclick="addGeneratedRecipeToPlan(' + JSON.stringify(receta).replace(/"/g, '&quot;') + ')" class="flex-1 py-2 rounded-xl bg-green-500 text-white font-bold text-sm">Agregar al Plan</button>' +
          '<button onclick="closeAIRecipeGenerator()" class="flex-1 py-2 rounded-xl bg-surface-container text-white text-sm">Cerrar</button>' +
        '</div>' +
      '</div>';
      resultDiv.classList.remove('hidden');
    } else {
      window.showToast('Error al generar receta', 3000, 'error');
    }
  } catch(e) {
    console.error('[generateAIReccipe] Error:', e);
    window.showToast('Error: ' + e.message, 3000, 'error');
  }
  
  btn.disabled = false;
  btn.innerHTML = '<span class="material-symbols-outlined">auto_awesome</span>Generar Receta';
}

function addGeneratedRecipeToPlan(receta) {
  var plan = { desayuno: [], almuerzo: [], cena: [], snacks: [] };
  var mealType = receta.mealType || 'almuerzo';
  
  plan[mealType] = [{
    id: 'ai_' + Date.now(),
    name: receta.nombre,
    portion: receta.porciones || 1,
    calories: receta.macrosPorcion?.calories || 400,
    protein: receta.macrosPorcion?.protein || 25,
    fat: receta.macrosPorcion?.fat || 30,
    carbs: receta.macrosPorcion?.netCarbs || 8,
    netCarbs: receta.macrosPorcion?.netCarbs || 8,
    isRecipe: true,
    isAIGenerated: true,
    aiRecipeData: receta
  }];
  
  saveMealPlanForDate(currentDay, plan);
  closeAIRecipeGenerator();
  renderMealPlan();
  
  window.showToast('Receta de IA agregada al plan', 3000, 'success');
}

function closeAIRecipeGenerator() {
  var modal = document.getElementById('aiRecipeModal');
  if (modal) {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
}

// Override renderMealPlan para nuevas tarjetas
function renderMealPlan(){
    updateMealCardMacros();
    renderMealCardItems();
    initCalendar();
}

// Fix selectDay
if (typeof selectDay === 'function') {
  var originalSelectDay = selectDay;
  selectDay = function(dateKey){
    currentDay = dateKey;
    window.currentDay = currentDay;
    var d = new Date(dateKey);
    var dateDisplay = document.getElementById("dateDisplay");
    if(dateDisplay) {
      dateDisplay.textContent = d.toLocaleDateString("es-ES",{weekday:"long",day:"numeric",month:"long"});
    }
    updateMealCardMacros();
    renderMealCardItems();
    initCalendar();
  };
}

// Fix copyPlan
function copyPlan(){
    var plan = getMealPlan(currentDay);
    var yesterday = new Date(currentDay);
    yesterday.setDate(yesterday.getDate()-1);
    var yesterdayKey = yesterday.toISOString().slice(0,10);
    var yesterdayPlan = getMealPlan(yesterdayKey);
    
    if(yesterdayPlan.desayuno.length > 0 || yesterdayPlan.almuerzo.length > 0 || yesterdayPlan.cena.length > 0 || yesterdayPlan.snacks.length > 0){
        saveMealPlanForDate(currentDay, yesterdayPlan);
        updateMealCardMacros();
        renderMealCardItems();
        initWeekSelector();
        initCalendar();
        if(typeof showToast === 'function') showToast("Plan copiado de ayer!", 3000, "success");
    } else {
        if(typeof showToast === 'function') showToast("No hay plan de ayer para copiar", 3000, "warning");
    }
}

// Fix resetPlan  
async function resetPlan(){
    if(!confirm("¿Reiniciar el plan del día?")) return;
    var plan = {desayuno:[], almuerzo:[], cena:[], snacks:[]};
    saveMealPlanForDate(currentDay, plan);
    updateMealCardMacros();
    renderMealCardItems();
    initWeekSelector();
    initCalendar();
    if(typeof showToast === 'function') showToast("Plan reiniciado", 2000);
}

// Open weekly modal
function openWeeklyModal(){
    var modal = document.getElementById('weeklyModal');
    if(modal){
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        renderWeeklyModalContent();
    }
}

function closeWeeklyModal(){
    var modal = document.getElementById('weeklyModal');
    if(modal){
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
}

function renderWeeklyModalContent(){
    var container = document.getElementById('weeklyDayList');
    if(!container) return;
    
    var today = new Date();
    var dayOfWeek = today.getDay();
    var monday = new Date(today);
    monday.setDate(today.getDate() - (dayOfWeek <= 0 ? 6 : dayOfWeek - 1));
    var weekDays = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
    
    var html = '';
    for(var i = 0; i < 7; i++){
        var d = new Date(monday);
        d.setDate(monday.getDate() + i);
        var dateKey = d.toISOString().slice(0,10);
        var isToday = dateKey === today.toISOString().slice(0,10);
        var plan = getMealPlan(dateKey);
        var itemCount = (plan.desayuno.length || 0) + (plan.almuerzo.length || 0) + (plan.cena.length || 0) + (plan.snacks.length || 0);
        
        html += '<div class="flex items-center justify-between p-3 rounded-xl ' + (isToday ? 'bg-primary-container/20' : 'bg-surface-container') + '">';
        html += '<div>';
        html += '<p class="text-sm font-medium text-white">' + (isToday ? 'Hoy - ' : '') + weekDays[i] + ' ' + d.getDate() + '</p>';
        html += '<p class="text-xs ' + (itemCount > 0 ? 'text-green-400' : 'text-white/50') + '">' + itemCount + ' alimentos</p>';
        html += '</div>';
        html += '<button onclick="selectDay(\'' + dateKey + '\'); closeWeeklyModal();" class="px-3 py-1.5 rounded-lg bg-surface-container-high text-white text-xs">Ver</button>';
        html += '</div>';
    }
    container.innerHTML = html;
}

// Initialize
setMealPlanMode('manual');
</script>

