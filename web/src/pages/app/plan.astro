function showMacroLimitModalForAdd(meal, itemKey, food, maxPortion, target, currentTotal, originalPortion) {
  var existing = document.getElementById('macroLimitModal');
  if (existing) existing.remove();
  
  var suggestedPortion = maxPortion || 0;
  var calPerGram = (food.calories || 0) / 100;
  var protPerGram = (food.protein || 0) / 100;
  var newCal = Math.round(calPerGram * suggestedPortion);
  var newProt = Math.round(protPerGram * suggestedPortion * 10) / 10;
  
  var modal = document.createElement('div');
  modal.id = 'macroLimitModal';
  modal.className = 'fixed inset-0 z-[90] flex items-center justify-center p-4 pointer-events-none';
  modal.innerHTML = '<div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeMacroLimitModal()"></div>' +
    '<div class="glass-card rounded-2xl p-5 w-full max-w-sm pointer-events-auto">' +
      '<div class="flex items-center gap-3 mb-4">' +
        '<div class="w-10 h-10 rounded-full bg-yellow-500/20 flex items-center justify-center"><span class="material-symbols-outlined text-yellow-400">warning</span></div>' +
        '<div><h3 class="text-lg font-headline font-bold text-white">Límite de Macros</h3><p class="text-xs text-white/60">' + (food ? food.name : 'Alimento') + ' excedería objetivos</p></div>' +
        '<button onclick="closeMacroLimitModal()" class="w-11 h-11 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-all ml-auto"><span class="material-symbols-outlined text-lg">close</span></button>' +
      '</div>' +
      '<div class="bg-surface-container rounded-xl p-4 mb-4">' +
        '<div class="grid grid-cols-2 gap-4 mb-3">' +
          '<div><p class="text-xs text-white/60">Calorías</p><p class="text-sm font-bold text-yellow-400">' + currentTotal.calories + ' / ' + target.calories + '</p></div>' +
          '<div><p class="text-xs text-white/60">Proteína</p><p class="text-sm font-bold text-orange-400">' + currentTotal.protein.toFixed(1) + ' / ' + target.protein + 'g</p></div>' +
        '</div>';
  
  if (suggestedPortion > 0) {
    modal.querySelector('.glass-card').innerHTML += '<p class="text-xs text-white/60">Puedes agregar hasta <span class="text-white font-bold">' + suggestedPortion + 'g</span> (' + newCal + ' cal, ' + newProt + 'g prot)</p></div>' +
      '<div class="flex gap-3">' +
        '<button onclick="closeMacroLimitModal()" class="flex-1 py-3 rounded-xl bg-surface-container text-white font-medium hover:bg-surface-container-highest transition-colors">Cancelar</button>' +
        '<button onclick="addFoodWithPortion(\'' + meal + '\',\'' + itemKey + '\',' + suggestedPortion + ')" class="flex-1 py-3 rounded-xl bg-primary-container text-white font-bold hover:bg-primary-container/80 transition-colors">Agregar ' + suggestedPortion + 'g</button>' +
      '</div>';
  } else {
    modal.querySelector('.glass-card').innerHTML += '<p class="text-xs text-red-400">No hay espacio suficiente para agregar este alimento</p></div>' +
      '<button onclick="closeMacroLimitModal()" class="w-full py-3 rounded-xl bg-surface-container text-white font-medium hover:bg-surface-container-highest transition-colors">Aceptar</button>';
  }
  
  document.body.appendChild(modal);
}

function closeMacroLimitModal() {
  var modal = document.getElementById('macroLimitModal');
  if (modal) modal.remove();
}

function applySuggestedPortion(meal, idx, portion) {
  closeMacroLimitModal();
  if (!generatedAutoPlan || !generatedAutoPlan.plan || !generatedAutoPlan.plan[meal] || !generatedAutoPlan.plan[meal][idx]) return;
  
  var item = generatedAutoPlan.plan[meal][idx];
  var basePortion = item.basePortion || item.portion;
  var ratio = portion / basePortion;
  
  item.portion = portion;
  item.calories = Math.round((item.baseCalories || item.calories) * ratio);
  item.protein = Math.round((item.baseProtein || item.protein) * ratio * 10) / 10;
  item.fat = Math.round((item.baseFat || item.fat) * ratio * 10) / 10;
  item.carbs = Math.round((item.baseCarbs || item.carbs) * ratio * 10) / 10;
  
  var total = { calories: 0, protein: 0, fat: 0, carbs: 0 };
  Object.keys(generatedAutoPlan.plan).forEach(function(m) {
    generatedAutoPlan.plan[m].forEach(function(i) {
      total.calories += i.calories || 0;
      total.protein += i.protein || 0;
      total.fat += i.fat || 0;
      total.carbs += i.carbs || 0;
    });
  });
  generatedAutoPlan.resultMacros = total;
  
  showAutoMealDetails(meal);
  renderAutoPlanSummary(generatedAutoPlan, document.getElementById('autoPlanSummary'));
}

function addFoodWithPortion(meal, itemKey, portion) {
  var sessionKey = 'autoPlanWarningMeal_' + currentDay;
  if (!sessionStorage.getItem(sessionKey)) {
    showAutoPlanWarning(function() {
      executeAddFoodWithPortion(meal, itemKey, portion);
    });
    return;
  }
  executeAddFoodWithPortion(meal, itemKey, portion);
}

function executeAddFoodWithPortion(meal, itemKey, portion) {
  closeMacroLimitModal();
  var despensa = getDespensa();
  var foods = getFoods();
  var item = despensa[itemKey];
  var food = foods.find(function(f) { return f.id === itemKey });
  if (!item || !food || !generatedAutoPlan || !generatedAutoPlan.plan || !generatedAutoPlan.plan[meal]) return;
  
  var basePortion = 100;
  var ratio = portion / basePortion;
  
  var newItem = {
    name: food.name,
    portion: portion,
    basePortion: basePortion,
    baseCalories: food.calories || 0,
    baseProtein: food.protein || 0,
    baseFat: food.fat || 0,
    baseCarbs: food.carbs || 0,
    calories: Math.round((food.calories || 0) * ratio),
    protein: Math.round((food.protein || 0) * ratio * 10) / 10,
    fat: Math.round((food.fat || 0) * ratio * 10) / 10,
    carbs: Math.round((food.carbs || 0) * ratio * 10) / 10,
    fromDespensa: true,
    despensaKey: itemKey
  };
  
  generatedAutoPlan.plan[meal].push(newItem);
  
  var total = { calories: 0, protein: 0, fat: 0, carbs: 0 };
  Object.keys(generatedAutoPlan.plan).forEach(function(m) {
    generatedAutoPlan.plan[m].forEach(function(i) {
      total.calories += i.calories || 0;
      total.protein += i.protein || 0;
      total.fat += i.fat || 0;
      total.carbs += i.carbs || 0;
    });
  });
  generatedAutoPlan.resultMacros = total;
  
  closeAddFoodModal();
  showAutoMealDetails(meal);
  renderAutoPlanSummary(generatedAutoPlan, document.getElementById('autoPlanSummary'));
}

