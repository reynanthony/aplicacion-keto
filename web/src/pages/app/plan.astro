function generateAndApplyAutoPlan() {
  var summaryDiv = document.getElementById('autoPlanSummary');
  summaryDiv.innerHTML = '<div class="flex items-center justify-center py-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-secondary"></div><span class="ml-3 text-on-surface-variant">Generando plan desde tu despensa...</span></div>';
  
  setTimeout(function() {
    if (typeof generateAutoMealPlan === 'function') {
