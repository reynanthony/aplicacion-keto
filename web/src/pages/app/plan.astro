var calories=Math.round((parseFloat(food.calories)||0)*ratio);
var protein=Math.round((parseFloat(food.protein)||0)*ratio*10)/10;
var fat=Math.round((parseFloat(food.fat)||0)*ratio*10)/10;
var carbs=Math.round((parseFloat(food.carbs)||0)*ratio*10)/10;
document.getElementById("portionPreview").textContent=totalGrams.toLocaleString()+" g";
document.getElementById("portionCalories").textContent=calories.toLocaleString();
document.getElementById("portionProtein").textContent=protein+"g";
document.getElementById("portionFat").textContent=fat+"g";
document.getElementById("portionCarbs").textContent=carbs+"g";
var despensa=getDespensa();
var availableStock=despensa[foodId]?despensa[foodId].stock:0;
var stockWarning=document.getElementById("stockWarning");
if(availableStock>0&&totalGrams>availableStock){
stockWarning.classList.remove("hidden");
