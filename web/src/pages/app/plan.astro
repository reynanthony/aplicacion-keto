<div id="panelSuple" class="hidden space-y-4">
  <div id="supleContent"></div>
  <a href="/app/suplementos" class="flex items-center justify-center gap-2 w-full py-4 rounded-2xl bg-surface-container-high text-white font-bold text-sm hover:bg-surface-container-highest transition-all border border-white/10">
    <span class="material-symbols-outlined">medication</span>
    <span>Gestionar Stack</span>
    <span class="material-symbols-outlined text-base">arrow_forward</span>
  </a>
</div>

<script is:inline>
// ===== PLAN SUB-TABS =====
var _activePlanTab = 'nutricion';

function switchPlanTab(tab) {
  _activePlanTab = tab;
  var panels = { nutricion: 'panelNutricion', entreno: 'panelEntreno', suple: 'panelSuple' };
  var tabs = { nutricion: 'tabNutricion', entreno: 'tabEntreno', suple: 'tabSuple' };
  Object.keys(panels).forEach(function(k) {
    var panel = document.getElementById(panels[k]);
    var btn = document.getElementById(tabs[k]);
    if (k === tab) {
      panel.classList.remove('hidden');
      btn.classList.add('bg-surface-container-high', 'text-white');
      btn.classList.remove('text-white/50', 'text-white/80');
    } else {
      panel.classList.add('hidden');
      btn.classList.remove('bg-surface-container-high', 'text-white');
      btn.classList.add('text-white/50');
    }
  });
  if (tab === 'entreno') renderEntrenoPanel();
  if (tab === 'suple') renderSuplePanel();
}

// ===== ENTRENO PANEL =====
function renderEntrenoPanel() {
  var workouts = safeParseJSON(localStorage.getItem('ketoWorkouts'), []);
  var today = new Date().toISOString().slice(0, 10);
  var todayWorkout = workouts.find(function(w) { return (w.date || '').slice(0, 10) === today; });
  var totalSessions = workouts.length;
  var streak = calcWorkoutStreak(workouts);
  var totalVol = workouts.reduce(function(sum, w) { return sum + (w.totalVolume || 0); }, 0);

  // Stats row
  document.getElementById('entrenoStatsRow').innerHTML = [
    { icon: 'bolt', val: totalSessions, label: 'Sesiones', color: 'text-orange-400' },
    { icon: 'local_fire_department', val: streak + ' días', label: 'Racha', color: 'text-yellow-400' },
    { icon: 'monitor_weight', val: Math.round(totalVol / 1000) + ' ton', label: 'Volumen total', color: 'text-green-400' }
  ].map(function(s) {
    return '<div class="glass-card rounded-xl p-3 text-center"><span class="material-symbols-outlined ' + s.color + ' text-2xl">' + s.icon + '</span><p class="' + s.color + ' text-xl font-black mt-1">' + s.val + '</p><p class="text-on-surface-variant text-[10px] mt-0.5">' + s.label + '</p></div>';
  }).join('');

  // Today card
  var todayHtml;
  if (todayWorkout) {
    var exList = (todayWorkout.exercises || []).slice(0, 4).map(function(ex) {
      return '<div class="flex items-center justify-between py-2 border-b border-white/5 last:border-0"><span class="text-white/80 text-sm">' + escapeHtml(ex.name || ex.exerciseName || 'Ejercicio') + '</span><span class="text-primary-container text-xs font-bold">' + (ex.sets ? ex.sets.length : (ex.sets || 0)) + ' series</span></div>';
    }).join('');
    todayHtml = '<div class="glass-card rounded-2xl p-4 border-l-4 border-green-500"><div class="flex items-center gap-3 mb-3"><div class="w-10 h-10 rounded-xl bg-green-500/20 flex items-center justify-center"><span class="material-symbols-outlined text-green-400">check_circle</span></div><div><p class="text-white font-bold">Entrenamiento hoy</p><p class="text-on-surface-variant text-xs">' + escapeHtml(todayWorkout.name || 'Sesión completada') + ' · ' + (todayWorkout.duration || '—') + ' min</p></div></div>' + (exList ? '<div class="mt-2">' + exList + '</div>' : '') + '</div>';
  } else {
    todayHtml = '<div class="glass-card rounded-2xl p-6 text-center border border-dashed border-white/10"><span class="material-symbols-outlined text-4xl text-white/20 mb-3 block">fitness_center</span><p class="text-white font-bold mb-1">Sin entrenamiento hoy</p><p class="text-on-surface-variant text-sm mb-4">¿Listo para entrenar?</p><a href="/app/entrenamientos" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-container text-white font-bold text-sm hover:bg-primary-container/80 transition-all"><span class="material-symbols-outlined text-sm">add</span>Registrar entreno</a></div>';
  }
  document.getElementById('entrenoTodayCard').innerHTML = todayHtml;

  // Recent workouts (last 3, skip today)
  var recent = workouts.filter(function(w) { return (w.date || '').slice(0, 10) !== today; }).slice(-3).reverse();
  if (recent.length) {
    document.getElementById('entrenoRecentList').innerHTML = '<p class="text-xs text-on-surface-variant uppercase tracking-wider mb-2">Recientes</p>' + recent.map(function(w) {
      var d = new Date(w.date);
      var label = isNaN(d.getTime()) ? '' : d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' });
      return '<div class="glass-card rounded-xl p-3 flex items-center gap-3"><div class="w-9 h-9 rounded-lg bg-surface-container-high flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-primary-container text-lg">fitness_center</span></div><div class="flex-1 min-w-0"><p class="text-white text-sm font-medium truncate">' + escapeHtml(w.name || 'Sesión') + '</p><p class="text-on-surface-variant text-xs">' + label + (w.duration ? ' · ' + w.duration + ' min' : '') + '</p></div><span class="text-green-400 text-xs font-bold">' + (w.totalVolume ? Math.round(w.totalVolume) + ' kg' : '') + '</span></div>';
    }).join('');
  } else {
    document.getElementById('entrenoRecentList').innerHTML = '';
  }
}

function calcWorkoutStreak(workouts) {
  if (!workouts.length) return 0;
  var dates = workouts.map(function(w) { return (w.date || '').slice(0, 10); }).filter(Boolean).sort().reverse();
  var unique = dates.filter(function(d, i) { return dates.indexOf(d) === i; });
  var streak = 0;
  var check = new Date();
  for (var i = 0; i < unique.length; i++) {
    var d = check.toISOString().slice(0, 10);
    if (unique[i] === d || (i === 0 && unique[0] === new Date(check - 86400000).toISOString().slice(0, 10))) {
      streak++;
      check.setDate(check.getDate() - 1);
    } else break;
  }
  return streak;
}

// ===== SUPLE PANEL =====
function renderSuplePanel() {
  var supls = safeParseJSON(localStorage.getItem('user_supplements'), []);
  var today = new Date().toISOString().slice(0, 10);
  var taken = safeParseJSON(localStorage.getItem('suple_taken_' + today), {});
  var container = document.getElementById('supleContent');

  if (!supls.length) {
    container.innerHTML = '<div class="glass-card rounded-2xl p-6 text-center border border-dashed border-white/10"><span class="material-symbols-outlined text-4xl text-white/20 mb-3 block">medication</span><p class="text-white font-bold mb-1">Sin suplementos configurados</p><p class="text-on-surface-variant text-sm mb-4">Agrega tu stack para ver el horario diario</p><a href="/app/suplementos" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-container text-white font-bold text-sm hover:bg-primary-container/80 transition-all"><span class="material-symbols-outlined text-sm">add</span>Configurar stack</a></div>';
    return;
  }

  var takenCount = Object.keys(taken).filter(function(k) { return taken[k]; }).length;
  var progress = Math.round(takenCount / supls.length * 100);

  var html = '<div class="glass-card rounded-xl p-4 mb-4"><div class="flex items-center justify-between mb-2"><span class="text-sm text-white font-medium">Progreso de hoy</span><span class="text-primary-container font-bold text-sm">' + takenCount + '/' + supls.length + '</span></div><div class="h-2 bg-surface rounded-full overflow-hidden"><div class="h-full bg-primary-container rounded-full transition-all" style="width:' + progress + '%"></div></div></div>';

  html += '<div class="space-y-3">';
  supls.forEach(function(s) {
    var isTaken = !!taken[s.id || s.name];
    var id = s.id || s.name;
    html += '<div class="glass-card rounded-xl p-4 flex items-center gap-3 cursor-pointer transition-all ' + (isTaken ? 'opacity-60' : '') + '" onclick="toggleSupleTaken(\'' + escapeHtml(id) + '\')">';
    html += '<div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ' + (isTaken ? 'bg-green-500/20' : 'bg-surface-container-high') + '">';
    html += '<span class="material-symbols-outlined text-[20px] ' + (isTaken ? 'text-green-400' : 'text-primary-container') + '">' + (isTaken ? 'check_circle' : (s.icon || 'medication')) + '</span>';
    html += '</div><div class="flex-1 min-w-0"><p class="text-white text-sm font-medium ' + (isTaken ? 'line-through' : '') + '">' + escapeHtml(s.name) + '</p><p class="text-on-surface-variant text-xs truncate">' + escapeHtml(s.dosage || '') + '</p></div>';
    html += '<span class="text-[10px] bg-surface-container px-2 py-1 rounded-full text-on-surface-variant whitespace-nowrap">' + escapeHtml(s.timing || '—') + '</span>';
    html += '</div>';
  });
  html += '</div>';
  container.innerHTML = html;
}

function toggleSupleTaken(id) {
  var today = new Date().toISOString().slice(0, 10);
  var taken = safeParseJSON(localStorage.getItem('suple_taken_' + today), {});
  taken[id] = !taken[id];
  localStorage.setItem('suple_taken_' + today, JSON.stringify(taken));
  renderSuplePanel();
}
</script>
</div>
</main>
