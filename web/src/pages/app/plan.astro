    window.UserLearning.registrarLikeReceta(recetaId, recetaNombre, ingredientes);
    window.showToast('Me gusta registrado', 2000);
  }
}

function registrarDislikeReceta(recetaId, recetaNombre, ingredientes) {
  if (window.UserLearning) {
    window.UserLearning.registrarDislikeReceta(recetaId, recetaNombre, ingredientes);
    window.showToast('No me gusta registrado', 2000);
  }
}

function registrarCalificacion(recetaId, recetaNombre, calificacion, ingredientes) {
  if (window.UserLearning) {
    window.UserLearning.registrarCalificacion(recetaId, recetaNombre, calificacion, ingredientes);
    window.showToast('Calificacion: ' + calificacion + '/5', 2000);
  }
}

function showRecetaFeedbackModal(recetaId, recetaNombre, ingredientes) {
  var existing = document.getElementById('recetaFeedbackModal');
  if (existing) existing.remove();

  var modal = document.createElement('div');
  modal.id = 'recetaFeedbackModal';
  modal.className = 'fixed inset-0 z-[90] flex items-center justify-center p-4 pointer-events-none';
  modal.innerHTML = '<div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeRecetaFeedbackModal()"></div>' +
    '<div class="bg-surface-container rounded-2xl p-5 w-full max-w-sm pointer-events-auto">' +
      '<div class="flex items-center gap-3 mb-4">' +
        '<span class="material-symbols-outlined text-primary-container text-3xl">thumb_up</span>' +
        '<h3 class="text-lg font-bold text-white">Feedback de Receta</h3>' +
      '</div>' +
      '<p class="text-sm text-on-surface-variant mb-4">¿Que te parecio esta receta?</p>' +
      '<div class="flex justify-center gap-3 mb-4">' +
        '<button onclick="registrarDislikeReceta(\'' + recetaId + '\',\'' + recetaNombre + '\',[]); closeRecetaFeedbackModal();" class="w-14 h-14 rounded-full bg-red-500/20 flex items-center justify-center hover:bg-red-500/30 transition-all">' +
          '<span class="material-symbols-outlined text-red-400 text-3xl">thumb_down</span>' +
        '</button>' +
        '<button onclick="registrarCalificacion(\'' + recetaId + '\',\'' + recetaNombre + '\',3,[]); closeRecetaFeedbackModal();" class="w-14 h-14 rounded-full bg-yellow-500/20 flex items-center justify-center hover:bg-yellow-500/30 transition-all">' +
          '<span class="material-symbols-outlined text-yellow-400 text-3xl">remove</span>' +
        '</button>' +
        '<button onclick="registrarLikeReceta(\'' + recetaId + '\',\'' + recetaNombre + '\',[]); closeRecetaFeedbackModal();" class="w-14 h-14 rounded-full bg-green-500/20 flex items-center justify-center hover:bg-green-500/30 transition-all">' +
          '<span class="material-symbols-outlined text-green-400 text-3xl">thumb_up</span>' +
        '</button>' +
      '</div>' +
      '<button onclick="closeRecetaFeedbackModal()" class="w-full py-3 rounded-xl bg-surface-container-high text-white">Cerrar</button>' +
    '</div>';
  document.body.appendChild(modal);
}

function closeRecetaFeedbackModal() {
  var modal = document.getElementById('recetaFeedbackModal');
  if (modal) modal.remove();
}

function showUserProfileModal() {
  var perfil = window.UserLearning ? window.UserLearning.generarPerfilUsuario() : null;
  var totalFeedbacks = window.UserLearning ? window.UserLearning.getTotalFeedbacks() : 0;
  var topLiked = window.UserLearning ? window.UserLearning.getTopLikedIngredients(5) : [];
  var topDisliked = window.UserLearning ? window.UserLearning.getTopDislikedIngredients(5) : [];

  var existing = document.getElementById('userProfileModal');
  if (existing) existing.remove();

  var modal = document.createElement('div');
  modal.id = 'userProfileModal';
  modal.className = 'fixed inset-0 z-[85] flex items-center justify-center p-4 pointer-events-none';
  
  var nivelColor = perfil && perfil.nivelExperiencia === 'avanzado' ? 'text-green-400' : 
                   perfil && perfil.nivelExperiencia === 'intermedio' ? 'text-yellow-400' : 'text-orange-400';
  
  modal.innerHTML = '<div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeUserProfileModal()"></div>' +
    '<div class="bg-surface-container rounded-2xl p-5 w-full max-w-md max-h-[80vh] overflow-y-auto pointer-events-auto">' +
      '<div class="flex items-center justify-between mb-4">' +
        '<div class="flex items-center gap-3">' +
          '<span class="material-symbols-outlined text-primary-container text-3xl">person</span>' +
          '<h3 class="text-lg font-bold text-white">Tu Perfil Keto</h3>' +
        '</div>' +
        '<button onclick="closeUserProfileModal()" class="w-10 h-10 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10">' +
          '<span class="material-symbols-outlined">close</span>' +
        '</button>' +
      '</div>' +
      
      '<div class="bg-surface-container-high rounded-xl p-4 mb-4">' +
        '<div class="grid grid-cols-2 gap-4 text-center">' +
          '<div><p class="text-xs text-on-surface-variant">Experiencia</p><p class="font-bold ' + nivelColor + '">' + (perfil ? perfil.nivelExperiencia : 'nuevo') + '</p></div>' +
          '<div><p class="text-xs text-on-surface-variant">Feedback</p><p class="font-bold text-white">' + totalFeedbacks + '</p></div>' +
        '</div>' +
      '</div>' +
      
      '<div class="mb-4">' +
        '<h4 class="text-sm font-bold text-green-400 mb-2 flex items-center gap-2"><span class="material-symbols-outlined text-sm">favorite</span>Ingredientes Favoritos</h4>' +
        '<div class="space-y-1">';
  
  if (topLiked.length > 0) {
    topLiked.forEach(function(item) {
      modal.innerHTML += '<div class="flex items-center justify-between text-sm bg-green-500/10 rounded-lg px-3 py-2">' +
        '<span class="text-white">' + item.nombre + '</span>' +
        '<span class="text-green-400">+' + item.score + '</span></div>';
    });
  } else {
    modal.innerHTML += '<p class="text-xs text-on-surface-variant">No hay favoritos aun. ¡Dale like a recetas!</p>';
  }
  
  modal.innerHTML += '</div><div class="mb-4">' +
        '<h4 class="text-sm font-bold text-red-400 mb-2 flex items-center gap-2"><span class="material-symbols-outlined text-sm">block</span>Ingredientes a Evitar</h4>' +
        '<div class="space-y-1">';
  
  if (topDisliked.length > 0) {
    topDisliked.forEach(function(item) {
      modal.innerHTML += '<div class="flex items-center justify-between text-sm bg-red-500/10 rounded-lg px-3 py-2">' +
        '<span class="text-white">' + item.nombre + '</span>' +
        '<span class="text-red-400">' + item.score + '</span></div>';
    });
  } else {
    modal.innerHTML += '<p class="text-xs text-on-surface-variant">No hay ingredientes evitados</p>';
  }
  
  modal.innerHTML += '</div></div>' +
      
      '<div class="flex gap-2">' +
        '<button onclick="closeUserProfileModal()" class="flex-1 py-3 rounded-xl bg-surface-container-high text-white">Cerrar</button>' +
        '<button onclick="exportUserData()" class="flex-1 py-3 rounded-xl bg-primary-container text-white">Exportar Datos</button>' +
      '</div>' +
    '</div>';
  
  document.body.appendChild(modal);
}

function closeUserProfileModal() {
  var modal = document.getElementById('userProfileModal');
  if (modal) modal.remove();
}

function exportUserData() {
  if (window.UserLearning) {
    var data = window.UserLearning.exportData();
    var json = JSON.stringify(data, null, 2);
    var blob = new Blob([json], { type: 'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'keto_profile_' + new Date().toISOString().slice(0, 10) + '.json';
    a.click();
    URL.revokeObjectURL(url);
    window.showToast('Datos exportados', 2000);
  }
}

function calculateAdvancedKetoScore(receta) {
  if (window.KetoScoreCalculator) {
    return window.KetoScoreCalculator.calculateRecipeScore(receta);
  }
  return null;
}

