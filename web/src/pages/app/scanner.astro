---
// Scanner — v3. Única pantalla a pantalla completa y sin Dock (regla del handoff).
// Cámara/BarcodeDetector se conservan intactos de la versión anterior; solo
// cambia el chrome alrededor (pantalla completa, corners/disparador lima,
// timeout de 4s -> "escribir a mano") y el destino tras detectar: abre la
// hoja Veredicto en vez de un result-card inline.
import AppLayout from '../../layouts/AppLayout.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Scanner" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }

    #scanner-root { position: fixed; inset: 0; background: #000; overflow: hidden; z-index: 1; }
    #scanner-video { width: 100%; height: 100%; object-fit: cover; }
    .v3-sc-overlay { position: absolute; inset: 0; pointer-events: none; }
    .v3-sc-frame { position: absolute; top: 18%; left: 10%; right: 10%; bottom: 34%; border-radius: 24px; }
    .v3-sc-corner { position: absolute; width: 38px; height: 38px; }
    .v3-sc-corner.tl { top: 0; left: 0; border-top: 3px solid var(--v3-lime); border-left: 3px solid var(--v3-lime); border-top-left-radius: 16px; }
    .v3-sc-corner.tr { top: 0; right: 0; border-top: 3px solid var(--v3-lime); border-right: 3px solid var(--v3-lime); border-top-right-radius: 16px; }
    .v3-sc-corner.bl { bottom: 0; left: 0; border-bottom: 3px solid var(--v3-lime); border-left: 3px solid var(--v3-lime); border-bottom-left-radius: 16px; }
    .v3-sc-corner.br { bottom: 0; right: 0; border-bottom: 3px solid var(--v3-lime); border-right: 3px solid var(--v3-lime); border-bottom-right-radius: 16px; }
    .v3-sc-line { position: absolute; left: 6%; right: 6%; height: 2px; background: linear-gradient(90deg, transparent, var(--v3-lime), transparent); box-shadow: 0 0 12px var(--v3-lime); animation: v3ScanLine 1.6s ease-in-out infinite; }
    @keyframes v3ScanLine { 0%, 100% { top: 10%; } 50% { top: 90%; } }

    #scanner-back { position: absolute; top: 24px; left: 20px; z-index: 5; width: 40px; height: 40px; border-radius: 50%; background: rgba(0,0,0,0.5); border: none; display: flex; align-items: center; justify-content: center; }
    #scanner-status { position: absolute; top: 26px; left: 0; right: 0; text-align: center; z-index: 4; }

    .v3-sc-controls { position: absolute; bottom: 0; left: 0; right: 0; padding: 0 0 calc(24px + env(safe-area-inset-bottom, 0px)); z-index: 4; background: linear-gradient(to top, rgba(0,0,0,0.65), transparent); }
    .v3-sc-shutter-row { display: flex; align-items: center; justify-content: center; gap: 40px; margin-bottom: 18px; }
    .v3-sc-ctl { width: 48px; height: 48px; border-radius: 14px; background: rgba(255,255,255,0.14); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; border: none; cursor: pointer; }
    .v3-sc-shutter { width: 76px; height: 76px; border-radius: 50%; background: var(--v3-lime); display: flex; align-items: center; justify-content: center; border: 4px solid rgba(255,255,255,0.25); box-shadow: 0 0 28px rgba(200,245,96,0.5); cursor: pointer; }

    #v3-manual-entry { display: none; position: absolute; left: 20px; right: 20px; bottom: 190px; z-index: 5; background: var(--v3-surface-1); border: 1px solid var(--v3-border); border-radius: var(--v3-radius-card); padding: 14px; }
    #v3-text-mode-box { display: none; position: absolute; left: 20px; right: 20px; bottom: 190px; z-index: 5; background: var(--v3-surface-1); border: 1px solid var(--v3-border); border-radius: var(--v3-radius-card); padding: 14px; gap: 10px; }
  </style>

  <div data-v3 id="scanner-root">
    <video id="scanner-video" autoplay playsinline muted></video>
    <div class="v3-sc-overlay">
      <div class="v3-sc-frame">
        <div class="v3-sc-corner tl"></div>
        <div class="v3-sc-corner tr"></div>
        <div class="v3-sc-corner bl"></div>
        <div class="v3-sc-corner br"></div>
        <div class="v3-sc-line"></div>
      </div>
    </div>

    <button id="scanner-back" onclick="location.href='/app/'" aria-label="Volver">
      <span class="material-symbols-outlined" style="color:#fff; font-size:20px">arrow_back</span>
    </button>

    <div id="scanner-status">
      <span style="font-size:13px; font-weight:600; color:rgba(255,255,255,0.9); padding:7px 16px; border-radius:100px; background:rgba(0,0,0,0.45);">Toca el disparador para iniciar la cámara</span>
    </div>

    <div id="v3-manual-entry">
      <p style="font-size:13px; color:var(--v3-text-70); margin-bottom:10px;">No se detectó nada. Escribe el nombre a mano.</p>
      <button type="button" id="btnManualOpen" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); width:100%; justify-content:center;">Escribir a mano</button>
    </div>

    <div id="v3-text-mode-box" style="display:none; flex-direction:column;">
      <input type="text" id="v3-text-name" placeholder="Nombre del alimento"
        style="background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:10px; padding:10px 12px; color:var(--v3-text); font-size:14px; margin-bottom:10px;" />
      <button type="button" id="btnBuscarText" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); width:100%; justify-content:center;">Buscar</button>
    </div>

    <div class="v3-sc-controls">
      <div class="v3-chip-group" style="justify-content:center; margin-bottom:16px; padding:0 20px;">
        <button type="button" class="v3-chip v3-chip--filter" data-chip-group="sc-mode" data-mode="alimento">Alimento</button>
        <button type="button" class="v3-chip v3-chip--filter" data-chip-group="sc-mode" data-mode="etiqueta">Etiqueta</button>
        <button type="button" class="v3-chip v3-chip--filter v3-chip--active" data-chip-group="sc-mode" data-mode="codigo">Código</button>
      </div>
      <div class="v3-sc-shutter-row">
        <button class="v3-sc-ctl" onclick="document.getElementById('galleryInput').click()" aria-label="Abrir galería">
          <span class="material-symbols-outlined" style="color:#fff; font-size:22px">photo_library</span>
        </button>
        <button class="v3-sc-shutter" onclick="toggleCamera()" id="toggleBtn" aria-label="Iniciar o detener cámara">
          <span class="material-symbols-outlined icon-filled" id="cameraIcon" style="color:var(--v3-text-on-lime); font-size:32px">center_focus_strong</span>
        </button>
        <div style="width:48px"></div>
      </div>
      <input type="file" id="galleryInput" accept="image/*" class="hidden" onchange="scanFromImage(this)">
    </div>
  </div>

  <VeredictoSheet />

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/data/keto-inspector-ingredientes.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    var lastScannedCode = null;
    var cameraActive = false;
    var stream = null;
    var detector = null;
    var scanMode = 'codigo';
    var noDetectionTimer = null;

    function setStatus(msg, color) {
      var statusEl = document.getElementById('scanner-status');
      if (!statusEl) return;
      statusEl.innerHTML = '<span style="font-size:13px;font-weight:600;color:' + (color || 'rgba(255,255,255,0.9)') + ';padding:7px 16px;border-radius:100px;background:rgba(0,0,0,0.45);">' + msg + '</span>';
    }

    function armNoDetectionTimeout() {
      clearNoDetectionTimeout();
      noDetectionTimer = setTimeout(function () {
        document.getElementById('v3-manual-entry').style.display = 'block';
      }, 4000);
    }
    function clearNoDetectionTimeout() {
      if (noDetectionTimer) clearTimeout(noDetectionTimer);
      noDetectionTimer = null;
      document.getElementById('v3-manual-entry').style.display = 'none';
    }

    function setScanMode(mode) {
      scanMode = mode;
      document.querySelectorAll('[data-chip-group="sc-mode"]').forEach(function (b) {
        var active = b.getAttribute('data-mode') === mode;
        b.classList.toggle('v3-chip--active', active);
      });
      document.getElementById('v3-text-mode-box').style.display = mode === 'codigo' ? 'none' : 'flex';
      if (mode === 'codigo') {
        setStatus(cameraActive ? 'Apunta al código de barras' : 'Toca el disparador para iniciar la cámara');
        if (cameraActive) armNoDetectionTimeout();
      } else {
        clearNoDetectionTimeout();
        setStatus('Escribe el nombre del producto');
        var input = document.getElementById('v3-text-name');
        if (input) input.focus();
      }
    }

    async function initScanner() {
      var video = document.getElementById('scanner-video');
      try {
        setStatus('Solicitando acceso a cámara…', '#fbbf24');
        stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
        });
        video.srcObject = stream;
        await video.play();
        cameraActive = true;
        setStatus('Cámara activa — apunta al código de barras', '#c8f560');
        document.getElementById('cameraIcon').textContent = 'stop';

        if ('BarcodeDetector' in window) {
          detector = new BarcodeDetector({ formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39'] });
          scanWithDetector();
          if (scanMode === 'codigo') armNoDetectionTimeout();
        } else {
          setStatus('Cámara activa — códigos no soportados en este navegador', '#fbbf24');
        }
      } catch (err) {
        console.error('Camera error:', err);
        setStatus('Error: ' + err.message, '#f87171');
      }
    }

    async function scanWithDetector() {
      if (!cameraActive || !detector) return;
      var video = document.getElementById('scanner-video');
      try {
        var barcodes = await detector.detect(video);
        if (barcodes.length > 0) {
          var code = barcodes[0].rawValue;
          if (code && code !== lastScannedCode) onBarcodeDetected(code);
        }
      } catch (e) {}
      requestAnimationFrame(scanWithDetector);
    }

    async function scanFromImage(input) {
      var file = input.files && input.files[0];
      if (!file) return;
      try {
        if (!('BarcodeDetector' in window)) { setStatus('Detección en imágenes no soportada', '#fbbf24'); return; }
        var det = detector || new BarcodeDetector({ formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39'] });
        var bmp = await createImageBitmap(file);
        var barcodes = await det.detect(bmp);
        if (barcodes.length > 0) onBarcodeDetected(barcodes[0].rawValue);
        else setStatus('No se detectó código en la imagen', '#fbbf24');
      } catch (e) {
        setStatus('No se pudo analizar la imagen', '#f87171');
      } finally {
        input.value = '';
      }
    }

    function onBarcodeDetected(code) {
      lastScannedCode = code;
      clearNoDetectionTimeout();
      playBeep();
      setStatus('Código detectado', '#c8f560');
      window.KetoVeredicto.open({ name: 'Código ' + code, barcode: code }, { redirectAfterAdd: true });
      setTimeout(function () { lastScannedCode = null; }, 3000);
    }

    function playBeep() {
      try {
        var ctx = new (window.AudioContext || window.webkitAudioContext)();
        var osc = ctx.createOscillator();
        var gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.frequency.value = 1800; osc.type = 'sine'; gain.gain.value = 0.3;
        osc.start(); osc.stop(ctx.currentTime + 0.1);
      } catch (e) {}
    }

    function toggleCamera() {
      var video = document.getElementById('scanner-video');
      if (cameraActive) {
        if (stream) stream.getTracks().forEach(function (t) { t.stop(); });
        cameraActive = false;
        video.srcObject = null;
        document.getElementById('cameraIcon').textContent = 'center_focus_strong';
        clearNoDetectionTimeout();
        setStatus('Cámara apagada — toca para reiniciar', '#fbbf24');
      } else {
        initScanner();
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('[data-chip-group="sc-mode"]').forEach(function (btn) {
        btn.addEventListener('click', function () { setScanMode(btn.getAttribute('data-mode')); });
      });

      document.getElementById('btnManualOpen').addEventListener('click', function () {
        document.getElementById('v3-manual-entry').style.display = 'none';
        setScanMode('alimento');
      });

      document.getElementById('btnBuscarText').addEventListener('click', function () {
        var name = document.getElementById('v3-text-name').value.trim();
        if (!name) return;
        var prefill = { name: name, calories: 0, carbs: 0, fat: 0, protein: 0 };
        if (window.inspectorKeto && window.inspectorKeto.inspeccionarProductoTexto) {
          var result = window.inspectorKeto.inspeccionarProductoTexto(name);
          if (result && result.coincidencias && result.coincidencias[0]) {
            var match = result.coincidencias[0];
            prefill.name = match.nombre || name;
            prefill.carbohidratos_netos_100g = match.carbohidratos_netos_100g;
          }
        }
        window.KetoVeredicto.open(prefill, { redirectAfterAdd: true });
      });
    });
  </script>
</AppLayout>
