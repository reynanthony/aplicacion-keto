---
// Scanner Keto IA — UI v2 (HUD nativo). Visor de cámara + resultado editable
// + escaneos recientes reescritos a markup kc-* (AppShell). Lógica de
// cámara/BarcodeDetector/Inspector Keto intacta. Respaldo: scanner.astro.bak
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="Scanner Keto IA" screen="scanner">
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}

.kc .sca-actions{display:flex;justify-content:flex-end;margin-top:8px}
.kc .sca-stack{display:flex;flex-direction:column;gap:18px}

/* Visor */
.kc .sca-view{position:relative;width:100%;height:380px;border-radius:var(--kc-radius-xl);overflow:hidden;background:var(--kc-surface-2);border:1px solid var(--kc-line)}
.kc .sca-view video{width:100%;height:100%;object-fit:cover}
.sca-overlay{position:absolute;inset:0;pointer-events:none}
.sca-frame{position:absolute;top:16%;left:12%;right:12%;bottom:30%;border-radius:20px}
.sca-corner{position:absolute;width:34px;height:34px}
.sca-corner.tl{top:0;left:0;border-top:3px solid var(--kc-amber);border-left:3px solid var(--kc-amber);border-top-left-radius:16px}
.sca-corner.tr{top:0;right:0;border-top:3px solid var(--kc-amber);border-right:3px solid var(--kc-amber);border-top-right-radius:16px}
.sca-corner.bl{bottom:0;left:0;border-bottom:3px solid var(--kc-amber);border-left:3px solid var(--kc-amber);border-bottom-left-radius:16px}
.sca-corner.br{bottom:0;right:0;border-bottom:3px solid var(--kc-amber);border-right:3px solid var(--kc-amber);border-bottom-right-radius:16px}
.sca-scanline{position:absolute;left:6%;right:6%;height:2px;background:linear-gradient(90deg,transparent,var(--kc-amber),transparent);box-shadow:0 0 12px var(--kc-amber);animation:sca-scanline 2.4s ease-in-out infinite}
@keyframes sca-scanline{0%,100%{top:8%}50%{top:92%}}
.kc .sca-status{position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:5;font:600 13px var(--kc-font-sans);padding:7px 16px;border-radius:var(--kc-radius-pill);background:rgba(0,0,0,.45);backdrop-filter:blur(8px);color:rgba(255,255,255,.85);white-space:nowrap}
.kc .sca-status[data-state="loading"]{color:var(--kc-amber)}
.kc .sca-status[data-state="active"]{color:var(--kc-mint)}
.kc .sca-status[data-state="error"]{color:var(--kc-red)}
.kc .sca-controls{position:absolute;bottom:0;left:0;right:0;padding:0 0 22px;z-index:5}
.kc .sca-controls__row{display:flex;align-items:center;justify-content:center;gap:36px;margin-bottom:18px}
.kc .sca-ctl{width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,.12);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;border:0;cursor:pointer;color:#fff;padding:0}
.kc .sca-shutter{width:72px;height:72px;border-radius:50%;background:var(--kc-amber-fill);display:flex;align-items:center;justify-content:center;border:4px solid rgba(255,255,255,.25);box-shadow:var(--kc-glow-amber);cursor:pointer;padding:0;color:var(--kc-on-amber)}
.kc .sca-modes{display:flex;justify-content:center;gap:10px}
.kc .sca-mode{font:600 11.5px var(--kc-font-sans);padding:7px 15px;border-radius:var(--kc-radius-pill);background:rgba(255,255,255,.12);color:rgba(255,255,255,.85);border:0;cursor:pointer;transition:background .14s}
.kc .sca-mode.is-active{background:var(--kc-amber-fill);color:var(--kc-on-amber);font-weight:700}
.kc .sca-hint{text-align:center;margin-top:14px;font:600 12.5px var(--kc-font-sans);letter-spacing:.03em;color:var(--kc-ink-3)}

/* Resultado */
.kc .sca-result__media{height:110px;background:radial-gradient(120% 120% at 50% 0%,color-mix(in oklab,var(--kc-amber) 24%,transparent),transparent 65%),var(--kc-surface-2);display:flex;align-items:center;justify-content:center;position:relative;border-radius:var(--kc-radius-xl) var(--kc-radius-xl) 0 0}
.kc .sca-result__media .material-symbols-outlined{font-size:52px;color:var(--kc-amber);opacity:.85}
.kc .sca-result__body{padding:20px}
.kc .sca-result__name{width:100%;background:var(--kc-surface-2);color:var(--kc-ink);border:1px solid var(--kc-line-strong);border-radius:var(--kc-radius-md);padding:12px 14px;font:700 16px var(--kc-font-sans);outline:0;margin-bottom:4px}
.kc .sca-mgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0 16px}
.kc .sca-mcell{background:var(--kc-surface-2);border-radius:var(--kc-radius-sm);padding:10px 12px}
.kc .sca-mcell input{width:100%;background:transparent;border:0;outline:0;color:var(--kc-ink);font:800 20px var(--kc-font-sans)}

@media(min-width:901px){ #scPage h1 { font-size: 40px !important; } }
</style>

<div id="scPage">

<!-- Hero -->
<div>
  <div class="kc-hero-sub"><span class="kc-chip kc-chip--sm kc-c-amber"><span class="material-symbols-outlined" style="font-size:14px">auto_awesome</span>Nueva función</span></div>
  <h1 class="kc-hero">Scanner <em>Keto IA</em></h1>
  <p class="kc-muted" style="font:400 14px/1.5 var(--kc-font-sans);margin-top:6px;max-width:440px">Escanea el código de barras del producto o escribe su nombre y el Inspector Keto te da el veredicto al instante. Los macros se completan a mano — todavía no tenemos una base de datos de productos.</p>
</div>
<div class="sca-actions">
  <a href="/app/alimentos" class="kc-btn kc-btn--secondary kc-btn--sm"><span class="material-symbols-outlined" style="font-size:16px">arrow_back</span>Alimentos</a>
</div>

<div class="sca-stack" style="margin-top:18px">

  <!-- Visor -->
  <div>
    <div class="sca-view">
      <video id="scanner-video" autoplay playsinline muted></video>
      <div class="sca-overlay">
        <div class="sca-frame">
          <div class="sca-corner tl"></div>
          <div class="sca-corner tr"></div>
          <div class="sca-corner bl"></div>
          <div class="sca-corner br"></div>
          <div class="sca-scanline"></div>
        </div>
      </div>
      <span id="scanner-status" class="sca-status" data-state="idle">Toca el botón para iniciar la cámara</span>
      <div class="sca-controls">
        <div class="sca-controls__row">
          <button class="sca-ctl" onclick="document.getElementById('galleryInput').click()" aria-label="Abrir galería"><span class="material-symbols-outlined" style="font-size:24px">photo_library</span></button>
          <button class="sca-shutter" onclick="toggleCamera()" id="toggleBtn" aria-label="Iniciar o detener cámara"><span class="material-symbols-outlined" id="cameraIcon" style="font-size:32px;font-variation-settings:'FILL' 1">center_focus_strong</span></button>
          <button class="sca-ctl" onclick="setScanMode('codigo')" aria-label="Modo código de barras"><span class="material-symbols-outlined" style="font-size:24px">qr_code_scanner</span></button>
        </div>
        <div class="sca-modes">
          <button class="sca-mode" data-mode="alimento" onclick="setScanMode('alimento')">Alimento</button>
          <button class="sca-mode" data-mode="etiqueta" onclick="setScanMode('etiqueta')">Etiqueta</button>
          <button class="sca-mode is-active" data-mode="codigo" onclick="setScanMode('codigo')">Código</button>
        </div>
      </div>
    </div>
    <input type="file" id="galleryInput" accept="image/*" class="hidden" onchange="scanFromImage(this)">
    <p class="sca-hint">Apunta y captura · el veredicto llega al instante</p>
  </div>

  <!-- Resultado + recientes -->
  <div class="kc-stack">

    <div id="result-section" class="kc-card kc-card--flush hidden">
      <div class="sca-result__media">
        <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">eco</span>
        <span class="kc-chip kc-chip--sm kc-c-neutral" style="position:absolute;top:12px;left:12px">Código detectado · <span id="barcode-value" class="kc-mono"></span></span>
      </div>
      <div class="sca-result__body">
        <input type="text" id="product-name" class="sca-result__name" placeholder="Nombre del producto">
        <div class="kc-label" style="margin:2px 0 4px">Porción · 100 g</div>

        <div class="sca-mgrid">
          <div class="sca-mcell"><span class="kc-label">Calorías</span><input type="number" id="product-calories" placeholder="0"></div>
          <div class="sca-mcell"><span class="kc-label">Carbos (g)</span><input type="number" id="product-carbs" placeholder="0"></div>
          <div class="sca-mcell"><span class="kc-label">Grasas (g)</span><input type="number" id="product-fat" placeholder="0"></div>
          <div class="sca-mcell"><span class="kc-label">Proteína (g)</span><input type="number" id="product-protein" placeholder="0"></div>
        </div>

        <button onclick="addToDespensa()" class="kc-btn kc-btn--primary kc-btn--block"><span class="material-symbols-outlined" style="font-size:20px">add</span>Añadir a mi registro</button>
      </div>
    </div>

    <!-- Escaneos recientes -->
    <div class="kc-card">
      <div class="kc-card__head" style="margin-bottom:10px">
        <h3 class="kc-card__title" style="font-size:15px;margin-top:0;display:flex;align-items:center;gap:8px"><span class="material-symbols-outlined" style="color:var(--kc-amber);font-size:19px">history</span>Escaneos recientes</h3>
      </div>
      <div id="recent-scans" class="kc-list">
        <p class="kc-muted" style="text-align:center;padding:16px 0;font-size:13px">No hay escaneos recientes</p>
      </div>
    </div>

  </div>
</div>
</div>

<Fragment slot="scripts">
<script is:inline src="/app/utils.js"></script>
<script is:inline src="/app/data/keto-inspector-ingredientes.js"></script>
<script is:inline src="/app/modules/inspectorKeto.js"></script>
<script is:inline src="/app/modules/keto-inspector-api.js"></script>
<script is:inline src="/app/modules/keto-inspector-scanner-integration.js"></script>
<script is:inline>
var lastScannedCode = null;
var cameraActive = false;
var stream = null;
var detector = null;
var scanMode = 'codigo';

function setStatus(msg, state) {
  var statusEl = document.getElementById('scanner-status');
  if (!statusEl) return;
  statusEl.textContent = msg;
  statusEl.dataset.state = state || 'idle';
}

function setScanMode(mode) {
  scanMode = mode;
  document.querySelectorAll('.sca-mode').forEach(function (b) {
    b.classList.toggle('is-active', b.getAttribute('data-mode') === mode);
  });
  if (mode === 'codigo') {
    setStatus(cameraActive ? 'Apunta al código de barras' : 'Toca el botón para iniciar la cámara', 'idle');
  } else {
    setStatus('Escribe el nombre del producto abajo y el Inspector lo analiza', 'idle');
    document.getElementById('result-section').classList.remove('hidden');
    var input = document.getElementById('product-name');
    if (input) input.focus();
  }
}

async function initScanner() {
  var video = document.getElementById('scanner-video');
  try {
    setStatus('Solicitando acceso a cámara…', 'loading');
    stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: 'environment',
        width: { ideal: 1280 },
        height: { ideal: 720 }
      }
    });
    video.srcObject = stream;
    await video.play();
    cameraActive = true;
    setStatus('Cámara activa — apunta al código de barras', 'active');
    document.getElementById('cameraIcon').textContent = 'stop';

    if ('BarcodeDetector' in window) {
      detector = new BarcodeDetector({
        formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39']
      });
      scanWithDetector();
    } else {
      setStatus('Cámara activa — códigos no soportados en este navegador', 'loading');
    }
  } catch (err) {
    console.error('Camera error:', err);
    setStatus('Error: ' + err.message, 'error');
    window.showToast('No se pudo acceder a la cámara: ' + err.message, 3000, "warning");
  }
}

async function scanWithDetector() {
  if (!cameraActive || !detector) return;
  var video = document.getElementById('scanner-video');
  try {
    var barcodes = await detector.detect(video);
    if (barcodes.length > 0) {
      var code = barcodes[0].rawValue;
      if (code && code !== lastScannedCode) {
        onBarcodeDetected(code);
      }
    }
  } catch (e) {}
  requestAnimationFrame(scanWithDetector);
}

async function scanFromImage(input) {
  var file = input.files && input.files[0];
  if (!file) return;
  try {
    if (!('BarcodeDetector' in window)) {
      window.showToast('Detección en imágenes no soportada en este navegador', 3000, "warning");
      return;
    }
    var det = detector || new BarcodeDetector({ formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39'] });
    var bmp = await createImageBitmap(file);
    var barcodes = await det.detect(bmp);
    if (barcodes.length > 0) {
      onBarcodeDetected(barcodes[0].rawValue);
    } else {
      setStatus('No se detectó código en la imagen', 'loading');
    }
  } catch (e) {
    window.showToast('No se pudo analizar la imagen', 3000, "warning");
  } finally {
    input.value = '';
  }
}

function onBarcodeDetected(code) {
  lastScannedCode = code;
  playBeep();
  document.getElementById('barcode-value').textContent = code;
  document.getElementById('result-section').classList.remove('hidden');
  document.getElementById('result-section').scrollIntoView({ behavior: 'smooth' });
  setStatus('Código detectado · rellena los macros', 'active');
  saveRecentScan(code);
  setTimeout(function () { lastScannedCode = null; }, 3000);
}

function playBeep() {
  try {
    var ctx = new (window.AudioContext || window.webkitAudioContext)();
    var osc = ctx.createOscillator();
    var gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.frequency.value = 1800;
    osc.type = 'sine';
    gain.gain.value = 0.3;
    osc.start();
    osc.stop(ctx.currentTime + 0.1);
  } catch (e) {}
}

function toggleCamera() {
  var video = document.getElementById('scanner-video');
  if (cameraActive) {
    if (stream) stream.getTracks().forEach(t => t.stop());
    cameraActive = false;
    video.srcObject = null;
    document.getElementById('cameraIcon').textContent = 'center_focus_strong';
    setStatus('Cámara apagada — toca para reiniciar', 'loading');
  } else {
    initScanner();
  }
}

function addToDespensa() {
  var name = document.getElementById('product-name').value.trim();
  if (!name) { window.showToast('Ingresa un nombre', 3000, "warning"); return; }

  var cal = parseFloat(document.getElementById('product-calories').value) || 0;
  var prot = parseFloat(document.getElementById('product-protein').value) || 0;
  var fat = parseFloat(document.getElementById('product-fat').value) || 0;
  var carbs = parseFloat(document.getElementById('product-carbs').value) || 0;

  var id = 'p' + Date.now();
  var foods = safeParseJSON(localStorage.getItem('ketoFoods'), []);
  foods.push({ id: id, name: name, calories: cal, protein: prot, fat: fat, carbs: carbs, portion: 100, barcode: lastScannedCode });
  localStorage.setItem('ketoFoods', JSON.stringify(foods));

  var despensa = safeParseJSON(localStorage.getItem('despensa'), {});
  despensa[id] = { stock: 100, lastUpdated: new Date().toISOString() };
  localStorage.setItem('despensa', JSON.stringify(despensa));

  showToast(name + ' agregado');

  document.getElementById('product-name').value = '';
  document.getElementById('product-calories').value = '';
  document.getElementById('product-protein').value = '';
  document.getElementById('product-fat').value = '';
  document.getElementById('product-carbs').value = '';
}

function saveRecentScan(code) {
  var scans = safeParseJSON(localStorage.getItem('recentScans'), []);
  scans.unshift({ code: code, time: new Date().toISOString() });
  if (scans.length > 10) scans = scans.slice(0, 10);
  localStorage.setItem('recentScans', JSON.stringify(scans));
  renderRecentScans();
}

function renderRecentScans() {
  var scans = safeParseJSON(localStorage.getItem('recentScans'), []);
  var container = document.getElementById('recent-scans');
  if (!scans.length) { container.innerHTML = '<p class="kc-muted" style="text-align:center;padding:16px 0;font-size:13px">No hay escaneos recientes</p>'; return; }

  container.innerHTML = scans.map(function (s) {
    var t = new Date(s.time).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    return '<div class="kc-li"><span class="material-symbols-outlined" style="color:var(--kc-ink-3);font-size:20px">qr_code</span><div class="kc-li__main"><div class="kc-li__t kc-mono" style="font-size:14px">' + s.code + '</div><div class="kc-li__s">' + t + '</div></div></div>';
  }).join('');
}

function showToast(msg) {
  var t = document.createElement('div');
  t.style.cssText = 'position:fixed;bottom:88px;left:16px;right:16px;background:var(--kc-surface-2);color:var(--kc-ink);padding:12px 16px;border-radius:14px;box-shadow:var(--kc-shadow-float);z-index:9999;text-align:center;font-size:14px;font-weight:600';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function () { t.remove(); }, 3000);
}

renderRecentScans();
</script>
</Fragment>
</AppShell>
