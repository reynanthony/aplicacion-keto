---
import DemoLayout from '../../../layouts/DemoLayout.astro';

const foods = [
  { name: 'Aguacate',            kcal: 160, fat: '15 g', carbs: '2 g',  v: 'keto' },
  { name: 'Salmón',              kcal: 208, fat: '13 g', carbs: '0 g',  v: 'keto' },
  { name: 'Huevo',               kcal: 155, fat: '11 g', carbs: '1 g',  v: 'keto' },
  { name: 'Queso cheddar',       kcal: 402, fat: '33 g', carbs: '1 g',  v: 'keto' },
  { name: 'Nueces de macadamia', kcal: 718, fat: '76 g', carbs: '5 g',  v: 'keto' },
  { name: 'Yogur griego',        kcal: 97,  fat: '5 g',  carbs: '4 g',  v: 'moderar' },
  { name: 'Zanahoria',           kcal: 41,  fat: '0 g',  carbs: '7 g',  v: 'moderar' },
  { name: 'Manzana',             kcal: 52,  fat: '0 g',  carbs: '12 g', v: 'evitar' },
  { name: 'Arroz blanco',        kcal: 130, fat: '0 g',  carbs: '28 g', v: 'evitar' },
  { name: 'Pan integral',        kcal: 247, fat: '4 g',  carbs: '41 g', v: 'evitar' },
];
const verdictBadge = { keto: 'kc-badge-green', moderar: 'kc-badge-amber', evitar: 'kc-badge-red' };
const verdictLabel = { keto: 'Keto ✓', moderar: 'Moderar', evitar: 'Evitar' };
---

<DemoLayout title="KetoCore | Demo Alimentos" active="alimentos">
<style is:global>
.dal-row { display:grid; grid-template-columns:2.4fr 1fr 1fr 1fr 1.1fr; gap:10px; align-items:center; }
@media (max-width:560px){
  .dal-row { grid-template-columns:1fr auto; }
  .dal-row > .dal-mid { display:none; }
}
</style>

<div class="px-4 pt-2 space-y-4" style="max-width:1180px;margin:0 auto">

  <div style="margin:6px 2px 4px">
    <div style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00;margin-bottom:10px">Base de datos</div>
    <h1 class="kc-h1" style="font-size:30px">¿Es keto?<br><span style="color:rgba(247,244,240,0.4)">Compruébalo.</span></h1>
  </div>

  <!-- Buscador -->
  <div class="relative" style="max-width:360px">
    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2" style="color:rgba(247,244,240,0.4);font-size:20px">search</span>
    <input id="dalSearch" oninput="dalFilter(this.value)" style="width:100%;height:46px;padding:0 16px 0 46px;border-radius:14px;background:#161310;border:1px solid rgba(255,240,225,0.08);color:#f7f4f0;font-size:14px;outline:none" placeholder="Busca un alimento… (ej. aguacate)" type="text"/>
  </div>

  <!-- Tabla ¿Es keto? -->
  <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:26px;padding:22px">
    <div class="dal-row" style="padding:0 4px 10px;border-bottom:1px solid rgba(255,240,225,0.07);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(247,244,240,0.35)">
      <span>Alimento</span><span class="dal-mid" style="text-align:right">kcal</span><span class="dal-mid" style="text-align:right">Grasa</span><span class="dal-mid" style="text-align:right">C. netos</span><span style="text-align:right">Veredicto</span>
    </div>
    <div id="dalRows">
      {foods.map((f, i) => (
        <div class="dal-row dal-food" data-name={f.name.toLowerCase()} style={`padding:14px 4px;${i < foods.length - 1 ? 'border-bottom:1px solid rgba(255,240,225,0.05)' : ''}`}>
          <span style="font-size:14px;font-weight:600;color:#f7f4f0">{f.name}</span>
          <span class="dal-mid nums" style="font-size:13px;color:rgba(247,244,240,0.6);text-align:right">{f.kcal}</span>
          <span class="dal-mid nums" style="font-size:13px;color:rgba(247,244,240,0.6);text-align:right">{f.fat}</span>
          <span class="dal-mid nums" style="font-size:13px;color:rgba(247,244,240,0.6);text-align:right">{f.carbs}</span>
          <span style="text-align:right"><span class={`kc-badge ${verdictBadge[f.v]}`}>{verdictLabel[f.v]}</span></span>
        </div>
      ))}
    </div>
    <p id="dalEmpty" style="display:none;text-align:center;padding:24px 0;font-size:13.5px;color:rgba(247,244,240,0.45)">Sin resultados en el demo — la app real tiene más de 300 alimentos.</p>
  </div>

  <!-- Nudge scanner -->
  <a href="/app/demo/scanner" class="kc-tile-cream" style="border-radius:24px;padding:20px;display:flex;align-items:center;gap:16px;text-decoration:none">
    <div style="width:46px;height:46px;border-radius:14px;background:rgba(255,77,0,0.14);display:flex;align-items:center;justify-content:center;flex-shrink:0"><span class="material-symbols-outlined icon-filled" style="color:#ff4d00;font-size:24px">center_focus_strong</span></div>
    <div style="flex:1">
      <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:#1a140e">¿No está en la lista? Escanéalo</div>
      <p style="font-size:12.5px;color:rgba(26,20,14,0.55);margin-top:2px">El Scanner Keto IA analiza cualquier alimento con la cámara.</p>
    </div>
    <span class="material-symbols-outlined" style="color:rgba(26,20,14,0.4)">arrow_forward</span>
  </a>
</div>

<script is:inline>
function dalFilter(q) {
  q = (q || '').toLowerCase().trim();
  var any = false;
  document.querySelectorAll('.dal-food').forEach(function (row) {
    var show = !q || row.getAttribute('data-name').indexOf(q) !== -1;
    row.style.display = show ? '' : 'none';
    if (show) any = true;
  });
  document.getElementById('dalEmpty').style.display = any ? 'none' : 'block';
}
</script>
</DemoLayout>
