---
import DemoLayout from '../../../layouts/DemoLayout.astro';

const days = [
  { d: 'LUN', n: 30 }, { d: 'MAR', n: 1 }, { d: 'MIÉ', n: 2, active: true },
  { d: 'JUE', n: 3 }, { d: 'VIE', n: 4 }, { d: 'SÁB', n: 5 }, { d: 'DOM', n: 6 },
];

const meals = [
  { label: 'Desayuno', icon: 'wb_sunny',     grad: 'linear-gradient(135deg,#3a2410,#1e1509)', iconColor: '#ff4d00', name: 'Huevos revueltos + aguacate', time: '08:00 · 15 min', kcal: 520, macros: 'P32·G40·C5', done: true },
  { label: 'Almuerzo', icon: 'restaurant',   grad: 'linear-gradient(135deg,#0f2818,#0a1a10)', iconColor: '#22c55e', name: 'Ensalada César keto con pollo', time: '13:30 · 20 min', kcal: 640, macros: 'P52·G44·C7', done: true },
  { label: 'Snack',    icon: 'lunch_dining', grad: 'linear-gradient(135deg,#2a1638,#170c20)', iconColor: '#a78bfa', name: 'Nueces de macadamia', time: '17:00 · 0 min', kcal: 380, macros: 'P28·G38·C4', done: true },
  { label: 'Cena',     icon: 'nightlight',   grad: 'linear-gradient(135deg,#3a1810,#1e0d09)', iconColor: '#fb923c', name: 'Salmón + espárragos', time: '20:00 · 25 min', kcal: 400, macros: 'P30·G38·C2', next: true },
];

const week = [
  { d: 'JUE', n: 3, items: ['Tortilla de espinacas', 'Pollo al curry', 'Bistec + brócoli'], kcal: '1,920' },
  { d: 'VIE', n: 4, items: ['Café con MCT', 'Salmón ahumado', 'Costillas BBQ keto'], kcal: '1,980' },
  { d: 'SÁB', n: 5, items: ['Pancakes keto', 'Ensalada de atún', 'Pizza fathead'], kcal: '1,890' },
];
---

<DemoLayout title="KetoCore | Demo Plan" active="plan">
<style is:global>
.dpl-meals { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.dpl-bottom { display:grid; grid-template-columns:1fr; gap:14px; }
@media (min-width:901px){
  .dpl-meals { grid-template-columns:repeat(4,1fr); gap:16px; }
  .dpl-bottom { grid-template-columns:1fr 320px; align-items:start; }
}
.dpl-day {
  display:flex; flex-direction:column; align-items:center; gap:3px;
  padding:10px 0; min-width:52px; flex:1; border-radius:16px;
  background:#161310; border:1px solid rgba(255,240,225,0.06); cursor:pointer;
}
.dpl-day.active { background:#ff4d00; border-color:#ff4d00; }
.dpl-day.active .dpl-day-l { color:rgba(26,14,5,0.7); font-weight:700; }
.dpl-day.active .dpl-day-n { color:#1a0e05; font-weight:900; }
.dpl-day-l { font-size:10px; font-weight:600; color:rgba(247,244,240,0.4); }
.dpl-day-n { font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:16px; color:#f7f4f0; font-variant-numeric:tabular-nums; }
</style>

<div class="px-4 pt-2 space-y-4" style="max-width:1180px;margin:0 auto">

  <!-- Header editorial -->
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:6px 2px 2px">
    <div>
      <div style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00;margin-bottom:10px">Plan Alimenticio · Semana 3</div>
      <h1 class="kc-h1" style="font-size:30px">Tu semana,<br><span style="color:rgba(247,244,240,0.4)">planificada.</span></h1>
    </div>
    <button onclick="showPaywall('plan')" class="kc-btn" style="height:42px;font-size:13px;padding:0 16px">
      <span class="material-symbols-outlined" style="font-size:18px">auto_awesome</span>Generar con IA
    </button>
  </div>

  <!-- Selector de días -->
  <div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none">
    {days.map(day => (
      <div class:list={['dpl-day', { active: day.active }]}>
        <span class="dpl-day-l">{day.d}</span>
        <span class="dpl-day-n">{day.n}</span>
      </div>
    ))}
  </div>

  <!-- Total del día -->
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0 2px">
    <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:18px;color:#f7f4f0">Miércoles · 4 comidas</h2>
    <div style="text-align:right">
      <div style="font-size:10.5px;color:rgba(247,244,240,0.4)">Total del día</div>
      <div class="kc-num" style="font-weight:800;font-size:17px;color:#f7f4f0">1,940 <span style="font-size:11px;color:rgba(247,244,240,0.4)">kcal</span></div>
    </div>
  </div>

  <!-- Tarjetas de comida -->
  <div class="dpl-meals">
    {meals.map(m => (
      <div style={`background:#161310;border:1px solid ${m.next ? 'rgba(255,77,0,0.2)' : 'rgba(255,240,225,0.06)'};border-radius:22px;overflow:hidden`}>
        <div style={`height:96px;background:${m.grad};display:flex;align-items:center;justify-content:center;position:relative`}>
          <span class="material-symbols-outlined icon-filled" style={`color:${m.iconColor};font-size:38px;opacity:0.85`}>{m.icon}</span>
          <span style="position:absolute;top:10px;left:10px;font-size:9px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;padding:4px 9px;border-radius:100px;background:rgba(11,10,8,0.6);color:#f7f4f0">{m.label}</span>
          {m.done && <span class="material-symbols-outlined icon-filled" style="position:absolute;top:10px;right:10px;color:#22c55e;font-size:20px">check_circle</span>}
          {m.next && <span style="position:absolute;top:10px;right:10px;font-size:9px;font-weight:700;padding:4px 9px;border-radius:100px;background:#ff4d00;color:#fff">Próxima</span>}
        </div>
        <div style="padding:14px">
          <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:13.5px;color:#f7f4f0;line-height:1.25;margin-bottom:5px">{m.name}</div>
          <div style="font-size:11px;color:rgba(247,244,240,0.4);margin-bottom:10px">{m.time}</div>
          <div style="display:flex;align-items:center;justify-content:space-between">
            <span class="kc-num" style="font-weight:800;font-size:14px;color:#f7f4f0">{m.kcal} <span style="font-size:10px;color:rgba(247,244,240,0.4)">kcal</span></span>
            <span style="font-size:10px;color:rgba(247,244,240,0.5)">{m.macros}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="dpl-bottom">
    <!-- Resto de la semana -->
    <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;padding:20px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#f7f4f0">Resto de la semana</h2>
        <span style="font-size:12px;color:rgba(247,244,240,0.45)">Promedio 1,930 kcal/día</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        {week.map(w => (
          <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:16px;background:#1e1a15">
            <div style="width:44px;text-align:center;flex-shrink:0">
              <div style="font-size:10px;color:rgba(247,244,240,0.4);font-weight:600">{w.d}</div>
              <div class="kc-num" style="font-weight:800;font-size:16px;color:#f7f4f0">{w.n}</div>
            </div>
            <div style="flex:1;display:flex;gap:6px;flex-wrap:wrap;min-width:0">
              {w.items.map(item => (
                <span style="font-size:11.5px;padding:4px 10px;border-radius:100px;background:#26211a;color:rgba(247,244,240,0.7);white-space:nowrap">{item}</span>
              ))}
            </div>
            <span class="kc-num" style="font-weight:700;font-size:13px;color:rgba(247,244,240,0.55);flex-shrink:0">{w.kcal}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Nudge lista de compras — cream -->
    <div class="kc-tile-cream" style="border-radius:24px;padding:22px;display:flex;flex-direction:column;justify-content:space-between;gap:16px">
      <div>
        <div style="width:42px;height:42px;border-radius:13px;background:rgba(96,165,250,0.16);display:flex;align-items:center;justify-content:center;margin-bottom:14px"><span class="material-symbols-outlined icon-filled" style="color:#2563eb;font-size:22px">shopping_cart</span></div>
        <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:17px;line-height:1.15;color:#1a140e;margin-bottom:6px">Lista de compras lista</h3>
        <p style="font-size:13px;color:rgba(26,20,14,0.6);line-height:1.55">28 ingredientes generados a partir del plan semanal, organizados por pasillo.</p>
      </div>
      <a href="/app/demo/compras" style="width:100%;padding:13px;border-radius:14px;background:#1a140e;color:#f3ede3;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:13.5px;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none">Ver lista <span class="material-symbols-outlined" style="font-size:17px">arrow_forward</span></a>
    </div>
  </div>
</div>
</DemoLayout>
