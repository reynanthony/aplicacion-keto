---
import DemoLayout from '../../../layouts/DemoLayout.astro';

const alertas = [
  { icon: 'check_circle', color: '#22c55e', bg: 'rgba(34,197,94,0.08)',  bd: 'rgba(34,197,94,0.18)',  title: 'Cetosis estable',       text: '21 días consecutivos bajo 25 g de carbos netos.' },
  { icon: 'egg_alt',      color: '#fbbf24', bg: 'rgba(251,191,36,0.08)', bd: 'rgba(251,191,36,0.18)', title: 'Proteína algo baja',    text: 'Promedias 128 g de 150 g. Suma un snack proteico.' },
  { icon: 'water_drop',   color: '#60a5fa', bg: 'rgba(96,165,250,0.08)', bd: 'rgba(96,165,250,0.18)', title: 'Hidratación al límite', text: '2.4 L de 3 L diarios. Los electrolitos lo agradecen.' },
];

const metricas = [
  { label: 'Adherencia al plan', val: '89%', pct: 89, color: '#ff4d00' },
  { label: 'Carbos bajo control', val: '95%', pct: 95, color: '#22d3ee' },
  { label: 'Constancia de registro', val: '84%', pct: 84, color: '#a78bfa' },
];

const barras = [72, 85, 90, 78, 94, 88, 96];
const dias = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
---

<DemoLayout title="KetoCore | Demo Inspector" active="inspector">
<style is:global>
.din-grid { display:grid; grid-template-columns:1fr; gap:14px; }
@media (min-width:901px){ .din-grid { grid-template-columns:1fr 1fr; align-items:start; } }
</style>

<div class="px-4 pt-2 space-y-4" style="max-width:1180px;margin:0 auto">

  <div style="margin:6px 2px 2px">
    <div style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00;margin-bottom:10px">Inteligencia · Análisis semanal</div>
    <h1 class="kc-h1" style="font-size:30px">El Inspector<br><span style="color:rgba(247,244,240,0.4)">cuida tu cetosis.</span></h1>
  </div>

  <!-- Veredicto naranja -->
  <div style="background:linear-gradient(150deg,#ff5a12,#e63f00);border-radius:26px;padding:24px;position:relative;overflow:hidden;box-shadow:0 12px 40px rgba(255,77,0,0.22)">
    <div style="position:absolute;right:-40px;top:-40px;width:190px;height:190px;border-radius:50%;background:rgba(255,255,255,0.08)"></div>
    <div style="position:relative">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><span class="material-symbols-outlined icon-filled" style="font-size:20px;color:rgba(26,14,5,0.85)">analytics</span><span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:12px;letter-spacing:0.02em;color:rgba(26,14,5,0.85)">VEREDICTO DE LA SEMANA</span></div>
      <div style="display:flex;align-items:baseline;gap:8px">
        <span class="kc-num" style="font-weight:900;font-size:64px;line-height:0.85;color:#1a0e05">82</span>
        <span style="font-size:15px;font-weight:700;color:rgba(26,14,5,0.7)">/ 100</span>
      </div>
      <p style="font-size:13px;font-weight:600;color:rgba(26,14,5,0.75);margin-top:8px;max-width:400px">Semana sólida: cetosis estable y adherencia alta. Ajusta proteína e hidratación para pasar de 90.</p>
    </div>
  </div>

  <!-- Alertas semánticas -->
  <div style="display:flex;flex-direction:column;gap:10px">
    {alertas.map(a => (
      <div style={`display:flex;align-items:center;gap:13px;padding:14px 16px;border-radius:18px;background:${a.bg};border:1px solid ${a.bd}`}>
        <span class="material-symbols-outlined icon-filled" style={`font-size:24px;color:${a.color};flex-shrink:0`}>{a.icon}</span>
        <div>
          <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:14px;color:#f7f4f0">{a.title}</div>
          <p style="font-size:12.5px;color:rgba(247,244,240,0.55);margin-top:2px">{a.text}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="din-grid">
    <!-- Métricas con barras -->
    <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;padding:20px">
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#f7f4f0;margin-bottom:16px">Métricas clave</h2>
      <div style="display:flex;flex-direction:column;gap:16px">
        {metricas.map(m => (
          <div>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:7px">
              <span style="font-size:13px;font-weight:600;color:rgba(247,244,240,0.7)">{m.label}</span>
              <span class="kc-num" style="font-weight:800;font-size:14px;color:#f7f4f0">{m.val}</span>
            </div>
            <div style="height:8px;border-radius:100px;background:rgba(255,240,225,0.06);overflow:hidden"><div style={`height:100%;width:${m.pct}%;border-radius:100px;background:${m.color}`}></div></div>
          </div>
        ))}
      </div>
    </div>

    <!-- Adherencia 7 días -->
    <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;padding:20px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#f7f4f0">Adherencia · 7 días</h2>
        <span style="font-size:12px;font-weight:700;color:#22c55e">89% promedio</span>
      </div>
      <div style="display:flex;align-items:flex-end;gap:8px;height:120px">
        {barras.map((b, i) => (
          <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end">
            <div style={`width:100%;height:${b}%;border-radius:8px 8px 4px 4px;background:${i === 6 ? '#ff4d00' : 'rgba(255,77,0,0.35)'}`}></div>
            <span style="font-size:9.5px;color:rgba(247,244,240,0.4);font-weight:600">{dias[i]}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Proyección de peso -->
  <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;padding:20px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px">
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#f7f4f0">Proyección de peso</h2>
      <span style="font-size:12px;color:rgba(247,244,240,0.45)">Meta 210 lbs · <span style="color:#22c55e;font-weight:700">en ~4 semanas</span></span>
    </div>
    <svg viewBox="0 0 640 150" width="100%" height="130" preserveAspectRatio="none" style="display:block">
      <line x1="0" y1="38" x2="640" y2="38" stroke="rgba(255,240,225,0.05)"></line>
      <line x1="0" y1="75" x2="640" y2="75" stroke="rgba(255,240,225,0.05)"></line>
      <line x1="0" y1="112" x2="640" y2="112" stroke="rgba(255,240,225,0.05)"></line>
      <path d="M0,28 L107,40 L214,52 L320,68" fill="none" stroke="#ff4d00" stroke-width="3.5" stroke-linecap="round"></path>
      <path d="M320,68 L427,84 L534,100 L640,118" fill="none" stroke="#ff4d00" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9"></path>
      <circle cx="320" cy="68" r="6" fill="#ff4d00" stroke="#161310" stroke-width="3.5"></circle>
      <circle cx="640" cy="118" r="5" fill="none" stroke="#22c55e" stroke-width="2.5"></circle>
    </svg>
    <div style="display:flex;justify-content:space-between;margin-top:10px;font-size:11px;color:rgba(247,244,240,0.32)"><span>Inicio</span><span>Hoy</span><span>Proyección</span><span style="color:#22c55e">Meta</span></div>
  </div>

  <!-- CTA -->
  <button onclick="showPaywall('progress')" class="kc-btn" style="width:100%;height:52px;font-size:15px">
    <span class="material-symbols-outlined" style="font-size:20px">analytics</span>
    Quiero que el Inspector analice mis datos
  </button>
</div>
</DemoLayout>
