---
import DemoLayout from '../../../layouts/DemoLayout.astro';

const logros = [
  { icon: 'restaurant',     name: 'Primera comida',   unlocked: true },
  { icon: 'star',           name: 'Iniciador keto',   unlocked: true },
  { icon: 'military_tech',  name: 'Guerrero semanal', unlocked: true },
  { icon: 'water_drop',     name: 'Héroe del agua',   unlocked: true },
  { icon: 'emoji_events',   name: 'Maestro mensual',  unlocked: false },
  { icon: 'fitness_center', name: 'Bestia del gym',   unlocked: false },
];
---

<DemoLayout title="KetoCore | Demo Progreso" active="progreso">
<style is:global>
.dpg-grid { display:grid; grid-template-columns:1fr; gap:14px; }
@media (min-width:901px){ .dpg-grid { grid-template-columns:1.5fr 1fr; align-items:start; } }
</style>

<div class="px-4 pt-2 space-y-4" style="max-width:1180px;margin:0 auto">

  <div style="margin:6px 2px 4px">
    <div style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00;margin-bottom:10px">Resultados · 21 días</div>
    <h1 class="kc-h1" style="font-size:30px">Tu progreso,<br><span style="color:rgba(247,244,240,0.4)">medido de verdad.</span></h1>
  </div>

  <div class="dpg-grid">
    <!-- Tendencia de peso -->
    <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:26px;padding:24px">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:10px">
        <div>
          <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:18px;color:#f7f4f0">Tendencia de peso</h2>
          <div style="display:flex;align-items:baseline;gap:10px;margin-top:8px">
            <span class="kc-num" style="font-weight:900;font-size:32px;color:#f7f4f0">228 <span style="font-size:15px;color:rgba(247,244,240,0.4)">lbs</span></span>
            <span style="display:inline-flex;align-items:center;gap:3px;font-size:13px;font-weight:700;color:#22c55e"><span class="material-symbols-outlined" style="font-size:16px">trending_down</span>−17 lbs</span>
          </div>
        </div>
        <span style="font-size:11px;font-weight:700;padding:6px 12px;border-radius:100px;background:rgba(255,77,0,0.12);color:#ff4d00">21 días</span>
      </div>
      <svg viewBox="0 0 640 170" width="100%" height="150" preserveAspectRatio="none" style="display:block">
        <defs><linearGradient id="dpgArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgba(255,77,0,0.3)"></stop><stop offset="100%" stop-color="rgba(255,77,0,0)"></stop></linearGradient></defs>
        <line x1="0" y1="42" x2="640" y2="42" stroke="rgba(255,240,225,0.05)"></line>
        <line x1="0" y1="85" x2="640" y2="85" stroke="rgba(255,240,225,0.05)"></line>
        <line x1="0" y1="128" x2="640" y2="128" stroke="rgba(255,240,225,0.05)"></line>
        <path d="M0,30 L91,42 L183,50 L274,72 L366,88 L457,104 L549,122 L640,134 L640,170 L0,170 Z" fill="url(#dpgArea)"></path>
        <path d="M0,30 L91,42 L183,50 L274,72 L366,88 L457,104 L549,122 L640,134" fill="none" stroke="#ff4d00" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="640" cy="134" r="6" fill="#ff4d00" stroke="#161310" stroke-width="3.5"></circle>
      </svg>
      <div style="display:flex;justify-content:space-between;margin-top:12px;font-size:11px;color:rgba(247,244,240,0.32)"><span>Día 1</span><span>Día 7</span><span>Día 14</span><span>Hoy</span></div>
    </div>

    <!-- Meta — cream -->
    <div class="kc-tile-cream" style="border-radius:26px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;gap:16px">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;color:rgba(26,20,14,0.55)">META: 210 LBS</span>
        <span class="material-symbols-outlined icon-filled" style="color:#ff4d00;font-size:22px">flag</span>
      </div>
      <div>
        <div class="kc-num" style="font-weight:900;font-size:56px;line-height:0.85;color:#1a140e">49%</div>
        <p style="font-size:13.5px;color:rgba(26,20,14,0.55);margin-top:10px;line-height:1.5">Del camino recorrido. Al ritmo actual, Carlos llega a su meta en ~4 semanas.</p>
      </div>
      <div style="height:9px;border-radius:100px;background:rgba(26,20,14,0.09);overflow:hidden"><div style="height:100%;width:49%;border-radius:100px;background:#ff4d00"></div></div>
    </div>
  </div>

  <!-- Stats + logros -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
    <div class="kc-tile" style="text-align:center;padding:18px">
      <div class="kc-num" style="font-size:32px;color:#ff4d00">21</div>
      <div style="font-size:11.5px;color:rgba(247,244,240,0.45);margin-top:4px">días de racha</div>
    </div>
    <div class="kc-tile" style="text-align:center;padding:18px">
      <div class="kc-num" style="font-size:32px;color:#22c55e">84</div>
      <div style="font-size:11.5px;color:rgba(247,244,240,0.45);margin-top:4px">comidas registradas</div>
    </div>
  </div>

  <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;padding:20px">
    <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#f7f4f0;margin-bottom:14px">Logros</h2>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
      {logros.map(l => (
        <div style={`border-radius:16px;padding:14px 8px;text-align:center;${l.unlocked ? 'background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.18)' : 'background:#1e1a15;border:1px solid rgba(255,240,225,0.05);opacity:0.5'}`}>
          <span class="material-symbols-outlined icon-filled" style={`font-size:26px;color:${l.unlocked ? '#fbbf24' : 'rgba(247,244,240,0.3)'}`}>{l.unlocked ? l.icon : 'lock'}</span>
          <div style="font-size:10.5px;font-weight:600;color:rgba(247,244,240,0.7);margin-top:6px">{l.name}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <button onclick="showPaywall('progress')" class="kc-btn" style="width:100%;height:52px;font-size:15px">
    <span class="material-symbols-outlined" style="font-size:20px">rocket_launch</span>
    Quiero medir mi propio progreso
  </button>
</div>
</DemoLayout>
