---
import DemoLayout from '../../../layouts/DemoLayout.astro';
---

<DemoLayout title="KetoCore | Demo Scanner" active="scanner">
<style is:global>
.dsc-frame { position:absolute; top:14%; left:12%; right:12%; bottom:32%; }
.dsc-corner { position:absolute; width:34px; height:34px; }
.dsc-corner.tl{top:0;left:0;border-top:3px solid #ff4d00;border-left:3px solid #ff4d00;border-top-left-radius:16px}
.dsc-corner.tr{top:0;right:0;border-top:3px solid #ff4d00;border-right:3px solid #ff4d00;border-top-right-radius:16px}
.dsc-corner.bl{bottom:0;left:0;border-bottom:3px solid #ff4d00;border-left:3px solid #ff4d00;border-bottom-left-radius:16px}
.dsc-corner.br{bottom:0;right:0;border-bottom:3px solid #ff4d00;border-right:3px solid #ff4d00;border-bottom-right-radius:16px}
.dsc-line { position:absolute; left:6%; right:6%; height:2px; background:linear-gradient(90deg,transparent,#ff4d00,transparent); box-shadow:0 0 12px #ff4d00; animation:dscScan 2.4s ease-in-out infinite; }
@keyframes dscScan { 0%,100%{top:8%} 50%{top:92%} }
#dscResult { display:none; animation:dscUp .35s cubic-bezier(.4,0,.2,1); }
#dscResult.show { display:block; }
@keyframes dscUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
.dsc-grid { display:grid; grid-template-columns:1fr; gap:16px; }
@media (min-width:901px){ .dsc-grid { grid-template-columns:1.1fr 1fr; align-items:start; } }
</style>

<div class="px-4 pt-2 space-y-4" style="max-width:1180px;margin:0 auto">

  <div style="margin:6px 2px 4px">
    <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:100px;background:rgba(255,77,0,0.1);border:1px solid rgba(255,77,0,0.2);margin-bottom:12px"><span class="material-symbols-outlined icon-filled" style="color:#ff4d00;font-size:16px">auto_awesome</span><span style="font-size:12px;font-weight:700;color:#ff7a3c">Scanner Keto IA</span></div>
    <h1 class="kc-h1" style="font-size:30px">Apunta. Escanea.<br><span style="color:rgba(247,244,240,0.4)">Veredicto al instante.</span></h1>
  </div>

  <div class="dsc-grid">
    <!-- Visor simulado -->
    <div>
      <div style="position:relative;width:100%;height:380px;border-radius:24px;overflow:hidden;background:linear-gradient(160deg,#2a2018,#161009);border:1px solid rgba(255,240,225,0.08)">
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center"><span class="material-symbols-outlined icon-filled" id="dscFood" style="color:rgba(255,240,225,0.16);font-size:120px;transition:color .4s">nutrition</span></div>
        <div class="dsc-frame">
          <div class="dsc-corner tl"></div><div class="dsc-corner tr"></div><div class="dsc-corner bl"></div><div class="dsc-corner br"></div>
          <div class="dsc-line" id="dscLine"></div>
        </div>
        <div style="position:absolute;top:5%;left:0;right:0;text-align:center;z-index:5">
          <span id="dscHint" style="font-size:13px;font-weight:600;color:rgba(255,255,255,0.85);padding:7px 16px;border-radius:100px;background:rgba(0,0,0,0.4);backdrop-filter:blur(8px)">Demo: toca el botón para simular un escaneo</span>
        </div>
        <div style="position:absolute;bottom:0;left:0;right:0;padding:0 0 22px;z-index:5;display:flex;justify-content:center">
          <button id="dscBtn" onclick="demoScan()" style="width:72px;height:72px;border-radius:50%;background:#ff4d00;display:flex;align-items:center;justify-content:center;border:4px solid rgba(255,255,255,0.25);box-shadow:0 0 24px rgba(255,77,0,0.5);cursor:pointer">
            <span class="material-symbols-outlined icon-filled" style="color:#fff;font-size:32px">center_focus_strong</span>
          </button>
        </div>
      </div>
      <p style="text-align:center;margin-top:12px;font-size:12.5px;font-weight:600;color:rgba(247,244,240,0.4)">En la app real, la cámara detecta alimentos, etiquetas y códigos de barras</p>
    </div>

    <!-- Resultado -->
    <div id="dscResult">
      <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;overflow:hidden">
        <div style="height:110px;background:linear-gradient(135deg,#3a2410,#1e1509);display:flex;align-items:center;justify-content:center;position:relative">
          <span class="material-symbols-outlined icon-filled" style="color:#ff4d00;font-size:52px;opacity:0.85">eco</span>
          <span style="position:absolute;top:12px;left:12px;font-size:10px;font-weight:600;padding:5px 11px;border-radius:100px;background:rgba(0,0,0,0.45);color:#fff">Detectado con 96%</span>
        </div>
        <div style="padding:20px">
          <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:22px;color:#f7f4f0">Aguacate</h2>
          <div style="font-size:12.5px;color:rgba(247,244,240,0.4);margin:4px 0 14px">Porción · 100 g (media pieza)</div>

          <div style="background:linear-gradient(140deg,#1a7a3e,#146030);border-radius:18px;padding:16px;display:flex;align-items:center;gap:14px;margin-bottom:14px">
            <span class="material-symbols-outlined icon-filled" style="color:#fff;font-size:32px">verified</span>
            <div><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#fff">100% Keto</div><div style="font-size:12px;color:rgba(255,255,255,0.8)">Perfecto para tu plan de hoy</div></div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
            <div style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06);border-radius:14px;padding:12px"><div style="font-size:10px;font-weight:700;text-transform:uppercase;color:rgba(247,244,240,0.4);margin-bottom:4px">Calorías</div><div class="kc-num" style="font-weight:900;font-size:20px;color:#f7f4f0">160</div></div>
            <div style="background:#1e1a15;border:1px solid rgba(8,145,178,0.18);border-radius:14px;padding:12px"><div style="font-size:10px;font-weight:700;text-transform:uppercase;color:rgba(247,244,240,0.4);margin-bottom:4px">Carbos netos</div><div class="kc-num" style="font-weight:900;font-size:20px;color:#22d3ee">2 g</div></div>
            <div style="background:#1e1a15;border:1px solid rgba(217,119,6,0.18);border-radius:14px;padding:12px"><div style="font-size:10px;font-weight:700;text-transform:uppercase;color:rgba(247,244,240,0.4);margin-bottom:4px">Grasas</div><div class="kc-num" style="font-weight:900;font-size:20px;color:#d97706">15 g</div></div>
            <div style="background:#1e1a15;border:1px solid rgba(234,88,12,0.18);border-radius:14px;padding:12px"><div style="font-size:10px;font-weight:700;text-transform:uppercase;color:rgba(247,244,240,0.4);margin-bottom:4px">Proteína</div><div class="kc-num" style="font-weight:900;font-size:20px;color:#ea580c">2 g</div></div>
          </div>

          <div style="background:rgba(167,139,250,0.08);border:1px solid rgba(167,139,250,0.18);border-radius:14px;padding:12px;display:flex;gap:11px;margin-bottom:16px">
            <span class="material-symbols-outlined icon-filled" style="color:#a78bfa;font-size:20px;flex-shrink:0">psychology</span>
            <p style="font-size:12.5px;line-height:1.5;color:rgba(247,244,240,0.7)">Rico en grasas monoinsaturadas y potasio. Ideal para tu desayuno o como topping de ensalada.</p>
          </div>

          <button onclick="showPaywall('scanner')" class="kc-btn" style="width:100%;height:48px;font-size:14.5px">
            <span class="material-symbols-outlined" style="font-size:20px">add</span>Añadir a mi registro
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
var dscScanning = false;
function demoScan() {
  if (dscScanning) return;
  dscScanning = true;
  var hint = document.getElementById('dscHint');
  var food = document.getElementById('dscFood');
  var result = document.getElementById('dscResult');
  result.classList.remove('show');
  hint.textContent = 'Analizando alimento…';
  food.style.color = 'rgba(255,240,225,0.16)';
  setTimeout(function () {
    food.textContent = 'eco';
    food.style.color = 'rgba(34,197,94,0.5)';
    hint.textContent = 'Detectado: Aguacate · 96% de confianza';
    result.classList.add('show');
    if (window.innerWidth < 901) result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    dscScanning = false;
  }, 1800);
}
</script>
</DemoLayout>
