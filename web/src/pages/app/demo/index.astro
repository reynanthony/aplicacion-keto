---
// El demo ya no es un clon estático de la app: siembra datos de muestra en
// localStorage (public/app/demo-seed.js) y redirige al dashboard real.
// Así el "modo prueba" es literalmente la app real, no una copia mantenida
// aparte que se desincroniza de los módulos reales.
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KetoCore | Cargando demo…</title>
</head>
<body style="background:#0b0a08;margin:0;height:100vh;display:flex;align-items:center;justify-content:center">
  <script is:inline src="/app/demo-seed.js"></script>
  <script is:inline>
    seedDemoDataIfNeeded();
    window.location.replace('/app/');
  </script>
</body>
</html>
