---
import DemoLayout from '../../../layouts/DemoLayout.astro';
---

<DemoLayout title="KetoCore | Demo Coach" active="coach">
<style is:global>
@keyframes msgIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
.msg-in { animation: msgIn 0.3s ease; }
@keyframes typingDot { 0%,80%,100%{opacity:0.2} 40%{opacity:1} }
.typing-dot { width:6px;height:6px;border-radius:50%;background:rgba(247,244,240,0.4);
  display:inline-block;animation:typingDot 1.2s infinite; }
.typing-dot:nth-child(2){animation-delay:0.15s}
.typing-dot:nth-child(3){animation-delay:0.3s}
.chip { display:inline-flex;align-items:center;padding:6px 12px;border-radius:100px;
  font-size:11px;font-weight:600;cursor:pointer;transition:all 0.15s;
  background:#1e1a15;border:1px solid rgba(255,240,225,0.08);color:rgba(247,244,240,0.7);
  white-space:nowrap; }
.chip:hover { background:#2a2a2a;color:#f7f4f0;border-color:rgba(255,77,0,0.3); }
</style>

<div class="px-4 pt-2 pb-4">
  <!-- Header -->
  <div class="flex items-center gap-4 mb-4">
    <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,rgba(167,139,250,0.2),rgba(99,102,241,0.15));border:1px solid rgba(167,139,250,0.2)">
      <span class="material-symbols-outlined icon-filled" style="color:#a78bfa;font-size:26px">psychology</span>
    </div>
    <div class="flex-1">
      <h1 class="text-xl font-black leading-tight" style="font-family:'Plus Jakarta Sans',sans-serif;color:#f7f4f0">Coach Keto IA</h1>
      <p class="text-xs" style="color:rgba(247,244,240,0.5)">Base de conocimiento local · Sin conexión requerida</p>
    </div>
    <div class="text-right">
      <div class="flex items-center gap-1.5 rounded-full px-3 py-1.5" style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2)">
        <span style="width:6px;height:6px;border-radius:50%;background:#22c55e;display:inline-block;animation:demoPulse 2s infinite"></span>
        <span class="text-[10px] font-bold" style="color:#22c55e">Online</span>
      </div>
    </div>
  </div>

  <!-- Context Card (Carlos) -->
  <div class="rounded-2xl p-4 mb-4 flex items-center gap-3" style="background:#161310;border:1px solid rgba(167,139,250,0.12)">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(255,77,0,0.1)">
      <span class="material-symbols-outlined icon-filled" style="color:#ff4d00;font-size:22px">person</span>
    </div>
    <div class="flex-1">
      <p class="text-xs font-bold" style="color:#f7f4f0">Contexto activo: Carlos R.</p>
      <p class="text-[10px]" style="color:rgba(247,244,240,0.45)">37 años · 228 lbs · Perder grasa · 21 días · Adherencia 89%</p>
    </div>
    <button onclick="showPaywall('coach')" class="text-[10px] font-bold px-3 py-1.5 rounded-full transition-all" style="background:rgba(167,139,250,0.1);color:#a78bfa;border:1px solid rgba(167,139,250,0.2)">
      Real ↗
    </button>
  </div>

  <!-- Chat Window -->
  <div id="chatWindow" class="rounded-2xl overflow-hidden mb-3" style="background:#111;border:1px solid rgba(255,240,225,0.06);min-height:360px;max-height:480px;overflow-y:auto;display:flex;flex-direction:column;gap:0;padding:16px;scroll-behavior:smooth">

    <!-- Welcome message -->
    <div class="msg-in flex gap-3 mb-4">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#a78bfa,#6366f1)">
        <span class="material-symbols-outlined icon-filled" style="color:#fff;font-size:16px">psychology</span>
      </div>
      <div class="flex-1">
        <p class="text-[10px] font-bold mb-1" style="color:rgba(247,244,240,0.4)">Coach Keto IA · Demo</p>
        <div class="rounded-2xl rounded-tl-none p-4" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06)">
          <p class="leading-relaxed" style="color:#f7f4f0;font-size:14.5px">
            ¡Hola Carlos! 👋 Soy tu Coach Keto IA.<br><br>
            En esta versión demo respondo preguntas generales sobre keto con mi base de conocimiento local (sin internet). Puedo ayudarte con temas como alimentos permitidos, síntomas, macros, ayuno y más.<br><br>
            ¿Qué te gustaría saber?
          </p>
        </div>
      </div>
    </div>

    <!-- Typing indicator (hidden by default) -->
    <div id="typingIndicator" class="flex gap-3 mb-4 hidden">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#a78bfa,#6366f1)">
        <span class="material-symbols-outlined icon-filled" style="color:#fff;font-size:16px">psychology</span>
      </div>
      <div class="rounded-2xl rounded-tl-none p-3.5" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06)">
        <div class="flex items-center gap-1">
          <span class="typing-dot"></span>
          <span class="typing-dot"></span>
          <span class="typing-dot"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Suggestion Chips -->
  <div id="suggestionsRow" class="flex gap-2 overflow-x-auto pb-2 mb-3" style="scrollbar-width:none">
    <!-- filled by JS -->
  </div>

  <!-- Input Row -->
  <div class="flex gap-2">
    <input id="coachInput" type="text" placeholder="Pregunta sobre keto..."
      class="flex-1 rounded-2xl px-4 py-3.5 text-sm font-medium outline-none"
      style="background:#1e1a15;border:1.5px solid rgba(255,240,225,0.07);color:#f7f4f0;font-family:'Inter',sans-serif"
      onkeydown="if(event.key==='Enter')sendQuestion()">
    <button onclick="sendQuestion()" class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 transition-all active:scale-95" style="background:linear-gradient(135deg,#ff4d00,#ea580c);box-shadow:0 4px 16px rgba(255,77,0,0.3)">
      <span class="material-symbols-outlined icon-filled" style="color:#fff;font-size:20px">send</span>
    </button>
  </div>

  <!-- Premium CTA -->
  <div class="mt-4 rounded-2xl p-4 flex items-center gap-3" style="background:rgba(167,139,250,0.05);border:1px solid rgba(167,139,250,0.15)">
    <span class="material-symbols-outlined icon-filled" style="color:#a78bfa;font-size:24px">auto_awesome</span>
    <div class="flex-1">
      <p class="text-xs font-bold" style="color:#f7f4f0">Coach con IA Real</p>
      <p style="font-size:10px;color:rgba(247,244,240,0.45)">Respuestas personalizadas basadas en tu historial</p>
    </div>
    <button onclick="showPaywall('coach')" class="text-xs font-bold px-3 py-2 rounded-xl whitespace-nowrap" style="background:linear-gradient(135deg,#a78bfa,#6366f1);color:#fff">
      Ver más →
    </button>
  </div>
</div>

<script is:inline src="/app/demo/demo-coach-kb.js"></script>
<script is:inline>
  // Init suggestions
  var suggestions = window.DemoCoachKB ? window.DemoCoachKB.SUGGESTIONS : [];
  var sugRow = document.getElementById('suggestionsRow');
  if (sugRow && suggestions) {
    suggestions.forEach(function(s) {
      var chip = document.createElement('button');
      chip.className = 'chip flex-shrink-0';
      chip.textContent = s;
      chip.onclick = function() { document.getElementById('coachInput').value = s; sendQuestion(); };
      sugRow.appendChild(chip);
    });
  }

  function addMessage(role, text, highlight) {
    var chat = document.getElementById('chatWindow');
    var isCoach = role === 'coach';
    var div = document.createElement('div');
    div.className = 'msg-in flex gap-3 mb-4' + (isCoach ? '' : ' flex-row-reverse');

    var avatarHtml = isCoach
      ? '<div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#a78bfa,#6366f1)"><span class="material-symbols-outlined icon-filled" style="color:#fff;font-size:16px">psychology</span></div>'
      : '<div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#ff4d00"><span class="material-symbols-outlined icon-filled" style="color:#fff;font-size:16px">person</span></div>';

    var bubbleStyle = isCoach
      ? 'background:#1e1a15;border:1px solid rgba(255,240,225,0.06)'
      : 'background:rgba(255,77,0,0.12);border:1px solid rgba(255,77,0,0.2)';
    var labelHtml = isCoach ? '<p class="text-[10px] font-bold mb-1" style="color:rgba(247,244,240,0.4)">Coach Keto IA · Demo</p>' : '';
    var corner = isCoach ? 'rounded-tl-none' : 'rounded-tr-none';

    div.innerHTML = avatarHtml + '<div class="flex-1 ' + (isCoach ? '' : 'flex flex-col items-end') + '">'
      + labelHtml
      + '<div class="rounded-2xl ' + corner + ' p-4" style="' + bubbleStyle + (isCoach ? '' : ';max-width:92%') + '">'
      + '<p class="leading-relaxed" style="color:#f7f4f0;font-size:14.5px">' + text.replace(/\n/g,'<br>') + '</p>'
      + (highlight ? '<div class="mt-2 rounded-lg px-3 py-2" style="background:rgba(167,139,250,0.1);border:1px solid rgba(167,139,250,0.15)"><p style="font-size:10px;color:#a78bfa;font-weight:600">💡 ' + highlight + '</p></div>' : '')
      + '</div></div>';

    var typing = document.getElementById('typingIndicator');
    chat.insertBefore(div, typing);
    chat.scrollTop = chat.scrollHeight;
  }

  function sendQuestion() {
    var input = document.getElementById('coachInput');
    var query = input.value.trim();
    if (!query) return;
    input.value = '';

    addMessage('user', query);

    var typing = document.getElementById('typingIndicator');
    typing.classList.remove('hidden');
    document.getElementById('chatWindow').scrollTop = 99999;

    setTimeout(function() {
      typing.classList.add('hidden');
      var result = window.DemoCoachKB ? window.DemoCoachKB.ask(query) : { a: 'Intenta con la versión completa para respuestas personalizadas.', found: false };
      var highlight = result.found ? null : 'Esta es una respuesta del demo. El Coach completo en KetoCore responde con contexto de tu historial.';
      addMessage('coach', result.a, highlight);
    }, 800 + Math.random() * 600);
  }

  // Focus input on desktop
  if (window.innerWidth >= 768) document.getElementById('coachInput').focus();
</script>
</DemoLayout>
