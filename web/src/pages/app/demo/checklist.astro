---
import DemoLayout from '../../../layouts/DemoLayout.astro';

const nutricion = [
  { id: 'agua',    icon: 'water_drop',      color: '#60a5fa', label: '3 L de agua',            done: true },
  { id: 'electro', icon: 'bolt',            color: '#fbbf24', label: 'Electrolitos + magnesio', done: true },
  { id: 'ayuno',   icon: 'schedule',        color: '#ff4d00', label: 'Ayuno 16:8 completado',   done: true },
  { id: 'carbos',  icon: 'grain',           color: '#22d3ee', label: 'Menos de 25 g de carbos', done: false },
];
const bienestar = [
  { id: 'entreno', icon: 'fitness_center',  color: '#4ade80', label: '30 min de ejercicio',     done: true },
  { id: 'pasos',   icon: 'directions_walk', color: '#22c55e', label: '8,000 pasos',             done: false },
  { id: 'sueno',   icon: 'bedtime',         color: '#a78bfa', label: '7+ horas de sueño',       done: false },
];
---

<DemoLayout title="KetoCore | Demo Checklist" active="checklist">
<style is:global>
.dck-item { display:flex; align-items:center; gap:13px; padding:13px 14px; border-radius:16px; background:#1e1a15; border:1px solid rgba(255,240,225,0.05); cursor:pointer; transition:background .15s; }
.dck-item.done { background:rgba(34,197,94,0.07); border-color:rgba(34,197,94,0.18); }
.dck-item.done .dck-label { color:rgba(247,244,240,0.45); text-decoration:line-through; }
.dck-check { width:26px; height:26px; border-radius:50%; border:2px solid rgba(247,244,240,0.25); display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:all .15s; }
.dck-item.done .dck-check { background:#22c55e; border-color:#22c55e; }
.dck-item.done .dck-check span { display:block; }
.dck-check span { display:none; }
.dck-grid { display:grid; grid-template-columns:1fr; gap:14px; }
@media (min-width:901px){ .dck-grid { grid-template-columns:1fr 1fr; align-items:start; } }
</style>

<div class="px-4 pt-2 space-y-4" style="max-width:1180px;margin:0 auto">

  <div style="margin:6px 2px 4px">
    <div style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00;margin-bottom:10px">Hábitos · Hoy</div>
    <h1 class="kc-h1" style="font-size:30px">Tu progreso de hoy</h1>
  </div>

  <!-- Banner de progreso -->
  <div style="background:linear-gradient(140deg,#1a7a3e,#146030);border-radius:26px;padding:22px;display:flex;align-items:center;gap:20px">
    <div style="position:relative;width:88px;height:88px;flex-shrink:0">
      <svg class="-rotate-90" width="88" height="88" viewBox="0 0 88 88">
        <circle cx="44" cy="44" r="38" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="8"></circle>
        <circle id="dckRing" cx="44" cy="44" r="38" fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round" stroke-dasharray="239" stroke-dashoffset="239" style="transition:stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1)"></circle>
      </svg>
      <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center"><span id="dckPct" class="kc-num" style="font-weight:900;font-size:22px;color:#fff">0%</span></div>
    </div>
    <div>
      <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:17px;color:#fff"><span id="dckCount">4</span> de 7 completadas</div>
      <p style="font-size:12.5px;color:rgba(255,255,255,0.8);margin-top:4px">Marca cada hábito al completarlo. Tu racha crece con la constancia diaria.</p>
    </div>
  </div>

  <div class="dck-grid">
    <!-- Nutrición -->
    <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;padding:20px">
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#f7f4f0;margin-bottom:14px">Nutrición</h2>
      <div style="display:flex;flex-direction:column;gap:9px">
        {nutricion.map(item => (
          <div class:list={['dck-item', { done: item.done }]} onclick="dckToggle(this)">
            <div class="dck-check"><span class="material-symbols-outlined" style="font-size:16px;color:#fff">check</span></div>
            <span class="material-symbols-outlined icon-filled" style={`font-size:20px;color:${item.color}`}>{item.icon}</span>
            <span class="dck-label" style="font-size:14px;font-weight:600;color:#f7f4f0">{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Bienestar -->
    <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;padding:20px">
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#f7f4f0;margin-bottom:14px">Bienestar</h2>
      <div style="display:flex;flex-direction:column;gap:9px">
        {bienestar.map(item => (
          <div class:list={['dck-item', { done: item.done }]} onclick="dckToggle(this)">
            <div class="dck-check"><span class="material-symbols-outlined" style="font-size:16px;color:#fff">check</span></div>
            <span class="material-symbols-outlined icon-filled" style={`font-size:20px;color:${item.color}`}>{item.icon}</span>
            <span class="dck-label" style="font-size:14px;font-weight:600;color:#f7f4f0">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Resumen semanal -->
  <div style="background:#161310;border:1px solid rgba(255,240,225,0.06);border-radius:24px;padding:20px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:#f7f4f0">Esta semana</h2>
      <span style="font-size:12px;color:rgba(247,244,240,0.4)">6 de 7 días en verde</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:8px">
      {['L','M','X','J','V','S','D'].map((d, i) => (
        <div style="text-align:center">
          <div style={`width:100%;aspect-ratio:1;border-radius:12px;display:flex;align-items:center;justify-content:center;${i < 6 ? 'background:rgba(34,197,94,0.14)' : 'background:#1e1a15;border:1px dashed rgba(255,240,225,0.12)'}`}>
            {i < 6 ? <span class="material-symbols-outlined icon-filled" style="color:#22c55e;font-size:18px">check</span> : <span style="font-size:11px;color:rgba(247,244,240,0.35)">hoy</span>}
          </div>
          <span style="font-size:10px;color:rgba(247,244,240,0.4);font-weight:600">{d}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
function dckUpdate() {
  var items = document.querySelectorAll('.dck-item');
  var done = document.querySelectorAll('.dck-item.done').length;
  var pct = Math.round(done / items.length * 100);
  document.getElementById('dckPct').textContent = pct + '%';
  document.getElementById('dckCount').textContent = done;
  document.getElementById('dckRing').style.strokeDashoffset = (239 * (1 - pct / 100)).toFixed(1);
}
function dckToggle(el) {
  el.classList.toggle('done');
  dckUpdate();
}
requestAnimationFrame(function () { setTimeout(dckUpdate, 300); });
</script>
</DemoLayout>
