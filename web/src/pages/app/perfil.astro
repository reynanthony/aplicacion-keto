---
// Perfil — UI v2 (HUD nativo). Reescrito a markup kc-* real: hero, chips,
// métricas, suscripción, datos editables, historial de peso y zona
// peligrosa (incluye el único botón de cerrar sesión visible, ya que el
// dropdown de header viejo no existe en AppShell). Lógica intacta
// (localStorage, entitlements, supabase). Respaldo: perfil.astro.bak
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="Mi Perfil" screen="perfil">
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}

.kc .prf-actions{display:flex;justify-content:flex-end}

.kc .prf-hero{display:flex;align-items:center;gap:14px}
.kc .prf-avatar{position:relative;flex-shrink:0;width:68px;height:68px;border-radius:var(--kc-radius-md);display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;background:color-mix(in oklab,var(--kc-amber) 14%,transparent);border:2px solid color-mix(in oklab,var(--kc-amber) 24%,transparent)}
.kc .prf-avatar img{width:100%;height:100%;object-fit:cover}
.kc .prf-avatar__initials{font:800 24px var(--kc-font-sans);color:var(--kc-amber)}
.kc .prf-avatar__cam{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:center;padding:3px 0;background:rgba(0,0,0,.45)}
.kc .prf-avatar__cam .material-symbols-outlined{font-size:13px;color:rgba(255,255,255,.75)}
.kc .prf-hero__name{font:800 16px var(--kc-font-sans);color:var(--kc-ink);margin-bottom:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kc .prf-hero__chips{display:flex;flex-wrap:wrap;gap:6px}

.kc .prf-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.kc .prf-metric{background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-md);padding:12px;text-align:center}
.kc .prf-metric .kc-ico{margin:0 auto 6px}
.kc .prf-metric b{display:block;font:800 18px var(--kc-font-sans);color:var(--kc-ink)}
.kc .prf-metric span{font:500 10px var(--kc-font-sans);color:var(--kc-ink-3)}

.kc .prf-sub-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px}

.kc .prf-kv{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-radius:var(--kc-radius-sm);background:var(--kc-surface-2)}
.kc .prf-kv+.prf-kv{margin-top:6px}
.kc .prf-kv span{font:500 13px var(--kc-font-sans);color:var(--kc-ink-3)}
.kc .prf-kv b{font:700 14px var(--kc-font-sans);color:var(--kc-ink)}
.kc .prf-kv--hi{background:color-mix(in oklab,var(--kc-amber) 10%,transparent)}
.kc .prf-kv--hi span{color:var(--kc-amber);font-weight:600}
.kc .prf-kv--hi b{color:var(--kc-amber);font-weight:800}

.kc .prf-danger{border-color:color-mix(in oklab,var(--kc-red) 30%,var(--kc-line))}
.kc .prf-danger-btn{width:100%;display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;border-radius:var(--kc-radius-md);font:700 14px var(--kc-font-sans);cursor:pointer;border:1px solid color-mix(in oklab,var(--kc-red) 20%,transparent);background:color-mix(in oklab,var(--kc-red) 8%,transparent);color:var(--kc-red)}
.kc .prf-danger-btn+.prf-danger-btn{margin-top:8px}
.kc .prf-danger-btn--soft{opacity:.75}
.kc .prf-danger-btn--softer{opacity:.55}

.kc .prf-modal{position:fixed;inset:0;z-index:70;align-items:center;justify-content:center;padding:16px}
.kc .prf-modal.hidden{display:none}
.kc .prf-modal.flex{display:flex}
.kc .prf-modal__scrim{position:absolute;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(4px)}
.kc .prf-modal__panel{position:relative;width:100%;max-width:360px;background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-xl);box-shadow:var(--kc-shadow-float);padding:22px}
</style>

<!-- Hero -->
<div>
  <div class="kc-hero-sub">Cuenta · Ajustes</div>
  <h1 class="kc-hero">Tu perfil<br><em>metabólico</em></h1>
</div>

<div class="prf-actions">
  <button class="kc-btn kc-btn--primary kc-btn--sm" onclick="saveProfile()"><span class="material-symbols-outlined" style="font-size:16px">save</span>Guardar</button>
</div>

<!-- Hero: avatar + nombre + chips -->
<section class="kc-card">
  <div class="prf-hero">
    <div class="prf-avatar" onclick="document.getElementById('avatarInput').click()">
      <img id="avatarImage" src="" class="hidden" alt="Avatar">
      <span id="avatarInitials" class="prf-avatar__initials">KL</span>
      <div class="prf-avatar__cam"><span class="material-symbols-outlined">photo_camera</span></div>
    </div>
    <input type="file" id="avatarInput" accept="image/*" class="hidden" onchange="handleAvatarChange(event)">
    <div style="flex:1;min-width:0">
      <p id="heroName" class="prf-hero__name">Tu Perfil</p>
      <div class="prf-hero__chips">
        <span id="heroWeight" class="kc-chip kc-c-amber">-- kg</span>
        <span id="heroGoal" class="kc-chip kc-c-neutral">Meta: --</span>
        <span id="heroLost" class="kc-chip kc-c-mint">0 kg</span>
      </div>
    </div>
  </div>
</section>

<!-- Métricas rápidas -->
<div class="prf-metrics">
  <div class="prf-metric"><span class="kc-ico kc-c-amber"><span class="material-symbols-outlined" style="font-size:18px;font-variation-settings:'FILL' 1">bolt</span></span><b id="statStreak">0</b><span>Racha</span></div>
  <div class="prf-metric"><span class="kc-ico kc-c-mint"><span class="material-symbols-outlined" style="font-size:18px;font-variation-settings:'FILL' 1">trending_down</span></span><b id="statLost">0</b><span>kg perdidos</span></div>
  <div class="prf-metric"><span class="kc-ico kc-c-cyan"><span class="material-symbols-outlined" style="font-size:18px;font-variation-settings:'FILL' 1">fitness_center</span></span><b id="statWorkouts">0</b><span>Entrenos</span></div>
</div>

<!-- Suscripción -->
<section class="kc-card">
  <div class="kc-card__head" style="margin-bottom:12px">
    <h2 class="kc-card__title" style="margin-top:0"><span class="material-symbols-outlined" style="font-size:18px;vertical-align:-3px;color:var(--kc-amber);font-variation-settings:'FILL' 1">workspace_premium</span> Suscripción</h2>
  </div>
  <div id="subEstadoFree">
    <p class="kc-card__sub" style="margin-bottom:14px">Estás en el plan Gratis. Sube a Premium para desbloquear Coach IA, el generador automático de plan y el historial de progreso.</p>
    <div class="prf-sub-btns">
      <button class="kc-btn kc-btn--primary" onclick="suscribirse('mensual')">Mensual · $14.99</button>
      <button class="kc-btn kc-btn--secondary" onclick="suscribirse('anual')">Anual · $149.99</button>
    </div>
  </div>
  <div id="subEstadoPremium" class="hidden">
    <div class="kc-chip kc-c-mint" style="height:auto;padding:10px 14px"><span class="material-symbols-outlined" style="font-size:18px">check_circle</span>Suscripción Premium activa</div>
  </div>
</section>

<!-- Datos Personales -->
<section class="kc-card">
  <div class="kc-card__head" style="margin-bottom:12px">
    <h2 class="kc-card__title" style="margin-top:0"><span class="material-symbols-outlined" style="font-size:18px;vertical-align:-3px;color:var(--kc-amber);font-variation-settings:'FILL' 1">person</span> Datos Personales</h2>
  </div>
  <div class="kc-field">
    <label class="kc-label">Nombre</label>
    <input type="text" id="userName" class="kc-input" placeholder="Tu nombre">
  </div>
  <div class="kc-field-2">
    <div class="kc-field"><label class="kc-label">Edad</label><input type="number" id="age" class="kc-input" placeholder="30"></div>
    <div class="kc-field">
      <label class="kc-label">Sexo</label>
      <select id="sex" class="kc-input"><option value="">Seleccionar</option><option value="male">Masculino</option><option value="female">Femenino</option></select>
    </div>
    <div class="kc-field"><label class="kc-label">Altura (cm)</label><input type="number" id="height" class="kc-input" placeholder="170"></div>
    <div class="kc-field" style="margin-bottom:0"><label class="kc-label">Meses Keto</label><input type="number" id="monthsOnKeto" class="kc-input" placeholder="1"></div>
  </div>
</section>

<!-- Peso & Objetivo -->
<section class="kc-card">
  <div class="kc-card__head" style="margin-bottom:12px">
    <h2 class="kc-card__title" style="margin-top:0"><span class="material-symbols-outlined" style="font-size:18px;vertical-align:-3px;color:var(--kc-amber);font-variation-settings:'FILL' 1">monitor_weight</span> Peso &amp; Objetivo</h2>
  </div>
  <div class="kc-field-2">
    <div class="kc-field"><label class="kc-label">Peso Inicial (kg)</label><input type="number" id="startWeight" step="0.1" class="kc-input" placeholder="85.0"></div>
    <div class="kc-field"><label class="kc-label">Peso Meta (kg)</label><input type="number" id="goalWeight" step="0.1" class="kc-input" placeholder="70.0"></div>
    <div class="kc-field">
      <label class="kc-label">Objetivo</label>
      <select id="trainingGoal" class="kc-input"><option value="lose">Perder Grasa</option><option value="maintain">Mantener</option><option value="gain">Ganar Músculo</option><option value="strength">Fuerza</option></select>
    </div>
    <div class="kc-field" style="margin-bottom:0">
      <label class="kc-label">Nivel de Actividad</label>
      <select id="activity" class="kc-input"><option value="1.2">Sedentario</option><option value="1.375">Ligero</option><option value="1.55">Moderado</option><option value="1.725">Activo</option><option value="1.9">Muy Activo</option></select>
    </div>
  </div>
</section>

<!-- Entrenamiento -->
<section class="kc-card">
  <div class="kc-card__head" style="margin-bottom:12px">
    <h2 class="kc-card__title" style="margin-top:0"><span class="material-symbols-outlined" style="font-size:18px;vertical-align:-3px;color:var(--kc-mint);font-variation-settings:'FILL' 1">fitness_center</span> Entrenamiento</h2>
  </div>
  <div class="kc-field-2">
    <div class="kc-field">
      <label class="kc-label">Tipo</label>
      <select id="trainingType" class="kc-input"><option value="bodyweight">Peso Corporal</option><option value="dumbbells">Mancuernas</option><option value="weights">Pesas / Barra</option><option value="both">Ambos</option><option value="machines">Máquinas</option></select>
    </div>
    <div class="kc-field">
      <label class="kc-label">Frecuencia</label>
      <select id="trainingFreq" class="kc-input"><option value="1">1 día / sem</option><option value="2">2 días / sem</option><option value="3">3 días / sem</option><option value="4">4 días / sem</option><option value="5">5 días / sem</option><option value="6">6 días / sem</option><option value="7">7 días / sem</option></select>
    </div>
  </div>
  <div class="kc-field" style="margin-bottom:0">
    <label class="kc-label">Experiencia</label>
    <select id="experience" class="kc-input"><option value="beginner">Principiante</option><option value="intermediate">Intermedio</option><option value="advanced">Avanzado</option></select>
  </div>
</section>

<!-- Resumen Metabólico -->
<section class="kc-card">
  <div class="kc-card__head" style="margin-bottom:12px">
    <h2 class="kc-card__title" style="margin-top:0"><span class="material-symbols-outlined" style="font-size:18px;vertical-align:-3px;color:var(--kc-amber);font-variation-settings:'FILL' 1">insights</span> Resumen Metabólico</h2>
  </div>
  <div class="prf-kv"><span>TMB (BMR)</span><b id="bmrValue">-- kcal</b></div>
  <div class="prf-kv"><span>TDEE</span><b id="tdeeValue">-- kcal</b></div>
  <div class="prf-kv prf-kv--hi"><span>Meta calórica</span><b id="caloriesValue">-- kcal</b></div>
  <div class="prf-kv"><span>Proteína diaria</span><b id="proteinValue">-- g</b></div>
  <p class="kc-label" style="text-align:center;margin-top:10px">Calculado con Mifflin-St Jeor · se actualiza al guardar</p>
</section>

<!-- Historial de Peso -->
<section class="kc-card">
  <div class="kc-card__head" style="margin-bottom:12px">
    <h2 class="kc-card__title" style="margin-top:0"><span class="material-symbols-outlined" style="font-size:18px;vertical-align:-3px;color:var(--kc-amber);font-variation-settings:'FILL' 1">history</span> Historial de Peso</h2>
    <a href="/app/progreso" class="kc-link" style="font-size:12px">Ver gráfica →</a>
  </div>
  <div id="weightHistoryList" class="kc-list" style="margin-bottom:12px"></div>
  <button class="kc-btn kc-btn--secondary kc-btn--block" onclick="showWeightModal()"><span class="material-symbols-outlined" style="font-size:16px">add</span>Registrar Peso</button>
</section>

<!-- Zona Peligrosa -->
<section class="kc-card prf-danger">
  <div class="kc-card__head" style="margin-bottom:4px">
    <h2 class="kc-card__title" style="margin-top:0"><span class="material-symbols-outlined" style="font-size:18px;vertical-align:-3px;color:var(--kc-red)">warning</span> Zona Peligrosa</h2>
  </div>
  <p class="kc-card__sub" style="margin-bottom:16px">Estas acciones son irreversibles. Asegúrate de saber lo que estás haciendo.</p>

  <button class="prf-danger-btn" onclick="handleLogout()"><span class="material-symbols-outlined" style="font-size:16px">logout</span>Cerrar Sesión</button>
  <button class="prf-danger-btn prf-danger-btn--soft" onclick="resetProgressData()"><span class="material-symbols-outlined" style="font-size:16px">restart_alt</span>Reiniciar solo el progreso</button>
  <button class="prf-danger-btn prf-danger-btn--softer" onclick="resetAllData()"><span class="material-symbols-outlined" style="font-size:16px">delete_forever</span>Borrar Todos los Datos</button>
</section>

<!-- Modal registrar peso -->
<div id="weightModal" class="prf-modal hidden">
  <div class="prf-modal__scrim" onclick="closeWeightModal()"></div>
  <div class="prf-modal__panel">
    <h3 class="kc-card__title" style="margin-top:0;margin-bottom:16px"><span class="material-symbols-outlined" style="color:var(--kc-amber);vertical-align:-3px">monitor_weight</span> Registrar Peso</h3>
    <input type="number" id="newWeightInput" step="0.1" min="20" max="300" class="kc-input" style="height:60px;font-size:22px;font-weight:700;text-align:center;margin-bottom:14px" placeholder="0.0">
    <button class="kc-btn kc-btn--primary kc-btn--block" style="margin-bottom:8px" onclick="saveWeight()">Guardar</button>
    <button class="kc-btn kc-btn--secondary kc-btn--block" onclick="closeWeightModal()">Cancelar</button>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="hidden" style="position:fixed;top:calc(16px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);padding:10px 18px;border-radius:var(--kc-radius-pill);box-shadow:var(--kc-shadow-float);z-index:9999;font:600 13px var(--kc-font-sans);color:#fff;opacity:0;transition:opacity .3s">
  <span id="toastMsg">✓ Guardado</span>
</div>

<Fragment slot="scripts">
<script is:inline src="/app/utils.js"></script>
<script is:inline src="/app/modules/entitlements.js"></script>
<script is:inline>
async function suscribirse(plan) {
  if (!window.KetoEntitlements) { showToast('No se pudo iniciar el checkout', true); return; }
  var url = await window.KetoEntitlements.checkoutUrl(plan);
  window.location.href = url;
}

function loadSubscriptionStatus() {
  if (!window.KetoEntitlements) return;
  var volvioDePago = new URLSearchParams(window.location.search).get('suscripcion') === 'activada';
  window.KetoEntitlements.isPremium(volvioDePago).then(function (premium) {
    document.getElementById('subEstadoFree').classList.toggle('hidden', premium);
    document.getElementById('subEstadoPremium').classList.toggle('hidden', !premium);
    if (volvioDePago) {
      showToast(premium ? '✓ Suscripción activada' : 'Pago recibido, confirmando suscripción...');
      window.history.replaceState({}, '', '/app/perfil');
    }
  });
}

function showToast(msg, isError) {
  var t = document.getElementById('toast'), m = document.getElementById('toastMsg');
  if (m) m.textContent = msg;
  t.style.background = isError ? 'var(--kc-red)' : 'var(--kc-mint)';
  t.classList.remove('hidden'); t.style.opacity = '1';
  setTimeout(function(){ t.style.opacity = '0'; setTimeout(function(){ t.classList.add('hidden'); }, 300); }, 2500);
}

function handleAvatarChange(event) {
  var file = event.target.files[0]; if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var url = e.target.result;
    document.getElementById('avatarImage').src = url;
    document.getElementById('avatarImage').classList.remove('hidden');
    document.getElementById('avatarInitials').classList.add('hidden');
    var p = safeParseJSON(localStorage.getItem('keto_profile'), {});
    p.avatar_url = url;
    localStorage.setItem('keto_profile', JSON.stringify(p));
    showToast('Foto actualizada');
  };
  reader.readAsDataURL(file);
}

function loadProfile() {
  var p = safeParseJSON(localStorage.getItem('keto_profile'), {});
  if (p.avatar_url) {
    document.getElementById('avatarImage').src = p.avatar_url;
    document.getElementById('avatarImage').classList.remove('hidden');
    document.getElementById('avatarInitials').classList.add('hidden');
  } else if (p.nombre || p.name) {
    document.getElementById('avatarInitials').textContent = (p.nombre || p.name).split(' ').map(function(n){ return n[0]; }).join('').substring(0,2).toUpperCase();
  }
  var sv = function(id, val){ var el=document.getElementById(id); if(el && val != null && val !== '') el.value = val; };
  sv('userName', p.nombre || p.name); sv('age', p.age); sv('sex', p.sex); sv('height', p.height);
  sv('startWeight', p.startWeight || p.weight); sv('goalWeight', p.goalWeight);
  sv('activity', p.activityLevel); sv('monthsOnKeto', p.monthsOnKeto);
  sv('trainingType', p.trainingType); sv('trainingFreq', p.trainingFreq);
  sv('trainingGoal', p.trainingGoal); sv('experience', p.experience);
  updateStats();
  loadWeightHistoryList();
}

function saveProfile() {
  var p = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var name       = document.getElementById('userName').value || p.nombre || p.name || '';
  var age        = parseInt(document.getElementById('age').value) || p.age || 0;
  var sex        = document.getElementById('sex').value || p.sex || 'male';
  var height     = parseInt(document.getElementById('height').value) || p.height || 0;
  var startWeight= parseFloat(document.getElementById('startWeight').value) || p.startWeight || 0;
  var goalWeight = parseFloat(document.getElementById('goalWeight').value) || p.goalWeight || 0;
  var activity   = parseFloat(document.getElementById('activity').value) || p.activityLevel || 1.55;
  var months     = parseInt(document.getElementById('monthsOnKeto').value) || p.monthsOnKeto || 1;
  var tType      = document.getElementById('trainingType').value || p.trainingType || 'bodyweight';
  var tFreq      = document.getElementById('trainingFreq').value || p.trainingFreq || '3';
  var tGoal      = document.getElementById('trainingGoal').value || p.trainingGoal || 'lose';
  var exp        = document.getElementById('experience').value || p.experience || 'beginner';

  var history = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
  var currentWeight = 0;
  if (history.length > 0) {
    var sorted = history.slice().sort(function(a,b){ return new Date(b.date)-new Date(a.date); });
    currentWeight = sorted[0].weight || 0;
  }
  if (!currentWeight) currentWeight = p.weight || startWeight;

  var goalFactor = tGoal === 'lose' ? -0.2 : tGoal === 'gain' ? 0.1 : 0;
  var w = currentWeight || 70, h = height || 170, a = age || 30;
  var bmr = sex === 'female' ? 10*w + 6.25*h - 5*a - 161 : 10*w + 6.25*h - 5*a + 5;
  var tdee = bmr * activity;
  var calories = Math.round(tdee * (1 + goalFactor));

  var profile = {
    name: name, nombre: name, age: age, sex: sex, height: height,
    weight: currentWeight, startWeight: startWeight, goalWeight: goalWeight,
    activityLevel: activity, monthsOnKeto: months,
    trainingType: tType, trainingFreq: tFreq, trainingGoal: tGoal, experience: exp,
    objetivo: tGoal, goal: goalFactor, avatar_url: p.avatar_url || ''
  };
  var macros = {
    calories: calories, protein: Math.round(w * 1.8),
    fat: Math.round((calories * 0.75) / 9), carbs: 25,
    bmr: Math.round(bmr), tdee: Math.round(tdee)
  };
  localStorage.setItem('keto_profile', JSON.stringify(profile));
  localStorage.setItem('keto_macros', JSON.stringify(macros));
  localStorage.setItem('ketocore_onboarding_done', 'true');
  showToast('✓ Perfil guardado');
  updateStats();
}

function updateStats() {
  var p = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var m = safeParseJSON(localStorage.getItem('keto_macros'), {});
  var workouts = safeParseJSON(localStorage.getItem('ketoWorkouts'), []);
  var history  = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
  var streak   = safeParseJSON(localStorage.getItem('ketoStreak'), { currentStreak: 0 });

  var currentWeight = 0;
  if (history.length > 0) {
    var s = history.slice().sort(function(a,b){ return new Date(b.date)-new Date(a.date); });
    currentWeight = s[0].weight || 0;
  }
  if (!currentWeight) currentWeight = p.weight || 0;

  var goalWeight  = parseFloat(p.goalWeight) || 0;
  var startWeight = parseFloat(p.startWeight) || 0;
  var lost = startWeight && currentWeight ? Math.max(0, startWeight - currentWeight) : 0;

  var ss = function(id, txt){ var el=document.getElementById(id); if(el) el.textContent=txt; };
  ss('heroName',   p.nombre || p.name || 'Tu Perfil');
  ss('heroWeight', currentWeight ? currentWeight.toFixed(1) + ' kg' : '-- kg');
  ss('heroGoal',   goalWeight ? 'Meta: ' + goalWeight + ' kg' : 'Meta: --');
  ss('heroLost',   lost > 0 ? '-' + lost.toFixed(1) + ' kg' : '0 kg');
  ss('statStreak',   streak.currentStreak || 0);
  ss('statLost',     lost > 0 ? lost.toFixed(1) : '0');
  ss('statWorkouts', workouts.length || 0);
  ss('bmrValue',     m.bmr ? m.bmr + ' kcal' : '-- kcal');
  ss('tdeeValue',    m.tdee ? m.tdee + ' kcal' : '-- kcal');
  ss('caloriesValue',m.calories ? m.calories + ' kcal' : '-- kcal');
  ss('proteinValue', m.protein ? m.protein + ' g' : '-- g');

  if (!p.avatar_url && (p.nombre || p.name)) {
    ss('avatarInitials', (p.nombre || p.name).split(' ').map(function(n){ return n[0]; }).join('').substring(0,2).toUpperCase());
  }
}

function loadWeightHistoryList() {
  var container = document.getElementById('weightHistoryList'); if (!container) return;
  var history = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
  var recent = history.slice().sort(function(a,b){ return new Date(b.date)-new Date(a.date); }).slice(0, 5);
  if (!recent.length) {
    container.innerHTML = '<p class="kc-label" style="text-align:center;padding:10px 0">Sin registros aún</p>';
    return;
  }
  container.innerHTML = recent.map(function(h, i) {
    var prev = recent[i+1];
    var diff = prev ? (h.weight - prev.weight) : null;
    var diffClass = diff === null ? '' : diff < 0 ? 'kc-delta-down' : diff > 0 ? 'kc-delta-up' : '';
    var diffText  = diff !== null ? (diff > 0 ? '+' : '') + diff.toFixed(1) + ' kg' : '';
    return '<div class="kc-li"><div class="kc-li__main"><div class="kc-li__s">' + h.date.slice(5).replace('-','/') + '</div></div>' +
      '<div class="kc-li__v">' + h.weight + ' kg' + (diffText ? '<small class="' + diffClass + '">' + diffText + '</small>' : '') + '</div></div>';
  }).join('');
}

function showWeightModal() {
  document.getElementById('weightModal').classList.remove('hidden');
  document.getElementById('weightModal').classList.add('flex');
  var inp = document.getElementById('newWeightInput'); if (inp) { inp.value=''; inp.focus(); }
}
function closeWeightModal() {
  document.getElementById('weightModal').classList.add('hidden');
  document.getElementById('weightModal').classList.remove('flex');
}

function saveWeight() {
  var inp = document.getElementById('newWeightInput');
  var val = parseFloat(inp.value);
  if (isNaN(val) || val < 20 || val > 300) { showToast('Peso inválido', true); return; }
  var history = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
  var today = new Date().toISOString().split('T')[0];
  var idx = history.findIndex(function(h){ return (h.date||h.fecha) === today; });
  if (idx >= 0) history[idx].weight = val; else history.push({ date: today, weight: val });
  localStorage.setItem('keto_weight_history', JSON.stringify(history));
  var p = safeParseJSON(localStorage.getItem('keto_profile'), {}); p.weight = val;
  localStorage.setItem('keto_profile', JSON.stringify(p));
  closeWeightModal(); showToast('✓ Peso registrado: ' + val + ' kg');
  updateStats(); loadWeightHistoryList();
}

async function handleLogout() {
  if (confirm('¿Cerrar sesión?')) {
    var isDemo = false;
    try { isDemo = localStorage.getItem('ketocore_demo_mode') === '1'; } catch (e) {}
    if (isDemo) { exitDemoMode(); return; }
    if (window.supabase) await window.supabase.auth.signOut();
    ['ketocore_user_id','ketocore_user_email','ketocore_onboarding_done'].forEach(function(k){ localStorage.removeItem(k); });
    window.location.href = '/app/welcome';
  }
}

// Clears only daily progress data, keeps profile + macros + objectives
function resetProgressData() {
  customConfirm('Se borrarán: historial de peso, racha, checklist diario, plan de comidas y entrenamientos. Tu perfil y objetivos quedan intactos.').then(function(ok) {
    if (!ok) return;
    var toRemove = ['keto_weight_history', 'ketoStreak', 'ketoWorkouts', 'keto_meals'];
    toRemove.forEach(function(k) { localStorage.removeItem(k); });
    // Pattern keys
    Object.keys(localStorage).forEach(function(k) {
      if (k.startsWith('mealPlan_') || k.startsWith('checklist_')) localStorage.removeItem(k);
    });
    showToast('Progreso reiniciado', 2000, 'success');
    setTimeout(function() { window.location.reload(); }, 1200);
  });
}

// Wipes ALL app data and returns to onboarding
function resetAllData() {
  customConfirm('⚠️ Se borrarán TODOS los datos de la app: perfil, peso, macros, objetivos, historial y configuración. Esta acción no se puede deshacer.').then(function(ok) {
    if (!ok) return;
    // Named keys
    [
      'keto_profile', 'keto_macros', 'keto_weight_history', 'keto_objetivos',
      'ketoStreak', 'ketoWorkouts', 'keto_meals', 'ketoFoods', 'despensa',
      'customRecipes', 'ketocore_onboarding_done', 'KetoCore_guest',
      'comunidad_waitlist', 'comunidad_count', 'userData', 'userData_migrated',
      'lastBackupDate', 'push_enabled', 'push_subscription', 'reminders_enabled'
    ].forEach(function(k) { localStorage.removeItem(k); });
    // Pattern keys
    Object.keys(localStorage).forEach(function(k) {
      if (k.startsWith('mealPlan_') || k.startsWith('checklist_') || k.startsWith('keto')) {
        localStorage.removeItem(k);
      }
    });
    showToast('Todos los datos borrados', 2000, 'info');
    setTimeout(function() { window.location.replace('/app/welcome'); }, 1000);
  });
}

document.addEventListener('DOMContentLoaded', loadProfile);
document.addEventListener('DOMContentLoaded', loadSubscriptionStatus);
</script>
