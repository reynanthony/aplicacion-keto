---
// Yo — v3. Resumen + navegación (sustituye el drawer de 16 enlaces de
// AppSidebar para las pantallas ya migradas). Todo lo que antes era
// formulario/ajuste en este archivo se movió a perfil-ajustes.astro sin
// cambios de lógica — aquí solo queda avatar, resumen y navegación.
import AppLayout from '../../layouts/AppLayout.astro';
import DataRow from '../../components/v3/DataRow.astro';
import Sheet from '../../components/v3/Sheet.astro';
import Dock from '../../components/v3/Dock.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Yo" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <div style="display:flex; align-items:center; gap:14px;">
        <div id="yoAvatarWrap" onclick="document.getElementById('yoAvatarInput').click()" style="position:relative; width:56px; height:56px; border-radius:16px; background:var(--v3-surface-1); border:2px solid var(--v3-border); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; overflow:hidden;">
          <img id="yoAvatarImg" src="" class="hidden" style="width:100%; height:100%; object-fit:cover;" alt="Avatar" />
          <span id="yoAvatarInitials" class="v3-num-mono" style="font-size:18px; color:var(--v3-lime);">KL</span>
        </div>
        <input type="file" id="yoAvatarInput" accept="image/*" class="hidden" />
        <div style="flex:1; min-width:0;">
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <span id="yoName" style="font-family:var(--v3-font-title); font-weight:800; font-size:16px; color:var(--v3-text);">Tu Perfil</span>
            <span class="v3-chip v3-chip--state" style="padding:3px 10px; font-size:10px;">Plan Demo</span>
          </div>
          <div id="yoStreak" style="font-size:12.5px; color:var(--v3-text-50); margin-top:2px;">Racha: 0 días</div>
        </div>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:16px; text-align:center;">
          <div id="yoHealthScore" class="v3-num-mono" style="font-size:26px; justify-content:center; color:var(--v3-amber);">--</div>
          <div class="v3-eyebrow" style="margin-top:4px;">Health Score</div>
        </div>
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:16px; text-align:center;">
          <div id="yoAdherencia" class="v3-num-mono" style="font-size:26px; justify-content:center; color:var(--v3-lime);">--%</div>
          <div class="v3-eyebrow" style="margin-top:4px;">Adherencia</div>
        </div>
      </div>

      <section>
        <p class="v3-eyebrow" style="margin-bottom:10px;">Seguimiento</p>
        <DataRow id="yo-row-progreso" leading="icon" leadingValue="trending_up" title="Progreso" meta="Peso, medidas y tendencia" />
        <DataRow id="yo-row-objetivos" leading="icon" leadingValue="flag" title="Objetivos" meta="Tus metas activas" />
        <DataRow id="yo-row-coach" leading="icon" leadingValue="psychology" title="Coach IA" meta="Chat y resumen semanal" />
      </section>

      <section>
        <p class="v3-eyebrow" style="margin-bottom:10px;">Rutina</p>
        <DataRow id="yo-row-entrenar" leading="icon" leadingValue="fitness_center" title="Entrenar" meta="Rutinas y sesiones" />
        <DataRow id="yo-row-suplementos" leading="icon" leadingValue="medication" title="Suplementos" meta="Tu protocolo diario" />
        <DataRow id="yo-row-comunidad" leading="icon" leadingValue="groups" title="Comunidad" meta="Tu cohorte" />
      </section>

      <section>
        <DataRow id="yo-row-sync" leading="icon" leadingValue="cloud_done" title="Sincronización" meta="—" />
      </section>

      <a href="/app/perfil-ajustes" class="v3-decision-card-action" style="background:var(--v3-surface-1); border:1px solid var(--v3-border); color:var(--v3-text); width:100%; justify-content:center;">
        <span class="material-symbols-outlined" style="font-size:18px">tune</span> Editar mis datos
      </a>
      <button type="button" id="yoLogoutBtn" class="v3-decision-card-action" style="background:transparent; border:1px solid var(--v3-border-alert); color:var(--v3-orange); width:100%; justify-content:center;">
        <span class="material-symbols-outlined" style="font-size:18px">logout</span> Cerrar sesión
      </button>

      <div style="display:none"><DataRow id="_v3-datarow-script-anchor-yo" title="" /></div>
    </main>

    <VeredictoSheet />
    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>
      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>
    <Dock active="yo" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/modules/health-score.js"></script>
  <script is:inline src="/app/modules/recommendation-engine.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    var YO_LINKS = {
      'yo-row-progreso': '/app/progreso',
      'yo-row-objetivos': '/app/objetivos',
      'yo-row-coach': '/app/coach',
      'yo-row-entrenar': '/app/entrenamientos',
      'yo-row-suplementos': '/app/suplementos',
      'yo-row-comunidad': '/app/comunidad'
    };

    function renderYo() {
      var p = safeParseJSON(localStorage.getItem('keto_profile'), {});
      var streak = safeParseJSON(localStorage.getItem('ketoStreak'), { currentStreak: 0 });

      document.getElementById('yoName').textContent = p.name || 'Tu Perfil';
      document.getElementById('yoStreak').textContent = 'Racha: ' + (streak.currentStreak || 0) + ' días';
      if (p.avatar_url) {
        document.getElementById('yoAvatarImg').src = p.avatar_url;
        document.getElementById('yoAvatarImg').classList.remove('hidden');
        document.getElementById('yoAvatarInitials').classList.add('hidden');
      } else if (p.name) {
        document.getElementById('yoAvatarInitials').textContent = p.name.split(' ').map(function (n) { return n[0]; }).join('').substring(0, 2).toUpperCase();
      }

      if (typeof HealthScoreEngine !== 'undefined') {
        document.getElementById('yoHealthScore').textContent = HealthScoreEngine.calculate().total;
      }
      if (typeof RecommendationEngine !== 'undefined') {
        document.getElementById('yoAdherencia').textContent = (RecommendationEngine.generate().adherence || 0) + '%';
      }

      var lastSync = localStorage.getItem('last_cloud_sync');
      var syncRow = document.querySelector('[data-row-id="yo-row-sync"]');
      var syncMeta = syncRow && syncRow.querySelector('.v3-row-meta');
      if (syncMeta) syncMeta.textContent = lastSync ? ('Última sync: ' + new Date(lastSync).toLocaleString('es-ES')) : 'Solo local — sin sincronizar todavía';

      var sub = document.querySelector('#v3-sheet-registrar .v3-sheet-subtitle');
      if (sub && window.KetoBudget) sub.textContent = 'Margen de hoy · ' + Math.round(window.KetoBudget.compute().available) + ' g netos';
    }

    document.addEventListener('DOMContentLoaded', function () {
      renderYo();

      Object.keys(YO_LINKS).forEach(function (id) {
        var row = document.querySelector('[data-row-id="' + id + '"] .v3-row-content');
        if (row) { row.style.cursor = 'pointer'; row.addEventListener('click', function () { location.href = YO_LINKS[id]; }); }
      });

      document.getElementById('yoAvatarInput').addEventListener('change', function (e) {
        var file = e.target.files[0]; if (!file) return;
        var reader = new FileReader();
        reader.onload = function (ev) {
          var p = safeParseJSON(localStorage.getItem('keto_profile'), {});
          p.avatar_url = ev.target.result;
          localStorage.setItem('keto_profile', JSON.stringify(p));
          renderYo();
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('yoLogoutBtn').addEventListener('click', async function () {
        if (!confirm('¿Cerrar sesión?')) return;
        if (window.supabase) await window.supabase.auth.signOut();
        ['ketocore_user_id', 'ketocore_user_email', 'ketocore_onboarding_done'].forEach(function (k) { localStorage.removeItem(k); });
        window.location.href = '/app/welcome';
      });
    });
  </script>
</AppLayout>
