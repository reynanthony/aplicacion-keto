---
// Coach IA — reskin al lenguaje HUD. Lógica intacta (chat keto-ai + KB demo +
// gating Premium + contexto + alertas); solo se reescribió el render a HUD.
// Respaldo del diseño anterior: coach.astro.bak
import AppShell from '../../layouts/AppShell.astro';
import Card from '../../components/kc/Card.astro';
import Icon from '../../components/kc/Icon.astro';
---
<AppShell title="Coach IA" screen="coach">
  <style is:global>
    @keyframes msgIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    @keyframes typingDot { 0%,80%,100% { opacity: .25; transform: scale(.85); } 40% { opacity: 1; transform: scale(1); } }
    @keyframes pulseGlow { 0%,100% { opacity: .6; } 50% { opacity: 1; } }
    .msg-in { animation: msgIn .3s ease-out forwards; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; }
    .status-online { background: var(--kc-mint); animation: pulseGlow 2s infinite; }
    .status-offline { background: var(--kc-amber); }
    .typing-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--kc-ink-3); display: inline-block; animation: typingDot 1.2s infinite ease-in-out; }
    .typing-dot:nth-child(2) { animation-delay: .18s; }
    .typing-dot:nth-child(3) { animation-delay: .36s; }
    .coach-av { width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center; flex-shrink: 0; background: rgba(255,159,67,.14); border: 1px solid rgba(255,159,67,.28); color: var(--kc-amber); }
    .coach-av svg { width: 17px; height: 17px; }
    .chat-bubble-coach { background: var(--kc-surface-2); border: 1px solid var(--kc-line); border-radius: 18px 18px 18px 4px; padding: 12px 14px; max-width: calc(100% - 42px); }
    .chat-bubble-user { background: rgba(255,159,67,.12); border: 1px solid rgba(255,159,67,.28); border-radius: 18px 18px 4px 18px; padding: 11px 14px; max-width: 92%; }
    .chat-bubble-coach p, .chat-bubble-user p { color: var(--kc-ink); font: 400 14.5px/1.55 var(--kc-font-sans); margin: 0; }
    .chat-bubble-coach a, .chat-bubble-user a { color: var(--kc-amber); font-weight: 700; }
    .suggestion-chip { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 100px; font: 600 13px var(--kc-font-sans); cursor: pointer; background: var(--kc-surface-2); border: 1px solid var(--kc-line); color: var(--kc-ink-2); white-space: nowrap; transition: all .15s; }
    .suggestion-chip:hover { border-color: rgba(255,159,67,.35); color: var(--kc-ink); }
    .suggestion-chip:active { transform: scale(.96); }
    .alert-card { border-radius: 14px; padding: 12px 14px; border: 1px solid; }
    .coach-input { position: fixed; left: 0; right: 0; bottom: calc(82px + env(safe-area-inset-bottom)); z-index: 30; max-width: 480px; margin: 0 auto; padding: 0 var(--kc-space-4); display: flex; gap: 8px; align-items: center; }
    .coach-input .kc-input { flex: 1; }
    @media (min-width: 901px) { .coach-input { bottom: calc(90px + env(safe-area-inset-bottom)); } }
  </style>

  <Card>
    <span slot="lead" class="kc-ico kc-c-amber"><Icon name="spark" /></span>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
      <div>
        <div class="kc-card__title" style="margin:0">Coach IA</div>
        <div id="aiStatusBar" style="display:flex;align-items:center;gap:6px;margin-top:5px">
          <span class="status-dot status-offline"></span>
          <span id="aiStatusLabel" class="kc-label">Verificando…</span>
        </div>
      </div>
      <button id="btnCtx" type="button" onclick="toggleContext()" class="kc-btn kc-btn--secondary kc-btn--sm">Contexto</button>
    </div>
  </Card>

  <div id="contextPanel" class="hidden">
    <Card eyebrow="Tu contexto" title="Estado actual">
      <div id="contextGrid" class="kc-grid" style="grid-template-columns:1fr 1fr 1fr"></div>
      <p id="contextHint" class="kc-label" style="margin-top:12px"></p>
    </Card>
  </div>

  <div id="alertsSection" class="kc-stack"></div>
  <div id="chatMessages" class="kc-stack" style="gap:14px"></div>

  <div id="suggestionsSection">
    <p class="kc-label" style="margin-bottom:10px">Preguntas frecuentes</p>
    <div id="suggestionChips" class="kc-row"></div>
  </div>

  <div style="height:70px"></div>

  <div class="coach-input" id="coachInputBar">
    <input id="chatInput" type="text" autocomplete="off" spellcheck="false" class="kc-input" placeholder="Pregúntale a tu Coach…"
      onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMessage()}" />
    <button id="sendBtn" onclick="sendMessage()" class="kc-btn kc-btn--primary kc-btn--icon" aria-label="Enviar"><Icon name="chevron" /></button>
  </div>

  <Fragment slot="scripts">
    <script is:inline src="/app/utils.js"></script>
    <script is:inline src="/app/modules/entitlements.js"></script>
    <script is:inline src="/app/modules/supabase-keto-ai.js"></script>
    <script is:inline src="/app/demo/demo-coach-kb.js"></script>
    <script is:inline src="/app/modules/meal-plan.js"></script>
    <script is:inline src="/app/modules/automation-engine.js"></script>
    <script is:inline>
    function safeJSON(k, d) { try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } }
    function escHtml(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function sparkIco() { return (window.KC_ICONS && window.KC_ICONS.spark) || ''; }

    var _ctx = {};
    function buildContext() {
      var profile = safeJSON('keto_profile', {}), macros = safeJSON('keto_macros', { calories:1800, protein:150, fat:140, carbs:25 });
      var wh = safeJSON('keto_weight_history', []); if (!Array.isArray(wh)) wh = [];
      wh.sort(function (a, b) { return a.date < b.date ? -1 : 1; });
      var streak = safeJSON('ketoStreak', { ketoDays: 0 }), todayKey = new Date().toISOString().slice(0, 10), plan = safeJSON('mealPlan_' + todayKey, {});
      var currW = wh.length ? parseFloat(wh[wh.length-1].weight) : parseFloat(profile.peso || 0);
      var startW = wh.length ? parseFloat(wh[0].weight) : currW, delta = Math.round((currW - startW) * 10) / 10;
      var cal = 0, carbs = 0, prot = 0;
      Object.keys(plan).forEach(function (meal) { if (!Array.isArray(plan[meal])) return; plan[meal].forEach(function (item) { var t = KetoMealPlan.itemTotals(item); cal += t.calories; carbs += t.carbs; prot += t.protein; }); });
      return { nombre: profile.nombre || profile.name || 'Usuario', peso: currW || null, pesoInicial: startW || null, pesoDelta: delta,
        metaCal: parseInt(macros.calories)||1800, metaCarbs: parseInt(macros.carbs)||25, metaProt: parseInt(macros.protein)||150, metaGrasa: parseInt(macros.fat)||140,
        racha: parseInt(streak.ketoDays)||0, calHoy: Math.round(cal), carbsHoy: Math.round(carbs), protHoy: Math.round(prot), registros: wh.length };
    }
    function contextSummary(ctx) {
      return ['Usuario: ' + ctx.nombre, ctx.peso ? 'Peso: ' + ctx.peso + ' kg' : null,
        ctx.pesoDelta !== 0 ? 'Cambio total: ' + (ctx.pesoDelta > 0 ? '+' : '') + ctx.pesoDelta + ' kg' : null,
        'Racha keto: ' + ctx.racha + ' días', 'Meta cal: ' + ctx.metaCal + ' kcal', 'Meta carbs: ' + ctx.metaCarbs + 'g', 'Meta prot: ' + ctx.metaProt + 'g',
        ctx.calHoy > 0 ? 'Hoy: ' + ctx.calHoy + ' kcal / ' + ctx.carbsHoy + 'g carbs' : null].filter(Boolean).join(', ');
    }
    function runInlineRules(ctx) {
      var s = [];
      if (ctx.racha >= 21) s.push({ type:'success', msg:'¡' + ctx.racha + ' días en cetosis! Racha excepcional.' });
      else if (ctx.racha >= 7) s.push({ type:'success', msg: ctx.racha + ' días de racha keto. ¡Muy bien!' });
      if (ctx.pesoDelta < -1) s.push({ type:'success', msg:'¡Has perdido ' + Math.abs(ctx.pesoDelta) + ' kg desde que empezaste!' });
      if (ctx.calHoy > 0 && ctx.carbsHoy > ctx.metaCarbs * 1.3) s.push({ type:'warning', msg:'Hoy llevas ' + ctx.carbsHoy + 'g de carbs vs tu meta de ' + ctx.metaCarbs + 'g.' });
      return s;
    }
    function renderContextPanel(ctx) {
      var grid = document.getElementById('contextGrid'), hint = document.getElementById('contextHint'); if (!grid) return;
      var items = [
        { label:'Peso', value: ctx.peso ? ctx.peso + ' kg' : '—', color:'var(--kc-ink)' },
        { label:'Cambio', value: ctx.pesoDelta !== 0 ? (ctx.pesoDelta > 0 ? '+' : '') + ctx.pesoDelta + ' kg' : '—', color: ctx.pesoDelta < 0 ? 'var(--kc-mint)' : ctx.pesoDelta > 0 ? 'var(--kc-red)' : 'var(--kc-ink)' },
        { label:'Racha keto', value: ctx.racha + 'd', color:'var(--kc-amber)' },
        { label:'Cal. meta', value: ctx.metaCal, color:'var(--kc-ink)' },
        { label:'Carbs meta', value: ctx.metaCarbs + 'g', color:'var(--kc-mint)' },
        { label:'Prot. meta', value: ctx.metaProt + 'g', color:'var(--kc-cyan)' }
      ];
      grid.innerHTML = items.map(function (it) {
        return '<div style="text-align:center;padding:8px 4px;background:var(--kc-surface-2);border:1px solid var(--kc-line);border-radius:12px">' +
          '<div style="font:800 16px var(--kc-font-sans);color:' + it.color + '">' + it.value + '</div>' +
          '<div class="kc-label" style="margin-top:4px">' + it.label + '</div></div>';
      }).join('');
      if (hint && ctx.calHoy > 0) hint.textContent = 'Hoy: ' + ctx.calHoy + ' kcal · ' + ctx.carbsHoy + 'g carbs · ' + ctx.protHoy + 'g proteína';
    }
    function toggleContext() { var p = document.getElementById('contextPanel'); if (!p) return; p.classList.toggle('hidden'); }

    var ALERT_C = { warning:{c:'var(--kc-amber)',bg:'rgba(255,159,67,.08)',b:'rgba(255,159,67,.25)'}, error:{c:'var(--kc-red)',bg:'rgba(255,107,120,.08)',b:'rgba(255,107,120,.25)'}, success:{c:'var(--kc-mint)',bg:'rgba(46,230,166,.08)',b:'rgba(46,230,166,.25)'}, info:{c:'var(--kc-cyan)',bg:'rgba(61,219,216,.08)',b:'rgba(61,219,216,.25)'} };
    function renderAlerts() {
      var section = document.getElementById('alertsSection'); if (!section) return;
      var alerts = window.KetoAutomations ? KetoAutomations.getAlerts() : []; if (!alerts.length) { section.innerHTML = ''; return; }
      section.innerHTML = alerts.slice(0, 3).map(function (a) {
        var s = ALERT_C[a.type] || ALERT_C.info;
        var btn = a.action === 'ask_coach' ? '<button onclick="prefillAndSend(\'' + escHtml(a.actionQuery || '') + '\')" class="kc-btn kc-btn--ghost kc-btn--sm" style="margin-top:8px;padding:0">' + escHtml(a.actionLabel || 'Consultar') + '</button>' : '';
        return '<div class="alert-card" style="background:' + s.bg + ';border-color:' + s.b + '">' +
          '<div style="display:flex;align-items:flex-start;gap:10px">' +
          '<span style="width:8px;height:8px;border-radius:50%;background:' + s.c + ';margin-top:5px;flex-shrink:0"></span>' +
          '<div style="flex:1"><div style="font:700 13px var(--kc-font-sans);color:var(--kc-ink)">' + escHtml(a.title) + '</div>' +
          '<div style="font:400 13px/1.5 var(--kc-font-sans);color:var(--kc-ink-2);margin-top:2px">' + escHtml(a.message) + '</div>' + btn + '</div>' +
          '<button onclick="dismissAlert(\'' + escHtml(a.id) + '\')" style="background:none;border:0;color:var(--kc-ink-3);cursor:pointer;font-size:16px;flex-shrink:0">✕</button>' +
          '</div></div>';
      }).join('');
    }
    function dismissAlert(id) { if (window.KetoAutomations) KetoAutomations.clearAlert(id); renderAlerts(); }
    function prefillAndSend(text) { var i = document.getElementById('chatInput'); if (i) i.value = text; sendMessage(); }

    var chatHistory = [], busy = false;
    function addMessage(role, html, meta) {
      var container = document.getElementById('chatMessages'); if (!container) return;
      var isUser = (role === 'user'), wrap = document.createElement('div');
      wrap.className = 'msg-in';
      wrap.style.cssText = 'display:flex;gap:10px;' + (isUser ? 'justify-content:flex-end' : 'justify-content:flex-start');
      if (isUser) {
        wrap.innerHTML = '<div class="chat-bubble-user"><p>' + html + '</p></div>';
      } else {
        var metaHtml = meta ? '<p class="kc-label" style="margin-top:8px">' + meta + '</p>' : '';
        wrap.innerHTML = '<div class="coach-av">' + sparkIco() + '</div><div class="chat-bubble-coach"><p>' + html + '</p>' + metaHtml + '</div>';
      }
      container.appendChild(wrap); wrap.scrollIntoView({ behavior:'smooth', block:'end' });
    }
    function showTyping() {
      var container = document.getElementById('chatMessages'); if (!container || document.getElementById('typingBubble')) return;
      var div = document.createElement('div'); div.id = 'typingBubble'; div.className = 'msg-in';
      div.style.cssText = 'display:flex;gap:10px;justify-content:flex-start';
      div.innerHTML = '<div class="coach-av">' + sparkIco() + '</div><div class="chat-bubble-coach"><div style="display:flex;gap:6px;align-items:center"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div></div>';
      container.appendChild(div); div.scrollIntoView({ behavior:'smooth', block:'end' });
    }
    function hideTyping() { var el = document.getElementById('typingBubble'); if (el) el.remove(); }

    var SUGGESTIONS = ['¿Cómo sé si estoy en cetosis?','¿Qué frutas puedo comer en keto?','¿Cuánta proteína necesito al día?','¿Qué es el keto flu y cómo evitarlo?','¿Puedo tomar café con leche?','¿Qué pasa si como carbohidratos?','¿El aguacate es bueno para keto?','¿Puedo hacer ayuno intermitente?'];
    function renderSuggestions() {
      var chips = document.getElementById('suggestionChips'); if (!chips) return;
      var list = (window.DemoCoachKB && DemoCoachKB.SUGGESTIONS) || SUGGESTIONS;
      chips.innerHTML = list.slice(0, 6).map(function (s) { return '<button class="suggestion-chip" onclick="prefillAndSend(\'' + s.replace(/'/g, "\\'") + '\')">' + s + '</button>'; }).join('');
    }

    async function sendMessage() {
      if (busy) return; var input = document.getElementById('chatInput'); if (!input) return;
      var text = input.value.trim(); if (!text) return;
      if (window.KetoEntitlements && !(await window.KetoEntitlements.isPremium())) {
        addMessage('assistant', 'El Coach IA es una función Premium. <a href="/app/perfil">Suscríbete</a> para seguir chateando.'); return;
      }
      input.value = ''; busy = true;
      var sugSect = document.getElementById('suggestionsSection'); if (sugSect) sugSect.style.display = 'none';
      addMessage('user', escHtml(text)); chatHistory.push({ role:'user', content:text }); showTyping();
      var answer = '', meta = '';
      try {
        if (window.KetoAI && KetoAI.isOnline) {
          var result = await KetoAI.callFunction('chat', { question:text, context:contextSummary(_ctx), history:chatHistory.slice(-6) });
          if (result && result.answer) { answer = result.answer; meta = 'Coach IA · respuesta personalizada'; aiConfirmedWorking = true; }
        }
        if (!answer && window.DemoCoachKB) { var kb = DemoCoachKB.ask(text); answer = escHtml(kb.a); meta = kb.found ? 'Base de conocimiento keto' : 'Respuesta general'; }
        if (!answer) { answer = 'En este momento estoy en modo offline. Conecta a internet para respuestas con IA. Mientras tanto puedes revisar Recetas o Guía.'; meta = 'Modo offline'; }
      } catch (e) {
        if (window.DemoCoachKB) { var kb2 = DemoCoachKB.ask(text); answer = escHtml(kb2.a); meta = 'Base de conocimiento (fallback)'; }
        else answer = 'Ocurrió un error. Intenta nuevamente.';
      }
      hideTyping(); addMessage('coach', answer, meta); chatHistory.push({ role:'coach', content:answer }); busy = false; updateStatusBadge();
    }

    var aiConfirmedWorking = false;
    function updateStatusBadge() {
      var dot = document.querySelector('#aiStatusBar .status-dot'), label = document.getElementById('aiStatusLabel');
      var reachable = window.KetoAI && KetoAI.isOnline, text, online;
      if (aiConfirmedWorking && reachable) { text = 'IA activa'; online = true; }
      else if (reachable) { text = 'Conectado'; online = true; }
      else { text = 'Modo offline · KB local'; online = false; }
      if (dot) dot.className = 'status-dot ' + (online ? 'status-online' : 'status-offline');
      if (label) label.textContent = text;
    }

    document.addEventListener('DOMContentLoaded', function () {
      _ctx = buildContext(); renderContextPanel(_ctx); renderSuggestions();
      if (window.KetoAutomations) { KetoAutomations.autoRun(); renderAlerts(); KetoAutomations.on('alerts', renderAlerts); }
      setTimeout(updateStatusBadge, 2500);
      var signals = runInlineRules(_ctx), greeting = '¡Hola ' + escHtml(_ctx.nombre) + '! Soy tu Coach IA. ';
      if (signals.length && signals[0].type === 'success') greeting += escHtml(signals[0].msg) + ' ';
      else if (_ctx.racha > 0) greeting += 'Llevas <strong>' + _ctx.racha + ' días</strong> en tu plan keto. ';
      greeting += '¿En qué te puedo ayudar hoy?'; addMessage('coach', greeting);
      var alerts = window.KetoAutomations ? KetoAutomations.getAlerts() : [];
      var urgent = alerts.find(function (a) { return a.type === 'error' || a.type === 'warning'; });
      if (urgent) setTimeout(function () { addMessage('coach', 'He detectado algo: <strong style="color:var(--kc-amber)">' + escHtml(urgent.title) + '</strong> — ' + escHtml(urgent.message) + (urgent.actionQuery ? '<br><br>Puedes preguntarme sobre eso directamente.' : ''), 'Alerta automática'); }, 900);
    });
    </script>
  </Fragment>
</AppShell>
