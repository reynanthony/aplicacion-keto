---
// Alimentos ("¿es keto?") — v3, alcance acordado con el usuario: buscador +
// lista DataRow con verdict-bar + DecisionCard cream de cierre. Se retira de
// ESTA pantalla (sin borrar datos subyacentes: ketoFoods/favoritos siguen en
// localStorage) el grid de tarjetas con imágenes, los modales de añadir/editar/
// Pexels/búsqueda online/receta rápida/grupos/historial y el FAB group —
// ninguna otra pantalla del repo referencia esos IDs/funciones (verificado).
import AppLayout from '../../layouts/AppLayout.astro';
import DataRow from '../../components/v3/DataRow.astro';
import DecisionCard from '../../components/v3/DecisionCard.astro';
import Chip from '../../components/v3/Chip.astro';
import Sheet from '../../components/v3/Sheet.astro';
import Dock from '../../components/v3/Dock.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Alimentos" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
    #al-search:focus-within { border-color: var(--v3-lime) !important; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <p class="v3-eyebrow">¿Es keto?</p>

      <div id="al-search" style="display:flex; align-items:center; gap:10px; background:var(--v3-surface-1); border:1.5px solid var(--v3-lime); border-radius:var(--v3-radius-pill); padding:12px 16px; transition:border-color .15s;">
        <span class="material-symbols-outlined" style="color:var(--v3-text-40); font-size:20px">search</span>
        <input id="alSearchInput" type="text" placeholder="Buscar un alimento…"
          style="flex:1; background:transparent; border:none; outline:none; color:var(--v3-text); font-size:14.5px;" />
        <a href="/app/scanner" aria-label="Escanear" style="display:flex; color:var(--v3-lime);">
          <span class="material-symbols-outlined" style="font-size:22px">qr_code_scanner</span>
        </a>
      </div>

      <div class="v3-chip-group" data-group="al-filter">
        <Chip role="filter" label="Todos" active={true} group="al-filter" />
        <Chip role="filter" label="Keto" group="al-filter" />
        <Chip role="filter" label="Proteínas" group="al-filter" />
        <Chip role="filter" label="Verduras" group="al-filter" />
        <Chip role="filter" label="Grasas" group="al-filter" />
      </div>

      <div id="alFoodList"></div>
      <div style="display:none"><DataRow id="_v3-datarow-script-anchor-alimentos" title="" /></div>

      <div id="alDecisionWrap" style="display:none;">
        <DecisionCard id="al-verdict" variant="cream" buttonLabel="Añadir" title="">
          <span id="alVerdictBody"></span>
        </DecisionCard>
      </div>

    </main>

    <VeredictoSheet />
    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>
      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>
    <Dock active="alimentos" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/food-api.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    var defaultFoods=[
    {id:"f1",name:"Huevos",portion:50,calories:78,protein:6,fat:5,carbs:0.6,category:"Proteínas",units:[{name:"unidades",grams:50},{name:"gramos",grams:1}]},
    {id:"f2",name:"Pechuga de pollo",portion:100,calories:165,protein:31,fat:3.6,carbs:0,category:"Proteínas",units:[{name:"gramos",grams:1},{name:"libras",grams:453.6}]},
    {id:"f3",name:"Carne molida 80/20",portion:100,calories:254,protein:17,fat:20,carbs:0,category:"Proteínas",units:[{name:"gramos",grams:1}]},
    {id:"f4",name:"Salmón",portion:100,calories:208,protein:20,fat:13,carbs:0,category:"Proteínas",units:[{name:"gramos",grams:1}]},
    {id:"f5",name:"Bacon",portion:50,calories:270,protein:12,fat:23,carbs:1,category:"Proteínas",units:[{name:"gramos",grams:1}]},
    {id:"f8",name:"Atún",portion:100,calories:132,protein:28,fat:1,carbs:0,category:"Proteínas",units:[{name:"gramos",grams:1},{name:"latas",grams:140}]},
    {id:"f12",name:"Aguacate",portion:100,calories:160,protein:2,fat:15,carbs:9,fiber:7,category:"Grasas",units:[{name:"gramos",grams:1},{name:"unidades",grams:200}]},
    {id:"f13",name:"Aceite de oliva",portion:15,calories:119,protein:0,fat:13.5,carbs:0,category:"Grasas",units:[{name:"ml",grams:0.9},{name:"cucharadas",grams:15}]},
    {id:"f14",name:"Mantequilla",portion:15,calories:102,protein:0.1,fat:11.5,carbs:0,category:"Grasas",units:[{name:"gramos",grams:1},{name:"cucharadas",grams:15}]},
    {id:"f17",name:"Almendras",portion:30,calories:170,protein:6,fat:15,carbs:6,fiber:3.5,category:"Frutos secos",units:[{name:"gramos",grams:1}]},
    {id:"f23",name:"Brócoli",portion:100,calories:34,protein:2.8,fat:0.4,carbs:7,fiber:2.6,category:"Verduras",units:[{name:"gramos",grams:1}]},
    {id:"f25",name:"Espinacas",portion:100,calories:23,protein:2.9,fat:0.4,carbs:3.6,fiber:2.2,category:"Verduras",units:[{name:"gramos",grams:1}]},
    {id:"f28",name:"Pepino",portion:100,calories:15,protein:0.7,fat:0.1,carbs:3.6,category:"Verduras",units:[{name:"gramos",grams:1}]},
    {id:"f30",name:"Tomate",portion:100,calories:18,protein:0.9,fat:0.2,carbs:3.9,fiber:1.2,category:"Verduras",units:[{name:"gramos",grams:1}]},
    {id:"f35",name:"Queso mozzarella",portion:100,calories:280,protein:28,fat:17,carbs:3.1,category:"Lácteos",units:[{name:"gramos",grams:1}]},
    {id:"f60",name:"Yogur griego natural",portion:100,calories:97,protein:9,fat:5,carbs:3.6,category:"Lácteos",units:[{name:"gramos",grams:1}]}
    ];

    var currentFoods=[];
    var currentFilter="Todos";
    var currentSearch="";
    var currentDetailFood=null;

    function mapCategory(cat){
      var map={proteina:'Proteínas',grasa:'Grasas',lacteo:'Lácteos',marisco:'Proteínas',vegetal:'Verduras',fruto_seco:'Frutos secos'};
      return map[cat]||cat;
    }

    async function loadFoodsFromSupabase(){
      var headers={
        'apikey':'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxtYnF6c29udWp3dnFtZmhqamdmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzMyNTQzMDAsImV4cCI6MjA4ODgzMDMwMH0.SBsTQCh844rtGx0wLNZaEGO8NDmAVZjUj1YiDkRSm1k',
        'Authorization':'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxtYnF6c29udWp3dnFtZmhqamdmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzMyNTQzMDAsImV4cCI6MjA4ODgzMDMwMH0.SBsTQCh844rtGx0wLNZaEGO8NDmAVZjUj1YiDkRSm1k'
      };
      try{
        var response=await fetch('https://lmbqzsonujwvqmfhjjgf.supabase.co/rest/v1/alimentos?activo=eq.true&select=*&order=nombre.asc',{headers:headers});
        var data=await response.json();
        if(data&&data.length>0){
          var supabaseFoods=data.map(function(r){return{id:r.id,name:r.nombre,calories:parseFloat(r.calorias)||0,protein:parseFloat(r.proteinas)||0,fat:parseFloat(r.grasas)||0,carbs:parseFloat(r.carbos)||0,fiber:parseFloat(r.fibra)||0,category:mapCategory(r.categoria),favorite:false};});
          var localFoods=safeParseJSON(localStorage.getItem("ketoFoods"),[])||[];
          var localIds={};
          localFoods.forEach(function(f){localIds[f.id]=true;});
          supabaseFoods.forEach(function(sf){if(!localIds[sf.id])localFoods.push(sf);});
          currentFoods=localFoods;
          localStorage.setItem("ketoFoods",JSON.stringify(currentFoods));
          renderFoods();
          return;
        }
      }catch(e){ /* fallback local */ }
      loadFoodsLocal();
    }

    function loadFoodsLocal(){
      var stored=safeParseJSON(localStorage.getItem("ketoFoods"),null);
      if(stored&&Array.isArray(stored)&&stored.length>0){
        currentFoods=stored;
      }else{
        currentFoods=JSON.parse(JSON.stringify(defaultFoods));
        localStorage.setItem("ketoFoods",JSON.stringify(currentFoods));
      }
      renderFoods();
    }

    function loadFoods(){ loadFoodsFromSupabase(); }
    function saveFoods(){ localStorage.setItem("ketoFoods",JSON.stringify(currentFoods)); }

    function getNetCarbs(food){ return Math.max(0,(food.carbs||0)-(food.fiber||0)); }

    // Se conserva tal cual (solo se remapea el color a 3 niveles lima/ámbar/naranja abajo)
    function getKetoScore(food){
      var netCarbs=getNetCarbs(food);
      if(netCarbs<=1)return{score:5,label:"Excelente"};
      if(netCarbs<=3)return{score:4,label:"Muy bueno"};
      if(netCarbs<=5)return{score:3,label:"Bueno"};
      if(netCarbs<=8)return{score:2,label:"Moderado"};
      return{score:1,label:"Bajo"};
    }
    function verdictFromScore(score){
      if(score>=4)return'lime';
      if(score===3)return'amber';
      return'orange';
    }

    function matchesFilter(food){
      if(currentFilter==="Todos")return true;
      if(currentFilter==="Keto")return getNetCarbs(food)<=3;
      return food.category===currentFilter;
    }

    function renderFoods(){
      var list=document.getElementById('alFoodList');
      var q=currentSearch.trim().toLowerCase();
      var foods=currentFoods.filter(function(f){
        if(q&&f.name.toLowerCase().indexOf(q)===-1)return false;
        return matchesFilter(f);
      });
      if(!foods.length){
        list.innerHTML='<p style="font-size:13px; color:var(--v3-text-40); padding:16px 2px;">Sin resultados.</p>';
        return;
      }
      list.innerHTML=foods.map(function(food){
        var score=getKetoScore(food);
        var verdict=verdictFromScore(score.score);
        return '' +
          '<div class="v3-row-wrap" data-row-id="'+food.id+'" data-food-id="'+food.id+'">' +
            '<div class="v3-row-actions"><button type="button" class="v3-row-action v3-row-action--edit" style="width:128px" data-open-food="'+food.id+'">Ver</button></div>' +
            '<div class="v3-row v3-row--verdict-bar">' +
              '<span class="v3-row-vbar v3-row-vbar--'+verdict+'"></span>' +
              '<div class="v3-row-content v3-row-content--pending" data-open-food="'+food.id+'" style="cursor:pointer;">' +
                '<div class="v3-row-body">' +
                  '<div class="v3-row-title">'+escapeHtml(food.name)+'</div>' +
                  '<div class="v3-row-meta">'+food.category+' · '+food.portion+'g</div>' +
                '</div>' +
                '<div class="v3-row-value v3-num-mono">'+getNetCarbs(food).toFixed(1)+'<span class="v3-row-unit">g</span></div>' +
              '</div>' +
            '</div>' +
          '</div>';
      }).join('');
    }

    var MEAL_LABELS={desayuno:'Desayuno',almuerzo:'Almuerzo',cena:'Cena',snacks:'Snack'};

    function openDetail(id){
      currentDetailFood=currentFoods.find(function(f){return f.id===id});
      if(!currentDetailFood)return;
      var score=getKetoScore(currentDetailFood);
      var verdict=verdictFromScore(score.score);
      var budget=window.KetoBudget.compute();
      var netCarbs=getNetCarbs(currentDetailFood);
      var after=budget.available-netCarbs;

      var wrap=document.getElementById('alDecisionWrap');
      var card=wrap.querySelector('.v3-decision-card');
      card.className='v3-decision-card v3-decision-card--cream';
      card.querySelector('.v3-decision-card-title').textContent=currentDetailFood.name+' · '+score.label;
      var msg=after>=0
        ? ('Con tu margen de hoy ('+Math.round(budget.available)+'g), esto entra sin problema.')
        : ('Esto agotaría tu margen de hoy — quedarías en '+Math.round(after)+'g.');
      document.getElementById('alVerdictBody').textContent=msg+' Netos: '+netCarbs.toFixed(1)+'g · '+currentDetailFood.calories+' kcal.';
      wrap.style.display='block';
      wrap.scrollIntoView({behavior:'smooth',block:'center'});
    }

    document.addEventListener('DOMContentLoaded',function(){
      loadFoods();

      document.getElementById('alSearchInput').addEventListener('input',function(e){
        currentSearch=e.target.value;
        renderFoods();
      });

      document.addEventListener('click',function(e){
        var el=e.target.closest('[data-open-food]');
        if(el) openDetail(el.getAttribute('data-open-food'));
      });

      document.addEventListener('v3:chip-active-changed',function(e){
        if(e.detail.group!=='al-filter')return;
        currentFilter=e.detail.label;
        renderFoods();
      });

      document.addEventListener('v3:decision-action',function(e){
        if(e.detail.id!=='al-verdict'||!currentDetailFood)return;
        var slot=window.KetoMealLog.inferMealSlot();
        window.selectMeal(MEAL_LABELS[slot]);
        document.getElementById('alDecisionWrap').style.display='none';
      });
      document.addEventListener('v3:decision-dismiss',function(e){
        if(e.detail.id==='al-verdict') document.getElementById('alDecisionWrap').style.display='none';
      });

      var sub=document.querySelector('#v3-sheet-registrar .v3-sheet-subtitle');
      if(sub) sub.textContent='Margen de hoy · '+Math.round(window.KetoBudget.compute().available)+' g netos';
    });

    window.selectMeal=function(meal){
      if(!currentDetailFood)return;
      try{
        var qty=currentDetailFood.portion;
        var mealKey=meal.toLowerCase();
        if(mealKey==="snack")mealKey="snacks";
        var item={id:currentDetailFood.id,name:currentDetailFood.name,portion:qty,calories:Math.round(currentDetailFood.calories*qty/currentDetailFood.portion),protein:(currentDetailFood.protein*qty/currentDetailFood.portion).toFixed(1),fat:(currentDetailFood.fat*qty/currentDetailFood.portion).toFixed(1),carbs:(currentDetailFood.carbs*qty/currentDetailFood.portion).toFixed(1)};
        window.KetoMealLog.logItem(mealKey,item);
        showToast("Añadido a "+meal);
      }catch(e){showToast("Error: "+e.message)}
    };

    function showToast(msg){
      var t=document.createElement('div');
      t.style.cssText='position:fixed;bottom:100px;left:16px;right:16px;background:var(--v3-surface-2);color:var(--v3-text);padding:12px 16px;border-radius:14px;box-shadow:0 8px 30px rgba(0,0,0,0.45);z-index:9999;text-align:center;font-size:14px;font-weight:600;';
      t.textContent=msg;
      document.body.appendChild(t);
      setTimeout(function(){t.remove();},3000);
    }
  </script>
</AppLayout>
