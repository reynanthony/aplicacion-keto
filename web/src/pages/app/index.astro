  var checklistHistory = [];
  for (var ci = 0; ci < 30; ci++) {
    var cd = new Date(); cd.setDate(cd.getDate() - ci);
    var ck = 'checklist_' + cd.toISOString().slice(0, 10);
    var cv = safeParseJSON(localStorage.getItem(ck), null);
    if (cv) checklistHistory.push(cv);
  }
  var waterDays    = checklistHistory.filter(function(c) { return (c.water || 0) >= 3; }).length;
  var workoutDays  = checklistHistory.filter(function(c) { return (c.workout || 0) >= 30; }).length;
  var macroHitDays = checklistHistory.filter(function(c) { return c.calorias && c.proteina; }).length;

  var allAchievements = [
    { id: 'first_meal',   name: 'Primera Comida',    icon: 'restaurant',        color: '#ff4d00', bg: 'rgba(255,77,0,0.12)',    desc: 'Registra tu primera comida',   unlocked: mealCount > 0 },
    { id: 'keto_starter', name: 'Iniciador Keto',    icon: 'star',              color: '#fbbf24', bg: 'rgba(251,191,36,0.12)', desc: '1 día en racha',               unlocked: (streakData.currentStreak || 0) >= 1 },
    { id: 'week_warrior', name: 'Guerrero Semanal',  icon: 'military_tech',     color: '#60a5fa', bg: 'rgba(96,165,250,0.12)', desc: '7 días en racha',              unlocked: (streakData.currentStreak || 0) >= 7 },
    { id: 'month_master', name: 'Maestro Mensual',   icon: 'emoji_events',      color: '#fbbf24', bg: 'rgba(251,191,36,0.12)', desc: '30 días en racha',             unlocked: (streakData.currentStreak || 0) >= 30 },
    { id: 'macro_master', name: 'Maestro de Macros', icon: 'donut_small',       color: '#fb923c', bg: 'rgba(251,146,60,0.12)', desc: 'Cumple macros 7 días',         unlocked: macroHitDays >= 7 },
    { id: 'water_hero',   name: 'Héroe del Agua',    icon: 'water_drop',        color: '#60a5fa', bg: 'rgba(96,165,250,0.12)', desc: 'Bebe 3L de agua 7 días',       unlocked: waterDays >= 7 },
    { id: 'gym_beast',    name: 'Bestia del Gym',    icon: 'fitness_center',    color: '#4ade80', bg: 'rgba(74,222,128,0.12)', desc: 'Entrena 20 días',              unlocked: workoutDays >= 20 },
    { id: 'consistent',   name: 'Consistente',       icon: 'track_changes',     color: '#c084fc', bg: 'rgba(192,132,252,0.12)',desc: 'Usa la app 14 días',           unlocked: (streakData.ketoDays || 0) >= 14 }
  ];
  
  return allAchievements.filter(function(a) { return a.unlocked; });
}

function initAchievements() {
  var recentContainer = document.getElementById('recentAchievements');
  if (!recentContainer) return;
  
  var achievements = getUnlockedAchievements();
  
  if (achievements.length === 0) {
    recentContainer.innerHTML = '<div class="text-center py-4 text-sm" style="color:rgba(247,244,240,0.45)">Completa tareas para desbloquear logros</div>';
