<script is:inline>
// toggleTheme() now in utils.js

function showNotifications() {
  populateNotifications();
  var modal = document.getElementById('notificationsModal');
  modal.classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function populateNotifications() {
  var container = document.getElementById('notificationsList');
  if (!container) return;
  
  var notifications = [];
  var todayKey = new Date().toISOString().slice(0, 10);
  var ketoProfile = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var macros = safeParseJSON(localStorage.getItem('keto_macros'), {});
  var checklistData = safeParseJSON(localStorage.getItem('checklist_' + todayKey), {});
  var mealPlan = safeParseJSON(localStorage.getItem('mealPlan_' + todayKey), {});
  var weightHistory = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
  if (!Array.isArray(weightHistory)) weightHistory = [];
  
  var targetCal = parseInt(macros.calories) || 0;
  var targetProt = parseInt(macros.protein) || 0;
  var targetFat = parseInt(macros.fat) || 0;
  var targetWater = 0;
  
  var consumedCal = 0, consumedProt = 0, consumedFat = 0;
  Object.keys(mealPlan).forEach(function(meal) {
    if (Array.isArray(mealPlan[meal])) {
      mealPlan[meal].forEach(function(item) {
        var totals = KetoMealPlan.itemTotals(item);
        consumedCal += totals.calories;
        consumedProt += totals.protein;
        consumedFat += totals.fat;
      });
    }
  });
  
  var water = checklistData.water || 0;
  var workout = checklistData.workout || 0;
  var checkedItems = Object.values(checklistData).filter(function(v) { return v === true; }).length;
  var totalItems = 5;
  
  if (consumedCal >= targetCal * 0.9 && consumedCal <= targetCal * 1.1) {
    notifications.push({
      icon: 'local_fire_department',
      iconBg: 'bg-primary-container/20',
      iconColor: 'text-primary-container',
      title: 'Calorías en meta',
      text: 'Has consumido ' + fmtNum(consumedCal) + ' de ' + fmtNum(targetCal) + ' kcal hoy.',
      time: 'Hoy',
      dot: false
    });
  } else if (consumedCal > targetCal) {
    notifications.push({
      icon: 'warning',
      iconBg: 'bg-red-500/20',
      iconColor: 'text-red-400',
      title: 'Calorías excedidas',
      text: 'Has consumido ' + fmtNum(consumedCal) + ' de ' + fmtNum(targetCal) + ' kcal. ' + fmtNum(consumedCal - targetCal) + ' kcal de más.',
      time: 'Hoy',
      dot: true
    });
  } else if (consumedCal > 0) {
    notifications.push({
      icon: 'egg_alt',
      iconBg: 'bg-primary-container/20',
      iconColor: 'text-primary-container',
      title: 'Progreso calórico',
      text: 'Has consumido ' + fmtNum(consumedCal) + ' de ' + fmtNum(targetCal) + ' kcal.',
      time: 'Hoy',
      dot: false
    });
  }
  
  if (consumedProt >= targetProt * 0.9) {
    notifications.push({
      icon: 'fitness_center',
      iconBg: 'bg-green-500/20',
      iconColor: 'text-green-400',
      title: 'Meta de proteína alcanzada',
      text: fmtNum(consumedProt) + 'g de ' + fmtNum(targetProt) + 'g consumidos.',
      time: 'Hoy',
      dot: false
    });
  } else if (consumedProt > 0) {
    notifications.push({
      icon: 'egg_alt',
      iconBg: 'bg-secondary/20',
      iconColor: 'text-secondary',
      title: 'Progreso de proteína',
      text: fmtNum(consumedProt) + 'g de ' + fmtNum(targetProt) + 'g consumidos.',
      time: 'Hoy',
      dot: false
    });
  }
  
  if (water >= targetWater) {
    notifications.push({
      icon: 'water_drop',
      iconBg: 'bg-blue-500/20',
      iconColor: 'text-blue-400',
      title: 'Hidratación completa',
      text: '¡Has alcanzado tu meta de ' + targetWater + 'L de agua!',
      time: 'Hoy',
      dot: false
    });
  } else if (water > 0) {
    var remaining = (targetWater - water).toFixed(1);
    notifications.push({
      icon: 'water_drop',
      iconBg: 'bg-secondary/20',
      iconColor: 'text-secondary',
      title: 'Recordatorio de hidratación',
      text: 'Te faltan ' + remaining + 'L para llegar a tu meta de ' + targetWater + 'L.',
      time: 'Hoy',
      dot: water < targetWater * 0.5
    });
  }
  
  if (workout >= 30) {
    notifications.push({
      icon: 'directions_run',
      iconBg: 'bg-green-500/20',
      iconColor: 'text-green-400',
      title: 'Entrenamiento completado',
      text: fmtNum(workout) + ' minutos de ejercicio hoy.',
      time: 'Hoy',
      dot: false
    });
  } else if (workout > 0) {
    notifications.push({
      icon: 'directions_run',
      iconBg: 'bg-secondary/20',
      iconColor: 'text-secondary',
      title: 'Progreso de ejercicio',
      text: fmtNum(workout) + ' minutos de ' + fmtNum(60) + ' min recomendados.',
      time: 'Hoy',
      dot: false
    });
  }
  
  if (checkedItems >= totalItems) {
    notifications.push({
      icon: 'check_circle',
      iconBg: 'bg-green-500/20',
      iconColor: 'text-green-400',
      title: 'Checklist completado',
      text: '¡Felicidades! Completaste todas las tareas del día.',
      time: 'Hoy',
      dot: false
    });
  }
  
  if (weightHistory.length >= 2) {
    var sorted = weightHistory.slice().sort(function(a, b) { return new Date(b.date) - new Date(a.date); });
    var latest = sorted[0].weight;
    var prev = sorted[1].weight;
    if (latest && prev) {
      var diff = (latest - prev).toFixed(1);
      var trend = diff < 0 ? 'perdido' : diff > 0 ? 'ganado' : 'mantenido';
      notifications.push({
        icon: 'monitor_weight',
        iconBg: 'bg-secondary/20',
        iconColor: 'text-secondary',
        title: 'Actualización de peso',
        text: 'Tu peso actual es ' + latest + 'kg. Has ' + trend + ' ' + Math.abs(diff) + 'kg desde el último registro.',
        time: 'Registro: ' + sorted[0].date,
        dot: false
      });
    }
  }
  
  var weeklyLoss = calculateWeeklyLoss();
  if (weeklyLoss !== '0' && weeklyLoss !== '--') {
    var lossVal = parseFloat(weeklyLoss);
    if (lossVal > 0) {
      notifications.push({
        icon: 'trending_down',
        iconBg: 'bg-green-500/20',
        iconColor: 'text-green-400',
        title: 'Progreso semanal',
        text: 'Has perdido ' + weeklyLoss + 'kg esta semana. ¡Sigue así!',
        time: 'Esta semana',
        dot: false
      });
    } else if (lossVal < 0) {
      notifications.push({
        icon: 'trending_up',
        iconBg: 'bg-red-500/20',
        iconColor: 'text-red-400',
        title: 'Atención: peso estable',
        text: 'Esta semana has subido ' + Math.abs(weeklyLoss) + 'kg. Revisa tu alimentación.',
        time: 'Esta semana',
        dot: true
      });
    }
  }
  
  if (notifications.length === 0) {
    notifications.push({
      icon: 'info',
      iconBg: 'bg-surface-container-high',
      iconColor: 'text-on-surface-variant',
      title: 'Sin actividad reciente',
      text: 'Comienza tu día registrando tu peso, comida y agua.',
      time: 'Hoy',
      dot: false
    });
  }
  
  container.innerHTML = notifications.map(function(n) {
    return '<div class="p-3.5 rounded-xl cursor-pointer transition-colors hover:bg-orange-50" style="border:1px solid rgba(255,240,225,0.06)">' +
      '<div class="flex items-start gap-3">' +
      '<div class="w-9 h-9 rounded-xl ' + n.iconBg + ' flex items-center justify-center flex-shrink-0">' +
      '<span class="material-symbols-outlined ' + n.iconColor + ' text-lg">' + n.icon + '</span>' +
      '</div>' +
      '<div class="flex-1 min-w-0">' +
      '<p class="text-sm font-semibold" style="color:#f7f4f0">' + n.title + '</p>' +
      '<p class="text-xs mt-0.5" style="color:rgba(247,244,240,0.6)">' + n.text + '</p>' +
      '<p class="text-[10px] mt-1.5" style="color:rgba(247,244,240,0.38)">' + n.time + '</p>' +
      '</div>' +
      (n.dot ? '<div class="w-2 h-2 rounded-full flex-shrink-0 mt-2" style="background:#ff4d00"></div>' : '') +
      '</div></div>';
  }).join('');
}

function closeNotifications() {
  var modal = document.getElementById('notificationsModal');
  modal.classList.add('hidden');
  document.body.style.overflow = '';
}

// toggleSidebar() now in utils.js

function showUpdateWeightModal() {
  var modal = document.getElementById('weightModal');
  var input = document.getElementById('newWeightInput');
  var currentWeight = localStorage.getItem('currentWeight') || '70';
  if (input) input.value = currentWeight;
  if (modal) {
    modal.classList.remove('hidden');
  }
  document.body.style.overflow = 'hidden';
}

function closeWeightModal() {
  var modal = document.getElementById('weightModal');
  modal.classList.add('hidden');
  document.body.style.overflow = '';
}

function openBackupModal() {
  var modal = document.getElementById('backupModal');
  modal.classList.remove('hidden');
  modal.classList.add('flex', 'modal-appear');
  document.body.style.overflow = 'hidden';
  
  // Cargar fecha del último backup
  var lastBackupEl = document.getElementById('lastBackupDate');
  if (lastBackupEl) {
    var lastBackup = localStorage.getItem('lastBackupDate');
    if (lastBackup) {
      lastBackupEl.textContent = new Date(lastBackup).toLocaleDateString('es-ES', { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    } else {
      lastBackupEl.textContent = 'Nunca';
    }
  }
}

function closeBackupModal() {
  var modal = document.getElementById('backupModal');
  modal.classList.remove('flex', 'modal-appear');
  modal.classList.add('hidden');
  document.body.style.overflow = '';
}

function saveNewWeight() {
  var input = document.getElementById('newWeightInput');
  var newWeight = parseFloat(input.value);
  
  if (!newWeight || newWeight < 20 || newWeight > 300) {
    window.showToast('Por favor ingresa un peso válido entre 20 y 300 kg', 3000, "warning");
    return;
  }
  
  var currentWeight = parseFloat(localStorage.getItem('currentWeight') || newWeight);
  localStorage.setItem('currentWeight', newWeight);
  
  var today = new Date().toISOString().slice(0, 10);
  var weightHistory = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
  if (!Array.isArray(weightHistory)) weightHistory = [];
  
  var existingIndex = weightHistory.findIndex(function(e) { return e.date === today; });
  if (existingIndex >= 0) {
    weightHistory[existingIndex].weight = newWeight;
  } else {
    weightHistory.push({ date: today, weight: newWeight });
  }
  localStorage.setItem('keto_weight_history', JSON.stringify(weightHistory));
  
  closeWeightModal();
  updateDashboard();
}

if (localStorage.getItem('theme') === 'dark' || !localStorage.getItem('theme')) {
  document.documentElement.classList.add('dark');
} else {
  document.documentElement.classList.remove('dark');
}

// Inicializar i18n
initI18n();

function safeSetText(id, text) {
  var el = document.getElementById(id);
  if (el) {
    el.textContent = text;
  }
}

function safeSetHTML(id, html) {
  var el = document.getElementById(id);
  if (el) {
    el.innerHTML = html;
  }
}

function safeSetStyle(id, prop, value) {
  var el = document.getElementById(id);
  if (el) {
    el.style[prop] = value;
  }
}

// Format number with thousands separator (commas)
function fmtNum(num) {
  if (num === null || num === undefined || num === '') return '0';
  var n = parseFloat(num);
  if (isNaN(n)) return '0';
  return n.toLocaleString('es-ES');
}

// Format number with 1 decimal place and thousands separator
function fmtNumDec(num) {
  if (num === null || num === undefined || num === '') return '0.0';
  var n = parseFloat(num);
  if (isNaN(n)) return '0.0';
  return n.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
}

// ==================== NEW DASHBOARD FUNCTIONS ====================

// Initialize dashboard on page load
function initDashboard() {
  loadDashboard();
  updateMotivationalMessage();
  initStreakSystem();
  initAchievements();
}

// Verificar onboarding al cargar
function checkOnboarding() {
  // Si el usuario está logueado pero no completó onboarding, redirigir
  const onboardingDone = localStorage.getItem('ketocore_onboarding_done');
  const userLoggedIn = localStorage.getItem('ketocore_user_id'); // asumiendo que guardas el user ID
  
  if (!onboardingDone) {
    // Verificar si hay sesión de Supabase activa
    const supabase = window.supabase;
    if (supabase) {
      supabase.auth.getSession().then(({ data: { session } }) => {
        if (session?.user && !onboardingDone) {
          window.location.href = '/app/onboarding';
        }
      });
    }
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initDashboard);
} else {
  // DOM already loaded
  initDashboard();
}

// Ejecutar verificación de onboarding
checkOnboarding();

// Actualizar avatar del header
updateHeaderAvatar();

// Motor de automatizaciones — corre en segundo plano
if (window.KetoAutomations) {
  KetoAutomations.autoRun();
}

// Reload dashboard when page becomes visible (e.g., after returning from profile)
document.addEventListener('visibilitychange', function() {
  if (!document.hidden) {
    loadDashboard();
  }
});

// Listen for profile saved events
window.addEventListener('profileSaved', function(e) {
  loadDashboard();
  updateHeaderAvatar();
});

function loadDashboard() {
  try {
    var ketoProfile = safeParseJSON(localStorage.getItem('keto_profile'), {});
    console.log('Dashboard - ketoProfile:', ketoProfile);
    console.log('Dashboard - startWeight:', ketoProfile.startWeight);
    console.log('Dashboard - goalWeight:', ketoProfile.goalWeight);
    var macros = safeParseJSON(localStorage.getItem('keto_macros'), {});
    
    var userName = ketoProfile.name || '';
    
    // Update greeting
    var greetingEl = document.getElementById('userGreeting');
    if (greetingEl) {
      if (userName) {
        greetingEl.textContent = '¡Hola, ' + userName + '!';
      } else {
        greetingEl.textContent = '¡Bienvenido!';
      }
    }
    
    // Update profile button
    var profileBtn = document.getElementById('profileBtn');
    if (profileBtn && userName) {
      profileBtn.textContent = userName.charAt(0).toUpperCase();
      profileBtn.title = 'Mi perfil: ' + userName;
    }
    
    var todayKey = new Date().toISOString().slice(0, 10);
    
    // Load checklist data
    var rawData = localStorage.getItem('checklist_' + todayKey);
    var checklistData = safeParseJSON(rawData, {});
    var water = checklistData.water || 0;
    var workout = checklistData.workout || 0;
    
    // Load macros - only use stored values, don't use defaults
    var macrosRaw = localStorage.getItem('keto_macros');
    var macros = macrosRaw ? JSON.parse(macrosRaw) : {};
    var hasMacros = macros && Object.keys(macros).length > 0;
    var targetCal = macros.calories !== undefined ? parseInt(macros.calories) : 0;
    var targetProt = macros.protein !== undefined ? parseInt(macros.protein) : 0;
    var targetFat = macros.fat !== undefined ? parseInt(macros.fat) : 0;
    var targetCarbs = macros.carbs !== undefined ? parseInt(macros.carbs) : 0;
    
    // Calculate consumed macros
    var mealPlan = safeParseJSON(localStorage.getItem('mealPlan_' + todayKey), {});
    var consumedCal = 0, consumedProt = 0, consumedFat = 0, consumedCarbs = 0;
    var totalMealItems = 0;
    
    Object.keys(mealPlan).forEach(function(meal) {
      if (Array.isArray(mealPlan[meal])) {
        totalMealItems += mealPlan[meal].length;
        mealPlan[meal].forEach(function(item) {
          var totals = KetoMealPlan.itemTotals(item);
          consumedCal += totals.calories;
          consumedProt += totals.protein;
          consumedFat += totals.fat;
          consumedCarbs += totals.carbs;
        });
      }
    });
    
    // Weight calculations - only use stored values, not defaults
    var ketoProfileRaw = localStorage.getItem('keto_profile');
    var ketoProfileCheck = ketoProfileRaw ? JSON.parse(ketoProfileRaw) : {};
    
    // Check if we have any profile data
    var hasProfile = ketoProfileCheck && (ketoProfileCheck.startWeight || ketoProfileCheck.weight || ketoProfileCheck.goalWeight);
    
    // Weight data from profile
    var startWeight = ketoProfileCheck.startWeight || 0;  // Peso inicial de Datos Personales
    var goalWeight = ketoProfileCheck.goalWeight || 0;   // Meta de peso
    
    // Get current weight from history (most recent entry)
    var weightHistoryRaw = localStorage.getItem('keto_weight_history');
    var weightHistory = weightHistoryRaw ? JSON.parse(weightHistoryRaw) : [];
    var currentWeight = 0;
    
    if (Array.isArray(weightHistory) && weightHistory.length > 0) {
      var sortedDesc = weightHistory.slice().sort(function(a, b) { return new Date(b.date) - new Date(a.date); });
      currentWeight = sortedDesc[0].weight || 0;
    }
    
    // If no history, use weight from profile
    if (!currentWeight && ketoProfileCheck.weight) {
      currentWeight = ketoProfileCheck.weight;
    }
    
    // Calculate progress
    var totalToLose = startWeight - goalWeight;
    var lostSoFar = currentWeight > 0 && startWeight > 0 ? startWeight - currentWeight : 0;
    var weightProgress = 0;
    if (totalToLose > 0 && currentWeight > 0 && startWeight > 0) {
      weightProgress = Math.round((lostSoFar / totalToLose) * 100);
    }
    if (weightProgress < 0) weightProgress = 0;
    if (weightProgress > 100) weightProgress = 100;
    
    // Update progress ring
    safeSetText('progressPercent', currentWeight > 0 && hasProfile ? weightProgress + '%' : '0%');
    var circle = document.getElementById('progressCircle');
    if (circle) {
      var circumference = 377;
      var offset = circumference - (circumference * weightProgress / 100);
      circle.style.strokeDashoffset = offset;
    }
    
    // Update weight display
    var remaining = currentWeight - goalWeight;
    var weightEl = document.getElementById('weightDisplay');
    if (weightEl) {
      if (currentWeight === 0) {
        weightEl.innerHTML = '<span class="text-on-surface-variant">Registra tu peso</span>';
      } else {
        weightEl.innerHTML = fmtNumDec(currentWeight) + 'kg <span class="text-on-surface-variant font-light">→</span> ' + fmtNumDec(goalWeight) + 'kg';
      }
    }
    
    var remainingEl = document.getElementById('remainingKg');
    if (remainingEl) {
      if (currentWeight === 0) {
        remainingEl.textContent = 'Toca para registrar';
      } else if (remaining > 0) {
        remainingEl.textContent = fmtNumDec(remaining) + 'kg restantes';
      } else if (remaining < 0) {
        remainingEl.textContent = fmtNumDec(Math.abs(remaining)) + 'kg bajo meta';
      } else {
        remainingEl.textContent = '¡Meta alcanzada!';
      }
    }
    
    // Update lost progress badge
    var lostBadge = document.getElementById('lostProgressBadge');
    var lostText = document.getElementById('lostProgressText');
    if (lostBadge && lostText) {
      if (lostSoFar > 0) {
        var percentOfTotal = totalToLose > 0 ? Math.round((lostSoFar / totalToLose) * 100) : 0;
        lostText.textContent = '-' + fmtNumDec(lostSoFar) + 'kg (' + percentOfTotal + '%)';
        lostBadge.classList.remove('hidden');
      } else if (lostSoFar < 0) {
        // Gained weight
        lostText.textContent = '+' + fmtNumDec(Math.abs(lostSoFar)) + 'kg';
        lostBadge.classList.remove('bg-green-500/20', 'text-green-400');
        lostBadge.classList.add('bg-red-500/20', 'text-red-400');
        lostBadge.classList.remove('hidden');
      } else {
        lostBadge.classList.add('hidden');
      }
    }
    
    // Calculate weekly loss
    var weeklyLoss = calculateWeeklyLoss();
    safeSetText('weeklyLossText', weeklyLoss.replace('kg', ''));
    
    // Update Macros
    updateMacrosDisplay(consumedCal, consumedProt, consumedFat, consumedCarbs, targetCal, targetProt, targetFat, targetCarbs);
    
    // Update Today's date
    var todayDateEl = document.getElementById('todayDateDisplay');
    if (todayDateEl) {
      var today = new Date();
      var options = { weekday: 'long', day: 'numeric', month: 'long' };
      todayDateEl.textContent = today.toLocaleDateString('es-ES', options);
    }
    
    // Update weight chart
    renderWeightChart();
    
    // Update today's meals summary
    renderTodayMealsSummary(mealPlan);
    
    // Update achievements
    updateAchievementsStats(totalMealItems);
    
    // Update weekly goals
    loadWeeklyGoals();
    
  } catch (e) {
    console.error('Error loading dashboard:', e);
  }
}


function updateMacrosDisplay(consumedCal, consumedProt, consumedFat, consumedCarbs, targetCal, targetProt, targetFat, targetCarbs) {
  var hasTargets = targetCal > 0 || targetProt > 0 || targetFat > 0 || targetCarbs > 0;
  
  // Calories
  var calPercent = hasTargets && targetCal > 0 ? Math.min(100, Math.round((consumedCal / targetCal) * 100)) : 0;
  var caloriesRemaining = hasTargets && targetCal > 0 ? Math.max(0, targetCal - consumedCal) : 0;
  
  safeSetText('consumedCalDisplay', fmtNum(consumedCal));
  safeSetText('targetCalDisplay', hasTargets ? fmtNum(targetCal) : '--');
  safeSetStyle('caloriesBar', 'width', calPercent + '%');
  safeSetText('caloriesRemaining', hasTargets ? fmtNum(caloriesRemaining) : '--');
  
  // Calorie status
  var calStatusEl = document.getElementById('calorieStatus');
  if (calStatusEl) {
    if (!hasTargets) {
      calStatusEl.textContent = 'Sin meta';
      calStatusEl.className = 'text-xs px-2 py-1 rounded-full bg-gray-500/20 text-gray-400';
    } else if (consumedCal > targetCal) {
      calStatusEl.textContent = 'Excedido';
      calStatusEl.className = 'text-xs px-2 py-1 rounded-full bg-red-500/20 text-red-400';
    } else if (consumedCal >= targetCal * 0.8) {
      calStatusEl.textContent = 'Casi completo';
      calStatusEl.className = 'text-xs px-2 py-1 rounded-full bg-yellow-500/20 text-yellow-400';
    } else {
      calStatusEl.textContent = 'En camino';
      calStatusEl.className = 'text-xs px-2 py-1 rounded-full bg-green-500/20 text-green-400';
    }
  }
  
  // Protein
  var protPercent = hasTargets && targetProt > 0 ? Math.min(100, Math.round((consumedProt / targetProt) * 100)) : 0;
  safeSetText('consumedProtDisplay', fmtNum(consumedProt));
  safeSetText('targetProtDisplay', hasTargets ? fmtNum(targetProt) : '--');
  safeSetStyle('proteinBar', 'width', protPercent + '%');
  
  // Fat
  var fatPercent = hasTargets && targetFat > 0 ? Math.min(100, Math.round((consumedFat / targetFat) * 100)) : 0;
  safeSetText('consumedFatDisplay', fmtNum(consumedFat));
  safeSetText('targetFatDisplay', hasTargets ? fmtNum(targetFat) : '--');
  safeSetStyle('fatBar', 'width', fatPercent + '%');
  
  // Carbs
  var carbsPercent = hasTargets && targetCarbs > 0 ? Math.min(100, Math.round((consumedCarbs / targetCarbs) * 100)) : 0;
  safeSetText('consumedCarbsDisplay', fmtNum(consumedCarbs));
  safeSetText('targetCarbsDisplay', hasTargets ? fmtNum(targetCarbs) : '--');
  safeSetStyle('carbsBar', 'width', carbsPercent + '%');
  
  // Distribution
  var totalMacroCal = (consumedProt * 4) + (consumedFat * 9) + (consumedCarbs * 4);
  if (totalMacroCal > 0) {
    var fatDist = Math.round((consumedFat * 9 / totalMacroCal) * 100);
    var protDist = Math.round((consumedProt * 4 / totalMacroCal) * 100);
    var carbsDist = 100 - fatDist - protDist;
    safeSetStyle('fatDistBar', 'width', fatDist + '%');
    safeSetStyle('protDistBar', 'width', protDist + '%');
    safeSetStyle('carbsDistBar', 'width', Math.max(0, carbsDist) + '%');
    safeSetText('macroDistributionRatio', fatDist + '% / ' + protDist + '% / ' + Math.max(0, carbsDist) + '%');
  }
}

// ==================== WEIGHT TREND CHART ====================

function renderWeightChart() {
  var svg    = document.getElementById('weightChartSvg');
  var legend = document.getElementById('weightLegend');
  if (!svg) return;

  var profile = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var history = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
  if (!Array.isArray(history)) history = [];

  var goalWeight  = parseFloat(profile.goalWeight  || profile.pesoObjetivo) || 0;
  var startWeight = parseFloat(profile.startWeight || profile.weight)       || 0;

  // Build last 7 days
  var today = new Date();
  var days = [];
  for (var i = 6; i >= 0; i--) {
    var d = new Date(today); d.setDate(today.getDate() - i);
    var ds = d.toISOString().slice(0, 10);
    var entry = history.find(function(h){ return (h.date || h.fecha) === ds; });
    days.push({ ds: ds, dn: d.getDate(), weight: entry ? (parseFloat(entry.weight || entry.peso) || null) : null, isToday: i === 0 });
  }

  var dataPts = days.filter(function(d){ return d.weight !== null; });

  if (dataPts.length === 0) {
    svg.innerHTML = '<text x="160" y="70" text-anchor="middle" dominant-baseline="middle" fill="rgba(247,244,240,0.28)" font-size="11" font-family="Inter,sans-serif">Registra tu peso para ver la tendencia</text>';
    if (legend) legend.innerHTML = '';
    safeSetText('weightAvg', '-- kg');
    return;
  }

  // Fixed SVG coordinate space matches viewBox="0 0 320 140"
  var W = 320, H = 140;
  var PL = 36, PR = 10, PT = 16, PB = 26;
  var iW = W - PL - PR;   // 274
  var iH = H - PT - PB;   // 98

  // Weight scale
  var ws = dataPts.map(function(d){ return d.weight; });
  if (goalWeight > 0) ws.push(goalWeight);
  var minW = Math.min.apply(null, ws);
  var maxW = Math.max.apply(null, ws);
  var rng = maxW - minW || 1;
  minW -= rng * 0.22;
  maxW += rng * 0.1;
  rng = maxW - minW;

  function xP(i) { return PL + (i / 6) * iW; }
  function yP(w) { return PT + iH - ((w - minW) / rng) * iH; }

  var h = '<defs>'
    + '<linearGradient id="wG" x1="0" y1="0" x2="0" y2="1">'
    + '<stop offset="0%" stop-color="#ff4d00" stop-opacity="0.28"/>'
    + '<stop offset="100%" stop-color="#ff4d00" stop-opacity="0.01"/>'
    + '</linearGradient></defs>';

  // Y-axis grid + labels (3 ticks)
  for (var t = 0; t < 3; t++) {
    var tw = minW + (rng * t / 2);
    var ty = yP(tw);
    h += '<line x1="' + PL + '" y1="' + f1(ty) + '" x2="' + (W-PR) + '" y2="' + f1(ty) + '" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>';
    h += '<text x="' + (PL-3) + '" y="' + f1(ty+3.5) + '" text-anchor="end" fill="rgba(247,244,240,0.3)" font-size="8.5" font-family="Inter,sans-serif">' + tw.toFixed(1) + '</text>';
  }

  // Goal weight dashed line
  if (goalWeight > 0 && goalWeight >= minW && goalWeight <= maxW + rng * 0.1) {
    var gy = yP(goalWeight);
    h += '<line x1="' + PL + '" y1="' + f1(gy) + '" x2="' + (W-PR) + '" y2="' + f1(gy) + '" stroke="#22c55e" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.5"/>';
    h += '<text x="' + (W-PR-2) + '" y="' + f1(gy-3) + '" text-anchor="end" fill="#22c55e" font-size="8" font-family="Inter,sans-serif" opacity="0.6">meta</text>';
  }

  // Map all 7 days to SVG coords (null y for missing entries)
  var pts = days.map(function(d, i){
    return { x: xP(i), y: d.weight !== null ? yP(d.weight) : null, w: d.weight, isToday: d.isToday, dn: d.dn };
  });

  // Smooth bezier through consecutive data points
  var conn = pts.filter(function(p){ return p.y !== null; });
  if (conn.length >= 2) {
    var lp = 'M' + f1(conn[0].x) + ',' + f1(conn[0].y);
    for (var j = 1; j < conn.length; j++) {
      var cp = (conn[j-1].x + conn[j].x) / 2;
      lp += ' C' + f1(cp) + ',' + f1(conn[j-1].y) + ' ' + f1(cp) + ',' + f1(conn[j].y) + ' ' + f1(conn[j].x) + ',' + f1(conn[j].y);
    }
    var bot = PT + iH;
    h += '<path d="' + lp + ' L' + f1(conn[conn.length-1].x) + ',' + bot + ' L' + f1(conn[0].x) + ',' + bot + ' Z" fill="url(#wG)"/>';
    h += '<path d="' + lp + '" fill="none" stroke="#ff4d00" stroke-width="2" stroke-linecap="round"/>';
  } else if (conn.length === 1) {
    h += '<circle cx="' + f1(conn[0].x) + '" cy="' + f1(conn[0].y) + '" r="4" fill="#ff4d00"/>';
  }

  // X-axis labels + data dots
  pts.forEach(function(p) {
    var tc = p.isToday ? '#ff4d00' : 'rgba(247,244,240,0.32)';
    h += '<text x="' + f1(p.x) + '" y="' + (H-6) + '" text-anchor="middle" fill="' + tc + '" font-size="8.5" font-weight="' + (p.isToday ? '700' : '400') + '" font-family="Inter,sans-serif">' + p.dn + '</text>';
    if (p.y !== null) {
      if (p.isToday) {
        h += '<circle cx="' + f1(p.x) + '" cy="' + f1(p.y) + '" r="9" fill="rgba(255,77,0,0.13)"/>';
        h += '<circle cx="' + f1(p.x) + '" cy="' + f1(p.y) + '" r="4.5" fill="#ff4d00" stroke="rgba(19,19,21,0.5)" stroke-width="1.5"/>';
        h += '<text x="' + f1(p.x) + '" y="' + f1(p.y - 14) + '" text-anchor="middle" fill="#ff4d00" font-size="10" font-weight="700" font-family="Inter,sans-serif">' + p.w.toFixed(1) + '</text>';
      } else {
        h += '<circle cx="' + f1(p.x) + '" cy="' + f1(p.y) + '" r="3" fill="#ff4d00" opacity="0.6"/>';
      }
    }
  });

  svg.innerHTML = h;

  // Summary stat cards
  var latestW = dataPts[dataPts.length - 1].weight;
  safeSetText('weightAvg', latestW ? latestW.toFixed(1) + ' kg' : '-- kg');

  if (legend) {
    var lostKg    = (startWeight && latestW && startWeight > latestW) ? (startWeight - latestW).toFixed(1) : null;
    var remaining = (goalWeight  && latestW)                          ? Math.abs(latestW - goalWeight).toFixed(1) : null;
    legend.innerHTML =
      statCard(latestW ? latestW.toFixed(1) + ' kg' : '--', 'Actual',   '#f7f4f0') +
      statCard(lostKg  ? '-' + lostKg + ' kg'       : '--', 'Perdido',  '#22c55e') +
      statCard(remaining                             || '--', 'Restante', '#ff4d00');
  }
}

function statCard(val, label, color) {
  return '<div class="text-center py-2 rounded-xl" style="background:#100e0b;border:1px solid rgba(255,240,225,0.06)">'
    + '<p class="text-sm font-black" style="color:' + color + '">' + val + '</p>'
    + '<p class="text-[9px] uppercase tracking-wider mt-0.5" style="color:rgba(247,244,240,0.4)">' + label + '</p>'
    + '</div>';
}

function f1(n) { return n.toFixed(1); }

