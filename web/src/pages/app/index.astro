  }

  recentContainer.innerHTML = achievements.map(function(a) {
    return '<div class="flex-shrink-0 rounded-xl p-3 text-center" style="min-width:96px;background:' + a.bg + ';border:1px solid ' + a.color + '33">' +
      '<div style="width:40px;height:40px;border-radius:12px;background:' + a.bg + ';display:flex;align-items:center;justify-content:center;margin:0 auto 6px">' +
        '<span class="material-symbols-outlined" style="font-size:20px;color:' + a.color + ';font-variation-settings:\'FILL\' 1">' + a.icon + '</span>' +
      '</div>' +
      '<p class="text-xs font-bold" style="color:#f7f4f0">' + a.name + '</p>' +
      '<p class="text-[10px]" style="color:rgba(247,244,240,0.5)">' + a.desc + '</p>' +
    '</div>';
  }).join('');
}

