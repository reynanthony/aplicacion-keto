// ==================== WEEKLY GOALS ====================

function loadWeeklyGoals() {
  var container = document.getElementById('weeklyGoalsGrid');
  if (!container) return;
  
  var today = new Date();
  var todayKey = today.toISOString().slice(0, 10);
  var dayOfWeek = today.getDay();
  
  // Calculate weekly stats
  var weekCalories = 0;
  var weekWorkouts = 0;
  var weekMeals = 0;
  var weekWater = 0;
  var daysWithData = 0;
  
  for (var i = 0; i < dayOfWeek; i++) {
    var d = new Date(today);
    d.setDate(d.getDate() - i);
    var dateKey = d.toISOString().slice(0, 10);
    
    var mealPlan = safeParseJSON(localStorage.getItem('mealPlan_' + dateKey), {});
    Object.keys(mealPlan).forEach(function(meal) {
      weekMeals += (mealPlan[meal] || []).length;
    });
    
    var checklist = safeParseJSON(localStorage.getItem('checklist_' + dateKey), {});
    if (checklist.workout > 0) weekWorkouts++;
    if (checklist.water >= 2) {
      weekWater += checklist.water;
      daysWithData++;
    }
    if ((mealPlan.desayuno && mealPlan.desayuno.length > 0) || 
        (mealPlan.almuerzo && mealPlan.almuerzo.length > 0) || 
        (mealPlan.cena && mealPlan.cena.length > 0)) {
      weekCalories++;
    }
  }
  
  // Today's data
  var todayChecklist = safeParseJSON(localStorage.getItem('checklist_' + todayKey), {});
  var todayWater = todayChecklist.water || 0;
  var todayMeals = 0;
  var todayMealPlan = safeParseJSON(localStorage.getItem('mealPlan_' + todayKey), {});
  Object.keys(todayMealPlan).forEach(function(meal) {
    todayMeals += (todayMealPlan[meal] || []).length;
  });
  
  var adherenceDays = 0; var adherenceHit = 0;
  for (var ai = 0; ai <= dayOfWeek; ai++) {
    var ad = new Date(today); ad.setDate(ad.getDate() - ai);
    var aChk = safeParseJSON(localStorage.getItem('checklist_' + ad.toISOString().slice(0, 10)), null);
    if (aChk !== null) { adherenceDays++; var done = Object.values(aChk).filter(function(v){ return v === true; }).length; if (done >= 4) adherenceHit++; }
  }
  var adherencePct = adherenceDays > 0 ? Math.round((adherenceHit / adherenceDays) * 100) : 0;

  var goals = [
    { label: 'Comidas',    value: weekMeals + todayMeals, target: (dayOfWeek + 1) * 3,      icon: 'restaurant',      iconColor: '#ff4d00', barColor: '#ff4d00' },
    { label: 'Entrenos',   value: weekWorkouts,            target: Math.min(dayOfWeek + 1, 5), icon: 'fitness_center',  iconColor: '#4ade80', barColor: '#22c55e' },
    { label: 'Adherencia', value: adherenceHit,            target: dayOfWeek + 1,              icon: 'task_alt',        iconColor: '#60a5fa', barColor: '#60a5fa', suffix: 'd' }
  ];

  container.innerHTML = goals.map(function(g) {
    var percent = Math.min(100, g.target > 0 ? Math.round((g.value / g.target) * 100) : 0);
    var fillColor = percent >= 100 ? '#22c55e' : g.barColor;
    return '<div style="background:#1e1a15;border-radius:14px;padding:14px;border:1px solid rgba(255,240,225,0.06)">' +
      '<div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">' +
        '<span class="material-symbols-outlined" style="font-size:16px;color:' + g.iconColor + '">' + g.icon + '</span>' +
        '<span style="font-size:11px;color:rgba(247,244,240,0.5)">' + g.label + '</span>' +
      '</div>' +
      '<p style="font-size:20px;font-weight:900;color:#f7f4f0;line-height:1;margin-bottom:8px;font-family:\'Plus Jakarta Sans\',sans-serif">' +
        g.value + '<span style="font-size:12px;color:rgba(247,244,240,0.4)">/' + g.target + (g.suffix || '') + '</span>' +
      '</p>' +
      '<div style="height:4px;background:rgba(255,240,225,0.07);border-radius:4px;overflow:hidden">' +
        '<div style="height:100%;border-radius:4px;transition:width 0.4s ease;width:' + percent + '%;background:' + fillColor + '"></div>' +
      '</div>' +
    '</div>';
  }).join('');
  
  // Load daily tip
  loadDailyTip();
}

function loadDailyTip() {
