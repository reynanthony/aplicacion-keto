---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Dashboard" authGuard={true}>
<style is:global>
.material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }

body {
  background-color: #131315 !important;
  color: #f7f4f0 !important;
  font-family: 'Inter', sans-serif !important;
}

/* App cards — steel blue dark surfaces */
.glass-card {
  background: #161310 !important;
  border: 1px solid rgba(255,240,225,0.07) !important;
  box-shadow: 0 4px 16px rgba(0,0,0,0.3), 0 1px 4px rgba(0,0,0,0.2) !important;
  backdrop-filter: none !important;
}
.glass-card:hover {
  box-shadow: 0 6px 24px rgba(0,0,0,0.4), 0 2px 8px rgba(0,0,0,0.25) !important;
}

/* Section cards */
.app-card {
  background: #161310;
  border: 1px solid rgba(255,240,225,0.06);
  border-radius: 20px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.25), 0 1px 4px rgba(0,0,0,0.15);
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }

::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: #161310; border-radius: 10px; }
::-webkit-scrollbar-thumb { background: rgba(255,77,0,0.35); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: #ff4d00; }

/* Modal cards */
.modal-card {
  background: #161310;
  border: 1px solid rgba(255,240,225,0.08);
  box-shadow: 0 8px 40px rgba(0,0,0,0.55), 0 2px 8px rgba(0,0,0,0.3);
  border-radius: 24px;
}

/* Tailwind hover class overrides for dark mode */
.hover\:bg-orange-50:hover { background-color: rgba(255,77,0,0.08) !important; }
.hover\:bg-gray-100:hover  { background-color: rgba(255,240,225,0.06) !important; }
.hover\:bg-red-50:hover    { background-color: rgba(248,113,113,0.1) !important; }
.hover\:bg-blue-50:hover   { background-color: rgba(96,165,250,0.1) !important; }
.hover\:bg-green-50:hover  { background-color: rgba(34,197,94,0.1) !important; }

@media (prefers-reduced-motion: reduce) {
  .fade-in-up { animation: none; opacity: 1; }
}

/* ── Dashboard Editorial Bento ── */
#dashGrid > * + * { margin-top: 18px; }
#dashGrid { padding-top: 84px; } /* header fijo móvil */
.dash-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 26px; flex-wrap: wrap; gap: 16px; }
.dash-greeting { font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:26px; letter-spacing:-0.02em; line-height:1.2; color:#f7f4f0; margin:0; }
.dash-subgreeting { font-size:14px; color:rgba(247,244,240,0.4); margin-top:4px; }
.dash-bento { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.db-score, .db-cal { grid-column: span 2; }
.db-score-top { position:relative; display:flex; align-items:center; justify-content:space-between; gap:10px; }
.db-score-segs { position:relative; display:flex; gap:5px; margin-top:16px; }
.db-score-segs > div { flex:1; height:5px; border-radius:100px; background:rgba(26,14,5,0.18); }
.db-score-foot { position:relative; display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:14px; flex-wrap:wrap; }
.dash-two, .dash-two2, .dash-lower { display: grid; grid-template-columns: 1fr; gap: 18px; }
.macro-band-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
@media (min-width: 901px) {
  .macro-band-grid { grid-template-columns: repeat(3, 1fr); }
  .macro-band-mid { padding: 0 24px; border-left: 1px solid rgba(255,240,225,0.07); border-right: 1px solid rgba(255,240,225,0.07); }
}
@media (min-width: 901px) {
  header.fixed { display: none !important; } /* editorial header propio en desktop */
  #dashGrid { padding-top: 38px; }
  .dash-bento { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 150px; gap: 18px; }
  .db-score { grid-column: span 2; grid-row: span 2; }
  .db-cal   { grid-column: span 2; grid-row: auto; }
  .dash-two  { grid-template-columns: 1.55fr 1fr; }
  .dash-two2 { grid-template-columns: 1fr 1fr; }
  .dash-lower { grid-template-columns: 1fr 1fr; align-items: start; }
  #dailyPlanList { grid-template-columns: repeat(2, 1fr) !important; }
}
</style>
<!-- Header -->
<header class="fixed top-0 left-0 right-0 z-40 h-14 px-4 flex items-center justify-between" style="background:rgba(19,19,21,0.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,240,225,0.06)">
  <a href="/app/" class="flex items-center gap-3" style="text-decoration:none">
    <img src="/app/logo.svg" alt="KetoCore" class="w-7 h-7" style="filter:drop-shadow(0 0 6px rgba(255,77,0,0.4))">
    <span class="text-base font-black tracking-tight" style="font-family:'Plus Jakarta Sans',sans-serif;color:#f7f4f0">KetoCore</span>
  </a>
  <div class="flex items-center gap-1.5">
    <button onclick="toggleMobileUserMenu()" aria-label="Mi cuenta" class="w-9 h-9 rounded-full flex items-center justify-center overflow-hidden" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06)">
      <img id="mobileHeaderAvatarImg" src="" class="hidden w-full h-full object-cover" alt="Avatar">
      <span id="mobileHeaderAvatarIcon" class="material-symbols-outlined" style="font-size:20px;color:rgba(247,244,240,0.6)">account_circle</span>
    </button>
    <button onclick="toggleHamburgerMenu()" aria-label="Abrir menú" class="w-9 h-9 rounded-full flex items-center justify-center" style="background:#1e1a15;color:rgba(247,244,240,0.6)">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:20px">menu</span>
    </button>
  </div>
</header>

<!-- Mobile User Dropdown -->
<div id="mobileUserDropdown" class="md:hidden fixed top-14 right-4 w-56 rounded-2xl overflow-hidden z-[80] hidden" style="background:#161310;border:1px solid rgba(255,240,225,0.07);box-shadow:0 8px 32px rgba(0,0,0,0.35)">
  <div class="p-3" style="border-bottom:1px solid rgba(255,240,225,0.06)">
    <p class="text-sm font-semibold" style="color:#f7f4f0" id="mobileDropdownUserName">Usuario</p>
    <p class="text-xs mt-0.5" style="color:rgba(247,244,240,0.55)" id="mobileDropdownUserEmail">email@example.com</p>
  </div>
  <div class="p-2">
    <a href="/app/perfil" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-orange-50" style="color:#f7f4f0">
      <span class="material-symbols-outlined text-lg" style="color:rgba(247,244,240,0.55)">person</span>
      <span class="text-sm font-medium">Mi Perfil</span>
    </a>
    <button onclick="handleLogout()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-red-50" style="color:#dc2626">
      <span class="material-symbols-outlined text-lg">logout</span>
      <span class="text-sm font-medium">Cerrar Sesión</span>
    </button>
  </div>
</div>

<script is:inline>

function toggleUserMenu() {
  var dropdown = document.getElementById('userDropdown');
  if (dropdown) dropdown.classList.toggle('hidden');
  updateDropdownInfo();
}

// Mobile User Dropdown
function toggleMobileUserMenu() {
  const dropdown = document.getElementById('mobileUserDropdown');
  dropdown.classList.toggle('hidden');
  updateDropdownInfo();
}

function updateDropdownInfo() {
  var profile = JSON.parse(localStorage.getItem('keto_profile') || '{}');
  var userName = profile.nombre || 'Usuario';
  var userEmail = localStorage.getItem('ketocore_user_email') || 'usuario@ejemplo.com';
  ['dropdownUserName','mobileDropdownUserName'].forEach(function(id) {
    var el = document.getElementById(id); if (el) el.textContent = userName;
  });
  ['dropdownUserEmail','mobileDropdownUserEmail'].forEach(function(id) {
    var el = document.getElementById(id); if (el) el.textContent = userEmail;
  });
}

function updateHeaderAvatar() {
  var profile = JSON.parse(localStorage.getItem('keto_profile') || '{}');
  var avatarUrl = profile.avatar_url;
  var img  = document.getElementById('mobileHeaderAvatarImg');
  var icon = document.getElementById('mobileHeaderAvatarIcon');
  if (avatarUrl) {
    if (img)  { img.src = avatarUrl; img.classList.remove('hidden'); }
    if (icon) icon.classList.add('hidden');
  } else {
    if (img)  img.classList.add('hidden');
    if (icon) icon.classList.remove('hidden');
  }
}

document.addEventListener('click', function(e) {
  var mobileDropdown = document.getElementById('mobileUserDropdown');
  if (mobileDropdown && !e.target.closest('#mobileUserDropdown') && !e.target.closest('button[onclick="toggleMobileUserMenu()"]')) {
    mobileDropdown.classList.add('hidden');
  }
});

// Logout
async function handleLogout() {
  if (confirm('¿Estás seguro de que quieres cerrar sesión?')) {
    await window.supabase.auth.signOut();
    localStorage.removeItem('ketocore_user_id');
    localStorage.removeItem('ketocore_user_email');
    localStorage.removeItem('ketocore_onboarding_done');
    window.location.href = '/app/welcome';
  }
}

</script>

<!-- Mobile Settings Modal -->
<div id="mobileSettingsModal" class="fixed inset-0 z-[60] hidden">
<div class="absolute inset-0 bg-black/25 backdrop-blur-sm" onclick="document.getElementById('mobileSettingsModal').classList.add('hidden')"></div>
<div class="absolute top-14 right-4 w-72 max-h-[70vh] overflow-hidden rounded-2xl" style="background:#161310;border:1px solid rgba(255,240,225,0.07);box-shadow:0 8px 32px rgba(0,0,0,0.35)">
<div class="p-4" style="border-bottom:1px solid rgba(255,240,225,0.06)">
<div class="flex items-center justify-between">
<h3 class="text-base font-bold flex items-center gap-2" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">
<span class="material-symbols-outlined" style="color:#ff4d00;font-size:20px">settings</span>
Configuración
</h3>
<button onclick="document.getElementById('mobileSettingsModal').classList.add('hidden')" class="w-9 h-9 rounded-full flex items-center justify-center transition-all hover:bg-gray-100" style="color:rgba(247,244,240,0.55)">
<span class="material-symbols-outlined text-lg">close</span>
</button>
</div>
</div>
<div class="p-3 space-y-1.5">
<select id="mobileLangSelector" onchange="setLang(this.value); location.reload();" class="w-full px-4 py-3 rounded-xl cursor-pointer font-medium text-sm transition-all hover:bg-gray-50" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06);color:#f7f4f0">
<option value="es">Español</option>
<option value="en">English</option>
</select>
<button onclick="requestPushPermission()" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-orange-50 text-sm font-medium" style="background:#1e1a15;color:#f7f4f0;border:1px solid rgba(255,240,225,0.07)">
<span class="material-symbols-outlined text-lg" style="color:#ff4d00">notifications</span>
Notificaciones
</button>
<button onclick="openBackupModal();document.getElementById('mobileSettingsModal').classList.add('hidden')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-orange-50 text-sm font-medium" style="background:#1e1a15;color:#f7f4f0;border:1px solid rgba(255,240,225,0.07)">
<span class="material-symbols-outlined text-lg" style="color:#ff4d00">backup</span>
Backup
</button>
<a href="/app/guia" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-orange-50 text-sm font-medium" style="background:#1e1a15;color:#f7f4f0;border:1px solid rgba(255,240,225,0.07)">
<span class="material-symbols-outlined text-lg" style="color:#60a5fa">menu_book</span>
Guía de Uso
</a>
<button onclick="openResetModal()" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all hover:bg-red-50 text-sm font-medium" style="background:rgba(220,38,38,0.1);color:#dc2626;border:1px solid rgba(220,38,38,0.15)">
<span class="material-symbols-outlined text-lg">restart_alt</span>
Reiniciar Todo
</button>
</div>
</div>
</div>

<!-- Global Reset Confirmation Modal -->
<div id="resetModal" class="fixed inset-0 z-[70] hidden flex items-center justify-center">
<div class="absolute inset-0 bg-black/25 backdrop-blur-sm" onclick="closeResetModal()"></div>
<div class="relative w-[90%] max-w-sm rounded-3xl p-6" style="background:#161310;box-shadow:0 8px 40px rgba(0,0,0,0.5);border:1px solid rgba(255,240,225,0.07)">
<div class="text-center mb-6">
<div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background:rgba(220,38,38,0.1)">
<span class="material-symbols-outlined text-3xl" style="color:#dc2626">warning</span>
</div>
<h3 class="text-xl font-bold mb-2" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">Reiniciar Todo</h3>
<p class="text-sm" style="color:rgba(247,244,240,0.6)">Esto borrará TODOS tus datos: perfil, plan, historial, despensa y progreso. Esta acción no se puede deshacer.</p>
</div>
<div class="space-y-3">
<button onclick="confirmGlobalReset()" class="w-full py-3.5 rounded-xl font-bold transition-all flex items-center justify-center gap-2 hover:opacity-90" style="background:#dc2626;color:#ffffff">
<span class="material-symbols-outlined">delete_forever</span>
Sí, borrar todo
</button>
<button onclick="closeResetModal()" class="w-full py-3.5 rounded-xl font-semibold transition-all hover:bg-gray-100" style="background:#1e1a15;color:rgba(247,244,240,0.6)">
Cancelar
</button>
</div>
</div>
</div>

<!-- Notifications Modal -->
<div id="notificationsModal" class="fixed inset-0 z-[60] hidden">
<div class="absolute inset-0 bg-black/25 backdrop-blur-sm" onclick="closeNotifications()"></div>
<div class="absolute top-16 left-4 right-4 md:left-auto md:right-8 md:w-96 max-h-[70vh] overflow-hidden rounded-2xl" style="background:#161310;border:1px solid rgba(255,240,225,0.07);box-shadow:0 8px 32px rgba(0,0,0,0.35)">
<div class="p-4" style="border-bottom:1px solid rgba(255,240,225,0.06)">
<div class="flex items-center justify-between">
<h3 class="text-base font-bold flex items-center gap-2" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">
<span class="material-symbols-outlined" style="color:#ff4d00;font-size:20px">notifications</span>
Notificaciones
</h3>
<button onclick="closeNotifications()" class="w-9 h-9 rounded-full flex items-center justify-center transition-all hover:bg-gray-100" style="color:rgba(247,244,240,0.55)">
<span class="material-symbols-outlined text-lg">close</span>
</button>
</div>
</div>

<!-- Weight Update Modal -->
<div id="weightModal" class="fixed inset-0 hidden" style="z-index: 9999;">
<div class="absolute inset-0 bg-black/25 backdrop-blur-sm" onclick="closeWeightModal()"></div>
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-md rounded-3xl p-6" style="background:#161310;box-shadow:0 8px 40px rgba(0,0,0,0.5);border:1px solid rgba(255,240,225,0.07)">
<div class="flex items-center justify-between mb-5">
<h3 class="text-lg font-bold flex items-center gap-2" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">
<span class="material-symbols-outlined" style="color:#ff4d00">monitor_weight</span>
Actualizar Peso
</h3>
<button onclick="closeWeightModal()" class="w-10 h-10 rounded-full flex items-center justify-center transition-all hover:bg-gray-100" style="color:rgba(247,244,240,0.55)">
<span class="material-symbols-outlined text-lg">close</span>
</button>
</div>
<div class="space-y-4">
<p class="text-sm" style="color:rgba(247,244,240,0.6)">Ingresa tu peso actual para actualizar tu progreso.</p>
<input type="number" id="newWeightInput" step="0.1" min="20" max="300" class="w-full py-4 px-4 rounded-xl font-medium text-lg transition-all" style="background:#1e1a15;border:1.5px solid rgba(255,240,225,0.08);color:#f7f4f0" placeholder="Peso en kg">
<button onclick="saveNewWeight()" class="w-full py-4 rounded-xl font-bold transition-all hover:opacity-90 flex items-center justify-center gap-2" style="background:#ff4d00;color:#ffffff">
<span class="material-symbols-outlined">save</span>
Guardar Peso
</button>
</div>
</div>
</div>

<div id="notificationsList" class="p-3 space-y-2 max-h-[50vh] overflow-y-auto">
</div>
<div class="p-3" style="border-top:1px solid rgba(255,240,225,0.06)">
<button class="w-full py-2.5 text-center text-sm font-semibold rounded-xl transition-colors hover:bg-orange-50" style="color:#ff4d00">Ver todas las notificaciones</button>
</div>
</div>
</div>

<!-- Backup Modal -->
<div id="backupModal" class="fixed inset-0 z-[70] hidden items-center justify-center p-4">
<div class="absolute inset-0 bg-black/25 backdrop-blur-sm" onclick="closeBackupModal()"></div>
<div class="relative rounded-3xl p-6 w-full max-w-md" style="background:#161310;box-shadow:0 8px 40px rgba(0,0,0,0.5);border:1px solid rgba(255,240,225,0.07)">
<div class="flex items-center justify-between mb-5">
<h3 class="text-lg font-bold flex items-center gap-2" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">
<span class="material-symbols-outlined" style="color:#ff4d00">backup</span>
Backup y Restauración
</h3>
<button onclick="closeBackupModal()" class="w-10 h-10 rounded-full flex items-center justify-center transition-all hover:bg-gray-100" style="color:rgba(247,244,240,0.55)">
<span class="material-symbols-outlined text-lg">close</span>
</button>
</div>
<div class="space-y-3">
<p class="text-sm" style="color:rgba(247,244,240,0.6)">Guarda una copia de seguridad de todos tus datos o restaura desde un archivo.</p>
<button onclick="downloadBackup()" class="w-full py-4 rounded-xl font-bold transition-all hover:opacity-90 flex items-center justify-center gap-2" style="background:#ff4d00;color:#ffffff">
<span class="material-symbols-outlined">download</span>
Exportar Backup
</button>
<button onclick="triggerRestore()" class="w-full py-4 rounded-xl font-semibold transition-all hover:bg-gray-100 flex items-center justify-center gap-2" style="background:#1e1a15;color:#f7f4f0;border:1px solid rgba(255,240,225,0.06)">
<span class="material-symbols-outlined">upload</span>
Importar Backup
</button>
<p class="text-xs text-center" style="color:rgba(247,244,240,0.42)">Último backup: <span id="lastBackupDate">Nunca</span></p>
</div>
</div>
</div>

<!-- Main Canvas -->
<main class="min-h-screen" style="background:#131315">
<div id="dashGrid" class="kc-page">

<!-- ========== HEADER EDITORIAL ========== -->
<div class="dash-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap">
      <span id="todayDateDisplay" style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00">Hoy</span>
      <span style="width:4px;height:4px;border-radius:50%;background:rgba(247,244,240,0.25)"></span>
      <span style="font-size:11px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:rgba(247,244,240,0.4)">Día <span id="streakCount">0</span> en cetosis</span>
    </div>
    <h1 class="dash-greeting"><span id="coachDayPart">Buenos días</span>, <span id="coachUserName">Campeón</span></h1>
    <p class="dash-subgreeting">Vas ganando la semana.</p>
  </div>
  <div style="display:flex;align-items:center;gap:12px">
    <button onclick="showNotifications()" aria-label="Notificaciones" style="height:46px;width:46px;border-radius:14px;background:#161310;border:1px solid rgba(255,240,225,0.08);cursor:pointer;display:flex;align-items:center;justify-content:center;position:relative;flex-shrink:0">
      <span class="material-symbols-outlined" style="font-size:21px;color:rgba(247,244,240,0.55)">notifications</span>
      <span style="position:absolute;top:10px;right:11px;width:7px;height:7px;border-radius:50%;background:#ff4d00;border:2px solid #161310"></span>
    </button>
    <button onclick="quickAddFood()" class="kc-btn"><span class="material-symbols-outlined" style="font-size:20px">add</span>Registrar comida</button>
  </div>
</div>

<!-- ========== BENTO SUPERIOR: score + calorías + stats ========== -->
<div class="dash-bento">

  <!-- HEALTH SCORE — único foco visual de la sección -->
  <div class="db-score" style="background:linear-gradient(150deg,#ff5a12,#e63f00);border-radius:26px;padding:26px 28px;display:flex;flex-direction:column;justify-content:center;box-shadow:0 12px 36px rgba(255,77,0,0.2);min-height:250px">
    <div class="db-score-top">
      <div style="display:flex;align-items:center;gap:9px"><span class="material-symbols-outlined icon-filled" style="font-size:19px;color:rgba(26,14,5,0.75)">ecg_heart</span><span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:12px;letter-spacing:0.04em;color:rgba(26,14,5,0.75)">HEALTH SCORE</span></div>
      <a href="/app/progreso" style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;font-weight:700;color:rgba(26,14,5,0.65);text-decoration:none"><span id="coachProgress">--</span><span class="material-symbols-outlined" style="font-size:15px">arrow_forward</span></a>
    </div>
    <div style="position:relative;margin-top:18px">
      <div class="kc-num" id="coachScoreNum" style="font-weight:900;font-size:clamp(56px,9vw,84px);line-height:0.85;color:#1a0e05">--</div>
      <div style="font-size:14px;font-weight:600;color:rgba(26,14,5,0.6);margin-top:6px">de 100 · <strong id="coachScoreLabel">--</strong></div>
    </div>
    <div id="scoreSegs" class="db-score-segs">
      <div></div><div></div><div></div><div></div><div></div>
    </div>
    <div class="db-score-foot">
      <span id="coachObjective" style="font-size:12.5px;font-weight:700;color:rgba(26,14,5,0.6)">--</span>
    </div>
  </div>

  <!-- CALORÍAS — misma familia oscura que el resto, sin competir con el score -->
  <div class="db-cal kc-tile" style="display:flex;flex-direction:column;justify-content:space-between;gap:12px">
