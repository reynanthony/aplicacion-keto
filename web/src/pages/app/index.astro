---
// Pantalla "Hoy" — UI v2 (HUD) conectada a datos REALES vía kc-adapter.js.
// Respaldo del dashboard anterior: index.astro.bak
import AppShell from '../../layouts/AppShell.astro';
import StatCard from '../../components/kc/StatCard.astro';
import MacroDial from '../../components/kc/MacroDial.astro';
import ProtocolList from '../../components/kc/ProtocolList.astro';
import TrendCard from '../../components/kc/TrendCard.astro';
import WeekBars from '../../components/kc/WeekBars.astro';
import CoachCard from '../../components/kc/CoachCard.astro';
---
<AppShell title="Hoy" screen="hoy">
  <div>
    <div class="kc-hero-sub" data-kc-text="greeting">&nbsp;</div>
    <h1 class="kc-hero">Vas al <em><span data-kc-text="today.progress.value">—</span>%</em> de tu día</h1>
  </div>

  <div class="kc-grid">
    <StatCard label="Progreso hoy" path="today.progress" unit="/100" color="amber" />
    <StatCard label="Salud" path="today.health" unit="/100" color="mint" />
    <StatCard label="Adherencia" path="today.adherence" unit="%" color="cyan" />
    <StatCard label="Racha" path="today.streak" unit="días" color="amber" />
  </div>

  <MacroDial path="energy" />

  <ProtocolList />
  <TrendCard />
  <WeekBars />
  <CoachCard />

  <Fragment slot="scripts">
    <script is:inline src="/app/utils.js"></script>
    <script is:inline src="/app/modules/meal-plan.js"></script>
    <script is:inline src="/app/modules/health-score.js"></script>
    <script is:inline src="/app/kc-adapter.js"></script>
  </Fragment>
</AppShell>
