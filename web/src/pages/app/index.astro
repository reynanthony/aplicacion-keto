<!-- Segmentos del score reflejan el número (HealthScoreEngine setea coachScoreNum) -->
<script is:inline>
(function () {
  var num = document.getElementById('coachScoreNum');
  var segs = document.querySelectorAll('#scoreSegs > div');
  if (!num || !segs.length) return;
  function paint() {
    var v = parseInt(num.textContent, 10);
    if (isNaN(v)) return;
    var lit = Math.round(v / 20);
    segs.forEach(function (s, i) { s.style.background = i < lit ? '#1a0e05' : 'rgba(26,14,5,0.22)'; });
  }
  new MutationObserver(paint).observe(num, { childList: true, characterData: true, subtree: true });
  paint();
})();
</script>

