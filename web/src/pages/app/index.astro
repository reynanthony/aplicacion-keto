---
// Hoy — v3. Pantalla mínima: una sola cifra accionable (carbos disponibles).
// Health Score y tendencia de peso se movieron a Progreso; Checklist se
// fusionó con el plan del día (DecisionCard "siguiente evento"). Ninguna de
// esas pantallas existe todavía (fases posteriores del handoff) — sus datos
// siguen en localStorage, solo dejan de mostrarse aquí.
import AppLayout from '../../layouts/AppLayout.astro';
import BudgetHeader from '../../components/v3/BudgetHeader.astro';
import DataRow from '../../components/v3/DataRow.astro';
import DecisionCard from '../../components/v3/DecisionCard.astro';
import Sheet from '../../components/v3/Sheet.astro';
import Dock from '../../components/v3/Dock.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Hoy" authGuard={true}>
  <style is:global>
    /* Nav Editorial Bento reemplazada por el Dock v3 en esta pantalla */
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <div id="hoyBudgetHeader">
        <BudgetHeader used={0} limit={25} state="ok" variant="hero" label="Hoy" />
      </div>

      <!-- Chips de estado: kcal consumidas + ratio de macros. No hay chip de
           cetosis/ayuno porque no existe ningún modelo de datos de ayuno en
           el repo — brecha de datos futura, no se simula. -->
      <div class="v3-chip-group" id="hoyStateChips"></div>

      <DecisionCard id="hoy-next-event" variant="lime" buttonLabel="Ver" title="Cargando…">
        <span id="hoyNextEventBody"></span>
      </DecisionCard>

      <div class="v3-decision-card v3-decision-card--cream" style="padding:16px 18px;">
        <p class="v3-eyebrow" style="margin-bottom:6px; color:rgba(26,20,14,0.5)">Coach</p>
        <p id="dailyTipText" style="font-size:13.5px; color:var(--v3-text-on-cream); margin:0;">Cargando consejo del día…</p>
      </div>

      <section>
        <p class="v3-eyebrow" style="margin-bottom:10px">Registrado hoy</p>
        <div id="registradoHoyList"></div>
        <!-- Ancla oculta: fuerza a Astro a incluir el script de swipe de DataRow
             en la página, ya que la lista real se construye a mano por JS
             (datos dinámicos de localStorage) y nunca instancia el componente. -->
        <div style="display:none"><DataRow id="_v3-datarow-script-anchor" title="" /></div>
      </section>

    </main>

    <VeredictoSheet />

    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>

      <div>
        <p class="v3-eyebrow" style="margin:16px 0 8px;">Repetir</p>
        <div id="repetirList"></div>
      </div>

      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>

    <Dock active="hoy" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/modules/health-score.js"></script>
  <script is:inline src="/app/modules/recommendation-engine.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/v3-budget-header.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    function renderStateChips(budget) {
      var wrap = document.getElementById('hoyStateChips');
      if (!wrap) return;
      var macros = safeParseJSON(localStorage.getItem('keto_macros'), {});
      var kcalTarget = Number(macros.calories) || 0;
      var protTarget = Number(macros.protein) || 0;
      var fatTarget = Number(macros.fat) || 0;
      var ratioLabel = (protTarget || fatTarget || macros.carbs)
        ? Math.round((protTarget || 0)) + '/' + Math.round((fatTarget || 0)) + '/' + Math.round(macros.carbs || 0)
        : '—';
      wrap.innerHTML =
        '<span class="v3-chip v3-chip--state"><span class="v3-chip-dot"></span>' + Math.round(budget.used) + ' g netos hoy</span>' +
        '<span class="v3-chip v3-chip--state">' + ratioLabel + ' g</span>' +
        (kcalTarget ? '<span class="v3-chip v3-chip--state">Meta ' + kcalTarget + ' kcal</span>' : '');
    }

    function renderNextEvent() {
      if (typeof RecommendationEngine === 'undefined') return;
      var plan = RecommendationEngine.generate();
      var next = plan.actions.find(function (a) { return !a.done; }) || plan.actions[0];
      if (!next) return;
      var card = document.querySelector('[data-decision-id="hoy-next-event"]');
      if (!card) return;
      var titleEl = card.querySelector('.v3-decision-card-title');
      var bodyEl = document.getElementById('hoyNextEventBody');
      var actionEl = card.querySelector('.v3-decision-card-action');
      if (titleEl) titleEl.textContent = next.label;
      if (bodyEl) bodyEl.textContent = next.detail;
      if (actionEl && next.href) actionEl.onclick = function () { location.href = next.href; };
    }

    function renderRegistradoHoy() {
      var list = document.getElementById('registradoHoyList');
      if (!list) return;
      var items = window.KetoMealLog.getRecentItems(3);
      if (!items.length) {
        list.innerHTML = '<p style="font-size:13px; color:var(--v3-text-40); padding:8px 2px;">Nada registrado todavía hoy.</p>';
        return;
      }
      list.innerHTML = items.map(function (item) {
        var time = item.addedAt ? new Date(item.addedAt).toTimeString().slice(0, 5) : '--:--';
        return '' +
          '<div class="v3-row-wrap" data-row-id="' + item.id + '">' +
            '<div class="v3-row-actions">' +
              '<button type="button" class="v3-row-action v3-row-action--edit" data-row-action="edit">Editar</button>' +
              '<button type="button" class="v3-row-action v3-row-action--delete" data-row-action="delete">Borrar</button>' +
            '</div>' +
            '<div class="v3-row">' +
              '<span class="v3-row-lead v3-row-lead-time">' + time + '</span>' +
              '<div class="v3-row-content v3-row-content--pending">' +
                '<div class="v3-row-body">' +
                  '<div class="v3-row-title">' + escapeHtml(item.name) + '</div>' +
                  '<div class="v3-row-meta">' + item.mealSlot + '</div>' +
                '</div>' +
                '<div class="v3-row-value v3-num-mono">' + Math.round(item.carbs) + '<span class="v3-row-unit">g</span></div>' +
              '</div>' +
            '</div>' +
          '</div>';
      }).join('');
    }

    function renderRepetir() {
      var list = document.getElementById('repetirList');
      if (!list) return;
      var items = window.KetoMealLog.getRecentItems(2);
      if (!items.length) { list.innerHTML = ''; return; }
      list.innerHTML = items.map(function (item, i) {
        return '<button type="button" class="v3-row-action v3-row-action--edit" data-repeat-idx="' + i + '" ' +
          'style="width:100%; justify-content:space-between; padding:11px 14px; border-radius:var(--v3-radius-row); margin-bottom:6px;">' +
          '<span>' + escapeHtml(item.name) + '</span><span>+</span></button>';
      }).join('');
      list.querySelectorAll('[data-repeat-idx]').forEach(function (btn, i) {
        btn.addEventListener('click', function () {
          window.KetoMealLog.repeatItem(items[i]);
          window.KetoSheet.close('v3-sheet-registrar');
        });
      });
    }

    function renderAll(animate) {
      var budget = window.KetoBudget.compute();
      var header = document.querySelector('#hoyBudgetHeader .v3-budget-header');
      window.V3BudgetHeader.render(header, budget, { animate: animate });
      renderStateChips(budget);
      var sub = document.querySelector('#v3-sheet-registrar .v3-sheet-subtitle');
      if (sub) sub.textContent = 'Margen de hoy · ' + Math.round(budget.available) + ' g netos';
      renderRegistradoHoy();
      renderRepetir();
    }

    document.addEventListener('DOMContentLoaded', function () {
      renderAll(false);
      renderNextEvent();
      if (typeof loadDailyTip === 'function') loadDailyTip();
    });
    document.addEventListener('v3:meal-logged', function () { renderAll(true); });
    document.addEventListener('v3:decision-dismiss', function (e) {
      var card = document.querySelector('[data-decision-id="' + e.detail.id + '"]');
      if (card) card.style.display = 'none';
    });

    function loadDailyTip() {
      var tips = [
        'Recuerda distribuir tu proteína a lo largo del día para mejor absorción.',
        'Los aguacates son tu mejor aliado: ricos en grasas saludables y fibra.',
        'Bebe al menos 2L de agua al día, especialmente si haces ejercicio.',
        'El ayuno intermitente puede potenciar los efectos de la dieta keto.',
        'El ejercicio en ayunas ayuda a quemar grasa más eficientemente.',
        'Combina entrenamiento de fuerza con cardio para mejores resultados.',
        'DESCANSO es parte del progreso. No entrenes todos los días.',
        'Duerme 7-8 horas para optimizar la producción de hormonas.',
        'El estrés crónico afecta tu metabolismo. Prueba técnicas de relajación.',
        'La consistencia supera a la perfección. Un mal día no arruina tu progreso.',
        'Lleva un diario de alimentos para identificar patrones en tu dieta.'
      ];
      var tipEl = document.getElementById('dailyTipText');
      if (tipEl) tipEl.textContent = tips[Math.floor(Math.random() * tips.length)];
    }
  </script>
</AppLayout>
