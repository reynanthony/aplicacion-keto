// ==================== STREAK & ACHIEVEMENTS ====================

function initStreakSystem() {
  checkAndUpdateStreak();
}

function checkAndUpdateStreak() {
  var streakData = safeParseJSON(localStorage.getItem('ketoStreak'), {
    currentStreak: 0,
    bestStreak: 0,
    lastKetoDate: null,
    ketoDays: 0,
    activitiesToday: 0
  });
  
  var today = new Date().toISOString().slice(0, 10);
  var yesterday = new Date();
  yesterday.setDate(yesterday.getDate() - 1);
  yesterday = yesterday.toISOString().slice(0, 10);
  
  // Check if activities were logged today
  if (streakData.lastKetoDate !== today) {
    // First check: was yesterday logged AND we had activities?
    if (streakData.lastKetoDate === yesterday && (streakData.activitiesToday || 0) > 0) {
      // Continue streak only if yesterday had real activity
      streakData.currentStreak++;
    } else if (streakData.lastKetoDate !== today) {
      // New day - reset activities counter (will increment when activity logged)
      streakData.activitiesToday = 0;
      // Only increment streak if we have actual activities today
      // Otherwise, don't change streak - wait for activity
    }
    
    streakData.lastKetoDate = today;
    
    // Update best streak
    if (streakData.currentStreak > streakData.bestStreak) {
      streakData.bestStreak = streakData.currentStreak;
    }
    
    localStorage.setItem('ketoStreak', JSON.stringify(streakData));
  }
  
  // Update display with actual values (starting from 0)
  safeSetText('streakCount', fmtNum(streakData.currentStreak || 0));
  safeSetText('streakDaysCount', fmtNum(streakData.currentStreak || 0));
  safeSetText('bestStreakCount', fmtNum(streakData.bestStreak || 0));
}

function updateAchievementsStats(totalMealItems) {
  var streakData = safeParseJSON(localStorage.getItem('ketoStreak'), { ketoDays: 0 });
  var mealsLogged = safeParseJSON(localStorage.getItem('mealsLoggedTotal'), 0);
  
  safeSetText('ketoDaysCount', fmtNum(streakData.ketoDays || streakData.currentStreak || 0));
  safeSetText('mealsLoggedCount', fmtNum(totalMealItems || 0));
  
