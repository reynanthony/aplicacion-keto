// ==================== REGISTRO DE SERVICE WORKER ====================
// Implementación PWA para KetoCore

(function() {
  // Registrar Service Worker (v3: auto-actualiza y purga cachés viejos)
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/app/sw.js')
        .then(registration => {
          registration.update();
          registration.addEventListener('updatefound', () => {
            const newWorker = registration.installing;
            if (!newWorker) return;
            newWorker.addEventListener('statechange', () => {
              if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                newWorker.postMessage('SKIP_WAITING');
              }
            });
          });
        })
        .catch(() => {});
      let swReloaded = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (swReloaded) return;
        swReloaded = true;
        window.location.reload();
      });
    });
  }
   
  // Listen for storage changes
  window.addEventListener('storage', function(e) {
    if (e.key === 'keto_profile' || e.key === 'keto_weight_history') {
      loadDashboard();
    }
  });
   
  // Also listen for custom profileSaved event
  window.addEventListener('profileSaved', function() {
    loadDashboard();
  });
  
  // Listen for weight updates
  window.addEventListener('weightUpdated', function() {
    loadDashboard();
  });
})();
</script>
