function calculateWeeklyLoss() {
  var ketoProfile = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var weightHistory = safeParseJSON(localStorage.getItem('keto_weight_history'), []);
  
  var today = new Date();
  var weekAgo = new Date(today);
  weekAgo.setDate(weekAgo.getDate() - 7);
  
  var weekEntries = weightHistory.filter(function(e) {
    return new Date(e.date) >= weekAgo;
  }).sort(function(a, b) { return new Date(a.date) - new Date(b.date); });
  
  if (weekEntries.length >= 2) {
    var first = weekEntries[0].weight;
    var last = weekEntries[weekEntries.length - 1].weight;
    var diff = (first - last).toFixed(1);
    return diff + 'kg';
  }
  
  return '0kg';
}

