---
// Suplementos — UI v2 (HUD nativo). Reescrito del puente .app-hud a markup
// kc-* real: el puente solo recoloreaba la estructura vieja (glass-cards,
// cajas-icono, grid de stats) y seguía descuadrado. Ahora usa el mismo
// lenguaje que las pestañas (kc-card, kc-eyebrow, kc-ico, kc-chip, kc-stat).
// Lógica y datos intactos (supplement-recommender + user_supplements).
// Respaldo del diseño anterior: suplementos.astro.bak
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="Suplementos" screen="suplementos">
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}

/* Nota médica */
.kc .sup-note{display:flex;gap:12px;align-items:center;padding:14px;background:color-mix(in oklab,var(--kc-amber) 8%,var(--kc-surface-1));border:1px solid color-mix(in oklab,var(--kc-amber) 22%,transparent);border-radius:var(--kc-radius-md)}
.kc .sup-note p{font:500 12.5px/17px var(--kc-font-sans);color:var(--kc-ink-2)}

/* Franja de perfil compacta (tipo instrumento, no compite con los KPIs) */
.kc .sup-facts{display:flex;flex-wrap:wrap;gap:8px}
.kc .sup-fact{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;background:var(--kc-surface-2);border:1px solid var(--kc-line);border-radius:var(--kc-radius-pill)}
.kc .sup-fact .material-symbols-outlined{font-size:16px;color:var(--kc-ink-3)}
.kc .sup-fact b{font:600 12.5px var(--kc-font-sans);color:var(--kc-ink)}

/* Tarjeta de suplemento (activo / recomendado) */
.kc .sup-card{background:var(--kc-surface-2);border:1px solid var(--kc-line);border-left:3px solid var(--c,var(--kc-line-strong));border-radius:var(--kc-radius-md);padding:16px}
.kc .sup-card+.sup-card{margin-top:12px}
.kc .sup-card__top{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.kc .sup-card__id{flex:1;min-width:0}
.kc .sup-card__name{font:600 15px/20px var(--kc-font-sans);color:var(--kc-ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:5px}
.kc .sup-card__desc{font:500 13px/18px var(--kc-font-sans);color:var(--kc-ink-2);margin-bottom:12px}
.kc .sup-card__meta{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.kc .sup-card__cell{background:var(--kc-surface-3);border-radius:var(--kc-radius-sm);padding:10px 12px;min-width:0}
.kc .sup-card__v{font:600 13px/17px var(--kc-font-sans);color:var(--kc-ink);margin-top:4px}
.kc .sup-card .kc-ico .material-symbols-outlined{font-size:20px}

/* Fila "Tomar ahora" */
.kc .sup-now{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:var(--kc-radius-md);background:var(--kc-surface-2);cursor:pointer;transition:background .18s}
.kc .sup-now+.sup-now{margin-top:8px}
.kc .sup-now.is-taken{opacity:.55}
.kc .sup-now__id{flex:1;min-width:0}
.kc .sup-now__name{font:600 14px/18px var(--kc-font-sans);color:var(--kc-ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.kc .sup-now.is-taken .sup-now__name{text-decoration:line-through}
.kc .sup-now__sub{font:500 12px var(--kc-font-mono);color:var(--kc-ink-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.kc .sup-now__flag{font:600 11px var(--kc-font-mono);color:var(--kc-ink-3);white-space:nowrap}
.kc .sup-now__flag.is-taken{color:var(--kc-mint)}
.kc .sup-now .kc-ico{width:36px;height:36px}
.kc .sup-now .kc-ico .material-symbols-outlined{font-size:19px}

/* Tiles de categoría */
.kc .sup-tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.kc .sup-tile{display:flex;gap:12px;align-items:center;padding:14px;background:var(--kc-surface-2);border:1px solid var(--kc-line);border-radius:var(--kc-radius-md);cursor:pointer;transition:background .18s}
.kc .sup-tile:active{transform:scale(.98)}
.kc .sup-tile__name{font:600 14px var(--kc-font-sans);color:var(--kc-ink)}
.kc .sup-tile__sub{font:500 11.5px var(--kc-font-mono);color:var(--kc-ink-3);margin-top:2px}

/* Modal catálogo (hoja inferior) */
.kc .sup-modal{position:fixed;inset:0;z-index:60;display:flex;align-items:flex-end;justify-content:center}
.kc .sup-modal.hidden{display:none}
.kc .sup-modal__scrim{position:absolute;inset:0;background:rgba(0,0,0,.72);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
.kc .sup-modal__panel{position:relative;width:100%;max-width:480px;max-height:86dvh;overflow-y:auto;background:var(--kc-surface-1);border:1px solid var(--kc-line);border-bottom:0;border-radius:var(--kc-radius-xl) var(--kc-radius-xl) 0 0;box-shadow:var(--kc-shadow-float);padding:18px 18px calc(20px + env(safe-area-inset-bottom))}
.kc .sup-modal__list{display:flex;flex-direction:column;gap:8px}
.kc .sup-pick{display:flex;align-items:center;gap:12px;padding:11px 12px;background:var(--kc-surface-2);border-radius:var(--kc-radius-md);cursor:pointer;transition:background .18s}
.kc .sup-pick:active{transform:scale(.99)}
.kc .sup-pick__id{flex:1;min-width:0}
.kc .sup-pick__name{font:600 14px var(--kc-font-sans);color:var(--kc-ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.kc .sup-pick__sub{font:500 12px var(--kc-font-mono);color:var(--kc-ink-3)}
.kc .sup-pick .kc-ico .material-symbols-outlined{font-size:19px}

/* Toast */
.kc .sup-toast{position:fixed;bottom:calc(96px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);z-index:70;display:flex;align-items:center;gap:10px;padding:12px 20px;border-radius:var(--kc-radius-pill);background:var(--kc-surface-1);border:1px solid var(--kc-line-strong);box-shadow:var(--kc-shadow-float);font:600 13px var(--kc-font-sans);color:var(--kc-ink)}
.kc .sup-toast.hidden{display:none}
</style>

<!-- Hero -->
<div>
  <div class="kc-hero-sub">Optimización nutricional</div>
  <h1 class="kc-hero">Tu stack de <em>suplementos</em></h1>
</div>

<!-- KPIs -->
<div class="kc-grid">
  <div class="kc-stat kc-c-cyan">
    <div class="kc-stat__top"><span class="kc-label">Activos</span></div>
    <div class="kc-stat__val" id="kpiActive">0</div>
    <div class="kc-bar kc-c-cyan"><i id="kpiActiveBar"></i></div>
  </div>
  <div class="kc-stat kc-c-amber">
    <div class="kc-stat__top"><span class="kc-label">Sugeridos</span></div>
    <div class="kc-stat__val" id="kpiRec">0</div>
    <div class="kc-bar kc-c-amber"><i id="kpiRecBar"></i></div>
  </div>
  <div class="kc-stat kc-c-mint">
    <div class="kc-stat__top"><span class="kc-label">Tomados hoy</span></div>
    <div class="kc-stat__val" id="kpiTaken">0/0</div>
    <div class="kc-bar kc-c-mint"><i id="kpiTakenBar"></i></div>
  </div>
  <div class="kc-stat kc-c-amber">
    <div class="kc-stat__top"><span class="kc-label">Adherencia</span></div>
    <div class="kc-stat__val"><span id="kpiAdh">0</span><small>%</small></div>
    <div class="kc-bar kc-c-amber"><i id="kpiAdhBar"></i></div>
  </div>
</div>

<!-- Franja de perfil + acción -->
<div class="sup-facts">
  <span class="sup-fact"><span class="material-symbols-outlined">monitor_weight</span><b id="profileWeight">--</b></span>
  <span class="sup-fact"><span class="material-symbols-outlined">flag</span><b id="profileGoal">--</b></span>
  <span class="sup-fact"><span class="material-symbols-outlined">fitness_center</span><b id="profileExercise">--</b></span>
  <span class="sup-fact"><span class="material-symbols-outlined">schedule</span><b id="profileKetoTime">--</b></span>
</div>
<button class="kc-btn kc-btn--primary kc-btn--block" onclick="openAddSupplementModal()">
  <span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:'FILL' 1">add_circle</span>Agregar suplemento
</button>

<!-- Nota -->
<div class="sup-note">
  <span class="kc-ico kc-c-amber"><span class="material-symbols-outlined">info</span></span>
  <p>Recomendaciones orientativas. Consulta con un profesional de la salud antes de iniciar cualquier suplementación.</p>
</div>

<!-- Tomar ahora (contextual, oculto por defecto) -->
<section class="kc-card hidden" id="tomarAhoraSection">
  <header class="kc-card__head">
    <div style="display:flex;gap:12px;align-items:center;min-width:0">
      <span class="kc-ico kc-c-amber"><span class="material-symbols-outlined">schedule</span></span>
      <div style="min-width:0"><div class="kc-eyebrow">Ahora</div><h2 class="kc-card__title" style="margin-top:2px">Tomar ahora</h2><div class="kc-label" id="tomarAhoraContext"></div></div>
    </div>
    <span class="kc-chip kc-c-amber" id="tomarAhoraCount"></span>
  </header>
  <div id="tomarAhoraList"></div>
</section>

<!-- Suplementos activos -->
<section class="kc-card">
  <header class="kc-card__head">
    <div><div class="kc-eyebrow">Tu stack</div><h2 class="kc-card__title">Suplementos activos</h2></div>
    <span class="kc-chip kc-c-mint" id="currentCount">0</span>
  </header>
  <div id="currentSupplements"><p class="kc-label" style="text-align:center;padding:20px 0">Sin suplementos registrados.</p></div>
</section>

<!-- Recomendados -->
<section class="kc-card">
  <header class="kc-card__head">
    <div><div class="kc-eyebrow">Para ti</div><h2 class="kc-card__title">Recomendados</h2></div>
    <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="refreshRecommendations()" aria-label="Actualizar"><span class="material-symbols-outlined" style="font-size:18px">refresh</span></button>
  </header>
  <div id="recommendedSupplements"><p class="kc-label" style="text-align:center;padding:20px 0">Analizando tu perfil…</p></div>
</section>

<!-- Categorías -->
<section class="kc-card">
  <header class="kc-card__head">
    <div><div class="kc-eyebrow">Catálogo</div><h2 class="kc-card__title">Explorar por categoría</h2></div>
  </header>
  <div class="sup-tiles" id="supplementCategories">
    <div class="sup-tile" onclick="filterByCategory('essential')"><span class="kc-ico kc-c-amber"><span class="material-symbols-outlined">star</span></span><div><div class="sup-tile__name">Esenciales</div><div class="sup-tile__sub">Fundamentos</div></div></div>
    <div class="sup-tile" onclick="filterByCategory('performance')"><span class="kc-ico kc-c-red"><span class="material-symbols-outlined">bolt</span></span><div><div class="sup-tile__name">Rendimiento</div><div class="sup-tile__sub">Músculo · energía</div></div></div>
    <div class="sup-tile" onclick="filterByCategory('weight')"><span class="kc-ico kc-c-mint"><span class="material-symbols-outlined">trending_down</span></span><div><div class="sup-tile__name">Control peso</div><div class="sup-tile__sub">Keto</div></div></div>
    <div class="sup-tile" onclick="filterByCategory('general')"><span class="kc-ico kc-c-cyan"><span class="material-symbols-outlined">health_and_safety</span></span><div><div class="sup-tile__name">Salud general</div><div class="sup-tile__sub">Bienestar</div></div></div>
  </div>
</section>

<!-- Modal catálogo -->
<div id="addSupplementModal" class="sup-modal hidden">
  <div class="sup-modal__scrim" onclick="closeAddSupplementModal()"></div>
  <div class="sup-modal__panel">
    <header class="kc-card__head" style="margin-bottom:14px">
      <div><div class="kc-eyebrow">Catálogo</div><h3 class="kc-card__title" id="addSupplementModalTitle" style="margin-top:4px">Agregar suplemento</h3></div>
      <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeAddSupplementModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
    </header>
    <div id="supplementListModal" class="sup-modal__list"></div>
    <button class="kc-btn kc-btn--secondary kc-btn--block" onclick="closeAddSupplementModal()" style="margin-top:14px">Cerrar</button>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="sup-toast hidden">
  <span class="material-symbols-outlined" style="color:var(--kc-mint);font-size:20px;font-variation-settings:'FILL' 1">check_circle</span>
  <span id="toastMessage">Guardado</span>
</div>

<Fragment slot="scripts">
<script is:inline src="/app/utils.js"></script>
<script is:inline src="/app/modules/supplement-recommender.js"></script>
<script is:inline>
// Categoría → icono Material Symbols + clase de color HUD
var supplementColors={
esencial:{icon:"star",cls:"kc-c-amber"},
rendimiento:{icon:"bolt",cls:"kc-c-red"},
control:{icon:"trending_down",cls:"kc-c-mint"},
salud:{icon:"health_and_safety",cls:"kc-c-cyan"}
};
var prioChipClass={alta:"kc-c-amber",media:"kc-c-cyan",baja:"kc-c-neutral"};

function setKpiVal(id,v){var e=document.getElementById(id);if(e)e.textContent=v;}
function setBar(id,pct){var e=document.getElementById(id);if(e)e.style.width=Math.max(0,Math.min(100,pct))+'%';}

// KPIs reales del stack (mismo modelo de gauge que la pantalla "Hoy")
function updateKpis(){
  var data=getSupplementRecommendations();
  var active=(data.current||[]).length;
  var recommended=(data.recommended||[]).length;
  var total=active+recommended;
  var today=new Date().toISOString().slice(0,10);
  var takenMap=safeParseJSON(localStorage.getItem('suple_taken_'+today),{});
  var takenToday=(data.current||[]).filter(function(s){return takenMap[s.id||s.name];}).length;
  var coverage=total?Math.round(active/total*100):0;
  var pendShare=total?Math.round(recommended/total*100):0;
  var adherence=active?Math.round(takenToday/active*100):0;
  setKpiVal('kpiActive',active); setBar('kpiActiveBar',coverage);
  setKpiVal('kpiRec',recommended); setBar('kpiRecBar',pendShare);
  setKpiVal('kpiTaken',takenToday+'/'+active); setBar('kpiTakenBar',adherence);
  setKpiVal('kpiAdh',adherence); setBar('kpiAdhBar',adherence);
}

function loadSupplementData(){
var data=getSupplementRecommendations();
var goalLabels={salud:"Salud",perdida_peso:"Pérdida peso",musculo:"Ganar músculo",mantenimiento:"Mantener",lose:"Perder grasa",gain:"Ganar músculo",maintain:"Mantener",strength:"Fuerza"};
document.getElementById("profileWeight").textContent=(data.profile.weight||"--")+" kg";
document.getElementById("profileGoal").textContent=goalLabels[data.profile.goal]||"Salud";
document.getElementById("profileExercise").textContent=data.profile.activityLevel||(data.profile.hasExercise?(data.profile.workoutDays+" días/sem"):"No");
document.getElementById("profileKetoTime").textContent=(data.profile.monthsOnKeto||"--")+" meses";
var currentHtml="";
if(data.current&&data.current.length>0){
document.getElementById("currentCount").textContent=data.current.length;
data.current.forEach(function(sup){currentHtml+=renderSupplementCard(sup,true);});
}else{
document.getElementById("currentCount").textContent="0";
currentHtml='<p class="kc-label" style="text-align:center;padding:20px 0">Sin suplementos registrados.</p>';
}
document.getElementById("currentSupplements").innerHTML=currentHtml;
var recHtml="";
if(data.recommended&&data.recommended.length>0){
data.recommended.forEach(function(sup){recHtml+=renderSupplementCard(sup,false);});
}else{
recHtml='<p class="kc-label" style="text-align:center;padding:20px 0">Todas las recomendaciones cubiertas.</p>';
}
document.getElementById("recommendedSupplements").innerHTML=recHtml;
updateKpis();
}

function renderSupplementCard(sup,isCurrent){
var catInfo=supplementColors[sup.category]||supplementColors.salud;
var accent=catInfo.cls||"kc-c-cyan";
var prio=sup.priority||"media";
var chip=prioChipClass[prio]||"kc-c-neutral";
var html='<div class="sup-card '+accent+'">';
html+='<div class="sup-card__top">';
html+='<span class="kc-ico '+accent+'"><span class="material-symbols-outlined">'+catInfo.icon+'</span></span>';
html+='<div class="sup-card__id"><div class="sup-card__name">'+(sup.name||'Suplemento')+'</div>';
html+='<span class="kc-chip kc-chip--sm '+chip+'">Prioridad '+prio+'</span></div>';
if(isCurrent){
html+='<button class="kc-btn kc-btn--sm kc-btn--secondary kc-btn--icon" onclick="removeUserSupplement(\''+sup.id+'\')" aria-label="Quitar"><span class="material-symbols-outlined" style="font-size:18px">delete</span></button>';
}else{
html+='<button class="kc-btn kc-btn--sm kc-btn--primary kc-btn--icon" onclick="addUserSupplement(\''+sup.id+'\')" aria-label="Añadir"><span class="material-symbols-outlined" style="font-size:18px;font-variation-settings:\'FILL\' 1">add</span></button>';
}
html+='</div>';
if(sup.description){html+='<p class="sup-card__desc">'+sup.description+'</p>';}
html+='<div class="sup-card__meta">';
html+='<div class="sup-card__cell"><div class="kc-eyebrow">Dosis</div><div class="sup-card__v">'+(sup.dosage||'—')+'</div></div>';
html+='<div class="sup-card__cell"><div class="kc-eyebrow">Momento</div><div class="sup-card__v">'+(sup.timing||'—')+'</div></div>';
html+='</div></div>';
return html;
}

function addUserSupplement(supId){
var data=getSupplementRecommendations();
var sup=data.recommended.find(function(s){return s.id===supId;});
if(sup){addSupplementToUserList(sup);loadSupplementData();renderTomarAhora();showToast(sup.name+" agregado");}
else{showToast("Suplemento no encontrado");}
}

function removeUserSupplement(supId){
removeSupplementFromUserList(supId);loadSupplementData();renderTomarAhora();showToast("Suplemento eliminado");
}

function refreshRecommendations(){loadSupplementData();showToast("Recomendaciones actualizadas");}

function filterByCategory(category){openAddSupplementModal(category);}

// Cargar suplementos desde Supabase
async function loadSupplementsFromSupabase() {
    try {
        const { data } = await window.supabase.from('suplementos').select('*').eq('activo', true).order('nombre');
        if (data && data.length > 0) { return data; }
    } catch (e) { console.error('Error cargando suplementos:', e); }
    return [];
}

function mapSuplementoCategory(cat) {
    const map = {mineral:'esencial',vitamina:'esencial',proteina:'rendimiento',aminoacido:'rendimiento',creatina:'rendimiento',cetogenico:'control',acido_graso:'control',quemador:'control',adaptogeno:'salud',hormona:'salud',digestivo:'salud',estimulante:'rendimiento'};
    return map[cat] || 'salud';
}

var categoryGroupLabels={essential:"Esenciales",performance:"Rendimiento",weight:"Control de peso",general:"Salud general"};
var colorGroupToTileGroup={esencial:"essential",rendimiento:"performance",control:"weight",salud:"general"};

async function openAddSupplementModal(filterGroup){
var allSupplements=[];
if(typeof supplementRecommender!=='undefined'){
var db=supplementRecommender.supplementsDB;
if(db.essential)Object.values(db.essential).forEach(function(s){s.group="essential";allSupplements.push(s);});
if(db.performance)Object.values(db.performance).forEach(function(s){s.group="performance";allSupplements.push(s);});
if(db.weight)Object.values(db.weight).forEach(function(s){s.group="weight";allSupplements.push(s);});
if(db.general)Object.values(db.general).forEach(function(s){s.group="general";allSupplements.push(s);});
}
const supabaseSupps = await loadSupplementsFromSupabase();
supabaseSupps.forEach(function(s) {
    var colorCategory=mapSuplementoCategory(s.categoria);
    allSupplements.push({id:s.id,name:s.nombre,category:colorCategory,group:colorGroupToTileGroup[colorCategory]||"general",dosage:s.dosis_recomendada||'',description:s.beneficios||'',timing:'diario',priority:'media',source:'cloud'});
});
if(filterGroup){allSupplements=allSupplements.filter(function(s){return s.group===filterGroup;});}
document.getElementById("addSupplementModalTitle").textContent=filterGroup?("Agregar — "+categoryGroupLabels[filterGroup]):"Agregar suplemento";
var html="";
allSupplements.forEach(function(sup){
var catInfo=supplementColors[sup.category]||supplementColors.salud;
html+='<div class="sup-pick" onclick="addUserSupplement(\''+sup.id+'\');closeAddSupplementModal();">';
html+='<span class="kc-ico '+(catInfo.cls||"kc-c-cyan")+'"><span class="material-symbols-outlined">'+catInfo.icon+'</span></span>';
html+='<div class="sup-pick__id"><div class="sup-pick__name">'+sup.name+'</div><div class="sup-pick__sub">'+(sup.dosage||sup.timing||'diario')+'</div></div>';
html+='<span class="material-symbols-outlined" style="color:var(--kc-amber);font-variation-settings:\'FILL\' 1">add_circle</span></div>';
});
document.getElementById("supplementListModal").innerHTML=html||'<p class="kc-label" style="text-align:center;padding:20px 0">No hay suplementos en esta categoría</p>';
document.getElementById("addSupplementModal").classList.remove("hidden");
}

function closeAddSupplementModal(){document.getElementById("addSupplementModal").classList.add("hidden");}

function showToast(msg){
var toast=document.getElementById("toast");
document.getElementById("toastMessage").textContent=msg;
toast.classList.remove("hidden");
setTimeout(function(){toast.classList.add("hidden");},3000);
}

function renderTomarAhora(){
  var hour = new Date().getHours();
  var supls = safeParseJSON(localStorage.getItem('user_supplements'), []);
  var section = document.getElementById('tomarAhoraSection');
  if (!section) return;
  if (!supls.length) { section.classList.add('hidden'); return; }

  var timeLabel, matchFn;
  if (hour >= 6 && hour < 10) {
    timeLabel = 'Mañana · Con el desayuno';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('desayuno')||t.includes('mañana')||t.includes('con comida')||t.includes('vitamina')||t.includes('omega')||t.includes('colageno')||t.includes('multivit'); };
  } else if (hour >= 10 && hour < 12) {
    timeLabel = 'Media mañana · Pre-entreno';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('pre')||t.includes('entreno')||t.includes('cafeina')||t.includes('carnitina')||t.includes('bcaa'); };
  } else if (hour >= 12 && hour < 15) {
    timeLabel = 'Mediodía · Con el almuerzo';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('almuerzo')||t.includes('comida')||t.includes('electro')||t.includes('creatina'); };
  } else if (hour >= 15 && hour < 19) {
    timeLabel = 'Tarde · Post-entreno o con cena';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('post')||t.includes('cena')||t.includes('tarde')||t.includes('creatina'); };
  } else {
    timeLabel = 'Noche · Antes de dormir';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('dormir')||t.includes('noche')||t.includes('magnesio'); };
  }

  var matches = supls.filter(matchFn);
  var today = new Date().toISOString().slice(0,10);
  var taken = safeParseJSON(localStorage.getItem('suple_taken_'+today), {});
  var listEl  = document.getElementById('tomarAhoraList');
  var ctxEl   = document.getElementById('tomarAhoraContext');
  var cntEl   = document.getElementById('tomarAhoraCount');

  if (!matches.length) { section.classList.add('hidden'); return; }
  section.classList.remove('hidden');
  if (ctxEl) ctxEl.textContent = timeLabel;
  if (cntEl) cntEl.textContent = matches.length + ' suplemento' + (matches.length>1?'s':'');

  listEl.innerHTML = matches.map(function(s){
    var id = s.id || s.name;
    var isTaken = !!taken[id];
    return '<div class="sup-now'+(isTaken?' is-taken':'')+'" onclick="toggleSupleNow(\''+escapeHtml(id)+'\')">' +
      '<span class="kc-ico '+(isTaken?'kc-c-mint':'kc-c-amber')+'"><span class="material-symbols-outlined" style="font-variation-settings:\'FILL\' 1">'+(isTaken?'check_circle':(s.icon||'medication'))+'</span></span>' +
      '<div class="sup-now__id"><div class="sup-now__name">'+ escapeHtml(s.name)+'</div><div class="sup-now__sub">'+escapeHtml(s.dosage||'')+'</div></div>' +
      '<span class="sup-now__flag'+(isTaken?' is-taken':'')+'">'+(isTaken?'✓ Tomado':'Tomar')+'</span>' +
    '</div>';
  }).join('');
}

function toggleSupleNow(id){
  var today = new Date().toISOString().slice(0,10);
  var taken = safeParseJSON(localStorage.getItem('suple_taken_'+today),{});
  taken[id] = !taken[id];
  localStorage.setItem('suple_taken_'+today, JSON.stringify(taken));
  renderTomarAhora();
  updateKpis();
}

loadSupplementData();
renderTomarAhora();
document.addEventListener('visibilitychange',function(){
if(!document.hidden){loadSupplementData();renderTomarAhora();}
});
</script>
</Fragment>
</AppShell>
