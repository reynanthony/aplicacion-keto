---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Suplementos" authGuard={true}>
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
.glass-card{background:rgba(22,19,16,0.7);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.secondary-gradient{background:linear-gradient(135deg,#ffb300 0%,#ffc94f 100%)}
.custom-scrollbar::-webkit-scrollbar{width:4px}
.custom-scrollbar::-webkit-scrollbar-track{background:#0b0a08}
.custom-scrollbar::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:10px}
@media(min-width:768px){
  #sups-grid{display:grid;grid-template-columns:1fr 360px;gap:1.25rem;align-items:start;padding-top:1rem;max-width:none!important;}
  #sups-grid>*{margin-top:0!important;}
  #sups-hero{grid-column:1/-1;grid-row:1;}
  #sups-disclaimer{grid-column:1/-1;grid-row:2;}
  #sups-profile{grid-column:1/-1;grid-row:3;}
  #sups-current{grid-column:1;grid-row:4;}
  #sups-recommended{grid-column:1;grid-row:5;}
  #tomarAhoraSection{grid-column:2;grid-row:4;}
  #sups-categories{grid-column:2;grid-row:5;}
}
</style>
<header class="fixed top-0 left-0 right-0 z-40 h-14 px-4 flex items-center justify-between" style="background:rgba(11,10,8,0.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,240,225,0.06)">
  <a href="/app/" class="flex items-center gap-3" style="text-decoration:none">
    <img src="/app/logo.svg" alt="KetoCore" class="w-7 h-7" style="filter:drop-shadow(0 0 6px rgba(255,77,0,0.4))">
    <span class="text-base font-black tracking-tight" style="font-family:'Plus Jakarta Sans',sans-serif;color:#f7f4f0">KetoCore</span>
  </a>
  <div class="flex items-center gap-1.5">
    <button onclick="toggleMobileUserMenu()" aria-label="Mi cuenta" class="w-9 h-9 rounded-full flex items-center justify-center overflow-hidden" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06)">
      <img id="mobileHeaderAvatarImg" src="" class="hidden w-full h-full object-cover" alt="Avatar">
      <span id="mobileHeaderAvatarIcon" class="material-symbols-outlined" style="font-size:20px;color:rgba(247,244,240,0.6)">account_circle</span>
    </button>
    <button onclick="toggleHamburgerMenu()" aria-label="Abrir menú" class="w-9 h-9 rounded-full flex items-center justify-center" style="background:#1e1a15;color:rgba(247,244,240,0.6)">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:20px">menu</span>
    </button>
  </div>
</header>

<!-- Mobile User Dropdown -->
<div id="mobileUserDropdown" class="md:hidden fixed top-14 right-4 w-56 rounded-2xl overflow-hidden z-[80] hidden" style="background:#161310;border:1px solid rgba(255,240,225,0.07);box-shadow:0 8px 32px rgba(0,0,0,0.35)">
  <div class="p-3" style="border-bottom:1px solid rgba(255,240,225,0.06)">
    <p class="text-sm font-semibold" style="color:#f7f4f0" id="mobileDropdownUserName">Usuario</p>
    <p class="text-xs mt-0.5" style="color:rgba(247,244,240,0.55)" id="mobileDropdownUserEmail">email@example.com</p>
  </div>
  <div class="p-2">
    <a href="/app/perfil" class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-orange-50" style="color:#f7f4f0">
      <span class="material-symbols-outlined text-lg" style="color:rgba(247,244,240,0.55)">person</span>
      <span class="text-sm font-medium">Mi Perfil</span>
    </a>
    <button onclick="handleLogout()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors hover:bg-red-50" style="color:#dc2626">
      <span class="material-symbols-outlined text-lg">logout</span>
      <span class="text-sm font-medium">Cerrar Sesión</span>
    </button>
  </div>
</div>
<main class="main-content pt-14 px-4 pb-20 min-h-screen" style="background:#0b0a08">
<div id="sups-grid" class="space-y-4 kc-page" style="padding-top:12px">

<!-- Hero Header -->
<div id="sups-hero" class="relative overflow-hidden bg-surface-container rounded-3xl p-8 md:p-12">
<div class="absolute -top-20 -right-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl"></div>
<div class="absolute -bottom-20 -left-20 w-48 h-48 bg-secondary/10 rounded-full blur-3xl"></div>
<div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
<div>
<span style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00">Optimización nutricional</span>
<h1 class="kc-h1" style="margin-top:10px">Tu stack de<br>suplementos</h1>
<p class="text-on-surface-variant mt-3 max-w-lg">Optimiza tu rendimiento con suplementos personalizados segun tu perfil y objetivos.</p>
</div>
<button onclick="openAddSupplementModal()" class="kc-btn">
<span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">add_circle</span>
Agregar Suplemento
</button>
</div>
</div>

<!-- Disclaimer Banner -->
<div id="sups-disclaimer" class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-6">
<div class="flex items-start gap-4">
<div class="w-12 h-12 rounded-xl bg-amber-500/20 flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-amber-400 text-2xl">medical_information</span>
</div>
<div>
<h4 class="font-headline font-bold text-white text-lg">Informacion Importante</h4>
<p class="text-on-surface-variant mt-1">Estas recomendaciones son orientativas. Consulta siempre con un profesional de la salud antes de iniciar cualquier suplementacion.</p>
</div>
</div>
</div>

<!-- Profile Stats Grid -->
<div id="sups-profile" class="grid grid-cols-2 md:grid-cols-4 gap-4">
<div class="bg-surface-container rounded-2xl p-6 relative overflow-hidden group">
<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-6xl text-primary">monitor_weight</span>
</div>
<div class="relative">
<span class="text-[10px] font-bold text-primary uppercase tracking-widest">Peso</span>
<p id="profileWeight" class="font-headline text-3xl font-black text-white mt-1 break-words">--</p>
<span class="text-xs text-on-surface-variant">kg</span>
</div>
</div>
<div class="bg-surface-container rounded-2xl p-6 relative overflow-hidden group">
<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-6xl text-secondary">flag</span>
</div>
<div class="relative">
<span class="text-[10px] font-bold text-secondary uppercase tracking-widest">Objetivo</span>
<p id="profileGoal" class="font-headline text-lg font-black text-white mt-1 break-words leading-snug">--</p>
</div>
</div>
<div class="bg-surface-container rounded-2xl p-6 relative overflow-hidden group">
<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-6xl text-green-400">fitness_center</span>
</div>
<div class="relative">
<span class="text-[10px] font-bold text-green-400 uppercase tracking-widest">Entrenamiento</span>
<p id="profileExercise" class="font-headline text-lg font-black text-white mt-1 break-words leading-snug">--</p>
</div>
</div>
<div class="bg-surface-container rounded-2xl p-6 relative overflow-hidden group">
<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-6xl text-purple-400">schedule</span>
</div>
<div class="relative">
<span class="text-[10px] font-bold text-purple-400 uppercase tracking-widest">Tiempo Keto</span>
<p id="profileKetoTime" class="font-headline text-lg font-black text-white mt-1 break-words leading-snug">--</p>
</div>
</div>
</div>

<!-- Tomar Ahora — contextual card -->
<div id="tomarAhoraSection" class="hidden bg-surface-container rounded-2xl p-6">
  <div class="flex items-center gap-3 mb-4">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,77,0,0.15)">
      <span class="material-symbols-outlined text-xl" style="color:#ff4d00;font-variation-settings:'FILL' 1">schedule</span>
    </div>
    <div>
      <h3 class="font-headline font-bold text-white text-lg">Tomar ahora</h3>
      <p id="tomarAhoraContext" class="text-on-surface-variant text-xs"></p>
    </div>
    <span id="tomarAhoraCount" class="ml-auto bg-primary-container/20 text-primary-container text-xs font-bold px-3 py-1 rounded-full"></span>
  </div>
  <div id="tomarAhoraList" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
</div>

<!-- Current Supplements Section -->
<div id="sups-current" class="bg-surface-container rounded-2xl p-8">
<div class="flex items-center justify-between mb-8">
<div class="flex items-center gap-4">
<div class="w-14 h-14 rounded-2xl bg-green-500/20 flex items-center justify-center">
<span class="material-symbols-outlined text-green-400 text-3xl" style="font-variation-settings:'FILL' 1">check_circle</span>
</div>
<div>
<h2 class="font-headline text-2xl font-extrabold text-white">Tus Suplementos Activos</h2>
<p class="text-on-surface-variant text-sm">Suplementos que tomas actualmente</p>
</div>
</div>
<span id="currentCount" class="bg-green-500/20 text-green-400 px-4 py-2 rounded-full text-sm font-bold">0 activos</span>
</div>
<div id="currentSupplements" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
<p class="text-on-surface-variant text-center py-12 col-span-full">No tienes suplementos registrados.</p>
</div>
</div>

<!-- Recommended Supplements Section -->
<div id="sups-recommended" class="bg-surface-container rounded-2xl p-8 relative overflow-hidden">
<div class="absolute top-0 right-0 w-64 h-64 bg-secondary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
<div class="relative">
<div class="flex items-center justify-between mb-8">
<div class="flex items-center gap-4">
<div class="w-14 h-14 rounded-2xl secondary-gradient flex items-center justify-center">
<span class="material-symbols-outlined text-white text-3xl" style="font-variation-settings:'FILL' 1">auto_awesome</span>
</div>
<div>
<h2 class="font-headline text-2xl font-extrabold text-white">Recomendados para Ti</h2>
<p class="text-on-surface-variant text-sm">Basados en tu perfil y objetivos</p>
</div>
</div>
<button onclick="refreshRecommendations()" class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center hover:bg-surface-container-highest transition-colors">
<span class="material-symbols-outlined text-on-surface-variant">refresh</span>
</button>
</div>
<div id="recommendedSupplements" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
<div class="flex items-center justify-center py-12 col-span-full">
<div class="animate-spin rounded-full h-10 w-10 border-b-2 border-secondary"></div>
<span class="ml-4 text-on-surface-variant">Analizando tu perfil...</span>
</div>
</div>
</div>
</div>

<!-- Supplement Categories -->
<div id="sups-categories" class="bg-surface-container rounded-2xl p-8">
<div class="flex items-center gap-4 mb-8">
<div class="w-14 h-14 rounded-2xl bg-purple-500/20 flex items-center justify-center">
<span class="material-symbols-outlined text-purple-400 text-3xl" style="font-variation-settings:'FILL' 1">category</span>
</div>
<div>
<h2 class="font-headline text-2xl font-extrabold text-white">Explorar por Categoria</h2>
<p class="text-on-surface-variant text-sm">Todos los suplementos disponibles</p>
</div>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="supplementCategories">
<div class="bg-surface-container-high rounded-2xl p-6 cursor-pointer hover:bg-surface-container-highest transition-all group" onclick="filterByCategory('essential')">
<div class="w-12 h-12 rounded-xl bg-orange-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-orange-400 text-2xl">star</span>
</div>
<h4 class="font-headline font-bold text-white mb-1">Esenciales</h4>
<p class="text-xs text-on-surface-variant">Fundamentos diarios</p>
</div>
<div class="bg-surface-container-high rounded-2xl p-6 cursor-pointer hover:bg-surface-container-highest transition-all group" onclick="filterByCategory('performance')">
<div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-red-400 text-2xl">bolt</span>
</div>
<h4 class="font-headline font-bold text-white mb-1">Rendimiento</h4>
<p class="text-xs text-on-surface-variant">Musculo y energia</p>
</div>
<div class="bg-surface-container-high rounded-2xl p-6 cursor-pointer hover:bg-surface-container-highest transition-all group" onclick="filterByCategory('weight')">
<div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-green-400 text-2xl">trending_down</span>
</div>
<h4 class="font-headline font-bold text-white mb-1">Control Peso</h4>
<p class="text-xs text-on-surface-variant">Optimizacion keto</p>
</div>
<div class="bg-surface-container-high rounded-2xl p-6 cursor-pointer hover:bg-surface-container-highest transition-all group" onclick="filterByCategory('general')">
<div class="w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-blue-400 text-2xl">health_and_safety</span>
</div>
<h4 class="font-headline font-bold text-white mb-1">Salud General</h4>
<p class="text-xs text-on-surface-variant">Bienestar integral</p>
</div>
</div>
</div>

</div>
</main>

<!-- Add Supplement Modal -->
<div id="addSupplementModal" class="fixed inset-0 z-[60] hidden">
<div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeAddSupplementModal()"></div>
<div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none overflow-y-auto">
<div class="glass-card rounded-3xl p-8 w-full max-w-lg max-h-[90vh] overflow-y-auto pointer-events-auto border border-primary/20">
<div class="flex justify-between items-center mb-6">
<h3 class="text-2xl font-headline font-black text-white">Agregar Suplemento</h3>
<button onclick="closeAddSupplementModal()" class="w-10 h-10 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/10 transition-all"><span class="material-symbols-outlined text-lg">close</span></button>
</div>
<div id="supplementListModal" class="space-y-3 max-h-96 overflow-y-auto custom-scrollbar"></div>
<div class="mt-6 pt-6 border-t border-white/10">
<button onclick="closeAddSupplementModal()" class="w-full py-4 rounded-xl bg-surface-container-high text-white font-medium hover:bg-surface-container-highest transition-colors">Cerrar</button>
</div>
</div>
</div>
</div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-28 left-1/2 -translate-x-1/2 z-[70] hidden">
<div class="glass-card rounded-full px-6 py-3 flex items-center gap-3 shadow-lg border border-primary/20">
<span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1">check_circle</span>
<span id="toastMessage" class="text-white font-bold">Guardado!</span>
</div>
</div>

<script is:inline src="/app/utils.js"></script>
<script is:inline src="/app/modules/supplement-recommender.js"></script>
<script is:inline>
var supplementColors={
esencial:{icon:"star",color:"#ff9800",bg:"bg-orange-500/20"},
rendimiento:{icon:"bolt",color:"#ff5722",bg:"bg-red-500/20"},
control:{icon:"trending_down",color:"#4caf50",bg:"bg-green-500/20"},
salud:{icon:"health_and_safety",color:"#2196f3",bg:"bg-blue-500/20"}
};

function loadSupplementData(){
var data=getSupplementRecommendations();
var goalLabels={salud:"Salud",perdida_peso:"Perdida peso",musculo:"Ganar musculo",mantenimiento:"Mantenimiento",lose:"Perder grasa",gain:"Ganar musculo",maintain:"Mantener",strength:"Fuerza"};
document.getElementById("profileWeight").textContent=(data.profile.weight||"--")+" kg";
document.getElementById("profileGoal").textContent=goalLabels[data.profile.goal]||"Salud";
document.getElementById("profileExercise").textContent=data.profile.activityLevel||(data.profile.hasExercise?(data.profile.workoutDays+" dias/sem"):"No");
document.getElementById("profileKetoTime").textContent=(data.profile.monthsOnKeto||"--")+" meses";
var currentHtml="";
if(data.current&&data.current.length>0){
document.getElementById("currentCount").textContent=data.current.length+" activos";
data.current.forEach(function(sup){
currentHtml+=renderSupplementCard(sup,true);
});
}else{
document.getElementById("currentCount").textContent="0 activos";
currentHtml='<p class="text-on-surface-variant text-center py-12 col-span-full">No tienes suplementos registrados.</p>';
}
document.getElementById("currentSupplements").innerHTML=currentHtml;
var recHtml="";
if(data.recommended&&data.recommended.length>0){
data.recommended.forEach(function(sup){
recHtml+=renderSupplementCard(sup,false);
});
}else{
recHtml='<p class="text-on-surface-variant text-center py-12 col-span-full">Genial! Tienes todas las recomendaciones cubiertas.</p>';
}
document.getElementById("recommendedSupplements").innerHTML=recHtml;
}

function renderSupplementCard(sup,isCurrent){
var priorityColors={alta:{border:"border-l-amber-500",badge:"bg-amber-500/20 text-amber-400",glow:"shadow-amber-500/20"},media:{border:"border-l-amber-400",badge:"bg-amber-400/20 text-amber-300",glow:"shadow-amber-400/20"},baja:{border:"border-l-white/20",badge:"bg-white/10 text-white/70",glow:""}};
var colors=priorityColors[sup.priority]||priorityColors.baja;
var catInfo=supplementColors[sup.category]||supplementColors.salud;
var html='<div class="bg-surface-container-low rounded-2xl p-6 border-l-4 '+colors.border+' hover:bg-surface-container-high transition-all group shadow-lg '+colors.glow+'">';
html+='<div class="flex items-start justify-between mb-4">';
html+='<div class="flex items-center gap-4">';
html+='<div class="w-14 h-14 rounded-2xl '+catInfo.bg+' flex items-center justify-center group-hover:scale-110 transition-transform">';
html+='<span class="material-symbols-outlined text-2xl" style="color:'+catInfo.color+'">'+catInfo.icon+'</span></div>';
html+='<div>';
html+='<h4 class="font-headline font-bold text-white text-lg">'+sup.name+'</h4>';
html+='<span class="text-[10px] font-bold uppercase tracking-wider '+colors.badge+' px-2 py-1 rounded-full">Prioridad '+sup.priority+'</span>';
html+='</div></div>';
if(isCurrent){
html+='<button onclick="removeUserSupplement(\''+sup.id+'\')" class="w-10 h-10 rounded-full bg-red-500/10 flex items-center justify-center text-red-400 hover:bg-red-500/20 hover:text-red-300 transition-all">';
html+='<span class="material-symbols-outlined text-lg">delete</span></button>';
}else{
html+='<button onclick="addUserSupplement(\''+sup.id+'\')" class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary hover:bg-primary/30 hover:text-white transition-all">';
html+='<span class="material-symbols-outlined text-lg" style="font-variation-settings:\'FILL\' 1">add_circle</span></button>';
}
html+='</div>';
html+='<p class="text-on-surface-variant text-sm mb-4">'+sup.description+'</p>';
html+='<div class="grid grid-cols-2 gap-4">';
html+='<div class="bg-surface-container-high rounded-xl p-3">';
html+='<p class="text-[10px] text-on-surface-variant uppercase tracking-wider mb-1">Dosis</p>';
html+='<p class="font-bold text-white">'+sup.dosage+'</p></div>';
html+='<div class="bg-surface-container-high rounded-xl p-3">';
html+='<p class="text-[10px] text-on-surface-variant uppercase tracking-wider mb-1">Momento</p>';
html+='<p class="font-bold text-white">'+sup.timing+'</p></div>';
html+='</div></div>';
return html;
}

function addUserSupplement(supId){
var data=getSupplementRecommendations();
var sup=data.recommended.find(function(s){return s.id===supId;});
if(sup){
addSupplementToUserList(sup);
loadSupplementData();
showToast(sup.name+" agregado");
}else{
showToast("Suplemento no encontrado");
}
}

function removeUserSupplement(supId){
removeSupplementFromUserList(supId);
loadSupplementData();
showToast("Suplemento eliminado");
}

function refreshRecommendations(){
loadSupplementData();
showToast("Recomendaciones actualizadas");
}

function filterByCategory(category){
showToast("Filtrando: "+category);
}

// Cargar suplementos desde Supabase
async function loadSupplementsFromSupabase() {
    try {
        const { data } = await window.supabase.from('suplementos').select('*').eq('activo', true).order('nombre');

        if (data && data.length > 0) {
            console.log('✅ Cargados', data.length, 'suplementos de Supabase');
            return data;
        }
    } catch (e) {
        console.error('Error cargando suplementos:', e);
    }
    return [];
}

function mapSuplementoCategory(cat) {
    const map = {
        'mineral': 'esencial',
        'vitamina': 'esencial',
        'proteina': 'rendimiento',
        'aminoacido': 'rendimiento',
        'creatina': 'rendimiento',
        'cetogenico': 'control',
        'acido_graso': 'control',
        'quemador': 'control',
        'adaptogeno': 'salud',
        'hormona': 'salud',
        'digestivo': 'salud',
        'estimulante': 'rendimiento'
    };
    return map[cat] || 'salud';
}

async function openAddSupplementModal(){
var data=getSupplementRecommendations();
var allSupplements=[];
if(typeof supplementRecommender!=='undefined'){
var db=supplementRecommender.supplementsDB;
if(db.essential)Object.values(db.essential).forEach(function(s){allSupplements.push(s);});
if(db.performance)Object.values(db.performance).forEach(function(s){allSupplements.push(s);});
if(db.weight)Object.values(db.weight).forEach(function(s){allSupplements.push(s);});
if(db.general)Object.values(db.general).forEach(function(s){allSupplements.push(s);});
}

// Cargar suplementos de Supabase
const supabaseSupps = await loadSupplementsFromSupabase();
supabaseSupps.forEach(function(s) {
    allSupplements.push({
        id: s.id,
        name: s.nombre,
        category: mapSuplementoCategory(s.categoria),
        dosage: s.dosis_recomendada || '',
        description: s.beneficios || '',
        timing: 'diario',
        priority: 'media',
        source: 'cloud'
    });
});

var html="";
allSupplements.forEach(function(sup){
var catInfo=supplementColors[sup.category]||supplementColors.salud;
