function renderTomarAhora(){
  var hour = new Date().getHours();
  var supls = safeParseJSON(localStorage.getItem('user_supplements'), []);
  if (!supls.length) return;

  var timeLabel, matchFn;
  if (hour >= 6 && hour < 10) {
    timeLabel = 'Mañana · Con el desayuno';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('desayuno')||t.includes('mañana')||t.includes('con comida')||t.includes('vitamina')||t.includes('omega')||t.includes('colageno')||t.includes('multivit'); };
  } else if (hour >= 10 && hour < 12) {
    timeLabel = 'Media mañana · Pre-entreno';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('pre')||t.includes('entreno')||t.includes('cafeina')||t.includes('carnitina')||t.includes('bcaa'); };
  } else if (hour >= 12 && hour < 15) {
    timeLabel = 'Mediodía · Con el almuerzo';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('almuerzo')||t.includes('comida')||t.includes('electro')||t.includes('creatina'); };
  } else if (hour >= 15 && hour < 19) {
    timeLabel = 'Tarde · Post-entreno o con cena';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('post')||t.includes('cena')||t.includes('tarde')||t.includes('creatina'); };
  } else {
    timeLabel = 'Noche · Antes de dormir';
    matchFn = function(s){ var t=(s.timing||'').toLowerCase(); return t.includes('dormir')||t.includes('noche')||t.includes('magnesio'); };
  }

  var matches = supls.filter(matchFn);
  var today = new Date().toISOString().slice(0,10);
  var taken = safeParseJSON(localStorage.getItem('suple_taken_'+today), {});

  var section = document.getElementById('tomarAhoraSection');
  var listEl  = document.getElementById('tomarAhoraList');
  var ctxEl   = document.getElementById('tomarAhoraContext');
  var cntEl   = document.getElementById('tomarAhoraCount');
  if (!section) return;

  if (!matches.length) { section.classList.add('hidden'); return; }
  section.classList.remove('hidden');
  if (ctxEl) ctxEl.textContent = timeLabel;
  if (cntEl) cntEl.textContent = matches.length + ' suplemento' + (matches.length>1?'s':'');

  listEl.innerHTML = matches.map(function(s){
    var id = s.id || s.name;
    var isTaken = !!taken[id];
    return '<div class="flex items-center gap-3 rounded-xl p-3 cursor-pointer transition-all '+(isTaken?'opacity-50 bg-surface-container-high':'bg-surface-container-high hover:bg-surface-container-highest')+'" onclick="toggleSupleNow(\''+escapeHtml(id)+'\')">' +
      '<div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 '+(isTaken?'bg-green-500/20':'bg-primary-container/20')+'">' +
        '<span class="material-symbols-outlined text-lg '+(isTaken?'text-green-400':'text-primary-container')+'" style="font-variation-settings:\'FILL\' 1">'+(isTaken?'check_circle':(s.icon||'medication'))+'</span>' +
      '</div>' +
      '<div class="flex-1 min-w-0">' +
        '<p class="text-white text-sm font-medium '+(isTaken?'line-through':'')+'">'+ escapeHtml(s.name)+'</p>' +
        '<p class="text-on-surface-variant text-xs truncate">'+escapeHtml(s.dosage||'')+'</p>' +
      '</div>' +
      '<span class="text-[10px] font-bold '+(isTaken?'text-green-400':'text-on-surface-variant')+'">'+(isTaken?'✓ Tomado':'Tomar')+'</span>' +
    '</div>';
  }).join('');
}

function toggleSupleNow(id){
  var today = new Date().toISOString().slice(0,10);
  var taken = safeParseJSON(localStorage.getItem('suple_taken_'+today),{});
  taken[id] = !taken[id];
  localStorage.setItem('suple_taken_'+today, JSON.stringify(taken));
  renderTomarAhora();
}
</script>

<script is:inline>
// User Dropdown Menu
function toggleUserMenu() {
  const dropdown = document.getElementById('userDropdown');
  dropdown.classList.toggle('hidden');
  updateDropdownInfo();
}

function toggleMobileUserMenu() {
  const dropdown = document.getElementById('mobileUserDropdown');
  dropdown.classList.toggle('hidden');
  updateDropdownInfo();
}

function updateDropdownInfo() {
  const profile = JSON.parse(localStorage.getItem('keto_profile') || '{}');
  const userName = profile.nombre || profile.name || 'Usuario';
  const userEmail = localStorage.getItem('ketocore_user_email') || 'usuario@ejemplo.com';
  const dn = document.getElementById('dropdownUserName');
  const de = document.getElementById('dropdownUserEmail');
  const mdn = document.getElementById('mobileDropdownUserName');
  const mde = document.getElementById('mobileDropdownUserEmail');
  if(dn) dn.textContent = userName;
  if(de) de.textContent = userEmail;
  if(mdn) mdn.textContent = userName;
  if(mde) mde.textContent = userEmail;
}

function updateHeaderAvatar() {
  const profile = JSON.parse(localStorage.getItem('keto_profile') || '{}');
  const avatarUrl = profile.avatar_url;
  const hi = document.getElementById('headerAvatarImg');
  const hi2 = document.getElementById('headerAvatarIcon');
  const mhi = document.getElementById('mobileHeaderAvatarImg');
  const mhi2 = document.getElementById('mobileHeaderAvatarIcon');
  if (avatarUrl) {
    if(hi) { hi.src = avatarUrl; hi.classList.remove('hidden'); }
    if(hi2) hi2.classList.add('hidden');
    if(mhi) { mhi.src = avatarUrl; mhi.classList.remove('hidden'); }
    if(mhi2) mhi2.classList.add('hidden');
  } else {
    if(hi) hi.classList.add('hidden');
    if(hi2) hi2.classList.remove('hidden');
    if(mhi) mhi.classList.add('hidden');
    if(mhi2) mhi2.classList.remove('hidden');
  }
}

document.addEventListener('click', function(e) {
  const dd = document.getElementById('userDropdown');
  const mdd = document.getElementById('mobileUserDropdown');
  const btn = document.getElementById('profileBtn');
  if (dd && !dd.contains(e.target) && !btn.contains(e.target)) dd.classList.add('hidden');
  if (mdd && !e.target.closest('#mobileUserDropdown') && !e.target.closest('button[onclick="toggleMobileUserMenu()"]')) mdd.classList.add('hidden');
});

async function handleLogout() {
  if (confirm('¿Cerrar sesión?')) {
    await window.supabase.auth.signOut();
    localStorage.removeItem('ketocore_user_id');
    localStorage.removeItem('ketocore_user_email');
    localStorage.removeItem('ketocore_onboarding_done');
    window.location.href = '/app/welcome';
  }
}

updateHeaderAvatar();
</script>

