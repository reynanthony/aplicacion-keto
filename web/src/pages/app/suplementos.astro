---
// Suplementos — v3. Migra también el header/nav legacy a AppLayout+Dock limpio
// (esta pantalla no venía del patrón nuevo). Modal de agregar → Sheet propio.
// Activos/recomendados → filas clicables con tokens v3. Categorías → Chip real
// (arregla filterByCategory, que antes solo mostraba un toast sin filtrar).
import AppLayout from '../../layouts/AppLayout.astro';
import Dock from '../../components/v3/Dock.astro';
import Sheet from '../../components/v3/Sheet.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Suplementos" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:10px;">
        <div>
          <p class="v3-eyebrow" style="margin-bottom:6px;">Optimización nutricional</p>
          <h1 style="font-family:var(--v3-font-title); font-weight:800; font-size:24px; color:var(--v3-text); line-height:1.15;">Tu stack de suplementos</h1>
        </div>
      </div>

      <div style="background:rgba(251,191,36,0.08); border:1px solid rgba(251,191,36,0.22); border-radius:var(--v3-radius-card); padding:14px; display:flex; gap:12px; align-items:flex-start;">
        <span class="material-symbols-outlined" style="color:var(--v3-amber); font-size:22px; flex-shrink:0;">medical_information</span>
        <p style="font-size:12px; line-height:1.5; color:var(--v3-text-70); margin:0;">Estas recomendaciones son orientativas. Consulta siempre con un profesional de la salud antes de iniciar cualquier suplementación.</p>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:12px;">
          <div class="v3-eyebrow" style="font-size:9.5px;">Peso</div>
          <div id="supProfileWeight" class="v3-num-mono" style="font-size:18px; margin-top:2px;">--</div>
        </div>
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:12px;">
          <div class="v3-eyebrow" style="font-size:9.5px;">Objetivo</div>
          <div id="supProfileGoal" style="font-size:14px; font-weight:700; color:var(--v3-text); margin-top:2px;">--</div>
        </div>
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:12px;">
          <div class="v3-eyebrow" style="font-size:9.5px;">Entrenamiento</div>
          <div id="supProfileExercise" style="font-size:14px; font-weight:700; color:var(--v3-text); margin-top:2px;">--</div>
        </div>
        <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:12px;">
          <div class="v3-eyebrow" style="font-size:9.5px;">Tiempo keto</div>
          <div id="supProfileKetoTime" style="font-size:14px; font-weight:700; color:var(--v3-text); margin-top:2px;">--</div>
        </div>
      </div>

      <section id="supTomarAhoraSection" class="hidden">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
          <p class="v3-eyebrow" style="margin:0;">Tomar ahora · <span id="supTomarAhoraContext"></span></p>
          <span id="supTomarAhoraCount" class="v3-chip" style="font-size:10px;"></span>
        </div>
        <div id="supTomarAhoraList" style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-card); padding:2px var(--v3-pad-card);"></div>
      </section>

      <section>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
          <p class="v3-eyebrow" style="margin:0;">Tus suplementos activos</p>
          <span id="supCurrentCount" class="v3-chip v3-chip--verdict-lime" style="font-size:10px;">0 activos</span>
        </div>
        <div id="supCurrentList" style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-card); padding:2px var(--v3-pad-card);">
          <p style="font-size:12px; color:var(--v3-text-40); padding:14px 0; text-align:center;">No tienes suplementos registrados.</p>
        </div>
      </section>

      <section>
        <p class="v3-eyebrow" style="margin-bottom:10px;">Explorar por categoría</p>
        <div class="v3-chip-group" id="supCategoryChips">
          <button type="button" class="v3-chip v3-chip--active" data-category="all">Todos</button>
          <button type="button" class="v3-chip" data-category="esencial">Esenciales</button>
          <button type="button" class="v3-chip" data-category="rendimiento">Rendimiento</button>
          <button type="button" class="v3-chip" data-category="control">Control peso</button>
          <button type="button" class="v3-chip" data-category="salud">Salud general</button>
        </div>
      </section>

      <section>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
          <p class="v3-eyebrow" style="margin:0;">Recomendados para ti</p>
          <button type="button" id="supRefreshBtn" class="v3-chip" style="cursor:pointer;">
            <span class="material-symbols-outlined" style="font-size:14px;">refresh</span>
          </button>
        </div>
        <div id="supRecommendedList" style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-card); padding:2px var(--v3-pad-card);">
          <p style="font-size:12px; color:var(--v3-text-40); padding:14px 0; text-align:center;">Analizando tu perfil…</p>
        </div>
      </section>

      <button type="button" id="supAddBtn" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); width:100%; justify-content:center;">
        <span class="material-symbols-outlined" style="font-size:18px">add_circle</span> Agregar suplemento
      </button>

    </main>

    <VeredictoSheet />
    <Sheet id="v3-sheet-add-supplement" title="Agregar suplemento" subtitle="Toca uno para añadirlo a tu stack">
      <div id="supModalList" style="display:flex; flex-direction:column; gap:8px; max-height:60vh; overflow-y:auto;"></div>
    </Sheet>
    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>
      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>
    <Dock active="yo" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/modules/supplement-recommender.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    var supplementColors = {
      esencial:    { icon: 'star',           color: 'var(--v3-amber)' },
      rendimiento: { icon: 'bolt',           color: 'var(--v3-orange-soft)' },
      control:     { icon: 'trending_down',  color: 'var(--v3-lime)' },
      salud:       { icon: 'health_and_safety', color: 'var(--v3-violet)' }
    };
    var supCategoryFilter = 'all';

    function loadSupplementData() {
      var data = getSupplementRecommendations();
      var goalLabels = { salud:'Salud', perdida_peso:'Pérdida peso', musculo:'Ganar músculo', mantenimiento:'Mantenimiento', lose:'Perder grasa', gain:'Ganar músculo', maintain:'Mantener', strength:'Fuerza' };
      document.getElementById('supProfileWeight').textContent = (data.profile.weight || '--') + ' kg';
      document.getElementById('supProfileGoal').textContent = goalLabels[data.profile.goal] || 'Salud';
      document.getElementById('supProfileExercise').textContent = data.profile.activityLevel || (data.profile.hasExercise ? (data.profile.workoutDays + ' días/sem') : 'No');
      document.getElementById('supProfileKetoTime').textContent = (data.profile.monthsOnKeto || '--') + ' meses';

      var currentEl = document.getElementById('supCurrentList');
      if (data.current && data.current.length > 0) {
        document.getElementById('supCurrentCount').textContent = data.current.length + ' activos';
        currentEl.innerHTML = data.current.map(function (sup, i) { return renderSupRow(sup, true, i === data.current.length - 1); }).join('');
      } else {
        document.getElementById('supCurrentCount').textContent = '0 activos';
        currentEl.innerHTML = '<p style="font-size:12px; color:var(--v3-text-40); padding:14px 0; text-align:center;">No tienes suplementos registrados.</p>';
      }

      window._supAllRecommended = data.recommended || [];
      renderRecommended();
    }

    function renderRecommended() {
      var recEl = document.getElementById('supRecommendedList');
      var list = window._supAllRecommended || [];
      if (supCategoryFilter !== 'all') list = list.filter(function (s) { return s.category === supCategoryFilter; });

      if (list.length > 0) {
        recEl.innerHTML = list.map(function (sup, i) { return renderSupRow(sup, false, i === list.length - 1); }).join('');
      } else if ((window._supAllRecommended || []).length === 0) {
        recEl.innerHTML = '<p style="font-size:12px; color:var(--v3-text-40); padding:14px 0; text-align:center;">¡Genial! Tienes todas las recomendaciones cubiertas.</p>';
      } else {
        recEl.innerHTML = '<p style="font-size:12px; color:var(--v3-text-40); padding:14px 0; text-align:center;">Sin resultados en esta categoría.</p>';
      }
    }

    function renderSupRow(sup, isCurrent, isLast) {
      var catInfo = supplementColors[sup.category] || supplementColors.salud;
      var action = isCurrent ? 'delete' : 'add';
      var html = '<div class="v3-row-wrap" data-sup-row data-sup-id="' + sup.id + '" data-sup-action="' + action + '">';
      if (isCurrent) {
        html += '<div class="v3-row-actions"><button type="button" class="v3-row-action v3-row-action--delete" data-row-action="delete" style="width:100%;">Borrar</button></div>';
      }
      html += '<div class="v3-row" style="' + (isLast ? '' : '') + (isCurrent ? '' : 'cursor:pointer;') + '">';
      html += '<div class="v3-row-content">';
      html += '<span class="v3-row-lead"><span class="material-symbols-outlined" style="color:' + catInfo.color + ';">' + catInfo.icon + '</span></span>';
      html += '<div class="v3-row-body">';
      html += '<div class="v3-row-title">' + escapeHtml(sup.name) + '</div>';
      html += '<div class="v3-row-meta">' + escapeHtml(sup.dosage || '') + (sup.timing ? ' · ' + escapeHtml(sup.timing) : '') + '</div>';
      html += '</div>';
      if (!isCurrent) html += '<span class="material-symbols-outlined" style="color:var(--v3-lime); font-size:20px;">add_circle</span>';
      html += '</div></div></div>';
      return html;
    }

    function addUserSupplement(supId) {
      var data = getSupplementRecommendations();
      var sup = (window._supAllRecommended || data.recommended).find(function (s) { return String(s.id) === String(supId); });
      if (sup) {
        addSupplementToUserList(sup);
        loadSupplementData();
        showToast(sup.name + ' agregado', 2000, 'success');
      } else {
        showToast('Suplemento no encontrado', 2000, 'error');
      }
    }

    function removeUserSupplement(supId) {
      removeSupplementFromUserList(supId);
      loadSupplementData();
      showToast('Suplemento eliminado', 2000, 'info');
    }

    async function loadSupplementsFromSupabase() {
      var headers = {
        'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxtYnF6c29udWp3dnFtZmhqamdmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzMyNTQzMDAsImV4cCI6MjA4ODgzMDMwMH0.SBsTQCh844rtGx0wLNZaEGO8NDmAVZjUj1YiDkRSm1k',
        'Authorization': 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxtYnF6c29udWp3dnFtZmhqamdmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzMyNTQzMDAsImV4cCI6MjA4ODgzMDMwMH0.SBsTQCh844rtGx0wLNZaEGO8NDmAVZjUj1YiDkRSm1k'
      };
      try {
        var response = await fetch('https://lmbqzsonujwvqmfhjjgf.supabase.co/rest/v1/suplementos?activo=eq.true&select=*&order=nombre.asc', { headers: headers });
        var data = await response.json();
        if (data && data.length > 0) return data;
      } catch (e) {
        console.error('Error cargando suplementos:', e);
      }
      return [];
    }

    function mapSuplementoCategory(cat) {
      var map = { mineral:'esencial', vitamina:'esencial', proteina:'rendimiento', aminoacido:'rendimiento', creatina:'rendimiento', cetogenico:'control', acido_graso:'control', quemador:'control', adaptogeno:'salud', hormona:'salud', digestivo:'salud', estimulante:'rendimiento' };
      return map[cat] || 'salud';
    }

    async function openAddSupplementSheet() {
      var allSupplements = [];
      if (typeof supplementRecommender !== 'undefined') {
        var db = supplementRecommender.supplementsDB;
        ['essential', 'performance', 'weight', 'general'].forEach(function (k) {
          if (db[k]) Object.values(db[k]).forEach(function (s) { allSupplements.push(s); });
        });
      }
      var supabaseSupps = await loadSupplementsFromSupabase();
      supabaseSupps.forEach(function (s) {
        allSupplements.push({ id: s.id, name: s.nombre, category: mapSuplementoCategory(s.categoria), dosage: s.dosis_recomendada || '', description: s.beneficios || '', timing: 'diario', priority: 'media', source: 'cloud' });
      });
      window._supAllRecommended = window._supAllRecommended && window._supAllRecommended.length ? window._supAllRecommended : allSupplements;

      var html = '';
      allSupplements.forEach(function (sup) {
        var catInfo = supplementColors[sup.category] || supplementColors.salud;
        html += '<div data-sup-modal-id="' + sup.id + '" style="display:flex; align-items:center; gap:12px; background:var(--v3-surface-2); border:1px solid var(--v3-border); border-radius:12px; padding:12px; cursor:pointer;">';
        html += '<span class="material-symbols-outlined" style="color:' + catInfo.color + ';">' + catInfo.icon + '</span>';
        html += '<div style="flex:1;"><div style="font-size:13.5px; font-weight:700; color:var(--v3-text);">' + escapeHtml(sup.name) + '</div><div style="font-size:11px; color:var(--v3-text-40);">' + escapeHtml(sup.dosage || sup.timing || 'diario') + '</div></div>';
        html += '<span class="material-symbols-outlined" style="color:var(--v3-lime); font-size:18px;">add_circle</span>';
        html += '</div>';
      });
      document.getElementById('supModalList').innerHTML = html || '<p style="text-align:center; color:var(--v3-text-40); padding:20px 0;">No hay suplementos disponibles</p>';
      window._supModalCache = allSupplements;
      if (window.KetoSheet) window.KetoSheet.toggle('v3-sheet-add-supplement');
    }

    function renderTomarAhora() {
      var hour = new Date().getHours();
      var supls = safeParseJSON(localStorage.getItem('user_supplements'), []);
      var section = document.getElementById('supTomarAhoraSection');
      if (!supls.length) { section.classList.add('hidden'); return; }

      var timeLabel, matchFn;
      if (hour >= 6 && hour < 10) {
        timeLabel = 'Mañana · con el desayuno';
        matchFn = function (s) { var t = (s.timing || '').toLowerCase(); return t.includes('desayuno') || t.includes('mañana') || t.includes('con comida') || t.includes('vitamina') || t.includes('omega') || t.includes('colageno') || t.includes('multivit'); };
      } else if (hour >= 10 && hour < 12) {
        timeLabel = 'Media mañana · pre-entreno';
        matchFn = function (s) { var t = (s.timing || '').toLowerCase(); return t.includes('pre') || t.includes('entreno') || t.includes('cafeina') || t.includes('carnitina') || t.includes('bcaa'); };
      } else if (hour >= 12 && hour < 15) {
        timeLabel = 'Mediodía · con el almuerzo';
        matchFn = function (s) { var t = (s.timing || '').toLowerCase(); return t.includes('almuerzo') || t.includes('comida') || t.includes('electro') || t.includes('creatina'); };
      } else if (hour >= 15 && hour < 19) {
        timeLabel = 'Tarde · post-entreno o con cena';
        matchFn = function (s) { var t = (s.timing || '').toLowerCase(); return t.includes('post') || t.includes('cena') || t.includes('tarde') || t.includes('creatina'); };
      } else {
        timeLabel = 'Noche · antes de dormir';
        matchFn = function (s) { var t = (s.timing || '').toLowerCase(); return t.includes('dormir') || t.includes('noche') || t.includes('magnesio'); };
      }

      var matches = supls.filter(matchFn);
      if (!matches.length) { section.classList.add('hidden'); return; }
      section.classList.remove('hidden');

      var today = new Date().toISOString().slice(0, 10);
      var taken = safeParseJSON(localStorage.getItem('suple_taken_' + today), {});

      document.getElementById('supTomarAhoraContext').textContent = timeLabel;
      document.getElementById('supTomarAhoraCount').textContent = matches.length + ' suplemento' + (matches.length > 1 ? 's' : '');

      document.getElementById('supTomarAhoraList').innerHTML = matches.map(function (s, i) {
        var id = s.id || s.name;
        var isTaken = !!taken[id];
        var last = i === matches.length - 1;
        return '<div class="v3-row" style="' + (last ? 'border-bottom:none;' : '') + ' cursor:pointer;" data-sup-toggle="' + escapeHtml(String(id)) + '">' +
          '<div class="v3-row-content v3-row-content--' + (isTaken ? 'done' : 'pending') + '">' +
          '<span class="v3-row-lead"><span class="material-symbols-outlined">' + (isTaken ? 'check_circle' : 'radio_button_unchecked') + '</span></span>' +
          '<div class="v3-row-body"><div class="v3-row-title">' + escapeHtml(s.name) + '</div><div class="v3-row-meta">' + escapeHtml(s.dosage || '') + '</div></div>' +
          '<span style="font-size:10px; font-weight:700; color:' + (isTaken ? 'var(--v3-lime)' : 'var(--v3-text-40)') + ';">' + (isTaken ? '✓' : 'Tomar') + '</span>' +
          '</div></div>';
      }).join('');
    }

    function toggleSupleNow(id) {
      var today = new Date().toISOString().slice(0, 10);
      var taken = safeParseJSON(localStorage.getItem('suple_taken_' + today), {});
      taken[id] = !taken[id];
      localStorage.setItem('suple_taken_' + today, JSON.stringify(taken));
      renderTomarAhora();
    }

    document.addEventListener('DOMContentLoaded', function () {
      loadSupplementData();
      renderTomarAhora();

      document.getElementById('supAddBtn').addEventListener('click', openAddSupplementSheet);
      document.getElementById('supRefreshBtn').addEventListener('click', function () { loadSupplementData(); showToast('Recomendaciones actualizadas', 2000, 'success'); });

      document.getElementById('supCategoryChips').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-category]');
        if (!btn) return;
        supCategoryFilter = btn.getAttribute('data-category');
        document.querySelectorAll('#supCategoryChips .v3-chip').forEach(function (c) { c.classList.toggle('v3-chip--active', c === btn); });
        renderRecommended();
      });

      document.getElementById('supCurrentList').addEventListener('click', function (e) {
        var wrap = e.target.closest('[data-sup-row]');
        if (!wrap) return;
        if (e.target.closest('[data-row-action="delete"]')) {
          removeUserSupplement(wrap.getAttribute('data-sup-id'));
        }
      });
      document.getElementById('supRecommendedList').addEventListener('click', function (e) {
        var wrap = e.target.closest('[data-sup-row]');
        if (!wrap) return;
        addUserSupplement(wrap.getAttribute('data-sup-id'));
      });

      document.getElementById('supModalList').addEventListener('click', function (e) {
        var item = e.target.closest('[data-sup-modal-id]');
        if (!item) return;
        addUserSupplement(item.getAttribute('data-sup-modal-id'));
        if (window.KetoSheet) window.KetoSheet.toggle('v3-sheet-add-supplement');
      });

      document.getElementById('supTomarAhoraList').addEventListener('click', function (e) {
        var row = e.target.closest('[data-sup-toggle]');
        if (!row) return;
        toggleSupleNow(row.getAttribute('data-sup-toggle'));
      });

      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) { loadSupplementData(); renderTomarAhora(); }
      });
    });
  </script>
</AppLayout>
