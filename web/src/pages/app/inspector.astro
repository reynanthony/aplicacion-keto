---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Inspector Inteligente" authGuard={true}>
<style is:global>
html, body { margin: 0; padding: 0; background: #0b0a08; color: #f7f4f0; font-family: 'Inter', sans-serif; }
.material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
.icon-filled { font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24; }

@keyframes scanLine {
  0%   { transform: translateY(-100%); opacity: 0; }
  20%  { opacity: 0.6; }
  80%  { opacity: 0.6; }
  100% { transform: translateY(100%); opacity: 0; }
}
@keyframes barGrow {
  from { width: 0 !important; }
  to   { width: var(--bar-w); }
}
@keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
@keyframes pulseGreen { 0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,0.3)} 50%{box-shadow:0 0 16px 4px rgba(34,197,94,0.15)} }

.fade-up { animation: fadeUp 0.4s ease-out forwards; }
.ik-card {
  background: #161310;
  border: 1px solid rgba(255,240,225,0.07);
  border-radius: 20px;
}
.metric-bar-bg { background: rgba(255,240,225,0.05); border-radius: 100px; height: 6px; overflow: hidden; }
.metric-bar    { height: 6px; border-radius: 100px; transition: width 1s cubic-bezier(.4,0,.2,1); }

.verdict-good    { background: rgba(34,197,94,0.06);  border-color: rgba(34,197,94,0.2)  !important; animation: pulseGreen 3s infinite; }
.verdict-warning { background: rgba(245,158,11,0.06); border-color: rgba(245,158,11,0.2) !important; }
.verdict-info    { background: rgba(96,165,250,0.06); border-color: rgba(96,165,250,0.2) !important; }

.period-tab { display:inline-flex;align-items:center;padding:5px 12px;border-radius:100px;font-size:11px;font-weight:700;cursor:pointer;border:1px solid transparent;transition:all 0.15s; }
.period-tab.active { background:rgba(255,77,0,0.12);color:#ff4d00;border-color:rgba(255,77,0,0.25); }
.period-tab:not(.active) { color:rgba(247,244,240,0.45);background:#1a1a1a;border-color:rgba(255,240,225,0.06); }

@media (min-width: 768px) {
  #inspMain {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
    padding-top: 3.5rem;
    padding-bottom: 3rem !important;
  }
  #inspMain > * { margin-top: 0 !important; }
  #insp-verdict   { grid-column: 1/-1; }
  #insp-alerts    { grid-column: 2; }
  #insp-metrics   { grid-column: 1; }
  #insp-adherence { grid-column: 1; }
  #insp-macros    { grid-column: 2; }
  #insp-weight    { grid-column: 1/-1; }
}
</style>

<!-- ── Header ─────────────────────────────────────────────────────────── -->
<header class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between px-4"
  style="height:56px;background:rgba(11,10,8,0.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,240,225,0.06)">

  <div class="flex items-center gap-3">
    <div class="relative w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
      style="background:rgba(255,77,0,0.1);border:1px solid rgba(255,77,0,0.2);overflow:hidden">
      <span class="material-symbols-outlined icon-filled" style="color:#ff4d00;font-size:20px">analytics</span>
      <div style="position:absolute;left:0;right:0;height:1px;background:linear-gradient(to right,transparent,rgba(255,77,0,0.8),transparent);animation:scanLine 2.5s ease-in-out infinite"></div>
    </div>
    <div>
      <h1 class="font-black text-base leading-none" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">Inspector Keto</h1>
      <p id="lastAnalyzed" style="font-size:9px;color:rgba(247,244,240,0.35);font-weight:600;margin-top:1px">Analizando...</p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <button onclick="refreshAnalysis()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold transition-all active:scale-95"
      style="background:rgba(255,77,0,0.12);color:#ff4d00;border:1px solid rgba(255,77,0,0.2)">
      <span class="material-symbols-outlined" style="font-size:14px">refresh</span>
      Analizar
    </button>
    <button onclick="toggleHamburgerMenu()" aria-label="Menú"
      class="w-9 h-9 rounded-full flex items-center justify-center"
      style="background:#161310;color:rgba(247,244,240,0.5);border:1px solid rgba(255,240,225,0.06)">
      <span class="material-symbols-outlined" style="font-size:20px">menu</span>
    </button>
  </div>
</header>

<!-- ── Main ───────────────────────────────────────────────────────────── -->
<main id="inspMain" class="main-content pt-14 pb-24 px-4 space-y-3" style="background:#0b0a08">

  <!-- Header editorial -->
  <div style="margin:10px 2px 16px">
    <div style="font-size:11px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#ff4d00;margin-bottom:10px">Inteligencia · Análisis</div>
    <h1 class="kc-h1" style="font-size:30px">El Inspector<br><span style="color:rgba(247,244,240,0.4)">cuida tu cetosis.</span></h1>
  </div>

  <!-- 1. Verdict card -->
  <section id="insp-verdict" class="ik-card p-4 fade-up">
    <div class="flex items-start gap-3">
      <div id="verdictIcon" class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0"
        style="background:rgba(247,244,240,0.06)">
        <span class="material-symbols-outlined icon-filled" style="color:#f7f4f0;font-size:22px">monitoring</span>
      </div>
      <div class="flex-1">
        <p id="verdictTitle" class="font-black text-lg leading-tight" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">Analizando tus datos...</p>
        <p id="verdictSub" class="text-xs mt-0.5 leading-relaxed" style="color:rgba(247,244,240,0.5)">El inspector está revisando tu progreso reciente.</p>
      </div>
      <div id="verdictScore" class="text-right flex-shrink-0">
        <p class="font-black text-2xl leading-none" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">—</p>
        <p class="text-[10px] font-bold mt-0.5" style="color:rgba(247,244,240,0.35)">puntos</p>
      </div>
    </div>
  </section>

  <!-- 2. Alerts from automation engine -->
  <section id="insp-alerts" class="space-y-2">
    <!-- Injected by JS -->
  </section>

  <!-- 3. Key metrics with animated bars -->
  <section id="insp-metrics" class="ik-card p-4 fade-up" style="animation-delay:0.07s">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-bold" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">Métricas Clave</h2>
      <div class="flex gap-1" id="periodTabs">
        <button class="period-tab active" onclick="setPeriod(7,this)">7d</button>
        <button class="period-tab"        onclick="setPeriod(14,this)">14d</button>
        <button class="period-tab"        onclick="setPeriod(30,this)">30d</button>
      </div>
    </div>
    <div id="metricsRows" class="space-y-3"></div>
  </section>

  <!-- 4. Adherence by period -->
  <section id="insp-adherence" class="ik-card p-4 fade-up" style="animation-delay:0.12s">
    <h2 class="text-sm font-bold mb-4" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">Adherencia al Plan</h2>
    <div id="adherenceGrid" class="grid grid-cols-3 gap-3 mb-4"></div>
    <!-- Weekly bar chart -->
    <div>
      <p class="text-xs mb-2 font-semibold" style="color:rgba(247,244,240,0.35)">Últimos 7 días</p>
      <div id="weekBars" class="flex gap-1.5 items-end" style="height:48px"></div>
      <div id="weekLabels" class="flex gap-1.5 mt-1"></div>
    </div>
  </section>

  <!-- 5. Macro compliance -->
  <section id="insp-macros" class="ik-card p-4 fade-up" style="animation-delay:0.17s">
    <h2 class="text-sm font-bold mb-3" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">Macros — Promedio <span id="macrosPeriodLabel">7 días</span></h2>
    <div id="macroRows" class="space-y-3"></div>
  </section>

  <!-- 6. Weight trend -->
  <section id="insp-weight" class="ik-card p-4 fade-up" style="animation-delay:0.22s">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-bold" style="color:#f7f4f0;font-family:'Plus Jakarta Sans',sans-serif">Tendencia de Peso</h2>
      <div id="weightTrendBadge" class="flex items-center gap-1 px-3 py-1 rounded-full" style="background:#1e1a15;border:1px solid rgba(255,240,225,0.06)">
        <span class="material-symbols-outlined" id="trendIcon" style="font-size:14px;color:rgba(247,244,240,0.4)">remove</span>
        <span id="trendLabel" style="font-size:10px;font-weight:700;color:rgba(247,244,240,0.4)">Sin datos</span>
      </div>
    </div>
    <!-- Mini SVG chart -->
    <div class="relative rounded-xl overflow-hidden" style="background:#111;height:80px">
      <svg id="weightChart" width="100%" height="80" viewBox="0 0 300 80" preserveAspectRatio="none">
        <defs>
          <linearGradient id="wGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#ff4d00" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#ff4d00" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path id="weightFill" d="" fill="url(#wGrad)"/>
        <path id="weightLine" d="" fill="none" stroke="#ff4d00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <p id="noWeightData" class="absolute inset-0 flex items-center justify-center text-xs" style="color:rgba(247,244,240,0.3)">
        Registra tu peso para ver la tendencia
      </p>
    </div>
    <div class="flex justify-between mt-2" id="weightStats"></div>
  </section>

</main>


<!-- ── Scripts ────────────────────────────────────────────────────────── -->
<script is:inline src="/app/modules/meal-plan.js"></script>
<script is:inline src="/app/modules/automation-engine.js"></script>
<script is:inline>
// ==================== INSPECTOR KETO — real app ====================

function safeJSON(k, d) {
  try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch(e) { return d; }
}

function daysAgo(n) {
  var d = new Date(); d.setDate(d.getDate() - n);
  return d.toISOString().slice(0, 10);
}

var _period = 7;

// ── Data readers ──────────────────────────────────────────────────────
function getWeightHistory() {
  var h = safeJSON('keto_weight_history', []);
  if (!Array.isArray(h)) return [];
  return h.slice().sort(function (a,b) { return a.date < b.date ? -1 : 1; });
}

function getDailyMacros(days) {
  var rows = [];
  for (var i = 0; i < days; i++) {
    var key  = daysAgo(i);
    var plan = safeJSON('mealPlan_' + key, {});
    var cal = 0, carbs = 0, prot = 0, fat = 0;
    var hasData = false;
    Object.keys(plan).forEach(function (meal) {
      if (!Array.isArray(plan[meal])) return;
      plan[meal].forEach(function (item) {
        var t = KetoMealPlan.itemTotals(item);
        cal   += t.calories;
        carbs += t.carbs;
        prot  += t.protein;
        fat   += t.fat;
        hasData = true;
      });
    });
    rows.push({ date: key, cal: Math.round(cal), carbs: Math.round(carbs), prot: Math.round(prot), fat: Math.round(fat), logged: hasData });
  }
  return rows;
}

function getMacrosTarget() {
  return safeJSON('keto_macros', { calories: 1800, protein: 150, fat: 140, carbs: 25 });
}

function getStreak() {
  return safeJSON('ketoStreak', { ketoDays: 0 });
}

// ── Analysis engine ───────────────────────────────────────────────────
function analyze(days) {
  var target  = getMacrosTarget();
  var wh      = getWeightHistory();
  var daily   = getDailyMacros(days);
  var streak  = getStreak();

  var loggedDays = daily.filter(function (d) { return d.logged; }).length;
  var adherence  = days > 0 ? Math.round((loggedDays / days) * 100) : 0;

  // Average macros from logged days only
  var logged = daily.filter(function (d) { return d.logged; });
  function avg(arr, key) {
    if (!arr.length) return 0;
    return Math.round(arr.reduce(function (s, d) { return s + d[key]; }, 0) / arr.length);
  }
  var avgCal   = avg(logged, 'cal');
  var avgCarbs = avg(logged, 'carbs');
  var avgProt  = avg(logged, 'prot');
  var avgFat   = avg(logged, 'fat');

  // Carb compliance %
  var carbPct  = target.carbs ? Math.round((avgCarbs / target.carbs) * 100) : 0;
  var protPct  = target.protein ? Math.round((avgProt  / target.protein) * 100) : 0;
  var calPct   = target.calories ? Math.round((avgCal / target.calories) * 100) : 0;

  // Weight trend
  var cutoff = daysAgo(days);
  var recent = wh.filter(function (e) { return e.date >= cutoff; });
  var weightTrend = 'stable';
  var weightDelta = 0;
  if (recent.length >= 2) {
    var first = parseFloat(recent[0].weight);
    var last  = parseFloat(recent[recent.length - 1].weight);
    weightDelta = Math.round((last - first) * 10) / 10;
    if (weightDelta < -0.3)      weightTrend = 'losing';
    else if (weightDelta > 0.3)  weightTrend = 'gaining';
    else                         weightTrend = 'stable';
  }

  // Overall score (0-100)
  var score = 0;
  score += Math.min(40, adherence * 0.4);         // adherence up to 40 pts
  score += carbPct <= 100 ? 20 : Math.max(0, 20 - (carbPct - 100) * 0.5);  // carbs compliance
  score += Math.min(20, (protPct / 100) * 20);    // protein
  if (weightTrend === 'losing') score += 20;
  else if (weightTrend === 'stable' && adherence >= 70) score += 10;
  score = Math.min(100, Math.round(score));

  return {
    days, adherence, loggedDays,
    avgCal, avgCarbs, avgProt, avgFat,
    carbPct, protPct, calPct,
    weightTrend, weightDelta, weightHistory: wh,
    streak: parseInt(streak.ketoDays) || 0,
    score,
    target
  };
}

// ── Render helpers ────────────────────────────────────────────────────
function pct(n, max) { return Math.min(100, Math.round((n / max) * 100)); }

function metricRow(label, value, unit, pct, color, subtitle) {
  var barPct = Math.min(100, pct);
  return '<div>' +
    '<div class="flex items-center justify-between mb-1">' +
      '<p class="text-xs font-semibold" style="color:rgba(247,244,240,0.7)">' + label + '</p>' +
      '<p class="text-xs font-bold" style="color:' + color + '">' + value + '<span style="font-size:10px;color:rgba(247,244,240,0.35);font-weight:400"> ' + unit + '</span></p>' +
    '</div>' +
    '<div class="metric-bar-bg"><div class="metric-bar" style="width:0;--bar-w:' + barPct + '%;background:' + color + '" data-pct="' + barPct + '"></div></div>' +
    (subtitle ? '<p style="font-size:9px;color:rgba(247,244,240,0.3);margin-top:3px">' + subtitle + '</p>' : '') +
  '</div>';
}

// ── Render verdict ────────────────────────────────────────────────────
function renderVerdict(data) {
  var icon = document.getElementById('verdictIcon');
  var title = document.getElementById('verdictTitle');
  var sub   = document.getElementById('verdictSub');
  var scoreEl = document.getElementById('verdictScore');
  var section = document.getElementById('insp-verdict');
  if (!title) return;

  var cfg;
  if (data.score >= 80) {
    cfg = {
      iconName: 'verified', iconColor: '#22c55e', titleColor: '#22c55e',
      t: 'Progreso Excelente',
      s: 'Tus métricas están en rango óptimo. Mantén esta consistencia para maximizar la pérdida de grasa.',
      cls: 'verdict-good'
    };
  } else if (data.score >= 60) {
    cfg = {
      iconName: 'trending_up', iconColor: '#60a5fa', titleColor: '#60a5fa',
      t: 'Buen Progreso',
      s: 'Vas por buen camino. Hay algunas áreas donde puedes mejorar para acelerar tus resultados.',
      cls: 'verdict-info'
    };
  } else if (data.score >= 40) {
    cfg = {
      iconName: 'warning', iconColor: '#f59e0b', titleColor: '#f59e0b',
      t: 'Requiere Atención',
      s: 'Detecté oportunidades de mejora en tu adherencia o macros. Consulta al Coach para un plan correctivo.',
      cls: 'verdict-warning'
    };
  } else {
    cfg = {
      iconName: 'error', iconColor: '#f87171', titleColor: '#f87171',
      t: 'Acción Recomendada',
      s: 'Tu adherencia o macros necesitan ajuste. El Coach IA puede ayudarte a retomar el rumbo.',
      cls: 'verdict-warning'
    };
  }

  section.className = 'ik-card p-4 fade-up ' + cfg.cls;
  icon.innerHTML = '<span class="material-symbols-outlined icon-filled" style="color:' + cfg.iconColor + ';font-size:22px">' + cfg.iconName + '</span>';
  icon.style.background = 'transparent';
  title.style.color = cfg.titleColor;
  title.textContent = cfg.t;
  sub.textContent   = cfg.s;
  scoreEl.innerHTML = '<p class="font-black text-2xl leading-none" style="color:' + cfg.iconColor + ';font-family:\'Plus Jakarta Sans\',sans-serif">' + data.score + '</p><p class="text-[10px] font-bold mt-0.5" style="color:rgba(247,244,240,0.35)">/ 100</p>';
}

// ── Render metrics ────────────────────────────────────────────────────
function renderMetrics(data) {
  var rows = document.getElementById('metricsRows');
  if (!rows) return;

  var t = data.target;
  rows.innerHTML = [
    metricRow('Calorías promedio', data.avgCal, 'kcal',
      pct(data.avgCal, t.calories || 1800), '#60a5fa',
      'Meta: ' + (t.calories || 1800) + ' kcal · ' + data.calPct + '% del objetivo'),
    metricRow('Carbohidratos promedio', data.avgCarbs, 'g',
      pct(data.avgCarbs, (t.carbs || 25) * 1.5), data.carbPct <= 100 ? '#22c55e' : '#f59e0b',
      'Meta: ' + (t.carbs || 25) + 'g · ' + (data.carbPct <= 100 ? 'Dentro del límite' : data.carbPct + '% del objetivo')),
    metricRow('Proteína promedio', data.avgProt, 'g',
      pct(data.avgProt, t.protein || 150), '#a78bfa',
      'Meta: ' + (t.protein || 150) + 'g · ' + data.protPct + '% del objetivo'),
    metricRow('Adherencia al plan', data.adherence, '%',
      data.adherence, '#ff4d00',
      data.loggedDays + ' de ' + data.days + ' días registrados'),
  ].join('');

  animateBars(rows);
}

// ── Render adherence ─────────────────────────────────────────────────
function renderAdherence() {
  var grid = document.getElementById('adherenceGrid');
  if (!grid) return;

  var periods = [7, 14, 30];
  grid.innerHTML = periods.map(function (d) {
    var daily = getDailyMacros(d);
    var logged = daily.filter(function (x) { return x.logged; }).length;
    var pctVal = Math.round((logged / d) * 100);
    var color = pctVal >= 80 ? '#22c55e' : pctVal >= 60 ? '#f59e0b' : '#f87171';
    return '<div class="text-center">' +
      '<p class="font-black text-xl leading-none" style="color:' + color + ';font-family:\'Plus Jakarta Sans\',sans-serif">' + pctVal + '%</p>' +
      '<p style="font-size:9px;color:rgba(247,244,240,0.35);margin-top:4px;font-weight:600">Últimos ' + d + 'd</p>' +
      '<p style="font-size:8px;color:rgba(247,244,240,0.22);margin-top:2px">' + logged + '/' + d + ' días</p>' +
    '</div>';
  }).join('');

  // Weekly bars
  renderWeekBars();
}

function renderWeekBars() {
  var container = document.getElementById('weekBars');
  var labels    = document.getElementById('weekLabels');
  if (!container || !labels) return;

  var days  = ['D','L','M','Mi','J','V','S'];
  var daily = getDailyMacros(7);
  daily.reverse(); // oldest first

  container.innerHTML = '';
  labels.innerHTML    = '';

  daily.forEach(function (d, i) {
    var isToday = i === daily.length - 1;
    var color   = d.logged ? (isToday ? '#ff4d00' : '#22c55e') : 'rgba(255,240,225,0.07)';
    var h       = d.logged ? Math.max(12, Math.min(48, Math.round((d.cal / 2000) * 48))) : 12;

    var bar = document.createElement('div');
    bar.style.cssText = 'flex:1;background:' + color + ';border-radius:4px 4px 0 0;height:' + h + 'px;min-height:4px;transition:height 0.6s ease';
    bar.title = d.date + (d.logged ? ' · ' + d.cal + ' kcal' : ' · Sin registro');
    container.appendChild(bar);

    var label = document.createElement('div');
    label.style.cssText = 'flex:1;text-align:center;font-size:8px;font-weight:600;color:' +
      (isToday ? '#ff4d00' : 'rgba(247,244,240,0.3)');
    var dateObj = new Date(d.date + 'T12:00:00');
    label.textContent = days[dateObj.getDay()];
    labels.appendChild(label);
  });
}

// ── Render macro compliance ───────────────────────────────────────────
function renderMacros(data) {
  var rows   = document.getElementById('macroRows');
  var plabel = document.getElementById('macrosPeriodLabel');
  if (!rows) return;
  if (plabel) plabel.textContent = data.days + ' días';

  var t = data.target;
  rows.innerHTML = [
    metricRow('Calorías', data.avgCal + ' / ' + (t.calories || 1800), 'kcal',
      pct(data.avgCal, t.calories || 1800),
      Math.abs(data.calPct - 100) <= 15 ? '#22c55e' : '#f59e0b', null),
    metricRow('Carbohidratos', data.avgCarbs + ' / ' + (t.carbs || 25), 'g',
      pct(data.avgCarbs, (t.carbs || 25) * 1.5),
      data.avgCarbs <= (t.carbs || 25) ? '#22c55e' : '#f59e0b', null),
    metricRow('Proteína', data.avgProt + ' / ' + (t.protein || 150), 'g',
      pct(data.avgProt, t.protein || 150),
      data.protPct >= 80 ? '#a78bfa' : '#f59e0b', null),
    metricRow('Grasa', data.avgFat + ' / ' + (t.fat || 140), 'g',
      pct(data.avgFat, t.fat || 140),
      '#60a5fa', null),
  ].join('');

  animateBars(rows);
}

// ── Render weight trend ───────────────────────────────────────────────
function renderWeightTrend(data) {
  var badge = document.getElementById('weightTrendBadge');
  var icon  = document.getElementById('trendIcon');
  var label = document.getElementById('trendLabel');
  var noData = document.getElementById('noWeightData');
  var stats = document.getElementById('weightStats');

  if (data.weightHistory.length < 2) {
    if (noData) noData.style.display = 'flex';
    return;
  }
  if (noData) noData.style.display = 'none';

  var cfg = {
    losing:  { icon: 'trending_down', color: '#22c55e', label: 'Bajando',  bg: 'rgba(34,197,94,0.1)',   border: 'rgba(34,197,94,0.2)' },
    gaining: { icon: 'trending_up',   color: '#f87171', label: 'Subiendo', bg: 'rgba(248,113,113,0.1)', border: 'rgba(248,113,113,0.2)' },
    stable:  { icon: 'remove',        color: '#f59e0b', label: 'Estable',  bg: 'rgba(245,158,11,0.1)',  border: 'rgba(245,158,11,0.2)' }
  }[data.weightTrend];

  if (badge) badge.style.cssText = 'display:flex;align-items:center;gap:4px;padding:4px 10px;border-radius:100px;background:' + cfg.bg + ';border:1px solid ' + cfg.border;
  if (icon)  { icon.textContent = cfg.icon; icon.style.color = cfg.color; }
  if (label) { label.textContent = cfg.label; label.style.color = cfg.color; }

  // Draw SVG chart
  var wh      = data.weightHistory.slice(-20);
  var weights = wh.map(function (e) { return parseFloat(e.weight); });
  var minW    = Math.min.apply(null, weights);
  var maxW    = Math.max.apply(null, weights);
  var range   = Math.max(maxW - minW, 0.5);

  var W = 300, H = 80, pad = 8;
  var pts = weights.map(function (w, i) {
    var x = pad + (i / (weights.length - 1)) * (W - pad * 2);
    var y = H - pad - ((w - minW) / range) * (H - pad * 2);
    return [x, y];
  });

  var linePath = 'M ' + pts.map(function (p) { return p[0] + ' ' + p[1]; }).join(' L ');
  var fillPath = linePath + ' L ' + pts[pts.length-1][0] + ' ' + (H - pad) + ' L ' + pts[0][0] + ' ' + (H - pad) + ' Z';

  var lineEl = document.getElementById('weightLine');
  var fillEl = document.getElementById('weightFill');
  if (lineEl) lineEl.setAttribute('d', linePath);
  if (fillEl) fillEl.setAttribute('d', fillPath);

  // Stats row
  if (stats) {
    var first = weights[0], last = weights[weights.length - 1];
    var delta = Math.round((last - first) * 10) / 10;
    stats.innerHTML =
      '<div class="text-center"><p class="font-bold text-sm" style="color:#f7f4f0">' + first + 'kg</p><p style="font-size:9px;color:rgba(247,244,240,0.35)">Inicio</p></div>' +
      '<div class="text-center"><p class="font-bold text-sm" style="color:' + cfg.color + '">' + (delta > 0 ? '+' : '') + delta + 'kg</p><p style="font-size:9px;color:rgba(247,244,240,0.35)">Cambio</p></div>' +
      '<div class="text-center"><p class="font-bold text-sm" style="color:#f7f4f0">' + last + 'kg</p><p style="font-size:9px;color:rgba(247,244,240,0.35)">Actual</p></div>';
  }
}

// ── Render alerts ─────────────────────────────────────────────────────
var ALERT_STYLES = {
  warning: { bg:'rgba(245,158,11,0.08)',border:'rgba(245,158,11,0.2)', icon:'#f59e0b' },
  error:   { bg:'rgba(239,68,68,0.08)', border:'rgba(239,68,68,0.22)', icon:'#ef4444' },
  success: { bg:'rgba(34,197,94,0.08)', border:'rgba(34,197,94,0.2)',  icon:'#22c55e' },
  info:    { bg:'rgba(96,165,250,0.08)',border:'rgba(96,165,250,0.2)', icon:'#60a5fa' }
};

function renderAlerts() {
  var section = document.getElementById('insp-alerts');
  if (!section) return;
  var alerts = window.KetoAutomations ? KetoAutomations.getAlerts() : [];
  if (!alerts.length) { section.innerHTML = ''; return; }

  section.innerHTML = alerts.slice(0, 4).map(function (a) {
    var s = ALERT_STYLES[a.type] || ALERT_STYLES.info;
    var btn = a.action === 'ask_coach'
      ? '<a href="/app/coach" class="mt-2 inline-flex items-center gap-1 text-[11px] font-bold px-3 py-1.5 rounded-full" style="background:rgba(255,77,0,0.1);color:#ff4d00;border:1px solid rgba(255,77,0,0.2)"><span class="material-symbols-outlined icon-filled" style="font-size:13px">psychology</span>' + (a.actionLabel || 'Coach') + '</a>'
      : '';
    return '<div class="ik-card p-3.5" style="background:' + s.bg + ';border-color:' + s.border + '">' +
      '<div class="flex items-start gap-2.5">' +
        '<span class="material-symbols-outlined icon-filled flex-shrink-0" style="font-size:18px;color:' + s.icon + ';margin-top:1px">' + (a.icon||'info') + '</span>' +
        '<div class="flex-1">' +
          '<p class="text-xs font-bold" style="color:#f7f4f0">' + (a.title||'') + '</p>' +
          '<p class="text-xs mt-0.5 leading-relaxed" style="color:rgba(247,244,240,0.55)">' + (a.message||'') + '</p>' +
          btn +
        '</div>' +
        '<button onclick="dismissAlert(\'' + (a.id||'') + '\')" class="material-symbols-outlined flex-shrink-0" style="color:rgba(247,244,240,0.25);font-size:16px">close</button>' +
      '</div></div>';
  }).join('');
}

function dismissAlert(id) {
  if (window.KetoAutomations) KetoAutomations.clearAlert(id);
  renderAlerts();
}

// ── Animate bars ──────────────────────────────────────────────────────
function animateBars(container) {
  if (!container) return;
  var bars = container.querySelectorAll('[data-pct]');
  bars.forEach(function (bar) {
    bar.style.width = '0';
    setTimeout(function () {
      bar.style.width = bar.getAttribute('data-pct') + '%';
    }, 80);
  });
}

// ── Period switch ─────────────────────────────────────────────────────
function setPeriod(days, btn) {
  _period = days;
  document.querySelectorAll('.period-tab').forEach(function (t) { t.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  runAnalysis();
}

// ── Full analysis run ─────────────────────────────────────────────────
function runAnalysis() {
  var data = analyze(_period);
  renderVerdict(data);
  renderMetrics(data);
  renderMacros(data);
  renderWeightTrend(data);
  renderAdherence();

  var el = document.getElementById('lastAnalyzed');
  if (el) el.textContent = 'Análisis de ' + _period + ' días · ' + new Date().toLocaleTimeString('es', { hour:'2-digit', minute:'2-digit' });
}

function refreshAnalysis() {
  if (window.KetoAutomations) { KetoAutomations.check(); renderAlerts(); }
  runAnalysis();
}

// ── Init ──────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {
  if (window.KetoAutomations) {
    KetoAutomations.autoRun();
    renderAlerts();
    KetoAutomations.on('alerts', renderAlerts);
  }
  runAnalysis();
});
</script>

</AppLayout>
