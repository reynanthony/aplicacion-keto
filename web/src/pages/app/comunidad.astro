---
import AppLayout from '../../layouts/AppLayout.astro';
import AppNav from '../../components/AppNav.astro';
---

<AppLayout title="KetoCore | Comunidad" authGuard={true}>
<style is:global>
*{box-sizing:border-box}
body{background:#0a0a0a;color:#fff;font-family:'Inter',sans-serif;min-height:100vh;}
.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px)}
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
.glass{background:rgba(22,22,22,0.85);border:1px solid rgba(255,255,255,0.07);backdrop-filter:blur(16px)}
.feed-card{background:#161616;border:1px solid rgba(255,255,255,0.06);border-radius:1rem}
.avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;flex-shrink:0}
@keyframes shimmer{0%{opacity:0.4}50%{opacity:0.7}100%{opacity:0.4}}
.coming-soon-blur{filter:blur(3px);pointer-events:none;user-select:none}
.coming-soon-overlay{position:relative}
.coming-soon-overlay::after{content:"Próximamente";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(10,10,10,0.55);border-radius:inherit;font-weight:800;font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.5);backdrop-filter:blur(1px)}
</style>
<!-- TopBar -->
<header class="fixed top-0 left-0 right-0 z-40 h-14 flex items-center justify-between px-4 border-b border-white/5" style="background:rgba(10,10,10,0.95);backdrop-filter:blur(20px)">
  <a href="/app/" class="flex items-center gap-3" style="text-decoration:none">
    <img src="/app/logo.svg" alt="KetoCore" class="w-8 h-8" style="filter:drop-shadow(0 0 6px rgba(255,77,0,0.4))">
    <h1 class="text-base font-headline font-black text-white">Comunidad</h1>
  </a>
  <div class="flex items-center gap-2">
    <span class="text-[10px] font-bold px-2 py-1 rounded-full" style="background:rgba(255,77,0,0.15);color:#ff4d00">BETA PRONTO</span>
    <button onclick="toggleHamburgerMenu()" aria-label="Menú" class="w-9 h-9 rounded-full flex items-center justify-center" style="background:rgba(255,255,255,0.05);color:rgba(245,245,245,0.6);border:1px solid rgba(255,255,255,0.06)">
      <span class="material-symbols-outlined" style="font-size:20px">menu</span>
    </button>
  </div>
</header>

<main class="main-content pt-14 pb-28 px-4 space-y-4">

  <!-- Mi tarjeta de comunidad -->
  <section class="glass rounded-2xl p-4 mt-2">
    <div class="flex items-center gap-3 mb-3">
      <div id="myAvatar" class="avatar text-white" style="background:linear-gradient(135deg,#ff4d00,#ffb300)">?</div>
      <div class="flex-1 min-w-0">
        <p id="myName" class="font-bold text-white text-sm">Tu perfil</p>
        <p class="text-on-surface-variant text-xs">Así te verán en la comunidad</p>
      </div>
      <span id="myBadge" class="text-[11px] font-bold px-2.5 py-1 rounded-full hidden" style="background:rgba(255,179,0,0.15);color:#ffb300"></span>
    </div>
    <div class="grid grid-cols-3 gap-2" id="myStats">
      <div class="bg-surface-container-highest rounded-xl p-3 text-center">
        <p id="statStreak" class="text-xl font-headline font-black text-primary-container">--</p>
        <p class="text-[9px] text-on-surface-variant uppercase tracking-wider mt-0.5">Racha</p>
      </div>
      <div class="bg-surface-container-highest rounded-xl p-3 text-center">
        <p id="statLost" class="text-xl font-headline font-black text-green-400">--</p>
        <p class="text-[9px] text-on-surface-variant uppercase tracking-wider mt-0.5">kg logrados</p>
      </div>
      <div class="bg-surface-container-highest rounded-xl p-3 text-center">
        <p id="statDays" class="text-xl font-headline font-black text-secondary">--</p>
        <p class="text-[9px] text-on-surface-variant uppercase tracking-wider mt-0.5">Días keto</p>
      </div>
    </div>
  </section>

  <!-- Leaderboard semanal -->
  <section class="glass rounded-2xl p-4">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-headline font-bold text-white flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary text-base" style="font-variation-settings:'FILL' 1">leaderboard</span>
        Ranking semanal
      </h2>
      <span class="text-[10px] text-on-surface-variant">Por racha</span>
    </div>
    <div class="space-y-2" id="leaderboard"></div>
  </section>

  <!-- Feed preview -->
  <section>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-headline font-bold text-white flex items-center gap-2">
        <span class="material-symbols-outlined text-base text-primary-container" style="font-variation-settings:'FILL' 1">dynamic_feed</span>
        Feed de la comunidad
      </h2>
      <span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:rgba(255,77,0,0.12);color:#ff4d00">Vista previa</span>
    </div>
    <div class="space-y-3 coming-soon-overlay rounded-2xl" id="feedContainer"></div>
  </section>

  <!-- CTA notificación -->
  <section class="glass rounded-2xl p-5 text-center">
    <span class="material-symbols-outlined text-3xl text-primary-container block mb-2" style="font-variation-settings:'FILL' 1">notifications_active</span>
    <h3 class="font-headline font-bold text-white mb-1">Sé el primero en entrar</h3>
    <p class="text-on-surface-variant text-xs mb-4 max-w-xs mx-auto">Lanzamos cuando tengamos 50 usuarios activos. Actualmente <span id="waitlistCount" class="text-white font-bold">--</span> personas esperan.</p>
    <button onclick="joinWaitlist()" id="waitlistBtn" class="px-7 py-3 rounded-xl text-white font-bold text-sm transition-all active:scale-95" style="background:linear-gradient(135deg,#ff4d00,#ff6b2c);box-shadow:0 4px 16px rgba(255,77,0,0.3)">
      Unirme a la lista de espera
    </button>
  </section>

</main>

<!-- Toast -->
<div id="toast" class="fixed top-20 left-1/2 -translate-x-1/2 px-5 py-3 rounded-xl shadow-lg z-[9999] font-medium hidden text-white text-sm" style="background:#22c55e;min-width:200px;text-align:center">
  <span id="toastMsg">✓</span>
</div>

<!-- Bottom Nav -->
<AppNav active="more" />

<script is:inline>
var MOCK_USERS = [
  { name:'Carlos M.', initials:'CM', color:'#7c3aed', streak:21, lost:8.2, days:45, post:'Día 45 en keto. Nunca me sentí tan bien. La energía es constante y ya no tengo antojos de azúcar 💪', time:'hace 2h', likes:24, emoji:'💪' },
  { name:'Ana R.',    initials:'AR', color:'#0ea5e9', streak:14, lost:5.4, days:30, post:'Mi primera semana sin carbos fue difícil, pero ahora el cuerpo lo pide solo. ¡Receta de hoy: huevos benedictinos keto! 🍳', time:'hace 4h', likes:18, emoji:'🔥' },
  { name:'Luis P.',  initials:'LP', color:'#22c55e', streak:7,  lost:3.1, days:14, post:'Nuevo PR en el gym y keto-adaptado. La combinación funciona. Semana 2 superada ✅', time:'hace 6h', likes:31, emoji:'⚡' },
  { name:'María F.', initials:'MF', color:'#f59e0b', streak:30, lost:11.0, days:60, post:'Mes 2 completado. -11kg. Antes no podía subir un piso sin cansarme. Ahora hago senderismo los fines de semana 🏔️', time:'hace 1d', likes:67, emoji:'🏆' }
];

function showToast(msg, color) {
  var t = document.getElementById('toast');
  var m = document.getElementById('toastMsg');
  if(m) m.textContent = msg;
  t.style.background = color || '#22c55e';
  t.classList.remove('hidden');
  setTimeout(function(){ t.classList.add('hidden'); }, 2500);
}

function loadMyProfile() {
  var profile = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var streak  = safeParseJSON(localStorage.getItem('ketoStreak'), {});
  var history = safeParseJSON(localStorage.getItem('keto_weight_history'), []);

  var name = profile.nombre || profile.name || 'Tú';
  var initials = name.split(' ').map(function(w){ return w[0]; }).join('').slice(0,2).toUpperCase() || 'TU';
  document.getElementById('myAvatar').textContent = initials;
  document.getElementById('myName').textContent = name;

  var currentStreak = streak.currentStreak || 0;
  var ketoDays = streak.ketoDays || 0;

  var sorted = history.slice().sort(function(a,b){ return new Date(b.date||b.fecha) - new Date(a.date||a.fecha); });
  var currentW = sorted.length ? (sorted[0].weight || sorted[0].peso || 0) : (parseFloat(profile.weight)||0);
  var startW   = parseFloat(profile.startWeight || profile.pesoInicial) || currentW;
  var lost     = Math.max(0, startW - currentW);

  document.getElementById('statStreak').textContent = currentStreak + (currentStreak === 1 ? ' día' : ' días');
  document.getElementById('statLost').textContent   = lost > 0 ? '-' + lost.toFixed(1) : '0';
  document.getElementById('statDays').textContent   = ketoDays;

  var badge = document.getElementById('myBadge');
  if (currentStreak >= 7) {
    badge.textContent = currentStreak >= 30 ? '🏆 Élite' : currentStreak >= 14 ? '🔥 Constante' : '⚡ En racha';
    badge.classList.remove('hidden');
  }
}

function loadLeaderboard() {
  var profile = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var streak  = safeParseJSON(localStorage.getItem('ketoStreak'), {});
  var myStreak = streak.currentStreak || 0;
  var myName   = profile.nombre || profile.name || 'Tú';

  var board = MOCK_USERS.map(function(u){ return { name:u.name, initials:u.initials, color:u.color, streak:u.streak, isMe:false }; });
  board.push({ name: myName + ' (tú)', initials: (myName[0]||'T').toUpperCase(), color:'#ff4d00', streak: myStreak, isMe:true });
  board.sort(function(a,b){ return b.streak - a.streak; });

  var html = '';
  board.forEach(function(u, i) {
    var medal = i===0 ? '🥇' : i===1 ? '🥈' : i===2 ? '🥉' : (i+1)+'.';
    html += '<div class="flex items-center gap-3 rounded-xl px-3 py-2.5 ' + (u.isMe ? '' : '') + '" style="' + (u.isMe ? 'background:rgba(255,77,0,0.08);border:1px solid rgba(255,77,0,0.2)' : 'background:#0a0a0a') + '">';
    html += '<span class="text-sm w-6 text-center">' + medal + '</span>';
    html += '<div class="avatar text-white text-xs" style="background:' + u.color + '">' + u.initials + '</div>';
    html += '<p class="flex-1 text-sm ' + (u.isMe ? 'text-white font-bold' : 'text-white/80') + '">' + escapeHtml(u.name) + '</p>';
    html += '<span class="text-[11px] font-bold ' + (u.isMe ? 'text-primary-container' : 'text-on-surface-variant') + '">' + u.streak + 'd</span>';
    html += '</div>';
  });
  document.getElementById('leaderboard').innerHTML = html;
}

function loadFeed() {
  var html = '';
  MOCK_USERS.slice(0, 3).forEach(function(u) {
    html += '<div class="feed-card p-4">';
    html += '<div class="flex items-center gap-3 mb-3">';
    html += '<div class="avatar text-white text-xs" style="background:' + u.color + '">' + u.initials + '</div>';
    html += '<div class="flex-1"><p class="text-white font-bold text-sm">' + escapeHtml(u.name) + '</p><p class="text-on-surface-variant text-[10px]">' + u.streak + ' días keto · ' + u.time + '</p></div>';
    html += '<span class="text-lg">' + u.emoji + '</span>';
    html += '</div>';
    html += '<p class="text-white/80 text-sm leading-relaxed mb-3">' + escapeHtml(u.post) + '</p>';
    html += '<div class="flex items-center gap-4 pt-2 border-t border-white/5">';
    html += '<button class="flex items-center gap-1.5 text-white/40 text-xs"><span class="material-symbols-outlined text-base">favorite_border</span>' + u.likes + '</button>';
    html += '<button class="flex items-center gap-1.5 text-white/40 text-xs"><span class="material-symbols-outlined text-base">chat_bubble_outline</span>Comentar</button>';
    html += '<button class="flex items-center gap-1.5 text-white/40 text-xs ml-auto"><span class="material-symbols-outlined text-base">share</span>Compartir</button>';
    html += '</div></div>';
  });
  document.getElementById('feedContainer').innerHTML = html;
}

function joinWaitlist() {
  var saved = localStorage.getItem('comunidad_waitlist');
  if (saved) {
    showToast('Ya estás en la lista ✓', '#ff4d00');
    return;
  }
  localStorage.setItem('comunidad_waitlist', '1');
  var count = parseInt(localStorage.getItem('comunidad_count') || '34') + 1;
  localStorage.setItem('comunidad_count', count);
  document.getElementById('waitlistCount').textContent = count;
  document.getElementById('waitlistBtn').textContent = '¡Ya estás en la lista! 🎉';
  document.getElementById('waitlistBtn').disabled = true;
  document.getElementById('waitlistBtn').style.opacity = '0.7';
  showToast('¡Listo! Te avisamos cuando lancemos 🚀', '#22c55e');
}

function loadWaitlistState() {
  var count = localStorage.getItem('comunidad_count') || '34';
  document.getElementById('waitlistCount').textContent = count;
  if (localStorage.getItem('comunidad_waitlist')) {
    var btn = document.getElementById('waitlistBtn');
    btn.textContent = '¡Ya estás en la lista! 🎉';
    btn.disabled = true;
    btn.style.opacity = '0.7';
  }
}

document.addEventListener('DOMContentLoaded', function() {
  loadMyProfile();
  loadLeaderboard();
  loadFeed();
  loadWaitlistState();
});
</script>

</AppLayout>
