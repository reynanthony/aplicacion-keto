---
// Comunidad — v3. El leaderboard y el feed siguen siendo mock (MOCK_USERS) —
// no se inventa backend social real aquí, solo se re-temea a v3. La waitlist
// es la única pieza funcional (contador local incremental).
import AppLayout from '../../layouts/AppLayout.astro';
import Dock from '../../components/v3/Dock.astro';
import Sheet from '../../components/v3/Sheet.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Comunidad" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <div>
        <p class="v3-eyebrow" style="margin-bottom:6px;">Comunidad · Juntos</p>
        <h1 style="font-family:var(--v3-font-title); font-weight:800; font-size:24px; color:var(--v3-text); line-height:1.15;">No estás haciendo esto solo.</h1>
      </div>

      <section style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-card); padding:var(--v3-pad-card);">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px;">
          <div id="cmAvatar" class="v3-num-mono" style="width:44px; height:44px; border-radius:14px; background:var(--v3-lime); color:var(--v3-text-on-lime); display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0;">?</div>
          <div style="flex:1; min-width:0;">
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
              <span id="cmName" style="font-family:var(--v3-font-title); font-weight:800; font-size:15px; color:var(--v3-text);">Tu perfil</span>
              <span id="cmBadge" class="v3-chip v3-chip--verdict-lime hidden" style="padding:3px 10px; font-size:10px;"></span>
            </div>
            <div style="font-size:12px; color:var(--v3-text-40); margin-top:2px;">Así te verán en la comunidad</div>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px;">
          <div style="background:var(--v3-surface-2); border-radius:var(--v3-radius-tile); padding:12px 6px; text-align:center;">
            <div id="cmStreak" class="v3-num-mono" style="font-size:19px; justify-content:center; color:var(--v3-lime);">--</div>
            <div class="v3-eyebrow" style="margin-top:3px; font-size:9.5px;">Racha</div>
          </div>
          <div style="background:var(--v3-surface-2); border-radius:var(--v3-radius-tile); padding:12px 6px; text-align:center;">
            <div id="cmLost" class="v3-num-mono" style="font-size:19px; justify-content:center; color:var(--v3-amber);">--</div>
            <div class="v3-eyebrow" style="margin-top:3px; font-size:9.5px;">Kg logrados</div>
          </div>
          <div style="background:var(--v3-surface-2); border-radius:var(--v3-radius-tile); padding:12px 6px; text-align:center;">
            <div id="cmDays" class="v3-num-mono" style="font-size:19px; justify-content:center; color:var(--v3-text);">--</div>
            <div class="v3-eyebrow" style="margin-top:3px; font-size:9.5px;">Días keto</div>
          </div>
        </div>
      </section>

      <section>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
          <p class="v3-eyebrow">Ranking semanal · por racha</p>
        </div>
        <div id="cmLeaderboard" style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-card); padding:6px var(--v3-pad-card);"></div>
      </section>

      <section>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
          <p class="v3-eyebrow">Feed de la comunidad</p>
          <span class="v3-chip" style="padding:3px 10px; font-size:10px;">Vista previa</span>
        </div>
        <div id="cmFeed" style="position:relative; display:flex; flex-direction:column; gap:10px; filter:blur(3px); pointer-events:none; user-select:none;"></div>
      </section>

      <div class="v3-decision-card v3-decision-card--lime" style="text-align:center;">
        <span class="material-symbols-outlined" style="font-size:28px;">notifications_active</span>
        <div class="v3-decision-card-title" style="padding-right:0;">Sé el primero en entrar</div>
        <div class="v3-decision-card-body">Lanzamos cuando tengamos 50 usuarios activos. Actualmente <strong id="cmWaitlistCount">--</strong> personas esperan.</div>
        <button type="button" id="cmWaitlistBtn" class="v3-decision-card-action" style="align-self:center;">Unirme a la lista de espera</button>
      </div>

    </main>

    <VeredictoSheet />
    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>
      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>
    <Dock active="yo" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    var CM_MOCK_USERS = [
      { name: 'Carlos M.', initials: 'CM', streak: 21, emoji: '💪' },
      { name: 'Ana R.', initials: 'AR', streak: 14, emoji: '🔥' },
      { name: 'Luis P.', initials: 'LP', streak: 7, emoji: '⚡' },
      { name: 'María F.', initials: 'MF', streak: 30, emoji: '🏆' }
    ];
    var CM_MOCK_POSTS = [
      { name: 'Carlos M.', initials: 'CM', streak: 21, time: 'hace 2h', post: 'Día 45 en keto. Nunca me sentí tan bien. La energía es constante 💪' },
      { name: 'Ana R.', initials: 'AR', streak: 14, time: 'hace 4h', post: 'Mi primera semana sin carbos fue difícil, pero ahora el cuerpo lo pide solo 🍳' },
      { name: 'Luis P.', initials: 'LP', streak: 7, time: 'hace 6h', post: 'Nuevo PR en el gym y keto-adaptado. La combinación funciona ✅' }
    ];

    function cmLoadProfile() {
      var profile = safeParseJSON(localStorage.getItem('keto_profile'), {});
      var streak = safeParseJSON(localStorage.getItem('ketoStreak'), {});
      var history = safeParseJSON(localStorage.getItem('keto_weight_history'), []);

      var name = profile.nombre || profile.name || 'Tú';
      var initials = name.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase() || 'TU';
      document.getElementById('cmAvatar').textContent = initials;
      document.getElementById('cmName').textContent = name;

      var currentStreak = streak.currentStreak || 0;
      var ketoDays = streak.ketoDays || 0;

      var sorted = history.slice().sort(function (a, b) { return new Date(b.date || b.fecha) - new Date(a.date || a.fecha); });
      var currentW = sorted.length ? (sorted[0].weight || sorted[0].peso || 0) : (parseFloat(profile.weight) || 0);
      var startW = parseFloat(profile.startWeight || profile.pesoInicial) || currentW;
      var lost = Math.max(0, startW - currentW);

      document.getElementById('cmStreak').textContent = currentStreak;
      document.getElementById('cmLost').textContent = lost > 0 ? '-' + lost.toFixed(1) : '0';
      document.getElementById('cmDays').textContent = ketoDays;

      var badge = document.getElementById('cmBadge');
      if (currentStreak >= 7) {
        badge.textContent = currentStreak >= 30 ? '🏆 Élite' : currentStreak >= 14 ? '🔥 Constante' : '⚡ En racha';
        badge.classList.remove('hidden');
      }

      return { name: name, streak: currentStreak };
    }

    function cmLoadLeaderboard(me) {
      var board = CM_MOCK_USERS.map(function (u) { return { name: u.name, initials: u.initials, streak: u.streak, isMe: false }; });
      board.push({ name: me.name + ' (tú)', initials: (me.name[0] || 'T').toUpperCase(), streak: me.streak, isMe: true });
      board.sort(function (a, b) { return b.streak - a.streak; });

      var html = '';
      board.forEach(function (u, i) {
        var medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i + 1) + '.';
        html += '<div style="display:flex; align-items:center; gap:12px; padding:10px 0; ' + (i < board.length - 1 ? 'border-bottom:1px solid var(--v3-border-soft);' : '') + '">';
        html += '<span style="width:22px; text-align:center; font-size:13px;">' + medal + '</span>';
        html += '<div class="v3-num-mono" style="width:30px; height:30px; border-radius:10px; background:' + (u.isMe ? 'var(--v3-lime)' : 'var(--v3-surface-2)') + '; color:' + (u.isMe ? 'var(--v3-text-on-lime)' : 'var(--v3-text-70)') + '; display:flex; align-items:center; justify-content:center; font-size:11px; flex-shrink:0;">' + u.initials + '</div>';
        html += '<span style="flex:1; font-size:13.5px; font-weight:' + (u.isMe ? '700' : '500') + '; color:var(--v3-text);">' + escapeHtml(u.name) + '</span>';
        html += '<span class="v3-num-mono" style="font-size:13px; color:' + (u.isMe ? 'var(--v3-lime)' : 'var(--v3-text-40)') + ';">' + u.streak + 'd</span>';
        html += '</div>';
      });
      document.getElementById('cmLeaderboard').innerHTML = html;
    }

    function cmLoadFeed() {
      var html = '';
      CM_MOCK_POSTS.forEach(function (u) {
        html += '<div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-card); padding:14px;">';
        html += '<div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">';
        html += '<div class="v3-num-mono" style="width:32px; height:32px; border-radius:10px; background:var(--v3-surface-2); color:var(--v3-text-70); display:flex; align-items:center; justify-content:center; font-size:11px;">' + u.initials + '</div>';
        html += '<div style="flex:1;"><div style="font-size:13.5px; font-weight:700; color:var(--v3-text);">' + escapeHtml(u.name) + '</div><div style="font-size:11px; color:var(--v3-text-40);">' + u.streak + ' días keto · ' + u.time + '</div></div>';
        html += '</div>';
        html += '<div style="font-size:13px; color:var(--v3-text-70); line-height:1.5;">' + escapeHtml(u.post) + '</div>';
        html += '</div>';
      });
      document.getElementById('cmFeed').innerHTML = html;
    }

    function cmLoadWaitlist() {
      var count = localStorage.getItem('comunidad_count') || '34';
      document.getElementById('cmWaitlistCount').textContent = count;
      if (localStorage.getItem('comunidad_waitlist')) {
        var btn = document.getElementById('cmWaitlistBtn');
        btn.textContent = '¡Ya estás en la lista! 🎉';
        btn.disabled = true;
        btn.style.opacity = '0.6';
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      var me = cmLoadProfile();
      cmLoadLeaderboard(me);
      cmLoadFeed();
      cmLoadWaitlist();

      document.getElementById('cmWaitlistBtn').addEventListener('click', function () {
        if (localStorage.getItem('comunidad_waitlist')) return;
        localStorage.setItem('comunidad_waitlist', '1');
        var count = parseInt(localStorage.getItem('comunidad_count') || '34') + 1;
        localStorage.setItem('comunidad_count', count);
        cmLoadWaitlist();
      });
    });
  </script>
</AppLayout>
