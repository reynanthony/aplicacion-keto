---
// Comunidad — UI v2 (HUD nativo). Reescrito a markup kc-* (hero, tarjeta de
// perfil, ranking, feed mock, CTA de waitlist). Lógica y datos mock
// intactos. Respaldo: comunidad.astro.bak
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="Comunidad" screen="comunidad">
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}

.kc .com-badge{display:inline-flex;align-items:center;font:700 11px var(--kc-font-mono);letter-spacing:.05em;text-transform:uppercase;padding:4px 10px;border-radius:var(--kc-radius-pill);background:color-mix(in oklab,var(--kc-amber) 18%,transparent);color:var(--kc-amber);margin-top:10px}
.kc .com-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font:800 14px var(--kc-font-sans);color:#fff;flex-shrink:0}
.kc .com-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}
.kc .com-stat{background:var(--kc-surface-2);border-radius:var(--kc-radius-sm);padding:10px;text-align:center}
.kc .com-stat b{display:block;font:700 19px var(--kc-font-sans);color:var(--kc-ink)}
.kc .com-stat span{font:500 10px var(--kc-font-mono);letter-spacing:.04em;text-transform:uppercase;color:var(--kc-ink-3)}
.kc .com-chip-preview{font:700 11px var(--kc-font-mono);padding:3px 9px;border-radius:var(--kc-radius-pill);background:color-mix(in oklab,var(--kc-amber) 14%,transparent);color:var(--kc-amber)}
.kc .com-soon{position:relative}
.kc .com-soon::after{content:"Próximamente";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:color-mix(in oklab,var(--kc-bg) 55%,transparent);border-radius:inherit;font:800 13px var(--kc-font-sans);letter-spacing:.15em;text-transform:uppercase;color:var(--kc-ink-2);backdrop-filter:blur(1px)}
.kc .com-soon-blur{filter:blur(3px);pointer-events:none;user-select:none}
.kc .com-row{display:flex;align-items:center;gap:10px;border-radius:var(--kc-radius-md);padding:9px 12px;background:var(--kc-surface-2)}
.kc .com-row+.com-row{margin-top:6px}
.kc .com-row.is-me{background:color-mix(in oklab,var(--kc-amber) 10%,var(--kc-surface-2));box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--kc-amber) 30%,transparent)}
.kc .com-row__rank{width:22px;text-align:center;font:600 13px var(--kc-font-sans);color:var(--kc-ink-3)}
.kc .com-row__name{flex:1;min-width:0;font:600 13px var(--kc-font-sans);color:var(--kc-ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.kc .com-row__streak{font:700 12px var(--kc-font-mono);color:var(--kc-ink-3)}
.kc .com-row.is-me .com-row__streak{color:var(--kc-amber)}
.kc .com-feed{background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-lg);padding:14px}
.kc .com-feed+.com-feed{margin-top:10px}
.kc .com-feed__head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.kc .com-feed__name{font:600 13px var(--kc-font-sans);color:var(--kc-ink)}
.kc .com-feed__meta{font:500 11px var(--kc-font-mono);color:var(--kc-ink-3)}
.kc .com-feed__text{font:400 13px/1.55 var(--kc-font-sans);color:var(--kc-ink-2);margin-bottom:10px}
.kc .com-feed__actions{display:flex;align-items:center;gap:16px;padding-top:10px;border-top:1px solid var(--kc-line)}
.kc .com-feed__action{display:flex;align-items:center;gap:5px;font:500 12px var(--kc-font-sans);color:var(--kc-ink-3);background:none;border:0;cursor:pointer;padding:0}
.kc .com-feed__action .material-symbols-outlined{font-size:16px}
.kc .com-toast{position:fixed;top:calc(16px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);z-index:90;padding:12px 20px;border-radius:var(--kc-radius-pill);background:var(--kc-surface-1);border:1px solid var(--kc-line-strong);box-shadow:var(--kc-shadow-float);font:600 13px var(--kc-font-sans)}
.kc .com-toast.hidden{display:none}
</style>

<!-- Hero -->
<div>
  <div class="kc-hero-sub">Comunidad · Juntos</div>
  <h1 class="kc-hero">No estás<br>haciendo esto <em>solo</em></h1>
  <span class="com-badge">Beta pronto</span>
</div>

<!-- Mi tarjeta de comunidad -->
<section class="kc-card">
  <div style="display:flex;align-items:center;gap:12px">
    <div id="myAvatar" class="com-avatar" style="background:linear-gradient(135deg,var(--kc-amber),var(--kc-amber-fill))">?</div>
    <div style="flex:1;min-width:0">
      <p id="myName" class="kc-card__title" style="margin-top:0;font-size:14px">Tu perfil</p>
      <p class="kc-label" style="margin-top:2px">Así te verán en la comunidad</p>
    </div>
    <span id="myBadge" class="com-chip-preview hidden"></span>
  </div>
  <div class="com-stats" id="myStats">
    <div class="com-stat"><b id="statStreak">--</b><span>Racha</span></div>
    <div class="com-stat"><b id="statLost">--</b><span>kg logrados</span></div>
    <div class="com-stat"><b id="statDays">--</b><span>Días keto</span></div>
  </div>
</section>

<!-- Leaderboard semanal -->
<section class="kc-card">
  <div class="kc-card__head" style="margin-bottom:12px">
    <h2 class="kc-card__title" style="margin-top:0;font-size:15px;display:flex;align-items:center;gap:8px"><span class="material-symbols-outlined" style="color:var(--kc-cyan);font-size:18px;font-variation-settings:'FILL' 1">leaderboard</span>Ranking semanal</h2>
    <span class="com-chip-preview">Vista previa</span>
  </div>
  <div class="com-soon" id="leaderboard"></div>
</section>

<!-- Feed preview -->
<section>
  <div class="kc-section" style="margin:0 0 10px">
    <h2 style="display:flex;align-items:center;gap:8px"><span class="material-symbols-outlined" style="color:var(--kc-amber);font-size:18px;font-variation-settings:'FILL' 1">dynamic_feed</span>Feed de la comunidad</h2>
    <span class="com-chip-preview">Vista previa</span>
  </div>
  <div class="com-soon" id="feedContainer"></div>
</section>

<!-- CTA notificación -->
<section class="kc-card" style="text-align:center">
  <span class="material-symbols-outlined" style="color:var(--kc-amber);font-size:30px;font-variation-settings:'FILL' 1">notifications_active</span>
  <h3 class="kc-card__title" style="margin-top:10px">Sé el primero en entrar</h3>
  <p class="kc-label" style="margin:6px auto 16px;max-width:260px">Lanzamos cuando tengamos 50 usuarios activos. Actualmente <span id="waitlistCount" style="color:var(--kc-ink);font-weight:700">--</span> personas esperan.</p>
  <button onclick="joinWaitlist()" id="waitlistBtn" class="kc-btn kc-btn--primary">Unirme a la lista de espera</button>
</section>

<!-- Toast -->
<div id="toast" class="com-toast hidden">
  <span id="toastMsg">✓</span>
</div>

<Fragment slot="scripts">
<script is:inline src="/app/utils.js"></script>
<script is:inline>
var MOCK_USERS = [
  { name:'Carlos M.', initials:'CM', color:'#7c3aed', streak:21, lost:8.2, days:45, post:'Día 45 en keto. Nunca me sentí tan bien. La energía es constante y ya no tengo antojos de azúcar 💪', time:'hace 2h', likes:24, emoji:'💪' },
  { name:'Ana R.',    initials:'AR', color:'#0ea5e9', streak:14, lost:5.4, days:30, post:'Mi primera semana sin carbos fue difícil, pero ahora el cuerpo lo pide solo. ¡Receta de hoy: huevos benedictinos keto! 🍳', time:'hace 4h', likes:18, emoji:'🔥' },
  { name:'Luis P.',  initials:'LP', color:'#22c55e', streak:7,  lost:3.1, days:14, post:'Nuevo PR en el gym y keto-adaptado. La combinación funciona. Semana 2 superada ✅', time:'hace 6h', likes:31, emoji:'⚡' },
  { name:'María F.', initials:'MF', color:'#f59e0b', streak:30, lost:11.0, days:60, post:'Mes 2 completado. -11kg. Antes no podía subir un piso sin cansarme. Ahora hago senderismo los fines de semana 🏔️', time:'hace 1d', likes:67, emoji:'🏆' }
];

function showToast(msg, color) {
  var t = document.getElementById('toast');
  var m = document.getElementById('toastMsg');
  if(m) m.textContent = msg;
  t.style.color = color || 'var(--kc-mint)';
  t.classList.remove('hidden');
  setTimeout(function(){ t.classList.add('hidden'); }, 2500);
}

function loadMyProfile() {
  var profile = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var streak  = safeParseJSON(localStorage.getItem('ketoStreak'), {});
  var history = safeParseJSON(localStorage.getItem('keto_weight_history'), []);

  var name = profile.nombre || profile.name || 'Tú';
  var initials = name.split(' ').map(function(w){ return w[0]; }).join('').slice(0,2).toUpperCase() || 'TU';
  document.getElementById('myAvatar').textContent = initials;
  document.getElementById('myName').textContent = name;

  var currentStreak = streak.currentStreak || 0;
  var ketoDays = streak.ketoDays || 0;

  var sorted = history.slice().sort(function(a,b){ return new Date(b.date||b.fecha) - new Date(a.date||a.fecha); });
  var currentW = sorted.length ? (sorted[0].weight || sorted[0].peso || 0) : (parseFloat(profile.weight)||0);
  var startW   = parseFloat(profile.startWeight || profile.pesoInicial) || currentW;
  var lost     = Math.max(0, startW - currentW);

  document.getElementById('statStreak').textContent = currentStreak + (currentStreak === 1 ? ' día' : ' días');
  document.getElementById('statLost').textContent   = lost > 0 ? '-' + lost.toFixed(1) : '0';
  document.getElementById('statDays').textContent   = ketoDays;

  var badge = document.getElementById('myBadge');
  if (currentStreak >= 7) {
    badge.textContent = currentStreak >= 30 ? '🏆 Élite' : currentStreak >= 14 ? '🔥 Constante' : '⚡ En racha';
    badge.classList.remove('hidden');
  }
}

function loadLeaderboard() {
  var profile = safeParseJSON(localStorage.getItem('keto_profile'), {});
  var streak  = safeParseJSON(localStorage.getItem('ketoStreak'), {});
  var myStreak = streak.currentStreak || 0;
  var myName   = profile.nombre || profile.name || 'Tú';

  var board = MOCK_USERS.map(function(u){ return { name:u.name, initials:u.initials, color:u.color, streak:u.streak, isMe:false }; });
  board.push({ name: myName + ' (tú)', initials: (myName[0]||'T').toUpperCase(), color:'var(--kc-amber)', streak: myStreak, isMe:true });
  board.sort(function(a,b){ return b.streak - a.streak; });

  var html = '';
  board.forEach(function(u, i) {
    var medal = i===0 ? '🥇' : i===1 ? '🥈' : i===2 ? '🥉' : (i+1)+'.';
    html += '<div class="com-row' + (u.isMe ? ' is-me' : '') + '">';
    html += '<span class="com-row__rank">' + medal + '</span>';
    html += '<div class="com-avatar" style="width:30px;height:30px;font-size:11px;background:' + u.color + '">' + u.initials + '</div>';
    html += '<p class="com-row__name">' + escapeHtml(u.name) + '</p>';
    html += '<span class="com-row__streak">' + u.streak + 'd</span>';
    html += '</div>';
  });
  document.getElementById('leaderboard').innerHTML = html;
}

function loadFeed() {
  var html = '';
  MOCK_USERS.slice(0, 3).forEach(function(u) {
    html += '<div class="com-feed">';
    html += '<div class="com-feed__head">';
    html += '<div class="com-avatar" style="width:34px;height:34px;font-size:12px;background:' + u.color + '">' + u.initials + '</div>';
    html += '<div style="flex:1"><p class="com-feed__name">' + escapeHtml(u.name) + '</p><p class="com-feed__meta">' + u.streak + ' días keto · ' + u.time + '</p></div>';
    html += '<span style="font-size:18px">' + u.emoji + '</span>';
    html += '</div>';
    html += '<p class="com-feed__text">' + escapeHtml(u.post) + '</p>';
    html += '<div class="com-feed__actions">';
    html += '<button class="com-feed__action"><span class="material-symbols-outlined">favorite_border</span>' + u.likes + '</button>';
    html += '<button class="com-feed__action"><span class="material-symbols-outlined">chat_bubble_outline</span>Comentar</button>';
    html += '<button class="com-feed__action" style="margin-left:auto"><span class="material-symbols-outlined">share</span>Compartir</button>';
    html += '</div></div>';
  });
  document.getElementById('feedContainer').innerHTML = html;
}

function joinWaitlist() {
  var saved = localStorage.getItem('comunidad_waitlist');
  if (saved) {
    showToast('Ya estás en la lista ✓', 'var(--kc-amber)');
    return;
  }
  localStorage.setItem('comunidad_waitlist', '1');
  var count = parseInt(localStorage.getItem('comunidad_count') || '34') + 1;
  localStorage.setItem('comunidad_count', count);
  document.getElementById('waitlistCount').textContent = count;
  document.getElementById('waitlistBtn').textContent = '¡Ya estás en la lista! 🎉';
  document.getElementById('waitlistBtn').disabled = true;
  document.getElementById('waitlistBtn').style.opacity = '0.7';
  showToast('¡Listo! Te avisamos cuando lancemos 🚀', 'var(--kc-mint)');
}

function loadWaitlistState() {
  var count = localStorage.getItem('comunidad_count') || '34';
  document.getElementById('waitlistCount').textContent = count;
  if (localStorage.getItem('comunidad_waitlist')) {
    var btn = document.getElementById('waitlistBtn');
    btn.textContent = '¡Ya estás en la lista! 🎉';
    btn.disabled = true;
    btn.style.opacity = '0.7';
  }
}

document.addEventListener('DOMContentLoaded', function() {
  loadMyProfile();
  loadLeaderboard();
  loadFeed();
  loadWaitlistState();
});
</script>
</Fragment>
</AppShell>
