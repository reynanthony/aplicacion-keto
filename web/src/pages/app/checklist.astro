function saveItem(){
var name=document.getElementById("itemName").value.trim();
var icon=document.getElementById("itemIcon").value;
var target=parseFloat(document.getElementById("itemTarget").value);
var unit=document.getElementById("itemUnit").value.trim();
if(!name||!target||!unit){
showToast("Completa todos los campos");
return;
}
var color=iconColors[icon]||'var(--kc-amber)';
if(editingItemIndex===-1){
  checklistConfig.push({id:"custom_"+Date.now(),icon:icon,iconColor:color,label:name,unit:unit,target:target,step:1,custom:true});
  showToast("Item agregado");
}else{
  if(editingItemIndex<checklistConfig.length){
    checklistConfig[editingItemIndex].label=name;
    checklistConfig[editingItemIndex].icon=icon;
    checklistConfig[editingItemIndex].iconColor=color;
    checklistConfig[editingItemIndex].target=target;
    checklistConfig[editingItemIndex].unit=unit;
  }else{
    var all=[].concat(checklistConfig,customItems);
    var item=all[editingItemIndex];
    item.label=name;
    item.icon=icon;
    item.iconColor=color;
    item.target=target;
    item.unit=unit;
  }
}
saveCustomItems();
closeItemForm();
renderCrudList();
showToast("Guardado!");
}

function editItem(index){
openItemForm(index);
}

function deleteItem(index){
  var item=checklistConfig[index];
  if(confirm("Eliminar '"+item.label+"' de tu checklist?")){
    checklistConfig.splice(index,1);
    saveCustomItems();
    renderCrudList();
    showToast("Item eliminado");
  }
}

