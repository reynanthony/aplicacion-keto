function toggleReminder(itemId){
  var reminders=JSON.parse(localStorage.getItem("checklistReminders")||"{}");
  if(!reminders[itemId]){
    reminders[itemId]={enabled:false,time:"08:00"};
  }
  reminders[itemId].enabled=!reminders[itemId].enabled;
  reminders[itemId].time=document.getElementById("time_"+itemId).value;
  localStorage.setItem("checklistReminders",JSON.stringify(reminders));
  renderNotificationList();
  if(reminders[itemId].enabled){
    scheduleNotification(itemId,reminders[itemId].time);
  }
}

function requestNotificationPermission(){
  if("Notification" in window){
    Notification.requestPermission().then(function(permission){
      if(permission==="granted"){
        showToast("Notificaciones activadas!");
        scheduleAllNotifications();
      }else{
        showToast("Permiso denegado");
      }
    });
  }else{
    showToast("Tu navegador no soporta notificaciones");
  }
}

function scheduleAllNotifications(){
  var reminders=JSON.parse(localStorage.getItem("checklistReminders")||"{}");
  var items=getEffectiveItems();
  items.forEach(function(item){
    if(reminders[item.id]&&reminders[item.id].enabled){
      scheduleNotification(item.id,reminders[item.id].time);
    }
  });
}

function scheduleNotification(itemId,time){
  if(Notification.permission!=="granted")return;
  var items=getEffectiveItems();
  var item=items.find(function(i){return i.id===itemId});
  if(!item)return;

  var now=new Date();
  var parts=time.split(":");
  var scheduledTime=new Date(now.getFullYear(),now.getMonth(),now.getDate(),parts[0],parts[1],0,0);

  if(scheduledTime<=now){
    scheduledTime.setDate(scheduledTime.getDate()+1);
  }

  var delay=scheduledTime.getTime()-now.getTime();

  setTimeout(function(){
    new Notification("KetoCore - Recordatorio",{
      body:"Es hora de "+item.label+"!",
      icon:"icons/icon-192x192.png",
      tag:itemId
    });
    scheduleNotification(itemId,time);
  },delay);
}

