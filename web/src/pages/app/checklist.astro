function loadCustomItems(){
  var stored=localStorage.getItem("checklistConfig");
  if(stored){
    try{
      var parsed=JSON.parse(stored);
      if(Array.isArray(parsed) && parsed.length>0 && parsed[0].id){
        checklistConfig=parsed;
      }else{
        checklistConfig=[].concat(defaultChecklistConfig);
        localStorage.setItem("checklistConfig",JSON.stringify(checklistConfig));
      }
    }catch(e){
      checklistConfig=[].concat(defaultChecklistConfig);
      localStorage.setItem("checklistConfig",JSON.stringify(checklistConfig));
    }
  }else{
    checklistConfig=[].concat(defaultChecklistConfig);
    localStorage.setItem("checklistConfig",JSON.stringify(checklistConfig));
  }
}

function saveCustomItems(){
  localStorage.setItem("checklistConfig",JSON.stringify(checklistConfig));
  loadChecklist();
}

function getEffectiveItems(){
  loadCustomItems();

  try {
    var macros = JSON.parse(localStorage.getItem('keto_macros') || '{}');
    if (macros.protein) {
      checklistConfig.forEach(function(item) {
        if (item.id === 'protein') {
          item.target = Math.round(macros.protein / 3);
        }
      });
    }
  } catch(e) {}

  return checklistConfig;
}

