---
// Checklist diario — UI v2 (HUD nativo). Pantalla reemplazada funcionalmente
// por habitos.astro pero sigue enlazada desde guia.astro, así que se migra
// igual. Reescrito a markup kc-* real reusando componentes canónicos
// (kc-dial, kc-week, kc-stat, kc-proto-like). Lógica y datos intactos
// (checklist/suplementos/comidas/notificaciones/racha). Respaldo: checklist.astro.bak
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="Checklist" screen="checklist">
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
.kc input[type="range"]{accent-color:var(--kc-amber);width:100%}

.kc .chk-actions{display:flex;justify-content:flex-end;gap:8px}
.kc .chk-ring-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.kc .chk-ring-sub{text-align:center;color:var(--kc-ink-3);font:500 13px var(--kc-font-sans);margin-top:10px}

/* Fila de suplemento/hábito con icono, barra y acción — mismo lenguaje que
   .cmp-row de compras.astro. */
.kc .chk-row{display:flex;align-items:center;gap:12px;background:var(--kc-surface-2);border-radius:var(--kc-radius-md);padding:12px}
.kc .chk-row+.chk-row{margin-top:8px}
.kc .chk-row__main{flex:1;min-width:0}
.kc .chk-row__top{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:7px}
.kc .chk-row__name{font:600 13.5px var(--kc-font-sans);color:var(--kc-ink)}
.kc .chk-row__name.done{color:var(--kc-ink-3)}
.kc .chk-row__val{font:600 12px var(--kc-font-mono);color:var(--kc-ink-3);white-space:nowrap}
.kc .chk-row__val b{color:var(--kc-ink);font-weight:700}
.kc .chk-check{width:30px;height:30px;border-radius:50%;border:0;flex-shrink:0;display:grid;place-items:center;cursor:pointer}

.kc .chk-meal{display:flex;align-items:center;gap:12px;background:var(--kc-surface-2);border-radius:var(--kc-radius-md);padding:12px;cursor:pointer;box-shadow:inset 0 0 0 1px var(--kc-line)}
.kc .chk-meal[data-done="1"]{box-shadow:inset 0 0 0 1.5px var(--kc-amber)}
.kc .chk-meal+.chk-meal{margin-top:8px}
.kc .chk-meal__main{flex:1;min-width:0}
.kc .chk-meal__name{font:600 14px var(--kc-font-sans);color:var(--kc-ink)}
.kc .chk-meal__sub{font:500 12px var(--kc-font-mono);color:var(--kc-ink-3);margin-top:2px}

.kc .chk-empty{text-align:center;padding:36px 16px;color:var(--kc-ink-3)}
.kc .chk-empty .material-symbols-outlined{font-size:48px;opacity:.5}
.kc .chk-empty p{font:500 13px var(--kc-font-sans);margin-top:10px}

/* Modales (patrón compartido por todas las pantallas HUD migradas) */
.kc .chk-modal{position:fixed;inset:0;z-index:60;align-items:center;justify-content:center;padding:16px}
.kc .chk-modal.hidden{display:none}
.kc .chk-modal.flex{display:flex}
.kc .chk-modal__scrim{position:absolute;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(4px)}
.kc .chk-modal__panel{position:relative;width:100%;max-width:420px;max-height:88dvh;overflow-y:auto;background:var(--kc-surface-1);border:1px solid var(--kc-line);border-radius:var(--kc-radius-xl);box-shadow:var(--kc-shadow-float);padding:22px}

.kc .chk-icon-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.kc .chk-icon-opt{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:var(--kc-radius-sm);background:var(--kc-surface-2);box-shadow:inset 0 0 0 1px transparent;text-align:left;border:0;cursor:pointer}
.kc .chk-icon-opt.is-selected{box-shadow:inset 0 0 0 1.5px var(--kc-amber)}
.kc .chk-icon-opt .material-symbols-outlined{font-size:18px}
.kc .chk-toggle{width:40px;height:24px;border-radius:999px;background:var(--kc-surface-3);border:0;cursor:pointer;position:relative;flex-shrink:0;padding:0}
.kc .chk-toggle i{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--kc-ink);transition:transform .18s var(--kc-ease)}
.kc .chk-toggle[data-on="1"]{background:var(--kc-amber-fill)}
.kc .chk-toggle[data-on="1"] i{transform:translateX(16px);background:var(--kc-on-amber)}
</style>

<!-- Hero -->
<div>
  <div class="kc-hero-sub">Checklist · racha de <span id="streakCount">0</span> días</div>
  <h1 class="kc-hero">Tu progreso,<br>bajo <em>control</em></h1>
</div>
<div class="chk-actions">
  <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="openNotificationModal()" aria-label="Recordatorios"><span class="material-symbols-outlined">notifications</span></button>
</div>

<!-- Progreso de hoy (ring) -->
<div class="kc-card">
  <div class="chk-ring-head">
    <div class="kc-eyebrow">Hoy</div>
  </div>
  <div class="kc-dial kc-c-amber">
    <svg viewBox="0 0 100 100">
      <circle class="trk" cx="50" cy="50" r="44" stroke-width="8"></circle>
      <circle id="progressCircle" class="arc" cx="50" cy="50" r="44" stroke-width="8" stroke-linecap="round" stroke-dasharray="276.46" stroke-dashoffset="276.46"></circle>
    </svg>
    <div class="kc-dial__c">
      <span id="progressPercent" class="kc-dial__big">0%</span>
    </div>
  </div>
  <p id="progressText" class="chk-ring-sub">0 de 6 tareas completadas</p>
</div>

<!-- Resumen (agua/electrolitos/entrenamiento/sueño) -->
<div class="kc-grid">
  <div class="kc-stat kc-c-cyan">
    <div class="kc-stat__top"><span class="kc-label"><span class="material-symbols-outlined" style="font-size:15px">water_drop</span> Agua</span></div>
    <div class="kc-stat__val"><span id="heroWater">0</span><small>/ 3 L</small></div>
    <div class="kc-bar kc-c-cyan"><i id="heroWaterBar"></i></div>
  </div>
  <div class="kc-stat kc-c-amber">
    <div class="kc-stat__top"><span class="kc-label"><span class="material-symbols-outlined" style="font-size:15px">science</span> Electrolitos</span></div>
    <div class="kc-stat__val"><span id="heroElectro">0</span><small>/ 500 ml</small></div>
    <div class="kc-bar kc-c-amber"><i id="heroElectroBar"></i></div>
  </div>
  <div class="kc-stat kc-c-red">
    <div class="kc-stat__top"><span class="kc-label"><span class="material-symbols-outlined" style="font-size:15px">fitness_center</span> Entreno</span></div>
    <div class="kc-stat__val"><span id="heroWorkout">0</span><small>/ 60 min</small></div>
    <div class="kc-bar kc-c-red"><i id="heroWorkoutBar"></i></div>
  </div>
  <div class="kc-stat kc-c-neutral">
    <div class="kc-stat__top"><span class="kc-label"><span class="material-symbols-outlined" style="font-size:15px">bedtime</span> Sueño</span></div>
    <div class="kc-stat__val"><span id="heroSleep">0</span><small>/ 8 hrs</small></div>
    <div class="kc-bar kc-c-neutral"><i id="heroSleepBar"></i></div>
  </div>
</div>

<!-- Suplementos -->
<div class="kc-card">
  <div class="kc-card__head">
    <div><div class="kc-card__title">Suplementos</div><div class="kc-card__sub">Controla tu suplementación diaria</div></div>
    <button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="openSupplementsModal()" aria-label="Agregar suplemento"><span class="material-symbols-outlined">add</span></button>
  </div>
  <div id="supplementsGrid"></div>
</div>

<!-- Historial semanal -->
<div class="kc-card">
  <div class="kc-card__head">
    <div class="kc-card__title">Historial semanal</div>
    <span class="material-symbols-outlined" style="color:var(--kc-amber)">bar_chart</span>
  </div>
  <div class="kc-week" id="weeklyChart"></div>
</div>

<!-- Checklist diario -->
<div class="kc-card">
  <div class="kc-card__head">
    <div><div class="kc-card__title">Checklist diario</div><div class="kc-card__sub">Sigue tus hábitos y metas de cada día</div></div>
    <button class="kc-btn kc-btn--secondary kc-btn--sm" onclick="openCrudModal()"><span class="material-symbols-outlined" style="font-size:18px">add</span>Agregar</button>
  </div>
  <div id="dailyChecklist"></div>
</div>

<!-- Comidas del día -->
<div class="kc-card">
  <div class="kc-card__head">
    <div><div class="kc-card__title">Comidas del día</div><div class="kc-card__sub">Registra lo que comiste hoy</div></div>
  </div>
  <div id="mealsContainer"></div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-28 left-1/2 -translate-x-1/2 z-[70] hidden" style="background:var(--kc-surface-1);border:1px solid var(--kc-line-strong);border-radius:var(--kc-radius-pill);padding:12px 20px;box-shadow:var(--kc-shadow-float);display:flex;align-items:center;gap:10px">
  <span class="material-symbols-outlined" style="color:var(--kc-mint);font-variation-settings:'FILL' 1">check_circle</span>
  <span id="toastMessage" style="font:600 13px var(--kc-font-sans);color:var(--kc-ink)">Guardado!</span>
</div>

<!-- Input Modal (ajustar valor de un item) -->
<div id="inputModal" class="chk-modal hidden">
  <div class="chk-modal__scrim" onclick="closeInputModal()"></div>
  <div class="chk-modal__panel">
    <div class="kc-card__head"><h3 id="modalTitle" class="kc-card__title"></h3><button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeInputModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button></div>
    <div id="modalContent"></div>
    <div style="display:flex;gap:10px;margin-top:20px">
      <button class="kc-btn kc-btn--secondary kc-btn--block" onclick="closeInputModal()">Cancelar</button>
      <button class="kc-btn kc-btn--primary kc-btn--block" onclick="saveInputValue()">Guardar</button>
    </div>
  </div>
</div>

<!-- Electrolito Modal -->
<div id="electrolitoModal" class="chk-modal hidden">
  <div class="chk-modal__scrim" onclick="closeElectrolitoModal()"></div>
  <div class="chk-modal__panel">
    <div class="kc-card__head"><h3 id="electrolitoTitle" class="kc-card__title"></h3><button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeElectrolitoModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button></div>
    <p id="electrolitoCurrent" style="text-align:center;font:800 32px var(--kc-font-sans);color:var(--kc-amber);margin:8px 0"></p>
    <input type="range" id="electrolitoSlider" min="0" max="100" value="0">
    <p id="electrolitoTarget" class="kc-label" style="text-align:center;margin-top:8px"></p>
    <div style="display:flex;gap:10px;margin-top:20px">
      <button class="kc-btn kc-btn--secondary kc-btn--block" onclick="closeElectrolitoModal()">Cancelar</button>
      <button class="kc-btn kc-btn--primary kc-btn--block" onclick="saveElectrolito()">Guardar</button>
    </div>
  </div>
</div>

<!-- CRUD Modal -->
<div id="crudModal" class="chk-modal hidden">
  <div class="chk-modal__scrim" onclick="closeCrudModal()"></div>
  <div class="chk-modal__panel">
    <div class="kc-card__head"><h3 class="kc-card__title">Configurar checklist</h3><button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeCrudModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button></div>
    <div id="crudContent"></div>
  </div>
</div>

<!-- Item Form Modal -->
<div id="itemFormModal" class="chk-modal hidden">
  <div class="chk-modal__scrim" onclick="closeItemForm()"></div>
  <div class="chk-modal__panel">
    <div class="kc-card__head"><h3 id="formTitle" class="kc-card__title">Nuevo item</h3><button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeItemForm()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button></div>
    <div class="kc-field">
      <label class="kc-label">Nombre</label>
      <input type="text" id="itemName" class="kc-input" placeholder="Ej: Meditación">
    </div>
    <div class="kc-field">
      <label class="kc-label">Icono</label>
      <select id="itemIcon" class="kc-input">
        <option value="water_drop">Agua</option>
        <option value="science">Ciencia/Electrolitos</option>
        <option value="fitness_center">Gimnasio</option>
        <option value="directions_walk">Caminar</option>
        <option value="egg_alt">Proteína</option>
        <option value="bedtime">Dormir</option>
        <option value="self_improvement">Meditación</option>
        <option value="menu_book">Leer</option>
        <option value="favorite">Salud</option>
        <option value="restaurant">Comida</option>
      </select>
    </div>
    <div class="kc-field-2">
      <div class="kc-field" style="margin-bottom:0">
        <label class="kc-label">Meta</label>
        <input type="number" id="itemTarget" class="kc-input" value="1" min="1">
      </div>
      <div class="kc-field" style="margin-bottom:0">
        <label class="kc-label">Unidad</label>
        <input type="text" id="itemUnit" class="kc-input" value="min" placeholder="min, g, hrs...">
      </div>
    </div>
    <div style="display:flex;gap:10px;margin-top:8px">
      <button class="kc-btn kc-btn--secondary kc-btn--block" onclick="closeItemForm()">Cancelar</button>
      <button class="kc-btn kc-btn--primary kc-btn--block" onclick="saveItem()">Guardar</button>
    </div>
  </div>
</div>

<!-- Notification Modal -->
<div id="notificationModal" class="chk-modal hidden">
  <div class="chk-modal__scrim" onclick="closeNotificationModal()"></div>
  <div class="chk-modal__panel">
    <div class="kc-card__head"><h3 class="kc-card__title">Recordatorios</h3><button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeNotificationModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button></div>
    <div id="notificationList" style="display:flex;flex-direction:column;gap:8px"></div>
    <button class="kc-btn kc-btn--primary kc-btn--block" style="margin-top:16px" onclick="requestNotificationPermission()">Activar notificaciones</button>
  </div>
</div>

<!-- Supplements Modal -->
<div id="supplementsModal" class="chk-modal hidden">
  <div class="chk-modal__scrim" onclick="closeSupplementsModal()"></div>
  <div class="chk-modal__panel" style="max-width:480px">
    <div class="kc-card__head"><h3 class="kc-card__title">Mis suplementos</h3><button class="kc-btn kc-btn--secondary kc-btn--sm kc-btn--icon" onclick="closeSupplementsModal()" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:18px">close</span></button></div>
    <div id="supplementsConfigList"></div>
    <button class="kc-btn kc-btn--secondary kc-btn--block" style="margin-top:16px" onclick="closeSupplementsModal()">Cerrar</button>
  </div>
</div>

<Fragment slot="scripts">
<script is:inline src="/app/utils.js"></script>
<script is:inline src="/app/modules/meal-plan.js"></script>
<script is:inline>
var defaultChecklistConfig=[
{id:"water",icon:"water_drop",iconColor:"var(--kc-cyan)",bg:"bg-cyan-500/20",label:"Agua",unit:"L",target:3,step:0.25},
{id:"electrolitos",icon:"science",iconColor:"var(--kc-amber)",bg:"bg-yellow-500/20",label:"Electrolitos",unit:"ml",target:500,step:50},
{id:"workout",icon:"fitness_center",iconColor:"var(--kc-red)",bg:"bg-orange-500/20",label:"Entrenamiento",unit:"min",target:60,step:5},
{id:"walk",icon:"directions_walk",iconColor:"var(--kc-mint)",bg:"bg-green-500/20",label:"Caminata",unit:"min",target:60,step:5},
{id:"protein",icon:"egg_alt",iconColor:"var(--kc-amber)",bg:"bg-amber-500/20",label:"Proteína",unit:"g",target:159,step:10},
{id:"sleep",icon:"bedtime",iconColor:"var(--kc-ink-3)",bg:"bg-gray-500/20",label:"Sueño",unit:"hrs",target:8,step:0.5}
];
var checklistConfig=[].concat(defaultChecklistConfig);

var currentInputItem=null;
var currentElectrolito=null;
var editingItemIndex=null;
var iconColors={'water_drop':'var(--kc-cyan)','science':'var(--kc-amber)','fitness_center':'var(--kc-red)','directions_walk':'var(--kc-mint)','egg_alt':'var(--kc-amber)','bedtime':'var(--kc-ink-3)','self_improvement':'var(--kc-cyan)','menu_book':'var(--kc-ink-2)','favorite':'var(--kc-red)'};

function loadChecklist(){
var todayKey=new Date().toISOString().slice(0,10);
var rawData=localStorage.getItem("checklist_"+todayKey);
var checklistData=safeParseJSON(rawData, {});
var userData=getLocalData("userData", schemas.userData, getDefaultUserData());
var container=document.getElementById("dailyChecklist");
container.innerHTML="";
var completedCount=0;
var allItems=getEffectiveItems();
var totalPercent=0;

allItems.forEach(function(item,index){
var value=checklistData[item.id]||0;
var isCompleted=value>=item.target;
if(isCompleted)completedCount++;
var percent=Math.min(Math.round((value/item.target)*100),100);
totalPercent+=percent;

var displayValue=item.step<1?value.toFixed(1).replace('.0',''):value;
var color=item.iconColor||'var(--kc-amber)';

var barColor = isCompleted ? 'var(--kc-mint)' : color;
var cardHtml ='<div class="chk-row" onclick="openInputModal(\''+item.id+'\')">';
cardHtml+='<div class="kc-ico" style="--c:'+color+'">';
cardHtml+='<span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:\'FILL\' 1">'+item.icon+'</span>';
if(isCompleted){
cardHtml+='<span class="kc-check" style="display:grid"><span class="material-symbols-outlined" style="font-size:11px">check</span></span>';
}
cardHtml+='</div>';
cardHtml+='<div class="chk-row__main">';
cardHtml+='<div class="chk-row__top">';
cardHtml+='<span class="chk-row__name'+(isCompleted?' done':'')+'">'+item.label+'</span>';
cardHtml+='<span class="chk-row__val"><b>'+displayValue+'</b> / '+item.target+' '+item.unit+'</span>';
cardHtml+='</div>';
cardHtml+='<div class="kc-bar"><i style="width:'+percent+'%;background:'+barColor+'"></i></div>';
cardHtml+='</div></div>';
container.innerHTML+=cardHtml;
});

var total=allItems.length;
var overallPercent=Math.round(totalPercent/total);
document.getElementById("progressPercent").textContent=overallPercent+"%";
document.getElementById("progressText").textContent=completedCount+" de "+total+" tareas completadas";
document.getElementById("progressCircle").style.strokeDashoffset=276.46-(276.46*overallPercent/100);

(function(){
  function setHero(id, elId, target, decimals){
    var val = checklistData[id] || 0;
    var pct = target > 0 ? Math.min(Math.round((val/target)*100), 100) : 0;
    var el = document.getElementById(elId), bar = document.getElementById(elId+'Bar');
    if (el) el.textContent = decimals ? (Math.round(val*10)/10) : Math.round(val);
    if (bar) bar.style.width = pct + '%';
  }
  setHero('water','heroWater',3,true);
  setHero('electrolitos','heroElectro',500,false);
  setHero('workout','heroWorkout',60,false);
  setHero('sleep','heroSleep',8,true);
})();

updateStreak();
}

function calculateStreak(){
  var streak=0;
  var today=new Date();
  var threshold=0.8;

  for(var i=0;i<365;i++){
    var d=new Date(today);
    d.setDate(d.getDate()-i);
    var dateKey=d.toISOString().slice(0,10);
    var rawData=localStorage.getItem("checklist_"+dateKey);
    var data=safeParseJSON(rawData,{});
    var items=getEffectiveItems();
    var completed=0;
    var total=items.length;

    items.forEach(function(item){
      var val=data[item.id]||0;
      if(val>=item.target)completed++;
    });

    var percent=total>0?completed/total:0;
    if(percent>=threshold){
      streak++;
    }else if(i>0){
      break;
    }
  }

  return streak;
}

function updateStreak(){
  var streak=calculateStreak();
  document.getElementById("streakCount").textContent=streak;
  localStorage.setItem("checklistStreak",streak);
}

function renderWeeklyChart(){
  var container=document.getElementById("weeklyChart");
  var days=["Lun","Mar","Mié","Jue","Vie","Sáb","Dom"];
  var today=new Date();
  var dayOfWeek=today.getDay();
  var startDay=dayOfWeek===0?6:dayOfWeek-1;

  var html="";
  for(var i=6;i>=0;i--){
    var d=new Date(today);
    d.setDate(d.getDate()-i);
    var dateKey=d.toISOString().slice(0,10);
    var rawData=localStorage.getItem("checklist_"+dateKey);
    var data=safeParseJSON(rawData,{});
    var items=getEffectiveItems();
    var completed=0;
    var total=items.length;

    items.forEach(function(item){
      var val=data[item.id]||0;
      if(val>=item.target)completed++;
    });

    var percent=total>0?Math.round((completed/total)*100):0;
    var isToday=i===0;
    var level=percent>=80?"full":percent>=50?"mid":percent>0?"low":"";
    var h=percent>0?Math.max(percent,6):3;
    var dayLabel=isToday?"Hoy":days[(startDay-i+7)%7];

    html+='<div class="kc-week__col"'+(level?' data-level="'+level+'"':'')+(isToday?' data-today':'')+'>';
    html+='<span class="kc-week__v">'+(percent>0?percent+"%":"–")+'</span>';
    html+='<div class="kc-week__bar"><i style="height:'+h+'%"></i></div>';
    html+='<span class="kc-week__d">'+dayLabel+'</span>';
    html+='</div>';
  }
  container.innerHTML=html;
}

function openInputModal(itemId){
currentInputItem=getEffectiveItems().find(function(c){return c.id===itemId});
var todayKey=new Date().toISOString().slice(0,10);
var rawData=localStorage.getItem("checklist_"+todayKey);
var checklistData=safeParseJSON(rawData, {});
var value=checklistData[itemId]||0;
var displayValue=currentInputItem.step<1?value.toFixed(1).replace('.0',''):value;
document.getElementById("modalTitle").textContent=currentInputItem.label;
document.getElementById("modalContent").innerHTML='<p style="text-align:center;font:800 32px var(--kc-font-sans);color:var(--kc-amber);margin-bottom:16px">'+displayValue+' '+currentInputItem.unit+'</p><input type="range" id="itemSlider" min="0" max="'+currentInputItem.target+'" step="'+currentInputItem.step+'" value="'+value+'">';
document.getElementById("itemSlider").addEventListener("input",function(){
var val=parseFloat(this.value);
