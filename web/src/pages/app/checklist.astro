function renderSupplements(){
  var container=document.getElementById("supplementsGrid");
  var selected=getSelectedSupplements();
  var todayKey=new Date().toISOString().slice(0,10);
  var takenData=JSON.parse(localStorage.getItem("supplements_"+todayKey)||"{}");
  var supps=window.availableSupplements||[
    {id:"creatina",name:"Creatina",category:"deportivo",dose:5,unit:"g",icon:"bolt",color:"var(--kc-amber)"},
    {id:"magnesio",name:"Magnesio",category:"vitaminas",dose:400,unit:"mg",icon:"medication",color:"var(--kc-cyan)"}
  ];

  var html="";
  selected.forEach(function(suppId){
    var supp=supps.find(function(s){return s.id===suppId});
    if(!supp)return;
    var taken=takenData[suppId]||0;
    var isComplete=taken>=supp.dose;
    html+='<div class="chk-row">';
    html+='<div class="kc-ico" style="--c:'+supp.color+'"><span class="material-symbols-outlined" style="font-size:20px">'+supp.icon+'</span></div>';
    html+='<div class="chk-row__main">';
    html+='<div class="chk-row__top"><span class="chk-row__name">'+supp.name+'</span><span class="chk-row__val">'+taken+' / '+supp.dose+' '+supp.unit+'</span></div>';
    html+='<div class="kc-bar"><i style="width:'+Math.min((taken/supp.dose)*100,100)+'%;background:'+supp.color+'"></i></div>';
    html+='</div>';
    html+='<button onclick="takeSupplement(\''+supp.id+'\')" class="chk-check" style="background:'+(isComplete?'color-mix(in oklab, var(--kc-mint) 18%, transparent)':'var(--kc-surface-3)')+';color:'+(isComplete?'var(--kc-mint)':'var(--kc-ink-3)')+'">';
    html+='<span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:\'FILL '+(isComplete?'1':'0')+'\'">check</span></button>';
    html+='</div>';
  });

  if(selected.length===0){
    html='<div class="chk-empty"><p>No hay suplementos seleccionados. ¡Agrega los tuyos!</p></div>';
  }

  container.innerHTML=html;
}

function takeSupplement(suppId){
  var supps=window.availableSupplements||[
    {id:"creatina",name:"Creatina",category:"deportivo",dose:5,unit:"g",icon:"bolt",color:"var(--kc-amber)"},
    {id:"magnesio",name:"Magnesio",category:"vitaminas",dose:400,unit:"mg",icon:"medication",color:"var(--kc-cyan)"}
  ];
  var supp=supps.find(function(s){return s.id===suppId});
  if(!supp)return;

  var todayKey=new Date().toISOString().slice(0,10);
  var takenData=JSON.parse(localStorage.getItem("supplements_"+todayKey)||"{}");

  var current=takenData[suppId]||0;
  var increment=supp.unit==="capsula"||supp.unit==="UI"||supp.unit==="dosis"?1:supp.dose/10;

  if(current<supp.dose){
    takenData[suppId]=Math.min(current+increment,supp.dose);
    localStorage.setItem("supplements_"+todayKey,JSON.stringify(takenData));
    renderSupplements();
    showToast(supp.name+": "+Math.round(takenData[suppId])+" "+supp.unit);
  }else{
    takenData[suppId]=0;
    localStorage.setItem("supplements_"+todayKey,JSON.stringify(takenData));
    renderSupplements();
    showToast(supp.name+" reiniciado");
  }
}

