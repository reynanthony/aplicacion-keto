  sportsSupps.forEach(function(supp){
    var isSelected=selected.indexOf(supp.id)!==-1;
    html+='<button onclick="toggleSupplement(\''+supp.id+'\')" class="chk-icon-opt'+(isSelected?' is-selected':'')+'">';
    html+='<span class="material-symbols-outlined" style="color:'+supp.color+'">'+supp.icon+'</span>';
    html+='<span><span style="display:block;font:600 12.5px var(--kc-font-sans);color:var(--kc-ink)">'+supp.name+'</span><span class="kc-label">'+supp.dose+' '+supp.unit+'</span></span>';
    html+='</button>';
  });
  html+='</div></div>';

  html+='<div><div class="kc-eyebrow" style="margin-bottom:10px">Vitaminas y minerales</div><div class="chk-icon-grid">';
  vitaminSupps.forEach(function(supp){
    var isSelected=selected.indexOf(supp.id)!==-1;
    html+='<button onclick="toggleSupplement(\''+supp.id+'\')" class="chk-icon-opt'+(isSelected?' is-selected':'')+'">';
    html+='<span class="material-symbols-outlined" style="color:'+supp.color+'">'+supp.icon+'</span>';
    html+='<span><span style="display:block;font:600 12.5px var(--kc-font-sans);color:var(--kc-ink)">'+supp.name+'</span><span class="kc-label">'+supp.dose+' '+supp.unit+'</span></span>';
    html+='</button>';
  });
  html+='</div></div>';

  container.innerHTML=html;
}

function toggleSupplement(suppId){
  var selected=getSelectedSupplements();
  var idx=selected.indexOf(suppId);
  if(idx===-1){
    selected.push(suppId);
  }else{
    selected.splice(idx,1);
  }
  saveSelectedSupplements(selected);
  renderSupplementsConfig();
  renderSupplements();
}
</script>
