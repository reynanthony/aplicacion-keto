---
// Bienvenido (login/registro) — pre-login, sin AppShell (no hay tab bar ni
// sesión aún). Retokenizado a tokens --kc-* del HUD, sobre AppLayout.
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="KetoCore | Bienvenido" authGuard={false} bodyClass="flex flex-col">
<style is:global>
body { font-family: 'Inter', sans-serif; background: var(--kc-bg); color: var(--kc-ink); }
h1, h2, h3 { font-family: 'Plus Jakarta Sans', sans-serif; }
.material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
@keyframes fadeInUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
.fade-in { animation: fadeInUp 0.4s ease-out forwards; }
@keyframes kpulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
.animate-pulse-custom { animation: kpulse 1.5s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) {
  .fade-in, .animate-pulse-custom { animation: none; opacity: 1; }
}
/* Pantalla de entrada: sin sidebar ni bottom-nav. Selector con especificidad
   mayor que la regla de AppLayout.astro (#appSidebar{display:flex!important}
   dentro de @media min-width:901px) — con igual especificidad, ambas
   !important, gana la ultima en el cascade, que resulto ser AppLayout (el
   sidebar se colaba encima del login en desktop). */
html body #appSidebar, html body #kcTabbar, html body #kcDrawer { display: none !important; }
main { margin-left: 0 !important; padding-bottom: 2rem !important; }

.wel-logo { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; background: var(--kc-amber-fill); box-shadow: var(--kc-glow-amber); flex-shrink: 0; }
.wel-logo img { width: 20px; height: 20px; filter: brightness(0) invert(1); }
.wel-divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; }
.wel-divider i { flex: 1; height: 1px; background: var(--kc-line); }
.wel-cta-demo { background: color-mix(in oklab, var(--kc-amber) 14%, transparent); color: var(--kc-amber); box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--kc-amber) 35%, transparent); }
.wel-benefit { display: flex; align-items: center; gap: 12px; color: var(--kc-ink-2); font-size: 14px; }
.wel-benefit + .wel-benefit { margin-top: 10px; }
#loginError, #registerError { color: var(--kc-red); font-size: 13px; margin-top: 12px; }
#loadingOverlay { background: color-mix(in oklab, var(--kc-bg) 92%, transparent); backdrop-filter: blur(12px); }
#toast { background: var(--kc-surface-1); color: var(--kc-ink); border: 1px solid var(--kc-line-strong); box-shadow: var(--kc-shadow-float); }
</style>

<div class="kc kc-app" style="min-height:100dvh;display:flex;flex-direction:column">

<!-- Header -->
<header class="px-5 pt-5 pb-3" style="display:flex;align-items:center;gap:12px">
  <span class="wel-logo"><img src="/app/logo.svg" alt="KetoCore"></span>
  <span style="font:700 20px 'Plus Jakarta Sans',sans-serif;color:var(--kc-ink)">KetoCore</span>
</header>

<!-- Main -->
<main class="flex-1" style="display:flex;align-items:center;justify-content:center;padding:24px 20px">
  <div class="w-full max-w-sm">

    <!-- Hero -->
    <div class="text-center fade-in" style="margin-bottom:28px">
      <h1 class="kc-hero" style="font-size:32px;text-align:center">Transforma tu <em>salud</em></h1>
      <p class="kc-label" style="font-size:15px;color:var(--kc-ink-3)">La app cetogénica más completa en español</p>
    </div>

    <!-- Feature pills -->
    <div class="fade-in" style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-bottom:28px;animation-delay:.08s">
      <span class="kc-chip kc-c-mint"><span class="material-symbols-outlined" style="font-size:14px">check_circle</span>Offline</span>
      <span class="kc-chip kc-c-cyan"><span class="material-symbols-outlined" style="font-size:14px">language</span>100% Español</span>
      <span class="kc-chip kc-c-amber"><span class="material-symbols-outlined" style="font-size:14px">star</span>Gratis</span>
    </div>

    <!-- Auth Card -->
    <div class="kc-card fade-in" style="animation-delay:.16s">

      <!-- Tabs -->
      <div class="kc-seg-ctl" style="margin-bottom:20px">
        <button id="tabLogin" type="button" onclick="switchTab('login')" aria-pressed="true">Iniciar Sesión</button>
        <button id="tabRegister" type="button" onclick="switchTab('register')" aria-pressed="false">Registrarse</button>
      </div>

      <!-- Login Form -->
      <div id="formLogin">
        <div class="kc-field">
          <label class="kc-label">Email</label>
          <input type="email" id="loginEmail" placeholder="tu@email.com" autocomplete="email" spellcheck="false" class="kc-input">
        </div>
        <div class="kc-field" style="margin-bottom:0">
          <label class="kc-label">Contraseña</label>
          <input type="password" id="loginPassword" placeholder="Tu contraseña" autocomplete="current-password" class="kc-input">
        </div>
        <button onclick="handleLogin()" id="loginBtn" class="kc-btn kc-btn--primary kc-btn--block" style="margin-top:16px">
          <span class="material-symbols-outlined" style="font-size:20px">login</span>
          <span>Iniciar Sesión</span>
        </button>
        <p id="loginError" style="display:none"></p>
      </div>

      <!-- Register Form -->
      <div id="formRegister" style="display:none">
        <div class="kc-field">
          <label class="kc-label">Nombre</label>
          <input type="text" id="registerName" placeholder="Tu nombre" autocomplete="given-name" class="kc-input">
        </div>
        <div class="kc-field">
          <label class="kc-label">Email</label>
          <input type="email" id="registerEmail" placeholder="tu@email.com" autocomplete="email" spellcheck="false" class="kc-input">
        </div>
        <div class="kc-field" style="margin-bottom:0">
          <label class="kc-label">Contraseña</label>
          <input type="password" id="registerPassword" placeholder="Mínimo 6 caracteres" autocomplete="new-password" class="kc-input">
        </div>
        <button onclick="handleRegister()" id="registerBtn" class="kc-btn kc-btn--primary kc-btn--block" style="margin-top:16px">
          <span class="material-symbols-outlined" style="font-size:20px">person_add</span>
          <span>Crear Cuenta</span>
        </button>
        <p id="registerError" style="display:none"></p>
      </div>

      <!-- Divider -->
      <div class="wel-divider"><i></i><span class="kc-label">o</span><i></i></div>

      <!-- Demo CTA (modo prueba: recorre la app sin cuenta) -->
      <a href="/app/demo/" class="kc-btn kc-btn--block wel-cta-demo" style="margin-bottom:10px;text-decoration:none">
        <span class="material-symbols-outlined icon-filled" style="font-size:20px">play_circle</span>
        Modo prueba — explora la app sin cuenta
      </a>

      <!-- Suscripción -->
      <a href="/#precios" class="kc-btn kc-btn--secondary kc-btn--block" style="margin-bottom:10px;text-decoration:none">
        <span class="material-symbols-outlined" style="font-size:18px;color:var(--kc-amber)">workspace_premium</span>
        Ver planes y suscribirse
      </a>
      <p class="kc-label" style="text-align:center;font-size:11.5px">El acceso completo a la app requiere suscripción. Explora todo con el modo prueba.</p>
    </div>

    <!-- Benefits -->
    <div class="fade-in" style="margin-top:24px;animation-delay:.24s">
      <div class="wel-benefit"><span class="kc-ico kc-c-amber"><span class="material-symbols-outlined" style="font-size:16px">cloud_sync</span></span>Sincronización en la nube</div>
      <div class="wel-benefit"><span class="kc-ico kc-c-amber"><span class="material-symbols-outlined" style="font-size:16px">install_mobile</span></span>Instala como app en tu móvil</div>
      <div class="wel-benefit"><span class="kc-ico kc-c-amber"><span class="material-symbols-outlined" style="font-size:16px">lock</span></span>Tus datos siempre seguros</div>
    </div>

    <!-- Volver al sitio -->
    <div class="text-center fade-in" style="margin-top:24px;animation-delay:.3s">
      <a href="/" class="kc-link" style="color:var(--kc-ink-3);display:inline-flex;align-items:center;gap:6px">
        <span class="material-symbols-outlined" style="font-size:16px">arrow_back</span>
        Volver al sitio web
      </a>
    </div>

  </div>
</main>

</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="fixed inset-0 z-50 flex items-center justify-center" style="display:none">
  <div class="text-center">
    <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4 animate-pulse-custom" style="background:var(--kc-amber-fill);box-shadow:var(--kc-glow-amber)">
      <span class="material-symbols-outlined text-3xl" style="color:var(--kc-on-amber);font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24">local_fire_department</span>
    </div>
    <p id="loadingText" class="font-semibold" style="color:var(--kc-ink)">Cargando...</p>
  </div>
</div>

<!-- Toast -->
<div id="toast" aria-live="polite" aria-atomic="true" class="fixed bottom-8 left-1/2 -translate-x-1/2 px-5 py-3 rounded-xl font-medium transition-all duration-300 pointer-events-none z-50"
  style="opacity:0;transform:translateX(-50%) translateY(12px)">
  <span id="toastText"></span>
</div>

<script is:inline>
  function switchTab(tab) {
    const loginTab = document.getElementById('tabLogin');
    const registerTab = document.getElementById('tabRegister');
    const loginForm = document.getElementById('formLogin');
    const registerForm = document.getElementById('formRegister');
    if (tab === 'login') {
      loginTab.setAttribute('aria-pressed', 'true');
      registerTab.setAttribute('aria-pressed', 'false');
      loginForm.style.display = '';
      registerForm.style.display = 'none';
    } else {
      registerTab.setAttribute('aria-pressed', 'true');
      loginTab.setAttribute('aria-pressed', 'false');
      registerForm.style.display = '';
      loginForm.style.display = 'none';
    }
  }

  function showLoading(text) {
    document.getElementById('loadingText').textContent = text || 'Cargando...';
    document.getElementById('loadingOverlay').style.display = 'flex';
  }

  function showToast(message, duration) {
    const toast = document.getElementById('toast');
    document.getElementById('toastText').textContent = message;
    toast.style.opacity = '1';
    toast.style.transform = 'translateX(-50%) translateY(0)';
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(-50%) translateY(12px)';
    }, duration || 3000);
  }

  function showError(id, msg) {
    const el = document.getElementById(id);
    el.textContent = msg;
    el.style.display = 'block';
  }

  function clearError(id) {
    document.getElementById(id).style.display = 'none';
  }

  async function handleLogin() {
    const email = document.getElementById('loginEmail').value.trim();
    const password = document.getElementById('loginPassword').value;
    const btn = document.getElementById('loginBtn');
    clearError('loginError');
    if (!email || !password) { showError('loginError', 'Completa todos los campos'); return; }
    btn.disabled = true;
    btn.innerHTML = '<span style="opacity:.7">Iniciando sesión...</span>';
    let data, error;
    try {
      ({ data, error } = await window.supabase.auth.signInWithPassword({ email, password }));
    } catch (e) {
      const savedEmail = localStorage.getItem('ketocore_user_email');
      const savedId = localStorage.getItem('ketocore_user_id');
      if (savedId && savedEmail === email) {
        showLoading('¡Bienvenido!');
        setTimeout(() => {
          window.location.href = localStorage.getItem('ketocore_onboarding_done') ? '/app/' : '/app/onboarding';
        }, 1000);
        return;
      }
      showError('loginError', 'Sin conexión. Prueba el modo demo mientras recuperas internet.');
      btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:20px">login</span><span>Iniciar Sesión</span>';
      btn.disabled = false;
      return;
    }
    if (error) {
      const msg = error.message === 'Invalid login credentials' ? 'Email o contraseña incorrectos' : error.message;
      showError('loginError', msg);
      btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:20px">login</span><span>Iniciar Sesión</span>';
      btn.disabled = false;
      return;
    }
    showLoading('¡Bienvenido!');
    await ensureProfile(data.user);
    localStorage.setItem('ketocore_user_id', data.user.id);
    localStorage.setItem('ketocore_user_email', email);
    setTimeout(() => {
      window.location.href = localStorage.getItem('ketocore_onboarding_done') ? '/app/' : '/app/onboarding';
    }, 1000);
  }

  async function handleRegister() {
    const name = document.getElementById('registerName').value.trim();
    const email = document.getElementById('registerEmail').value.trim();
    const password = document.getElementById('registerPassword').value;
    const btn = document.getElementById('registerBtn');
    clearError('registerError');
    if (!name || !email || !password) { showError('registerError', 'Completa todos los campos'); return; }
    if (password.length < 6) { showError('registerError', 'La contraseña debe tener al menos 6 caracteres'); return; }
    btn.disabled = true;
    btn.innerHTML = '<span style="opacity:.7">Creando cuenta...</span>';
    let data, error;
    try {
      ({ data, error } = await window.supabase.auth.signUp({ email, password, options: { data: { nombre: name } } }));
    } catch (e) {
      const localId = 'local_' + Date.now();
      localStorage.setItem('ketocore_user_id', localId);
      localStorage.setItem('ketocore_user_email', email);
      localStorage.setItem('ketocore_user_name', name);
      localStorage.removeItem('ketocore_onboarding_done');
      showLoading('¡Cuenta creada!');
      setTimeout(() => { window.location.href = '/app/onboarding'; }, 1000);
      return;
    }
    if (error) {
      showError('registerError', error.message);
      btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:20px">person_add</span><span>Crear Cuenta</span>';
      btn.disabled = false;
      return;
    }
    showLoading('¡Cuenta creada!');
    await ensureProfile(data.user);
    localStorage.setItem('ketocore_user_id', data.user.id);
    localStorage.setItem('ketocore_user_email', email);
    localStorage.removeItem('ketocore_onboarding_done');
    setTimeout(() => { window.location.href = '/app/onboarding'; }, 1000);
  }

  async function ensureProfile(user) {
    if (!user) return;
    try {
      const { data: existing } = await window.supabase.from('usuarios').select('id').eq('id', user.id).single();
      if (!existing) {
        await window.supabase.from('usuarios').insert({ id: user.id, email: user.email, nombre: user.user_metadata?.nombre || user.email.split('@')[0] });
        await window.supabase.from('progreso_racha').insert({ usuario_id: user.id, racha_actual: 0, racha_maxima: 0 });
      }
    } catch (e) { /* offline */ }
  }

  async function checkAuth() {
    try {
      const { data: { session } } = await window.supabase.auth.getSession();
      if (session?.user) {
        localStorage.setItem('ketocore_user_id', session.user.id);
        localStorage.setItem('ketocore_user_email', session.user.email);
        window.location.href = localStorage.getItem('ketocore_onboarding_done') ? '/app/' : '/app/onboarding';
      }
    } catch (e) { /* offline */ }
  }

  checkAuth();
</script>

</AppLayout>
