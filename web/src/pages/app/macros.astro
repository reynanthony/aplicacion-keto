---
// Macros — v3. Donut de reparto real + 3 filas de macro (Netos, Grasas,
// Proteína, en ese orden) + Registro de hoy como DataRow. BMR/déficit/días
// para meta/peso/racha se retiran de esta pantalla — pertenecen a Progreso
// (pantalla futura del handoff), no a Macros.
import AppLayout from '../../layouts/AppLayout.astro';
import BudgetHeader from '../../components/v3/BudgetHeader.astro';
import DataRow from '../../components/v3/DataRow.astro';
import Sheet from '../../components/v3/Sheet.astro';
import Dock from '../../components/v3/Dock.astro';
import VeredictoSheet from '../../components/v3/VeredictoSheet.astro';
---

<AppLayout title="KetoCore | Macros" authGuard={true}>
  <style is:global>
    #appSidebar, #kcTabbar, #kcDrawer { display: none !important; }
  </style>

  <div data-v3 style="background:var(--v3-surface-app); min-height:100vh;">
    <main style="padding: var(--v3-pad-screen) var(--v3-pad-screen) 140px; max-width:520px; margin:0 auto; display:flex; flex-direction:column; gap: var(--v3-gap-block);">

      <div id="macrosBudgetHeader">
        <BudgetHeader used={0} limit={25} variant="bar" label="Macros" />
      </div>

      <div style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-card); padding:24px; display:flex; flex-direction:column; align-items:center; gap:20px;">
        <div style="position:relative; width:190px; height:190px; flex-shrink:0;">
          <svg width="190" height="190" viewBox="0 0 200 200">
            <circle cx="100" cy="100" r="80" fill="none" stroke="rgba(230,255,242,0.06)" stroke-width="22"></circle>
            <circle id="donutCarb" cx="100" cy="100" r="80" fill="none" stroke="var(--v3-lime)" stroke-width="22" stroke-dasharray="0 503" transform="rotate(-90 100 100)" stroke-linecap="round" style="transition:stroke-dasharray 1.2s cubic-bezier(.4,0,.2,1)"></circle>
            <circle id="donutFat" cx="100" cy="100" r="80" fill="none" stroke="var(--v3-amber)" stroke-width="22" stroke-dasharray="0 503" transform="rotate(-90 100 100)" stroke-linecap="round" style="transition:stroke-dasharray 1.2s cubic-bezier(.4,0,.2,1)"></circle>
            <circle id="donutProt" cx="100" cy="100" r="80" fill="none" stroke="var(--v3-cream)" stroke-width="22" stroke-dasharray="0 503" transform="rotate(-90 100 100)" stroke-linecap="round" style="transition:stroke-dasharray 1.2s cubic-bezier(.4,0,.2,1)"></circle>
          </svg>
          <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;">
            <div id="mxKcalNow" class="v3-num-mono" style="font-size:32px; color:var(--v3-text);">0</div>
            <div style="font-size:11px; color:var(--v3-text-40); margin-top:2px;">de <span id="mxKcalTarget">--</span> kcal</div>
          </div>
        </div>
        <div style="width:100%; display:flex; flex-direction:column; gap:10px;">
          <p style="font-size:12.5px; color:var(--v3-text-50); margin:0 0 4px;">Objetivo: 70% grasas · 25% proteína · 5% carbos</p>
          <div style="display:flex; align-items:center; gap:10px;"><span style="width:10px; height:10px; border-radius:3px; background:var(--v3-lime); flex-shrink:0;"></span><span style="flex:1; font-size:13.5px; color:var(--v3-text);">Carbos netos</span><span id="mxPctCarb" class="v3-num-mono">--%</span></div>
          <div style="display:flex; align-items:center; gap:10px;"><span style="width:10px; height:10px; border-radius:3px; background:var(--v3-amber); flex-shrink:0;"></span><span style="flex:1; font-size:13.5px; color:var(--v3-text);">Grasas</span><span id="mxPctFat" class="v3-num-mono">--%</span></div>
          <div style="display:flex; align-items:center; gap:10px;"><span style="width:10px; height:10px; border-radius:3px; background:var(--v3-cream); flex-shrink:0;"></span><span style="flex:1; font-size:13.5px; color:var(--v3-text);">Proteína</span><span id="mxPctProt" class="v3-num-mono">--%</span></div>
        </div>
      </div>

      <div id="mxRowNetos" data-macro-row style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:16px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
          <span class="v3-eyebrow">Carbos netos</span>
          <span class="v3-num-mono"><span id="mxCarbNow">0</span> / <span id="mxCarbTarget">--</span> g</span>
        </div>
        <div class="v3-bh-bar-track" style="height:6px;"><div id="mxCarbBar" class="v3-bh-bar-fill" style="width:0%; background:var(--v3-lime);"></div></div>
        <p id="mxCarbNote" style="font-size:11.5px; color:var(--v3-text-40); margin:8px 0 0;">--</p>
      </div>

      <div id="mxRowGrasas" data-macro-row style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:16px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
          <span class="v3-eyebrow">Grasas</span>
          <span class="v3-num-mono"><span id="mxFatNow">0</span> / <span id="mxFatTarget">--</span> g</span>
        </div>
        <div class="v3-bh-bar-track" style="height:6px;"><div id="mxFatBar" class="v3-bh-bar-fill" style="width:0%; background:var(--v3-amber);"></div></div>
        <p id="mxFatNote" style="font-size:11.5px; color:var(--v3-text-40); margin:8px 0 0;">--</p>
      </div>

      <div id="mxRowProteina" data-macro-row style="background:var(--v3-surface-1); border:1px solid var(--v3-border); border-radius:var(--v3-radius-tile); padding:16px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
          <span class="v3-eyebrow">Proteína</span>
          <span class="v3-num-mono"><span id="mxProtNow">0</span> / <span id="mxProtTarget">--</span> g</span>
        </div>
        <div class="v3-bh-bar-track" style="height:6px;"><div id="mxProtBar" class="v3-bh-bar-fill" style="width:0%; background:var(--v3-cream);"></div></div>
        <p id="mxProtNote" style="font-size:11.5px; color:var(--v3-text-40); margin:8px 0 0;">--</p>
      </div>

      <section>
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
          <p class="v3-eyebrow" style="margin:0;">Registro de hoy</p>
          <span id="mxLogSummary" style="font-size:12px; color:var(--v3-text-40);">0 comidas</span>
        </div>
        <div id="mxLogRows"></div>
        <div style="display:none"><DataRow id="_v3-datarow-script-anchor-macros" title="" /></div>
      </section>

    </main>

    <VeredictoSheet />
    <Sheet id="v3-sheet-registrar" title="Registrar" subtitle="Margen de hoy · — g netos">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
        <a href="/app/scanner" class="v3-decision-card-action" style="background:var(--v3-lime); color:var(--v3-text-on-lime); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">center_focus_strong</span> Escanear
        </a>
        <a href="/app/alimentos" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">search</span> Buscar
        </a>
        <button type="button" class="v3-decision-card-action" disabled style="background:var(--v3-surface-2); color:var(--v3-text-40); justify-content:center; cursor:not-allowed;">
          <span class="material-symbols-outlined" style="font-size:18px">mic</span> Dictar · Próximamente
        </button>
        <a href="/app/recetas" class="v3-decision-card-action" style="background:var(--v3-surface-2); color:var(--v3-text); justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:18px">menu_book</span> Recetas
        </a>
      </div>
      <Fragment slot="footnote">Offline · sincroniza solo</Fragment>
    </Sheet>
    <Dock active="macros" fabSheetId="v3-sheet-registrar" />
  </div>

  <script is:inline src="/app/utils.js"></script>
  <script is:inline src="/app/modules/day-budget.js"></script>
  <script is:inline src="/app/modules/meal-log.js"></script>
  <script is:inline src="/app/modules/v3-motion.js"></script>
  <script is:inline src="/app/modules/v3-budget-header.js"></script>
  <script is:inline src="/app/modules/inspectorKeto.js"></script>
  <script is:inline src="/app/modules/v3-veredicto.js"></script>

  <script is:inline>
    function fmt(n){var s=String(Math.round(Number(n)));return s.replace(/(\d)(?=(\d{3})+(?!\d))/g,'$1,');}

    var MEAL_META={
      desayuno:{label:'Desayuno',icon:'wb_sunny'},
      almuerzo:{label:'Almuerzo',icon:'restaurant'},
      cena:{label:'Cena',icon:'nightlight'},
      snacks:{label:'Snack',icon:'lunch_dining'}
    };

    function loadMacrosData(animate){
      var m = safeParseJSON(localStorage.getItem('keto_macros'), {});
      var protTarget = Number(m.protein) || 0, fatTarget = Number(m.fat) || 0;
      var budget = window.KetoBudget.compute();
      var calTarget = Number(m.calories) || 0;

      // Sumar consumo de hoy directo, sin re-escalar por portion/100 —
      // item.protein/fat/carbs en mealPlan_ ya son valores absolutos
      // pre-escalados (corrige el doble escalado que tenía esta pantalla).
      var items = window.KetoMealLog.getRecentItems(999);
      var cCal=0, cProt=0, cFat=0;
      items.forEach(function(item){
        cCal += Number(item.calories) || 0;
        cProt += Number(item.protein) || 0;
        cFat += Number(item.fat) || 0;
      });
      var cCarb = budget.used;

      var header = document.querySelector('#macrosBudgetHeader .v3-budget-header');
      window.V3BudgetHeader.render(header, budget, { animate: animate });

      var C = 503;
      var totalMacroCal = (cProt*4) + (cFat*9) + (cCarb*4);
      var carbPct=0, fatPct=0, protPct=0;
      if (totalMacroCal > 0) {
        carbPct = Math.round((cCarb*4/totalMacroCal)*100);
        fatPct = Math.round((cFat*9/totalMacroCal)*100);
        protPct = Math.max(0, 100-carbPct-fatPct);
      }
      var carbArc=C*carbPct/100, fatArc=C*fatPct/100, protArc=C*protPct/100;
      var dC=document.getElementById('donutCarb'), dF=document.getElementById('donutFat'), dP=document.getElementById('donutProt');
      if (dC) { dC.setAttribute('stroke-dasharray', carbArc+' '+C); dC.setAttribute('transform','rotate(-90 100 100)'); }
      if (dF) { dF.setAttribute('stroke-dasharray', fatArc+' '+C); dF.setAttribute('transform','rotate('+(-90+carbPct*3.6)+' 100 100)'); }
      if (dP) { dP.setAttribute('stroke-dasharray', protArc+' '+C); dP.setAttribute('transform','rotate('+(-90+(carbPct+fatPct)*3.6)+' 100 100)'); }
      document.getElementById('mxKcalNow').textContent = fmt(cCal);
      document.getElementById('mxKcalTarget').textContent = calTarget ? fmt(calTarget) : '--';
      document.getElementById('mxPctCarb').textContent = carbPct+'%';
      document.getElementById('mxPctFat').textContent = fatPct+'%';
      document.getElementById('mxPctProt').textContent = protPct+'%';

      function setMacro(now, target, barId, nowId, targetId, noteId, kcalPerG){
        document.getElementById(nowId).textContent = fmt(now);
        document.getElementById(targetId).textContent = target ? fmt(target) : '--';
        var pct = target>0 ? Math.min(100, Math.round(now/target*100)) : 0;
        document.getElementById(barId).style.width = pct+'%';
        var left = Math.max(0, target-now);
        document.getElementById(noteId).textContent = fmt(now*kcalPerG)+' kcal · '+(target?('quedan '+left+' g'):'sin meta');
      }
      setMacro(cCarb, budget.limit, 'mxCarbBar', 'mxCarbNow', 'mxCarbTarget', 'mxCarbNote', 4);
      setMacro(cFat, fatTarget, 'mxFatBar', 'mxFatNow', 'mxFatTarget', 'mxFatNote', 9);
      setMacro(cProt, protTarget, 'mxProtBar', 'mxProtNow', 'mxProtTarget', 'mxProtNote', 4);

      var summary = document.getElementById('mxLogSummary');
      if (summary) summary.textContent = items.length + (items.length===1?' comida':' comidas') + ' · ' + fmt(cCal) + ' kcal';

      var logEl = document.getElementById('mxLogRows');
      if (!items.length) {
        logEl.innerHTML = '<p style="font-size:13px; color:var(--v3-text-40); padding:8px 2px;">No hay alimentos registrados hoy.</p>';
      } else {
        logEl.innerHTML = items.map(function(item){
          var meta = MEAL_META[item.mealSlot] || { label: item.mealSlot, icon: 'restaurant' };
          var time = item.addedAt ? new Date(item.addedAt).toTimeString().slice(0,5) : '--:--';
          return '' +
            '<div class="v3-row-wrap" data-row-id="'+item.id+'">' +
              '<div class="v3-row-actions">' +
                '<button type="button" class="v3-row-action v3-row-action--edit" data-row-action="edit">Editar</button>' +
                '<button type="button" class="v3-row-action v3-row-action--delete" data-row-action="delete">Borrar</button>' +
              '</div>' +
              '<div class="v3-row">' +
                '<span class="v3-row-lead"><span class="material-symbols-outlined">'+meta.icon+'</span></span>' +
                '<div class="v3-row-content v3-row-content--pending">' +
                  '<div class="v3-row-body">' +
                    '<div class="v3-row-title">'+escapeHtml(item.name)+'</div>' +
                    '<div class="v3-row-meta">'+time+' · '+meta.label+' · '+fmt(item.calories)+' kcal</div>' +
                  '</div>' +
                  '<div class="v3-row-value v3-num-mono">'+Math.round(item.carbs)+'<span class="v3-row-unit">g</span></div>' +
                '</div>' +
              '</div>' +
            '</div>';
        }).join('');
      }

      var sub = document.querySelector('#v3-sheet-registrar .v3-sheet-subtitle');
      if (sub) sub.textContent = 'Margen de hoy · ' + Math.round(budget.available) + ' g netos';
    }

    document.addEventListener('DOMContentLoaded', function () { loadMacrosData(false); });
    document.addEventListener('v3:meal-logged', function () { loadMacrosData(true); });
    document.addEventListener('v3:row-swipe', function (e) {
      if (e.detail.action !== 'delete') return;
      var today = getTodayKey();
      var plan = safeParseJSON(localStorage.getItem('mealPlan_'+today), {});
      Object.keys(plan).forEach(function(slot){
        if (!Array.isArray(plan[slot])) return;
        plan[slot] = plan[slot].filter(function(it){ return it.id !== e.detail.id; });
      });
      localStorage.setItem('mealPlan_'+today, JSON.stringify(plan));
      window.KetoBudget.refresh();
      loadMacrosData(false);
    });
  </script>
</AppLayout>
