---
// Macros — UI v2 (HUD) con datos reales (kc-adapter). Sin FastingCard (KetoCore
// no lleva temporizador de ayuno). Respaldo del original: macros.astro.bak
import AppShell from '../../layouts/AppShell.astro';
import DaySelector from '../../components/kc/DaySelector.astro';
import MacroSplit from '../../components/kc/MacroSplit.astro';
import Card from '../../components/kc/Card.astro';
import FastingCard from '../../components/kc/FastingCard.astro';
import MealList from '../../components/kc/MealList.astro';
import Icon from '../../components/kc/Icon.astro';
const rows = [
  { k: 'fat', n: 'Grasa', c: 'amber' },
  { k: 'protein', n: 'Proteína', c: 'cyan' },
  { k: 'carbs', n: 'Carbos netos', c: 'mint' },
  { k: 'fiber', n: 'Fibra', c: 'neutral' },
];
---
<AppShell title="Macros" screen="macros">
  <div>
    <div class="kc-hero-sub" data-kc-text="subtitle">&nbsp;</div>
    <h1 class="kc-hero">Te quedan <em><span data-kc-text="energy.kcal.left" data-kc-fmt="int">—</span> kcal</em></h1>
  </div>

  <DaySelector />

  <MacroSplit path="split" />

  <Card eyebrow="Detalle" title="Macronutrientes">
    <span slot="chip" class="kc-chip kc-c-mint" data-kc-text="ketoStatus">—</span>
    {rows.map((r) => (
      <div class={`kc-mrow kc-c-${r.c}`}>
        <div class="kc-mrow__top">
          <span class="kc-mrow__n"><i></i>{r.n}</span>
          <span class="kc-mrow__v"><span data-kc-text={`energy.${r.k}.value`}>—</span> <small>/ <span data-kc-text={`energy.${r.k}.goal`}></span> g</small></span>
        </div>
        <div class="kc-bar kc-bar--lg"><i data-kc-pct={`energy.${r.k}.pct`}></i></div>
        <div class="kc-mrow__f kc-label"><span><span data-kc-text={`energy.${r.k}.pct`} data-kc-fmt="pct"></span> de la meta</span><span data-kc-text={`energy.${r.k}.note`}></span></div>
      </div>
    ))}
  </Card>

  <FastingCard />

  <div class="kc-search">
    <Icon name="search" />
    <input type="search" placeholder="Busca un alimento o pega un código" aria-label="Buscar alimento" data-kc-action="food:search" />
    <button class="kc-btn kc-btn--secondary kc-btn--sm" type="button" data-kc-action="log:scan"><Icon name="scan" />Inspector</button>
  </div>

  <MealList>
    <div style="margin-top:12px"><button class="kc-btn kc-btn--primary kc-btn--block" type="button" data-kc-action="log:food"><Icon name="plus" />Añadir comida</button></div>
  </MealList>

  <Fragment slot="scripts">
    <script is:inline src="/app/utils.js"></script>
    <script is:inline src="/app/modules/meal-plan.js"></script>
    <script is:inline src="/app/modules/health-score.js"></script>
    <script is:inline src="/app/kc-adapter.js"></script>
  </Fragment>
</AppShell>
