---
// Guía — UI v2 (HUD nativo). Reescrito a markup kc-* (hero + tarjetas de
// pasos + tips). Lógica intacta (cierre/recordar, redirect si ya se vio).
// Respaldo: guia.astro.bak
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="Guía" screen="guia">
<style is:global>
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.kc .gui-step{animation:fadeIn .4s ease forwards}
.kc .gui-num{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font:700 15px var(--kc-font-sans);background:var(--kc-amber-fill);color:var(--kc-on-amber);flex-shrink:0}
.kc .gui-step__head{display:flex;align-items:center;gap:10px;margin-bottom:2px}
.kc .gui-step__icon{font-size:19px;color:var(--c,var(--kc-ink-2))}
.kc .gui-step__title{font:600 15px/20px var(--kc-font-sans);color:var(--kc-ink)}
.kc .gui-step__desc{font:500 13px/18px var(--kc-font-sans);color:var(--kc-ink-2);margin:8px 0 10px}
.kc .gui-bullets{background:var(--kc-surface-2);border-radius:var(--kc-radius-sm);padding:10px 12px;display:flex;flex-direction:column;gap:7px;margin-bottom:10px}
.kc .gui-bullet{display:flex;align-items:center;gap:8px;font:500 13px var(--kc-font-sans);color:var(--kc-ink-2)}
.kc .gui-bullet .material-symbols-outlined{font-size:17px;color:var(--c,var(--kc-ink-3))}
.kc .gui-tip{display:flex;gap:10px;padding:12px 0}
.kc .gui-tip+.gui-tip{border-top:1px solid var(--kc-line)}
.kc .gui-tip .material-symbols-outlined{font-size:20px;flex-shrink:0;margin-top:1px;color:var(--c,var(--kc-ink-2))}
.kc .gui-tip__t{font:600 13.5px var(--kc-font-sans);color:var(--kc-ink)}
.kc .gui-tip__d{font:500 12.5px/17px var(--kc-font-sans);color:var(--kc-ink-3);margin-top:2px}
.kc .gui-remember{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:4px;font:500 13px var(--kc-font-sans);color:var(--kc-ink-3)}
.kc .gui-remember input{width:16px;height:16px;accent-color:var(--kc-amber-fill)}
</style>

<!-- Hero -->
<div>
  <div class="kc-hero-sub">Ayuda · Primeros pasos</div>
  <h1 class="kc-hero">Aprende a usar <em>KetoCore</em></h1>
  <p style="font:500 13px/19px var(--kc-font-sans);color:var(--kc-ink-3);margin-top:-4px">Sigue estos pasos para sacar el máximo provecho de la app.</p>
</div>

<!-- Steps -->
<div class="kc-stack">

<div class="gui-step kc-card">
  <div class="gui-step__head"><span class="gui-num">1</span><span class="material-symbols-outlined gui-step__icon kc-c-amber">person</span><h3 class="gui-step__title">Completa tu Perfil</h3></div>
  <p class="gui-step__desc">Configura tus datos para calcular tus macros personalizados.</p>
  <div class="gui-bullets">
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-mint">check</span>Peso actual y meta de peso</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-mint">check</span>Altura, edad y sexo</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-mint">check</span>Nivel de actividad física</div>
  </div>
  <a href="/app/perfil" class="kc-link" style="display:inline-flex;align-items:center;gap:6px">Ir al Perfil<span class="material-symbols-outlined" style="font-size:17px">arrow_forward</span></a>
</div>

<div class="gui-step kc-card" style="animation-delay:.1s">
  <div class="gui-step__head"><span class="gui-num">2</span><span class="material-symbols-outlined gui-step__icon kc-c-cyan">fact_check</span><h3 class="gui-step__title">Usa el Checklist Diario</h3></div>
  <p class="gui-step__desc">Registra tu agua, electrolitos, ejercicio y más cada día.</p>
  <div class="gui-bullets">
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-cyan">water_drop</span>Agua: 3L diarios</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-amber">science</span>Electrolitos: 500ml</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-red">fitness_center</span>Ejercicio: 60 minutos</div>
  </div>
  <a href="/app/checklist" class="kc-link" style="display:inline-flex;align-items:center;gap:6px">Ir al Checklist<span class="material-symbols-outlined" style="font-size:17px">arrow_forward</span></a>
</div>

<div class="gui-step kc-card" style="animation-delay:.2s">
  <div class="gui-step__head"><span class="gui-num">3</span><span class="material-symbols-outlined gui-step__icon kc-c-mint">event_note</span><h3 class="gui-step__title">Planifica tu Semana</h3></div>
  <p class="gui-step__desc">Genera un plan de comidas automático o crea el tuyo manualmente.</p>
  <div class="gui-bullets">
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-mint">auto_awesome</span>Generador automático de planes</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-amber">block</span>Excluye ingredientes no deseados</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-cyan">swap_horiz</span>Sustitución automática de recetas</div>
  </div>
  <a href="/app/plan" class="kc-link" style="display:inline-flex;align-items:center;gap:6px">Ir al Plan<span class="material-symbols-outlined" style="font-size:17px">arrow_forward</span></a>
</div>

<div class="gui-step kc-card" style="animation-delay:.3s">
  <div class="gui-step__head"><span class="gui-num">4</span><span class="material-symbols-outlined gui-step__icon kc-c-red">restaurant</span><h3 class="gui-step__title">Gestiona tu Despensa</h3></div>
  <p class="gui-step__desc">Añade alimentos disponibles y genera tu lista de compras.</p>
  <div class="gui-bullets">
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-red">add_circle</span>Añade alimentos con código de barras</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-cyan">shopping_cart</span>Genera lista de compras semanal</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-mint">category</span>Organiza por categorías</div>
  </div>
  <a href="/app/alimentos" class="kc-link" style="display:inline-flex;align-items:center;gap:6px">Ir a Alimentos<span class="material-symbols-outlined" style="font-size:17px">arrow_forward</span></a>
</div>

<div class="gui-step kc-card" style="animation-delay:.4s">
  <div class="gui-step__head"><span class="gui-num">5</span><span class="material-symbols-outlined gui-step__icon kc-c-amber">donut_small</span><h3 class="gui-step__title">Sigue tus Macros</h3></div>
  <p class="gui-step__desc">Visualiza tu progreso calórico y de nutrientes.</p>
  <div class="gui-bullets">
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-amber">local_fire_department</span>Calorías diarias</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-mint">egg_alt</span>Proteína, grasas y carbos</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-cyan">monitor_weight</span>Evolución de peso</div>
  </div>
  <a href="/app/macros" class="kc-link" style="display:inline-flex;align-items:center;gap:6px">Ir a Macros<span class="material-symbols-outlined" style="font-size:17px">arrow_forward</span></a>
</div>

<div class="gui-step kc-card" style="animation-delay:.5s">
  <div class="gui-step__head"><span class="gui-num">6</span><span class="material-symbols-outlined gui-step__icon kc-c-cyan">fitness_center</span><h3 class="gui-step__title">Entrenamientos</h3></div>
  <p class="gui-step__desc">Rutinas personalizadas para casa o gimnasio.</p>
  <div class="gui-bullets">
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-mint">home</span>Ejercicios sin equipamiento</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-amber">fitness_center</span>Rutinas con pesas</div>
    <div class="gui-bullet"><span class="material-symbols-outlined kc-c-cyan">bar_chart</span>Historial de progreso</div>
  </div>
  <a href="/app/entrenamientos" class="kc-link" style="display:inline-flex;align-items:center;gap:6px">Ir a Entrenamientos<span class="material-symbols-outlined" style="font-size:17px">arrow_forward</span></a>
</div>

</div>

<!-- Tips -->
<div class="kc-card">
  <h3 class="kc-card__title" style="display:flex;align-items:center;gap:8px;margin-top:0"><span class="material-symbols-outlined kc-c-mint" style="color:var(--c)">lightbulb</span>Consejos Rápidos</h3>
  <div class="gui-tip">
    <span class="material-symbols-outlined kc-c-amber" style="color:var(--c)">touch_app</span>
    <div><div class="gui-tip__t">Toca el donut chart</div><div class="gui-tip__d">En el dashboard puedes tocar el progreso para ver detalles de macros.</div></div>
  </div>
  <div class="gui-tip">
    <span class="material-symbols-outlined kc-c-cyan" style="color:var(--c)">water_drop</span>
    <div><div class="gui-tip__t">Registra el agua inmediatamente</div><div class="gui-tip__d">Usa el modal rápido de agua desde el dashboard.</div></div>
  </div>
  <div class="gui-tip">
    <span class="material-symbols-outlined kc-c-amber" style="color:var(--c)">block</span>
    <div><div class="gui-tip__t">Usa exclusiones inteligentes</div><div class="gui-tip__d">En Plan puedes excluir ingredientes y el sistema sustituye automáticamente.</div></div>
  </div>
  <div class="gui-tip">
    <span class="material-symbols-outlined kc-c-mint" style="color:var(--c)">qr_code_scanner</span>
    <div><div class="gui-tip__t">Escanea códigos de barras</div><div class="gui-tip__d">Añade alimentos rápidamente escaneando el producto.</div></div>
  </div>
</div>

<!-- CTA -->
<div style="display:flex;gap:10px">
  <a href="/app/" class="kc-btn kc-btn--primary kc-btn--block"><span class="material-symbols-outlined">person</span>Empezar Ahora</a>
  <button onclick="closeGuide()" class="kc-btn kc-btn--secondary kc-btn--icon" aria-label="Cerrar"><span class="material-symbols-outlined">close</span></button>
</div>

<!-- Recordar -->
<label class="gui-remember">
  <input type="checkbox" id="dontShowAgain">
  No mostrar de nuevo
</label>

<Fragment slot="scripts">
<script is:inline>
function closeGuide() {
  if (document.getElementById('dontShowAgain').checked) {
    localStorage.setItem('KetoCore_guide_seen', 'true');
  }
  window.location.href = '/app/';
}

// Check if already seen
if (localStorage.getItem('KetoCore_guide_seen')) {
  window.location.href = '/app/';
}
</script>
</Fragment>
</AppShell>
