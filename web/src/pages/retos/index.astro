---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const challenges = await getCollection('challenges');
---

<Layout title="Retos" description="Retos keto con comunidad activa. 7 días sin azúcar, 30 días keto, retos de ayuno y más. Únete y comprométete al cambio.">

<section style="padding:3rem 0 2rem">
  <div class="wrap">
    <span class="chip" style="margin-bottom:1rem;display:inline-block">Centro de retos</span>
    <h1 class="d" style="font-size:clamp(2rem,4vw,3.25rem);margin-bottom:1rem">Los retos con comunidad<br>funcionan 3× más.</h1>
    <p style="color:var(--c-text-muted);font-size:1.0625rem;max-width:560px">La rendición de cuentas pública transforma la disciplina temporal en hábitos permanentes. Únete a un reto y compruébalo.</p>
  </div>
</section>

<!-- Active challenges -->
<section style="padding:0 0 4rem">
  <div class="wrap">
    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:2rem">
      <span style="width:8px;height:8px;border-radius:50%;background:var(--c-green);display:inline-block"></span>
      <p style="font-size:0.875rem;font-weight:700;color:var(--c-green)">{challenges.filter(c => c.data.active).length} retos activos ahora mismo</p>
    </div>

    <div class="grid-2">
      {challenges.map(async c => {
        const { Content } = await render(c);
        return (
          <div class="card" style="padding:2rem;overflow:hidden;position:relative">
            {c.data.image && (
              <div style="position:absolute;inset:0;opacity:0.04">
                <img src={c.data.image} alt="" style="width:100%;height:100%;object-fit:cover">
              </div>
            )}
            <div style="position:relative;z-index:1">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.25rem;gap:1rem">
                <div>
                  <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.625rem;flex-wrap:wrap">
                    <span class="chip">{c.data.category}</span>
                    <span class="badge">{c.data.difficulty}</span>
                    {c.data.active && (
                      <span style="display:flex;align-items:center;gap:0.25rem;font-size:0.7rem;color:var(--c-green)">
                        <span style="width:5px;height:5px;border-radius:50%;background:var(--c-green);display:inline-block"></span>
                        Activo
                      </span>
                    )}
                  </div>
                  <h2 style="font-family:var(--font-display);font-weight:900;font-size:1.25rem;line-height:1.3">{c.data.title}</h2>
                </div>
                <div style="text-align:right;flex-shrink:0">
                  <p style="font-family:var(--font-display);font-weight:900;font-size:1.5rem;color:var(--c-primary)">{c.data.duration}</p>
                  <p style="font-size:0.7rem;color:var(--c-text-dim)">duración</p>
                </div>
              </div>

              <p style="color:var(--c-text-muted);font-size:0.875rem;line-height:1.7;margin-bottom:1.25rem">{c.data.description}</p>

              {c.data.benefits.length > 0 && (
                <div style="display:flex;flex-direction:column;gap:0.375rem;margin-bottom:1.5rem">
                  {c.data.benefits.slice(0, 3).map(b => (
                    <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.8125rem;color:var(--c-text-muted)">
                      <span class="icon icon-fill" style="color:var(--c-green);font-size:14px">check_circle</span>
                      {b}
                    </div>
                  ))}
                </div>
              )}

              <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem">
                <span style="display:flex;align-items:center;gap:0.375rem;font-size:0.8125rem;color:var(--c-text-dim)">
                  <span class="icon" style="font-size:16px">groups</span>
                  {c.data.participants.toLocaleString()} participantes
                </span>
                <a href="/app/welcome" class="btn btn-sm">Unirme al reto</a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<hr class="rule">

<!-- Challenge types coming -->
<section class="section">
  <div class="wrap">
    <div class="section-header">
      <span class="chip">Próximamente</span>
      <h2 class="d" style="font-size:clamp(1.75rem,3vw,2.5rem)">Más retos en camino</h2>
    </div>
    <div class="grid-3">
      {[
        { icon: 'water_drop', title: 'Reto de hidratación 21 días', desc: 'Beber 2.5L diarios durante 3 semanas. Piel, energía y concentración.', pronto: true },
        { icon: 'directions_walk', title: 'Reto de caminata', desc: '30 minutos diarios durante 30 días. El ejercicio más subestimado.', pronto: true },
        { icon: 'bedtime', title: 'Reto de sueño', desc: '8 horas de sueño durante 14 días. El suplemento gratuito más efectivo.', pronto: true },
      ].map(c => (
        <div class="card" style="padding:1.5rem;opacity:0.6">
          <span class="icon icon-fill" style="font-size:28px;color:var(--c-primary);margin-bottom:0.75rem;display:block">{c.icon}</span>
          <span class="badge" style="margin-bottom:0.75rem;display:inline-block">Próximamente</span>
          <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:800;margin-bottom:0.5rem">{c.title}</h3>
          <p style="font-size:0.8125rem;color:var(--c-text-muted);line-height:1.6">{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section" style="background:var(--c-surface);text-align:center">
  <div class="wrap" style="max-width:560px;margin:0 auto">
    <h2 class="d" style="font-size:clamp(1.75rem,3vw,2.5rem);margin-bottom:1rem">Los retos son mejores con tu historial en la app.</h2>
    <p style="color:var(--c-text-muted);margin-bottom:2rem">Registra progreso, comparte milestones y recibe notificaciones de la comunidad.</p>
    <a href="/app/welcome" class="btn">Unirme a KetoCore</a>
  </div>
</section>
</Layout>
