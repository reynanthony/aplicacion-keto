---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const foods = await getCollection('foods');
const foodCount = foods.length;
const categories = [...new Set(foods.map(f => f.data.category))];
---

<Layout title="Base de Datos de Alimentos" description={`Guía nutricional keto: ${foodCount} alimentos con perfil nutricional completo, compatibilidad con dietas y guía de uso.`}>

<section style="padding:3rem 0 2rem">
  <div class="wrap">
    <span class="chip" style="margin-bottom:1rem;display:inline-block">Base de datos nutricional · En crecimiento</span>
    <h1 class="d" style="font-size:clamp(2rem,4vw,3.25rem);margin-bottom:1rem">¿Puedo comerlo en keto?</h1>
    <p style="color:var(--c-text-muted);font-size:1.0625rem;max-width:560px">Macros, beneficios, compatibilidad con dietas y cómo incorporar cada alimento en tu protocolo. La base de datos pública tiene {foodCount} alimentos hoy — en la app tienes búsqueda completa y escáner de código de barras.</p>
  </div>
</section>

<!-- Search -->
<section style="padding:0 0 2rem;border-bottom:1px solid var(--c-border)">
  <div class="wrap">
    <div style="max-width:480px;position:relative">
      <span class="icon" style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--c-text-dim)">search</span>
      <input id="food-search" type="text" class="input" placeholder="Buscar alimento..." style="padding-left:2.75rem">
    </div>
  </div>
</section>

<!-- Diet filters -->
<section style="padding:1.5rem 0;border-bottom:1px solid var(--c-border)">
  <div class="wrap">
    <div class="scroll-x" style="gap:0.5rem">
      {['Todo', 'Keto', 'Low Carb', 'Carnivore', 'Alto en proteína', 'Vegetariano', 'Sin gluten'].map((d, i) => (
        <button class={`filter-btn${i === 0 ? ' active' : ''}`} data-diet={d === 'Todo' ? '' : d}>{d}</button>
      ))}
    </div>
  </div>
</section>

<!-- Food grid -->
<section class="section-sm">
  <div class="wrap">
    <div class="grid-4" id="food-grid">
      {foods.map(f => (
        <a href={`/alimentos/${f.id}`} class="card card-link" data-name={f.data.name.toLowerCase()} data-diets={f.data.diets.join(',').toLowerCase()}>
          {f.data.image && <img src={f.data.image} alt={f.data.name} loading="lazy" style="width:100%;height:140px;object-fit:cover">}
          <div style="padding:1rem">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.375rem">
              <h3 style="font-family:var(--font-display);font-size:0.9375rem;font-weight:800">{f.data.name}</h3>
              {f.data.netCarbs <= 3 && <span class="badge" style="background:rgba(34,197,94,0.1);color:var(--c-green)">Keto ✓</span>}
            </div>
            <p style="font-size:0.75rem;color:var(--c-text-dim);margin-bottom:0.625rem">{f.data.category}</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.25rem">
              <span style="font-size:0.7rem;color:var(--c-text-dim)">{f.data.calories} kcal</span>
              <span style="font-size:0.7rem;color:var(--c-green);font-weight:600">{f.data.netCarbs}g net carbs</span>
              <span style="font-size:0.7rem;color:#818cf8">{f.data.protein}g prot</span>
              <span style="font-size:0.7rem;color:var(--c-gold)">{f.data.fat}g grasa</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    {foods.length === 0 && (
      <div style="text-align:center;padding:4rem;color:var(--c-text-dim)">
        <span class="icon" style="font-size:48px;display:block;margin-bottom:1rem">restaurant</span>
        <p>La base de datos de alimentos se está construyendo</p>
        <a href="/app/welcome" class="btn" style="margin-top:1.5rem;display:inline-flex">Acceder a la base completa en la app</a>
      </div>
    )}

    <!-- App teaser -->
    <div class="card" style="margin-top:3rem;padding:2.5rem;text-align:center;background:var(--c-surface)">
      <span class="chip" style="margin-bottom:1rem;display:inline-block">En la app</span>
      <h2 class="d" style="font-size:clamp(1.5rem,2.5vw,2rem);margin-bottom:0.875rem">Base de datos completa + escáner de código de barras</h2>
      <p style="color:var(--c-text-muted);font-size:0.9375rem;margin-bottom:1.75rem">En la app tienes acceso completo con búsqueda de alimentos, escáner, registro de comidas y seguimiento de macros en tiempo real.</p>
      <a href="/app/welcome" class="btn">Acceder gratis</a>
    </div>
  </div>
</section>

<style>
  .filter-btn {
    padding: 0.375rem 0.875rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    color: var(--c-text-muted);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    font-family: var(--font-body);
  }
  .filter-btn:hover, .filter-btn.active {
    background: var(--c-primary-dim);
    border-color: var(--c-primary-border);
    color: var(--c-primary);
  }
</style>

<script>
  const search = document.getElementById('food-search') as HTMLInputElement;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#food-grid a');
  let activeDiet = '';

  function applyFilters() {
    const query = search.value.toLowerCase();
    cards.forEach(card => {
      const name = card.dataset.name ?? '';
      const diets = card.dataset.diets ?? '';
      const matchSearch = !query || name.includes(query);
      const matchDiet = !activeDiet || diets.includes(activeDiet.toLowerCase());
      (card as HTMLElement).hidden = !(matchSearch && matchDiet);
    });
  }

  search?.addEventListener('input', applyFilters);

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDiet = btn.dataset.diet ?? '';
      applyFilters();
    });
  });
</script>
</Layout>
