---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const protocols = await getCollection('protocols');
  return protocols.map(p => ({ params: { slug: p.id }, props: { protocol: p } }));
}

const { protocol } = Astro.props;
const { Content } = await render(protocol);
const related = (await getCollection('protocols'))
  .filter(p => p.id !== protocol.id)
  .slice(0, 2);
---

<Layout title={protocol.data.title} description={protocol.data.description} image={protocol.data.image}>

<div class="wrap" style="max-width:860px;margin:0 auto;padding-top:2.5rem">
  <!-- Breadcrumb -->
  <nav style="display:flex;align-items:center;gap:0.5rem;margin-bottom:2rem;font-size:0.8125rem;color:var(--c-text-dim)">
    <a href="/" style="color:var(--c-text-dim);text-decoration:none">Inicio</a>
    <span>›</span>
    <a href="/protocolos" style="color:var(--c-text-dim);text-decoration:none">Protocolos</a>
    <span>›</span>
    <span style="color:var(--c-text-muted)">{protocol.data.title}</span>
  </nav>

  <div style="display:grid;grid-template-columns:1fr 300px;gap:3rem;align-items:start" id="protocol-layout">
    <!-- Main content -->
    <div>
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;flex-wrap:wrap">
        <span class="chip">{protocol.data.category}</span>
        <span class="badge">{protocol.data.difficulty}</span>
      </div>
      <h1 class="d" style="font-size:clamp(1.875rem,3.5vw,2.75rem);margin-bottom:1rem">{protocol.data.title}</h1>
      <p style="color:var(--c-text-muted);font-size:1.0625rem;line-height:1.7;margin-bottom:2.5rem">{protocol.data.description}</p>

      <div class="prose">
        <Content />
      </div>
    </div>

    <!-- Sidebar -->
    <div style="position:sticky;top:80px">
      <!-- Protocol meta card -->
      <div class="card" style="padding:1.5rem;margin-bottom:1rem">
        <h3 style="font-family:var(--font-display);font-weight:800;font-size:0.9375rem;margin-bottom:1.25rem">Resumen del protocolo</h3>
        <div style="display:flex;flex-direction:column;gap:0.875rem">
          {[
            { label: 'Objetivo', value: protocol.data.goal, icon: 'flag' },
            { label: 'Duración', value: protocol.data.duration, icon: 'schedule' },
            { label: 'Dificultad', value: protocol.data.difficulty, icon: 'bar_chart' },
            { label: 'Categoría', value: protocol.data.category, icon: 'category' },
          ].map(item => (
            <div style="display:flex;align-items:center;gap:0.75rem">
              <span class="icon" style="font-size:18px;color:var(--c-primary)">{item.icon}</span>
              <div>
                <p style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--c-text-dim)">{item.label}</p>
                <p style="font-size:0.875rem;font-weight:600">{item.value}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Benefits -->
      {protocol.data.benefits.length > 0 && (
        <div class="card" style="padding:1.5rem;margin-bottom:1rem;border-color:rgba(34,197,94,0.2)">
          <h3 style="font-family:var(--font-display);font-weight:800;font-size:0.875rem;color:var(--c-green);margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.06em">Beneficios</h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:0.625rem">
            {protocol.data.benefits.map(b => (
              <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.8125rem;color:var(--c-text-muted)">
                <span class="icon icon-fill" style="color:var(--c-green);font-size:16px;flex-shrink:0;margin-top:1px">check_circle</span>
                {b}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- CTA -->
      <div class="card" style="padding:1.5rem;background:var(--c-primary-dim);border-color:var(--c-primary-border);text-align:center">
        <p style="font-family:var(--font-display);font-weight:800;font-size:0.9375rem;margin-bottom:0.625rem">Versión personalizada</p>
        <p style="color:var(--c-text-muted);font-size:0.8125rem;margin-bottom:1.25rem">Adapta este protocolo a tus macros, horario y objetivo específico.</p>
        <a href="/app/welcome.html" class="btn" style="width:100%;justify-content:center">Crear cuenta gratis</a>
      </div>
    </div>
  </div>
</div>

{related.length > 0 && (
  <section class="section" style="background:var(--c-surface);margin-top:4rem">
    <div class="wrap">
      <h2 style="font-family:var(--font-display);font-weight:800;font-size:1.25rem;margin-bottom:1.5rem">Otros protocolos</h2>
      <div class="grid-2">
        {related.map(p => (
          <a href={`/protocolos/${p.id}`} class="card card-link" style="padding:1.5rem">
            <span class="chip" style="margin-bottom:0.75rem;display:inline-block">{p.data.category}</span>
            <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:800;margin-bottom:0.5rem">{p.data.title}</h3>
            <p style="font-size:0.8125rem;color:var(--c-text-muted)" class="line-clamp-2">{p.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  @media (max-width: 768px) {
    #protocol-layout { grid-template-columns: 1fr !important; }
  }
</style>
</Layout>
