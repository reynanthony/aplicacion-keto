---
// Layout de las pantallas /app con la UI v2.
//   <AppShell title="Hoy" screen="hoy" demo>  … </AppShell>
//   demo = rellena con public/app/kc-demo.js (quítalo al conectar Supabase)
import '../styles/global.css';
import { KC_ICONS } from '../lib/kc-icons.js';
import AppHeader from '../components/kc/AppHeader.astro';
import TabBar from '../components/kc/TabBar.astro';
import RegistroSheet from '../components/kc/RegistroSheet.astro';
import MoreMenu from '../components/kc/MoreMenu.astro';
interface Props { title: string; screen: string; demo?: boolean }
const { title, screen, demo = false } = Astro.props;
---
<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <!-- authGuard KetoCore: solo con cuenta o modo demo (mismo patrón que AppLayout) -->
    <script is:inline>
      !function(){var u=localStorage.getItem("ketocore_user_id");if(!u)window.location.replace("/app/welcome");
      if(localStorage.getItem("ketocore_demo_mode")==="1")document.documentElement.classList.add("kc-demo");}();
    </script>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0c10" />
    <title>{title} · KetoCore</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400..700&display=swap" rel="stylesheet" />
    <!-- Material Symbols: lo usan las pantallas legacy migradas vía .app-hud -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
    <!-- tema antes del primer pintado: evita el destello -->
    <script is:inline>
      (function () {
        var t = 'dark'; // /app arranca en oscuro (mundo de marca); el toggle guarda kc-theme
        try { t = localStorage.getItem('kc-theme') || 'dark'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <!-- Dependencias que las pantallas legacy (migradas vía .app-hud) esperan; en
         <head> para que estén listas antes del contenido de la pantalla. -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0"></script>
    <script is:inline src="/app/supabase-client.js"></script>
    <script is:inline src="/app/storage-manager.js"></script>
  </head>
  <body class="kc kc-app" data-kc-screen={screen} data-kc-loading>
    <AppHeader />
    <main class="kc-main">
      <slot />
    </main>
    <TabBar active={screen} />
    <RegistroSheet />
    <MoreMenu />

    <script is:inline define:vars={{ icons: KC_ICONS }}>window.KC_ICONS = icons;</script>
    {demo && <script is:inline>window.KC_DEMO_ON = true;</script>}
    {demo && <script is:inline src="/app/kc-demo.js"></script>}
    <script is:inline src="/app/kc-ui.js"></script>
    <slot name="scripts" />
  </body>
</html>
