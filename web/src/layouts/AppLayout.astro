---
import '../styles/global.css';
import AppSidebar from '../components/AppSidebar.astro';

interface Props {
  title?: string;
  authGuard?: boolean;
  bodyClass?: string;
}

const { title = 'KetoCore', authGuard = true, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html class="dark" lang="es">
<head>
  {authGuard && (
    <script is:inline>
      // Acceso a la app solo con cuenta o con el id sintetico que siembra
      // /app/demo/ (modo prueba: misma app real, datos de muestra).
      !function(){var u=localStorage.getItem("ketocore_user_id");if(!u)window.location.replace("/app/welcome");
      if(localStorage.getItem("ketocore_demo_mode")==="1")document.documentElement.classList.add("kc-demo");}();
    </script>
  )}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ff4d00" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/svg+xml" href="/app/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
  <title>{title}</title>
  <style is:global>
  /* ── Desktop layout: sidebar activo > 900px (breakpoint app del diseño) ── */
  @media (min-width: 901px) {
    #appSidebar { display: flex !important; }
    /* ocultar botones hamburguesa móviles en desktop */
    button[aria-label="Menú"],
    button[aria-label="Abrir menú"] { display: none !important; }
    /* desplazar header fijo a la derecha del sidebar */
    header.fixed { left: 250px !important; }
    /* desplazar main a la derecha del sidebar; destapar páginas angostas */
    main { margin-left: 250px !important; padding-bottom: 2rem !important; max-width: none !important; }
    /* normalizar gutters horizontales */
    main.main-content { padding-left: 1rem !important; padding-right: 1rem !important; }
    /* grupo FAB: sin bottom nav en desktop, bajar */
    .fixed.bottom-20.right-4 { bottom: 1rem !important; }
  }
  /* ── Móvil: aire para la bottom tab bar ── */
  @media (max-width: 900px) {
    main { padding-bottom: 96px !important; }
  }

  /* ── Banner "Modo Prueba" (solo cuando html.kc-demo) ──
     Se desplaza todo en bloque (header/sidebar/main) en vez de recalibrar
     el padding-top de cada página individualmente. */
  #kcDemoBanner {
    display: none; position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    height: 40px; align-items: center; justify-content: space-between;
    gap: 10px; padding: 0 14px;
    background: rgba(15,13,10,0.97);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(255,77,0,0.25);
    white-space: nowrap;
  }
  .kcdb-left { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .kcdb-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff4d00; flex-shrink: 0; animation: kcDemoPulse 2s infinite; }
  @keyframes kcDemoPulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .kcdb-label { font-size: 10.5px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #ff7a3c; font-family: 'Plus Jakarta Sans', sans-serif; }
  .kcdb-sub { font-size: 11px; font-weight: 500; color: rgba(247,244,240,0.45); overflow: hidden; text-overflow: ellipsis; }
  #kcDemoBanner a.kcdb-cta {
    display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0;
    height: 27px; padding: 0 13px; border-radius: 100px;
    background: #ff4d00; color: #fff; text-decoration: none;
    font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 11.5px;
    box-shadow: 0 3px 10px rgba(255,77,0,0.3);
    transition: transform .14s, box-shadow .14s;
  }
  #kcDemoBanner a.kcdb-cta:hover { transform: translateY(-1px); box-shadow: 0 5px 14px rgba(255,77,0,0.38); }
  @media (max-width: 420px) { .kcdb-sub { display: none; } }

  html.kc-demo #kcDemoBanner { display: flex; }
  html.kc-demo header.fixed { top: 40px !important; }
  html.kc-demo #appSidebar { top: 40px !important; }
  html.kc-demo main { margin-top: 40px !important; }
  </style>
  <!-- Clear obsolete sidebar state from old nav system -->
  <script is:inline>localStorage.removeItem('sidebarCollapsed');</script>
  <!-- Supabase -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0"></script>
  <!-- Shared PWA scripts -->
  <script is:inline src="/app/supabase-client.js"></script>
  <script is:inline src="/app/storage-manager.js"></script>
  <!-- Service Worker: registro único para toda la app (antes duplicado e
       inconsistente en index/plan/alimentos -- solo index.astro tenía la
       recarga automática al detectar versión nueva, por lo que abrir la
       app en otra pantalla podía dejarla pegada en una versión vieja). -->
  <script is:inline>
  (function () {
    if (!('serviceWorker' in navigator)) return;
    window.addEventListener('load', function () {
      navigator.serviceWorker.register('/app/sw.js').then(function (registration) {
        registration.update();
        registration.addEventListener('updatefound', function () {
          var newWorker = registration.installing;
          if (!newWorker) return;
          newWorker.addEventListener('statechange', function () {
            if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
              newWorker.postMessage('SKIP_WAITING');
            }
          });
        });
      }).catch(function () {});
      // Guard en sessionStorage (no una variable de página): evita loops de
      // recarga si controllerchange dispara mas de una vez entre distintas
      // navegaciones mientras el SW nuevo termina de tomar control. El flag
      // se limpia a los 5s -- tiempo de sobra para que la recarga termine,
      // dejando la puerta abierta a futuras actualizaciones legítimas.
      navigator.serviceWorker.addEventListener('controllerchange', function () {
        var alreadyReloading = false;
        try { alreadyReloading = sessionStorage.getItem('kc_sw_reloading') === '1'; } catch (e) {}
        if (alreadyReloading) return;
        try {
          sessionStorage.setItem('kc_sw_reloading', '1');
          setTimeout(function () { try { sessionStorage.removeItem('kc_sw_reloading'); } catch (e) {} }, 5000);
        } catch (e) {}
        window.location.reload();
      });
    });
  })();
  </script>
</head>
<body data-theme="app" class={`min-h-screen bg-background text-on-surface font-body overflow-x-hidden${bodyClass ? ' ' + bodyClass : ''}`}>
  <div id="kcDemoBanner">
    <div class="kcdb-left">
      <span class="kcdb-dot"></span>
      <span class="kcdb-label">Modo prueba</span>
      <span class="kcdb-sub">· datos de ejemplo de Carlos</span>
    </div>
    <a href="/app/welcome" class="kcdb-cta">Crear cuenta<span class="material-symbols-outlined" style="font-size:14px">arrow_forward</span></a>
  </div>
  <slot />
  <AppSidebar />
</body>
</html>
