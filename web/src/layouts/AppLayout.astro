---
import '../styles/global.css';
import AppSidebar from '../components/AppSidebar.astro';

interface Props {
  title?: string;
  authGuard?: boolean;
  bodyClass?: string;
}

const { title = 'KetoCore', authGuard = true, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html class="dark" lang="es">
<head>
  {authGuard && (
    <script is:inline>
      !function(){var d=localStorage.getItem("ketocore_onboarding_done"),g=localStorage.getItem("KetoCore_guest"),u=localStorage.getItem("ketocore_user_id");if(!d&&!g&&!u)window.location.replace("/app/welcome");}();
    </script>
  )}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ff4d00" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/app/manifest.json" />
  <link rel="icon" type="image/svg+xml" href="/app/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
  <title>{title}</title>
  <style is:global>
  /* ── Desktop layout: sidebar activo > 900px (breakpoint app del diseño) ── */
  @media (min-width: 901px) {
    #appSidebar { display: flex !important; }
    /* ocultar botones hamburguesa móviles en desktop */
    button[aria-label="Menú"],
    button[aria-label="Abrir menú"] { display: none !important; }
    /* desplazar header fijo a la derecha del sidebar */
    header.fixed { left: 250px !important; }
    /* desplazar main a la derecha del sidebar; destapar páginas angostas */
    main { margin-left: 250px !important; padding-bottom: 2rem !important; max-width: none !important; }
    /* normalizar gutters horizontales */
    main.main-content { padding-left: 1rem !important; padding-right: 1rem !important; }
    /* grupo FAB: sin bottom nav en desktop, bajar */
    .fixed.bottom-20.right-4 { bottom: 1rem !important; }
  }
  /* ── Móvil: aire para la bottom tab bar ── */
  @media (max-width: 900px) {
    main { padding-bottom: 96px !important; }
  }
  </style>
  <!-- Clear obsolete sidebar state from old nav system -->
  <script is:inline>localStorage.removeItem('sidebarCollapsed');</script>
  <!-- Supabase -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0"></script>
  <!-- Shared PWA scripts -->
  <script is:inline src="/app/supabase-client.js"></script>
  <script is:inline src="/app/storage-manager.js"></script>
</head>
<body data-theme="app" class={`min-h-screen bg-background text-on-surface font-body overflow-x-hidden${bodyClass ? ' ' + bodyClass : ''}`}>
  <slot />
  <AppSidebar />
</body>
</html>
