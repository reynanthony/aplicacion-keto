---
import '../styles/global.css';

interface Props {
  title?: string;
  active?: string;
}
const { title = 'KetoCore | Demo', active = 'home' } = Astro.props;

// Bottom-nav espejo de la app real: Inicio / Coach / [Escanear] / Plan / Más
const sideLinks = [
  { id: 'home',           href: '/app/demo/',              icon: 'cottage',             label: 'Dashboard',       color: '' },
  { id: 'macros',         href: '/app/demo/macros',        icon: 'donut_small',         label: 'Macros',          color: '' },
  { id: 'plan',           href: '/app/demo/plan',          icon: 'event_note',          label: 'Plan Alimenticio',color: '' },
  { id: 'recetas',        href: '/app/demo/recetas',       icon: 'menu_book',           label: 'Recetas',         color: '#fb923c' },
  { id: 'checklist',      href: '/app/demo/checklist',     icon: 'task_alt',            label: 'Checklist',       color: '#22c55e' },
  { id: 'alimentos',      href: '/app/demo/alimentos',     icon: 'restaurant',          label: 'Alimentos',       color: '#fb923c' },
  { id: 'scanner',        href: '/app/demo/scanner',       icon: 'center_focus_strong', label: 'Scanner IA',      color: '#22d3ee' },
  { id: 'coach',          href: '/app/demo/coach',         icon: 'psychology',          label: 'Coach IA',        color: '#a78bfa' },
  { id: 'inspector',      href: '/app/demo/inspector',     icon: 'analytics',           label: 'Inspector',       color: '#60a5fa' },
  { id: 'progreso',       href: '/app/demo/progreso',      icon: 'trending_up',         label: 'Mi Progreso',     color: '#ff4d00' },
  { id: 'compras',        href: '/app/demo/compras',       icon: 'shopping_cart',       label: 'Lista de Compras',color: '#60a5fa' },
  { id: 'entrenamientos', href: '/app/demo/entrenamientos',icon: 'fitness_center',      label: 'Entrenamientos',  color: '#4ade80' },
];
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="theme-color" content="#ff4d00" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
  <style is:global>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
    .icon-filled { font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24; }

    body[data-theme="demo"] {
      background: #0b0a08 !important;
      color: #f7f4f0 !important;
    }

    /* ── Demo Banner (estética Editorial Bento) ── */
    #demoBanner {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      height: 40px; display: flex; align-items: center; justify-content: space-between;
      gap: 10px; padding: 0 14px;
      background: rgba(15,13,10,0.97);
      backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(255,77,0,0.25);
      white-space: nowrap;
    }
    .db-left { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .db-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff4d00; flex-shrink: 0; animation: demoPulse 2s infinite; }
    .db-label {
      font-size: 10.5px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
      color: #ff7a3c; font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .db-sub { font-size: 11px; font-weight: 500; color: rgba(247,244,240,0.45); overflow: hidden; text-overflow: ellipsis; }
    #demoBanner a.db-cta {
      display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0;
      height: 27px; padding: 0 13px; border-radius: 100px;
      background: #ff4d00; color: #fff; text-decoration: none;
      font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 11.5px;
      box-shadow: 0 3px 10px rgba(255,77,0,0.3);
      transition: transform .14s, box-shadow .14s;
    }
    #demoBanner a.db-cta:hover { transform: translateY(-1px); box-shadow: 0 5px 14px rgba(255,77,0,0.38); }
    @media (max-width: 420px) { .db-sub { display: none; } }

    /* ── Demo Header ── */
    #demoHeader {
      position: fixed; top: 40px; left: 0; right: 0; z-index: 40; height: 56px;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 1rem;
      background: rgba(11,10,8,0.97); backdrop-filter: blur(24px);
      border-bottom: 1px solid rgba(255,240,225,0.06);
    }

    /* ── Demo Sidebar ── */
    #demoSidebar {
      display: none;
      position: fixed; top: 40px; left: 0; bottom: 0; width: 248px; z-index: 30;
      background: #0f0f0f; border-right: 1px solid rgba(255,240,225,0.05);
      flex-direction: column; padding: 12px 0; overflow-y: auto;
    }
    @media (min-width: 901px) {
      #demoSidebar { display: flex; }
      #demoBottomNav { display: none !important; }
      #demoMenuBtn { display: none !important; }
      #demoMain { margin-left: 248px !important; }
      #demoHeader { left: 248px !important; }
    }

    /* ── Sidebar links ── */
    .dsb-logo { padding: 12px 16px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .dsb-logo img { width: 36px; height: 36px; filter: drop-shadow(0 0 6px rgba(255,77,0,0.4)); }
    .dsb-brand { font-family: 'Plus Jakarta Sans',sans-serif; font-weight: 900; font-size: 18px;
      background: linear-gradient(to right,#ff4d00,#ffb300); -webkit-background-clip: text;
      -webkit-text-fill-color: transparent; background-clip: text; letter-spacing: -0.02em; }
    .dsb-tag { font-size: 9px; color: rgba(247,244,240,0.35); font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase; margin-top: 1px; }
    .dsb-section { font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(247,244,240,0.28); padding: 8px 16px 4px; margin-top: 4px; }
    .dsb-link {
      display: flex; align-items: center; gap: 10px; padding: 9px 16px; margin: 1px 8px;
      border-radius: 10px; text-decoration: none; color: rgba(247,244,240,0.6);
      font-size: 13px; font-weight: 500; transition: all 0.15s; cursor: pointer;
    }
    .dsb-link:hover { background: rgba(255,240,225,0.05); color: #f7f4f0; }
    .dsb-link.active { background: rgba(255,77,0,0.12); color: #ff4d00; }
    .dsb-link.active .material-symbols-outlined { color: #ff4d00 !important; }
    .dsb-icon { font-size: 18px; }

    /* Demo badge in sidebar */
    .dsb-demo-badge {
      margin: 0 8px; padding: 10px 14px; background: rgba(255,77,0,0.08);
      border: 1px solid rgba(255,77,0,0.2); border-radius: 12px;
      display: flex; align-items: center; gap: 8px;
    }
    .dsb-demo-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #ff4d00;
      animation: demoPulse 2s infinite; flex-shrink: 0; }
    @keyframes demoPulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

    /* ── Demo Bottom Nav ── */
    #demoBottomNav {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; height: 68px;
      display: flex; align-items: center; justify-content: space-around;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: rgba(11,10,8,0.97); backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255,240,225,0.08);
    }
    .dbn-item {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
      flex: 1; padding: 8px 4px; text-decoration: none;
      color: rgba(247,244,240,0.5); transition: color 0.15s; cursor: pointer;
      background: none; border: none; font-family: 'Inter',sans-serif;
    }
    .dbn-ic { font-size: 23px; }
    .dbn-label { font-size: 11px; font-weight: 600; font-family: 'Inter',sans-serif; }
    .dbn-item.active { color: #ff4d00; }
    .dbn-scan {
      width: 46px; height: 34px; margin-top: -14px; border-radius: 14px;
      background: #ff4d00; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 6px 16px rgba(255,77,0,0.4);
    }

    /* ── Demo Main ── */
    #demoMain {
      padding-top: 96px; /* 40 banner + 56 header */
      padding-bottom: 88px; /* bottom nav */
      min-height: 100vh;
      background: #0b0a08;
    }
    @media (min-width: 901px) {
      #demoMain { padding-bottom: 2rem; }
    }

    /* ── Demo More Menu ── */
    #demoMoreMenu {
      position: fixed; bottom: 72px; left: 8px; right: 8px; z-index: 80;
      background: #161310; border: 1px solid rgba(255,240,225,0.07);
      border-radius: 20px; padding: 12px;
      box-shadow: 0 -8px 32px rgba(0,0,0,0.4);
      display: none; grid-template-columns: 1fr 1fr; gap: 8px;
    }
    #demoMoreMenu.open { display: grid; }
    .dmm-item {
      display: flex; align-items: center; gap: 10px; padding: 10px 12px;
      background: #1e1a15; border-radius: 12px; text-decoration: none;
      color: rgba(247,244,240,0.8); font-size: 13px; font-weight: 500;
      border: 1px solid rgba(255,240,225,0.05); transition: background 0.15s;
    }
    .dmm-item:hover { background: #2a2a2a; }
    .dmm-item .material-symbols-outlined { font-size: 20px; }

    /* ── Demo Paywall ── */
    #demoPaywallOverlay {
      position: fixed; inset: 0; z-index: 200; display: none;
      align-items: center; justify-content: center;
      background: rgba(0,0,0,0.75); backdrop-filter: blur(8px);
    }
    #demoPaywallOverlay.visible { display: flex; }
    #demoPaywallCard {
      width: 90%; max-width: 360px; background: #161310;
      border: 1px solid rgba(255,240,225,0.08); border-radius: 28px;
      padding: 28px; box-shadow: 0 24px 80px rgba(0,0,0,0.6);
    }
    .dpw-icon {
      width: 56px; height: 56px; border-radius: 18px; margin: 0 auto 16px;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg,#ff4d00,#ff7346);
    }
    .dpw-title { font-family: 'Plus Jakarta Sans',sans-serif; font-weight: 900; font-size: 22px;
      color: #f7f4f0; text-align: center; margin-bottom: 8px; }
    .dpw-sub { font-size: 13px; color: rgba(247,244,240,0.55); text-align: center;
      line-height: 1.5; margin-bottom: 20px; }
    .dpw-features { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
    .dpw-feat {
      display: flex; align-items: center; gap: 10px; padding: 10px 12px;
      background: rgba(255,77,0,0.06); border: 1px solid rgba(255,77,0,0.12);
      border-radius: 10px; font-size: 13px; color: rgba(247,244,240,0.8); font-weight: 500;
    }
    .dpw-feat .material-symbols-outlined { color: #ff4d00; font-size: 18px; flex-shrink: 0; }
    .dpw-cta {
      width: 100%; padding: 14px; border-radius: 14px; border: none; cursor: pointer;
      background: linear-gradient(135deg,#ff4d00,#ea580c); color: #fff;
      font-family: 'Plus Jakarta Sans',sans-serif; font-weight: 800; font-size: 15px;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: opacity 0.2s; box-shadow: 0 6px 24px rgba(255,77,0,0.3);
    }
    .dpw-cta:hover { opacity: 0.9; }
    .dpw-skip {
      width: 100%; padding: 12px; border-radius: 14px; border: none; cursor: pointer;
      background: transparent; color: rgba(247,244,240,0.4);
      font-size: 13px; font-weight: 500; margin-top: 10px; transition: color 0.2s;
    }
    .dpw-skip:hover { color: rgba(247,244,240,0.7); }

    /* ── Shared card styles ── */
    .dk-card {
      background: #161310; border: 1px solid rgba(255,240,225,0.06);
      border-radius: 20px; box-shadow: 0 4px 16px rgba(0,0,0,0.25), 0 1px 4px rgba(0,0,0,0.15);
    }
    .dk-card-orange {
      background: #161310; border: 1px solid rgba(255,77,0,0.15);
      border-radius: 20px; box-shadow: 0 4px 20px rgba(255,77,0,0.06), 0 1px 4px rgba(0,0,0,0.2);
    }
    .dk-pill {
      display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px;
      border-radius: 100px; font-size: 11px; font-weight: 700;
    }
    .dk-progress-bar { height: 6px; background: rgba(255,240,225,0.06); border-radius: 100px; overflow: hidden; }
    .dk-progress-fill { height: 100%; border-radius: 100px; transition: width 0.6s ease; }

    /* ── Demo grid (desktop 2-col) ── */
    @media (min-width: 901px) {
      .demo-2col {
        display: grid; grid-template-columns: 1fr 360px;
        gap: 1.25rem; align-items: start; padding-top: 0;
      }
      .demo-2col > * { margin-top: 0 !important; }
    }

    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: #111; }
    ::-webkit-scrollbar-thumb { background: rgba(255,77,0,0.3); border-radius: 10px; }

    /* ── Tour guiado del demo ── */
    /* El overlay NO bloquea la página: las interacciones de prueba
       (escribir, marcar, escanear) funcionan con la guía visible. */
    #dtOverlay { position: absolute; top: 0; left: 0; right: 0; z-index: 300; display: none; pointer-events: none; overflow: hidden; }
    #dtOverlay.on { display: block; }
    #dtSpot {
      position: absolute; border-radius: 20px; pointer-events: none;
      box-shadow: 0 0 0 9999px rgba(0,0,0,0.6), 0 0 0 3px rgba(255,77,0,0.9);
      transition: all .35s cubic-bezier(.4,0,.2,1);
    }
    #dtSpot.center { box-shadow: 0 0 0 9999px rgba(0,0,0,0.6); }
    #dtCard {
      position: absolute; width: min(320px, calc(100% - 32px));
      background: #161310; border: 1px solid rgba(255,240,225,0.1);
      border-radius: 20px; padding: 18px; z-index: 301;
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
      transition: all .35s cubic-bezier(.4,0,.2,1);
      pointer-events: auto;
    }
    .dt-step { font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #ff4d00; margin-bottom: 6px; }
    .dt-title { font-family: 'Plus Jakarta Sans',sans-serif; font-weight: 800; font-size: 16px; color: #f7f4f0; margin-bottom: 6px; }
    .dt-text { font-size: 13px; line-height: 1.55; color: rgba(247,244,240,0.65); margin-bottom: 14px; }
    .dt-row { display: flex; gap: 8px; align-items: center; }
    .dt-next {
      flex: 1; padding: 11px; border-radius: 12px; border: none; cursor: pointer;
      background: #ff4d00; color: #fff; font-family: 'Plus Jakarta Sans',sans-serif;
      font-weight: 700; font-size: 13.5px; display: flex; align-items: center; justify-content: center; gap: 6px;
      text-decoration: none;
    }
    .dt-skip { padding: 11px 12px; border-radius: 12px; border: none; cursor: pointer; background: transparent; color: rgba(247,244,240,0.4); font-size: 12.5px; font-weight: 600; }
    #dtHelp {
      position: fixed; bottom: 84px; right: 14px; z-index: 90;
      width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255,240,225,0.1);
      background: #161310; color: rgba(247,244,240,0.6); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 16px rgba(0,0,0,0.4); font-family: 'Plus Jakarta Sans',sans-serif;
    }
    @media (min-width: 901px) { #dtHelp { bottom: 20px; } }
  </style>
</head>
<body data-theme="demo">

  <!-- ── Demo Banner ── -->
  <div id="demoBanner">
    <div class="db-left">
      <span class="db-dot"></span>
      <span class="db-label">Modo prueba</span>
      <span class="db-sub">· datos de ejemplo de Carlos</span>
    </div>
    <a href="/#precios" class="db-cta">Suscribirse<span class="material-symbols-outlined" style="font-size:14px">arrow_forward</span></a>
  </div>

  <!-- ── App Header ── -->
  <header id="demoHeader">
    <a href="/app/demo/" style="display:flex;align-items:center;gap:10px;text-decoration:none">
      <img src="/app/logo.svg" alt="KetoCore" style="width:28px;height:28px;filter:drop-shadow(0 0 6px rgba(255,77,0,0.4))">
      <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:900;font-size:16px;color:#f7f4f0">KetoCore</span>
      <span style="font-size:10px;background:rgba(255,77,0,0.15);color:#ff4d00;border-radius:6px;padding:1px 7px;font-weight:700;border:1px solid rgba(255,77,0,0.2)">DEMO</span>
    </a>
    <button id="demoMenuBtn" onclick="toggleDemoMenu()" style="width:36px;height:36px;border-radius:50%;background:#1e1a15;border:1px solid rgba(255,240,225,0.06);display:flex;align-items:center;justify-content:center;cursor:pointer;color:rgba(247,244,240,0.6)">
      <span class="material-symbols-outlined" style="font-size:20px">menu</span>
    </button>
  </header>

  <!-- ── Demo Sidebar ── -->
  <aside id="demoSidebar">
    <a href="/app/demo/" class="dsb-logo">
      <img src="/app/logo.svg" alt="KetoCore">
      <div>
        <div class="dsb-brand">KetoCore</div>
        <div class="dsb-tag">Modo Demo</div>
      </div>
    </a>

    <div class="dsb-demo-badge">
      <div class="dsb-demo-badge-dot"></div>
      <div>
        <div style="font-size:11px;font-weight:700;color:#ff4d00">Modo Demo Activo</div>
        <div style="font-size:10px;color:rgba(247,244,240,0.4);margin-top:1px">Explorando como Carlos R.</div>
      </div>
    </div>

    <p class="dsb-section" style="margin-top:16px">Navegación Demo</p>
    {sideLinks.map(link => (
      <a href={link.href} class:list={['dsb-link', { active: active === link.id }]}>
        <span class="material-symbols-outlined dsb-icon" style={link.color ? `color:${link.color}` : ''}>{link.icon}</span>
        <span>{link.label}</span>
      </a>
    ))}

    <div style="margin-top:auto;padding:12px 8px 8px">
      <a href="/app/welcome" style="display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;border-radius:14px;background:linear-gradient(135deg,#ff4d00,#ea580c);color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;text-decoration:none;box-shadow:0 4px 16px rgba(255,77,0,0.3)">
        <span class="material-symbols-outlined" style="font-size:18px">rocket_launch</span>
        Comenzar Gratis
      </a>
      <p style="text-align:center;font-size:10px;color:rgba(247,244,240,0.28);margin-top:6px">Sin tarjeta de crédito</p>
    </div>
  </aside>

  <!-- ── Main Content ── -->
  <main id="demoMain">
    <slot />
  </main>

  <!-- ── Demo Bottom Nav (espejo de la app real) ── -->
  <nav id="demoBottomNav">
    <a href="/app/demo/" class:list={['dbn-item', { active: active === 'home' }]}>
      <span class="material-symbols-outlined dbn-ic" style={active === 'home' ? "font-variation-settings:'FILL' 1" : ""}>cottage</span>
      <span class="dbn-label">Inicio</span>
    </a>
    <a href="/app/demo/macros" class:list={['dbn-item', { active: active === 'macros' }]}>
      <span class="material-symbols-outlined dbn-ic" style={active === 'macros' ? "font-variation-settings:'FILL' 1" : ""}>donut_small</span>
      <span class="dbn-label">Macros</span>
    </a>
    <a href="/app/demo/scanner" class:list={['dbn-item', { active: active === 'scanner' }]} aria-label="Escanear">
      <span class="dbn-scan"><span class="material-symbols-outlined icon-filled" style="font-size:24px;color:#fff">center_focus_strong</span></span>
      <span class="dbn-label">Escanear</span>
    </a>
    <a href="/app/demo/plan" class:list={['dbn-item', { active: active === 'plan' }]}>
      <span class="material-symbols-outlined dbn-ic" style={active === 'plan' ? "font-variation-settings:'FILL' 1" : ""}>event_note</span>
      <span class="dbn-label">Plan</span>
    </a>
    <button type="button" class="dbn-item" onclick="toggleDemoMenu()">
      <span class="material-symbols-outlined dbn-ic">menu</span>
      <span class="dbn-label">Más</span>
    </button>
  </nav>

  <!-- ── Demo More Menu ── -->
  <div id="demoMoreMenu">
    {sideLinks.filter(l => !['home','plan','macros','scanner'].includes(l.id)).map(link => (
      <a href={link.href} class="dmm-item">
        <span class="material-symbols-outlined" style={link.color ? `color:${link.color};font-size:20px` : 'font-size:20px'}>{link.icon}</span>
        {link.label}
      </a>
    ))}
    <a href="/app/welcome" class="dmm-item" style="grid-column:1/-1;background:rgba(255,77,0,0.08);border-color:rgba(255,77,0,0.2);color:#ff4d00;justify-content:center;font-weight:700">
      <span class="material-symbols-outlined" style="color:#ff4d00;font-size:20px">rocket_launch</span>
      Crear cuenta gratis
    </a>
  </div>

  <!-- ── Paywall Overlay ── -->
  <div id="demoPaywallOverlay">
    <div id="demoPaywallCard">
      <div class="dpw-icon">
        <span class="material-symbols-outlined icon-filled" id="dpwIcon" style="color:#fff;font-size:28px">star</span>
      </div>
      <h3 class="dpw-title" id="dpwTitle">Función Premium</h3>
      <p class="dpw-sub" id="dpwSub">Disponible en KetoCore Premium</p>
      <div class="dpw-features" id="dpwFeatures"></div>
      <a href="/app/welcome" class="dpw-cta">
        <span class="material-symbols-outlined" style="font-size:18px">rocket_launch</span>
        Comenzar Gratis
      </a>
      <button class="dpw-skip" onclick="hideDemoPaywall()">Continuar explorando el demo</button>
    </div>
  </div>

  <!-- ── Tour guiado ── -->
  <div id="dtOverlay">
    <div id="dtSpot"></div>
    <div id="dtCard">
      <div class="dt-step" id="dtStep">Paso 1 de 3</div>
      <div class="dt-title" id="dtTitle"></div>
      <div class="dt-text" id="dtText"></div>
      <div class="dt-row">
        <button class="dt-next" id="dtNext" onclick="dtNext()">Siguiente</button>
        <button class="dt-skip" onclick="dtEnd(true)">Omitir</button>
      </div>
    </div>
  </div>
  <button id="dtHelp" onclick="dtStart(true)" aria-label="Ver guía de esta pantalla" title="Ver guía">
    <span class="material-symbols-outlined" style="font-size:20px">help</span>
  </button>

  <script is:inline define:vars={{ demoActive: active }}>
    // ══════════ TOUR GUIADO DEL DEMO ══════════
    // Pasos por pantalla: qué hacer, ver y esperar. sel:null = paso centrado.
    var DT_ORDER = ['home','macros','scanner','checklist','alimentos','progreso','plan','coach','inspector','recetas','compras','entrenamientos'];
    var DT_LABELS = { home:'Dashboard', macros:'Macros', scanner:'Scanner IA', checklist:'Checklist', alimentos:'Alimentos', progreso:'Progreso', plan:'Plan', coach:'Coach IA', inspector:'Inspector', recetas:'Recetas', compras:'Compras', entrenamientos:'Entrenos' };
    var DT_LINKS = { home:'/app/demo/', macros:'/app/demo/macros', scanner:'/app/demo/scanner', checklist:'/app/demo/checklist', alimentos:'/app/demo/alimentos', progreso:'/app/demo/progreso', plan:'/app/demo/plan', coach:'/app/demo/coach', inspector:'/app/demo/inspector', recetas:'/app/demo/recetas', compras:'/app/demo/compras', entrenamientos:'/app/demo/entrenamientos' };
    var DT_STEPS = {
      home: [
        { sel: null, title: 'Bienvenido al modo prueba', text: 'Estás viendo la app con los datos de Carlos, un usuario real de ejemplo. Todo lo que ves aquí es lo que recibirás con tu suscripción.' },
        { sel: 'a[href="/app/demo/inspector"]', title: 'Tu Health Score', text: 'La IA resume tu salud metabólica en un número, calculado a diario con tus comidas, peso y hábitos.' },
        { sel: '.kc-tile-cream', title: 'Calorías y macros del día', text: 'Cada comida que registras se descuenta aquí. Verde = vas en meta.' },
      ],
      macros: [
        { sel: null, title: 'Control de macros', text: 'El corazón de keto: la app calcula tu reparto ideal de grasas, proteína y carbos, y te muestra cuánto llevas.' },
        { sel: '.kc-tile-cream', title: 'Lo más importante: carbos netos', text: 'Este número te dice cuánto margen te queda hoy para seguir en cetosis. La app lo vigila por ti.' },
      ],
      scanner: [
        { sel: '#dscBtn', title: 'Pruébalo: toca el botón naranja', text: 'Simula un escaneo. En la app real, la cámara detecta el alimento y te da su veredicto keto en 2 segundos.' },
      ],
      checklist: [
        { sel: '.dck-item', title: 'Toca un hábito para marcarlo', text: 'Pruébalo ahora: al marcar y desmarcar, el anillo de progreso se actualiza. Así construyes tu racha diaria.' },
      ],
      alimentos: [
        { sel: '#dalSearch', title: 'Escribe un alimento', text: 'Prueba con "manzana" o "salmón". El veredicto Keto / Moderar / Evitar aparece al instante.' },
      ],
      progreso: [
        { sel: null, title: 'Resultados medibles', text: 'Carlos perdió 17 lbs en 21 días. La app grafica tu peso, tu meta y tus logros — tu progreso, en evidencia.' },
      ],
      plan:           [{ sel: null, title: 'Tu semana, planificada', text: 'La app genera tu plan de comidas con IA según tus macros. Aquí ves el día de Carlos ya resuelto: qué comer y cuándo.' }],
      coach:          [{ sel: null, title: 'Coach IA, siempre en línea', text: 'Pregunta lo que sea: el coach conoce tu progreso y responde con contexto. Escríbele algo para probar.' }],
      inspector:      [{ sel: null, title: 'El Inspector te analiza', text: 'Detecta patrones en tus datos: cetosis, hidratación, proteína. Te avisa antes de que algo se desvíe.' }],
      recetas:        [{ sel: null, title: 'Recetas verificadas', text: 'Cada receta trae macros calculados y carbos netos. Filtra por categoría y añádelas a tu plan con un toque.' }],
      compras:        [{ sel: null, title: 'Lista de compras automática', text: 'Se genera sola a partir de tu plan semanal, organizada por pasillo del supermercado.' }],
      entrenamientos: [{ sel: null, title: 'Entrenamiento integrado', text: 'Rutinas y seguimiento conectados con tu nutrición: la app ajusta tus macros según lo que entrenas.' }],
    };

    var dtSteps = DT_STEPS[demoActive] || [];
    var dtIdx = 0;
    var dtKey = 'demo_tour_' + demoActive;

    function dtShow() {
      var s = dtSteps[dtIdx];
      if (!s) { dtEnd(true); return; }
      var overlay = document.getElementById('dtOverlay');
      var spot = document.getElementById('dtSpot');
      var card = document.getElementById('dtCard');
      overlay.classList.add('on');

      document.getElementById('dtStep').textContent = 'Paso ' + (dtIdx + 1) + ' de ' + dtSteps.length;
      document.getElementById('dtTitle').textContent = s.title;
      document.getElementById('dtText').textContent = s.text;

      // Último paso → botón "Siguiente pantalla"
      var nextBtn = document.getElementById('dtNext');
      var isLast = dtIdx === dtSteps.length - 1;
      var orderIdx = DT_ORDER.indexOf(demoActive);
      var nextPage = orderIdx >= 0 && orderIdx < DT_ORDER.length - 1 ? DT_ORDER[orderIdx + 1] : null;
      if (isLast && nextPage) {
        nextBtn.innerHTML = 'Siguiente: ' + DT_LABELS[nextPage] + ' <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span>';
        nextBtn.onclick = function () { dtEnd(true); window.location.href = DT_LINKS[nextPage]; };
      } else if (isLast) {
        nextBtn.textContent = 'Entendido';
        nextBtn.onclick = function () { dtEnd(true); };
      } else {
        nextBtn.textContent = 'Siguiente';
        nextBtn.onclick = dtNext;
      }

      // El body va con zoom en móvil: convertir coordenadas visuales → layout
      var z = parseFloat(getComputedStyle(document.body).zoom) || 1;
      var vw = window.innerWidth / z;
      var vh = window.innerHeight / z;
      var sy = window.scrollY / z;
      overlay.style.height = (document.documentElement.scrollHeight / z) + 'px';

      var el = s.sel ? document.querySelector(s.sel) : null;
      if (el) {
        el.scrollIntoView({ block: 'center', behavior: 'instant' });
        sy = window.scrollY / z;
        var r0 = el.getBoundingClientRect();
        var r = { top: r0.top / z, left: r0.left / z, width: r0.width / z, height: r0.height / z, bottom: r0.bottom / z };
        var top = r.top + sy;
        spot.classList.remove('center');
        spot.style.top = (top - 6) + 'px';
        spot.style.left = Math.max(4, r.left - 6) + 'px';
        spot.style.width = Math.min(r.width + 12, vw - 8) + 'px';
        spot.style.height = (r.height + 12) + 'px';
        // tarjeta debajo o encima del foco según espacio
        var below = r.bottom + 210 < vh;
        card.style.top = (below ? top + r.height + 18 : Math.max(sy + 12, top - 210)) + 'px';
        card.style.left = Math.max(16, Math.min(r.left, vw - 336)) + 'px';
      } else {
        spot.classList.add('center');
        spot.style.width = '0px'; spot.style.height = '0px';
        spot.style.top = sy + 'px'; spot.style.left = '50%';
        card.style.top = (sy + vh * 0.3) + 'px';
        card.style.left = 'max(16px, calc(50% - 160px))';
      }
    }
    function dtNext() { dtIdx++; if (dtIdx >= dtSteps.length) { dtEnd(true); } else { dtShow(); } }
    function dtEnd(remember) {
      document.getElementById('dtOverlay').classList.remove('on');
      if (remember) { try { localStorage.setItem(dtKey, '1'); } catch (e) {} }
    }
    function dtStart(force) {
      if (!dtSteps.length) return;
      if (!force) { try { if (localStorage.getItem(dtKey)) return; } catch (e) {} }
      dtIdx = 0;
      dtShow();
    }
    // Autoarranque suave al entrar por primera vez a cada pantalla
    window.addEventListener('load', function () { setTimeout(function () { dtStart(false); }, 700); });
  </script>

  <script is:inline>
    // ── Demo Menu Toggle ──
    function toggleDemoMenu() {
      const m = document.getElementById('demoMoreMenu');
      m.classList.toggle('open');
    }
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('demoMoreMenu');
      if (menu && !e.target.closest('#demoMoreMenu') && !e.target.closest('#demoMenuBtn')) {
        menu.classList.remove('open');
      }
    });

    // ── Paywall System ──
    const PAYWALL_CONFIG = {
      plan: {
        icon: 'event_note',
        title: 'Plan Personalizado',
        sub: 'Tu plan de comidas se genera con IA según tu metabolismo, objetivo y preferencias.',
        features: [
          { icon: 'smart_toy', text: 'Plan generado por IA para tu perfil' },
          { icon: 'restaurant_menu', text: '21 días de comidas planificadas' },
          { icon: 'shopping_cart', text: 'Lista de compras automática' },
        ]
      },
      coach: {
        icon: 'psychology',
        title: 'Coach Real con IA',
        sub: 'Accede al coach inteligente que responde con contexto de tu historial y progreso real.',
        features: [
          { icon: 'chat', text: 'Respuestas personalizadas a tu historial' },
          { icon: 'fitness_center', text: 'Ajuste de macros y plan en tiempo real' },
          { icon: 'notifications_active', text: 'Alertas proactivas sin que preguntes' },
        ]
      },
      progress: {
        icon: 'trending_up',
        title: 'Guarda Tu Progreso',
        sub: 'Crea tu cuenta para empezar a registrar tu peso, comidas y hábitos diarios.',
        features: [
          { icon: 'cloud_sync', text: 'Sincronización en todos tus dispositivos' },
          { icon: 'history', text: 'Historial de 365 días de progreso' },
          { icon: 'analytics', text: 'Inspector analizando tus patrones' },
        ]
      },
      scanner: {
        icon: 'center_focus_strong',
        title: 'Scanner Keto IA',
        sub: 'Apunta la cámara a cualquier alimento o etiqueta y obtén macros + veredicto keto al instante.',
        features: [
          { icon: 'photo_camera', text: 'Detección por cámara o código de barras' },
          { icon: 'grain', text: 'Carbos netos y veredicto keto en segundos' },
          { icon: 'add_circle', text: 'Añade directo a tu registro diario' },
        ]
      }
    };

    function showPaywall(type) {
      const cfg = PAYWALL_CONFIG[type] || PAYWALL_CONFIG.plan;
      document.getElementById('dpwIcon').textContent = cfg.icon;
      document.getElementById('dpwTitle').textContent = cfg.title;
      document.getElementById('dpwSub').textContent = cfg.sub;
      const feats = document.getElementById('dpwFeatures');
      feats.innerHTML = cfg.features.map(f =>
        `<div class="dpw-feat"><span class="material-symbols-outlined icon-filled">${f.icon}</span>${f.text}</div>`
      ).join('');
      document.getElementById('demoPaywallOverlay').classList.add('visible');
    }
    function hideDemoPaywall(e) {
      if (!e || e.target === document.getElementById('demoPaywallOverlay') || !e.target.closest('#demoPaywallCard')) {
        document.getElementById('demoPaywallOverlay').classList.remove('visible');
      }
    }
    document.getElementById('demoPaywallOverlay').addEventListener('click', hideDemoPaywall);

    // Highlight active sidebar link
    (function() {
      const path = window.location.pathname.replace(/\/$/, '') || '/app/demo';
      document.querySelectorAll('.dsb-link').forEach(function(a) {
        const href = a.getAttribute('href').replace(/\/$/, '') || '/app/demo';
        if (path === href || (path === '/app/demo' && href === '/app/demo')) {
          a.classList.add('active');
        }
      });
    })();
  </script>
</body>
</html>
